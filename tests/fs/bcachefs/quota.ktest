#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

require-kernel-config QUOTA
require-kernel-config BCACHEFS_QUOTA

config-scratch-devs 4G
config-scratch-devs 4G

require-git http://evilpiepirate.org/git/linuxquota.git
require-make linuxquota

test_usrquota_twodevices()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    udevadm settle

    mount -t bcachefs -o usrquota,grpquota,prjquota ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    repquota -s /mnt

    echo foo:10	    >> /etc/projid
    echo 10:/mnt    >> /etc/projects

    set_as_user
    chmod 777 /mnt

    setquota -u $as_user_uid 256M 512M 64 128 /mnt
    #setquota -t 60 60 /mnt

    echo "testing direct writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/foo bs=1M count=1024 oflag=direct
    repquota -s /mnt

    rm /mnt/foo

    echo "testing buffered writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/foo bs=1M count=1024
    repquota -s /mnt
    rm /mnt/foo

    umount /mnt
}

test_usrquota()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs -o usrquota,grpquota,prjquota ${ktest_scratch_dev[0]} /mnt

    repquota -s /mnt

    echo foo:10	    >> /etc/projid
    echo 10:/mnt    >> /etc/projects

    set_as_user
    chmod 777 /mnt

    setquota -u $as_user_uid 256M 512M 64 128 /mnt
    #setquota -t 60 60 /mnt

    echo "testing direct writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/foo bs=1M count=1024 oflag=direct
    repquota -s /mnt

    rm /mnt/foo

    echo "testing buffered writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/foo bs=1M count=1024
    repquota -s /mnt
    rm /mnt/foo

    umount /mnt
}

test_grpquota()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}

    mount -t bcachefs -o usrquota,grpquota,prjquota ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    set_as_user
    chmod 777 /mnt

    setquota -g $as_user_gid 256M 512M 64 128 /mnt
    #setquota -t 60 60 /mnt

    repquota -g -s /mnt

    echo "testing direct writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/foo bs=1M count=1024 oflag=direct
    repquota -g -s /mnt

    umount /mnt
}

test_prjquota()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs -o usrquota,grpquota,prjquota ${ktest_scratch_dev[0]} /mnt

    repquota -vP  /mnt
    mkdir /mnt/q1
    mkdir /mnt/q2

    setproject -c -P q1 /mnt/q1
    setproject -c -P q2_averylongprojectquotanamefooooooooooooooooooooooooooooooooooooooooobar /mnt/q2

    getfattr -R -d -m - /mnt/

    set_as_user
    chmod 777 /mnt/q1

    #setquota -t 60 60 /mnt
    setquota -P q1 256M 512M 64 128 /mnt

    # dd creates q1/foo itself, after setproject, so it inherits q1's project
    # id. A file created before setproject stays in project 0, and writes to it
    # wouldn't count against this limit at all.
    echo "testing direct writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/q1/foo bs=1M count=1024 oflag=direct
    repquota -P -s /mnt

    chattr -p 0 /mnt/q1/foo

    #mv /mnt/q1/foo /mnt/q2
    repquota -P -s /mnt

    umount /mnt
}

test_prjquota_multidevices()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    udevadm settle

    mount -t bcachefs -o usrquota,grpquota,prjquota ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    repquota -vP  /mnt
    mkdir /mnt/q1
    mkdir /mnt/q2

    setproject -c -P q1 /mnt/q1
    setproject -c -P q2 /mnt/q2

    getfattr -R -d -m - /mnt/

    set_as_user
    chmod 777 /mnt/q1

    #setquota -t 60 60 /mnt
    setquota -P q1 256M 512M 64 128 /mnt

    # dd creates q1/foo itself, after setproject, so it inherits q1's project
    # id. A file created before setproject stays in project 0, and writes to it
    # wouldn't count against this limit at all.
    echo "testing direct writes"
    assert_fails_with "Disk quota exceeded" $as_user dd if=/dev/zero of=/mnt/q1/foo bs=1M count=1024 oflag=direct
    repquota -P -s /mnt

    mv /mnt/q1/foo /mnt/q2
    repquota -P -s /mnt

    umount /mnt
}

test_prjquota_after_primary_device_remove()
{
    set_watchdog 180

    run_quiet "" bcachefs format -f				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}		\
	--label=hdd.hdd1 ${ktest_scratch_dev[1]}		\
	--metadata_target=hdd					\
	--foreground_target=hdd					\
	--promote_target=hdd					\
	--background_target=hdd
    udevadm settle

    mount -t bcachefs -o usrquota,grpquota,prjquota		\
	${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    repquota -P -s /mnt
    bcachefs device remove ${ktest_scratch_dev[0]} /mnt
    repquota -P -s /mnt

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[1]}
}

main "$@"
