#!/usr/bin/env bash
# Exercise EC evacuation and degraded-read forward progress after degraded IO.
# shellcheck disable=SC1091,SC2034,SC2154,SC2329

# shellcheck source=tests/fs/bcachefs/bcachefs-test-libs.sh
. "$(dirname "$(readlink -e "${BASH_SOURCE[0]}")")/bcachefs-test-libs.sh"

require-kernel-config BCACHEFS_ERASURE_CODING

config-scratch-devs 16G
config-scratch-devs 16G
config-scratch-devs 16G
config-scratch-devs 16G
config-scratch-devs 16G

config-mem 4G

# Reads while a member is offline may legitimately recover from alternate
# replicas or EC reconstruction; the regression is loss of forward progress.
ktest_expect_sb_errors="data_read_(io|csum)_err_recovered"

prepare_ec_degraded_io()
{
    local usage=$1

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=3				\
	"${ktest_scratch_dev[0]}"			\
	"${ktest_scratch_dev[1]}"			\
	"${ktest_scratch_dev[2]}"			\
	"${ktest_scratch_dev[3]}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]:0:4}")" /mnt
    bcachefs subvolume create /mnt/data

    fio --output-format=json			\
	--output="$ktest_out/fio-seed.json"	\
	--name=seed				\
	--filename=/mnt/data/seed.dat		\
	--rw=write				\
	--bs=1M					\
	--size=7G				\
	--end_fsync=1

    fio --output-format=json			\
	--output="$ktest_out/fio-churn.json"	\
	--name=churn				\
	--filename=/mnt/data/seed.dat		\
	--rw=randwrite				\
	--bs=4k					\
	--size=7G				\
	--runtime=120				\
	--time_based				\
	--fdatasync=16

    bcachefs fs usage -h /mnt | tee "$usage"
    if ! grep -qE '^user:[[:space:]]+2/4' "$usage"; then
	echo "no EC-striped user data found before degraded IO" >&2
	return 1
    fi

    bcachefs device offline --force "${ktest_scratch_dev[1]}"

    fio --output-format=json				\
	--output="$ktest_out/fio-degraded-write.json"	\
	--name=degraded-write				\
	--directory=/mnt/data				\
	--rw=randwrite					\
	--bs=4k						\
	--size=1G					\
	--runtime=30					\
	--time_based					\
	--fdatasync=16
}

fio_running()
{
    local pid=$1 state

    [[ -d /proc/$pid ]] || return 1
    state=$(ps -o stat= -p "$pid" 2>/dev/null) || return 1
    [[ $state != Z* ]]
}

dump_degraded_read_stall()
{
    local fio_pid=$1 pid

    ps -e -o pid,ppid,stat,etime,wchan:32,comm,args
    bcachefs fs usage -a -h /mnt || true
    bcachefs reconcile status /mnt || true
    for pid in "$fio_pid" $(pgrep -P "$fio_pid" 2>/dev/null || true); do
	[[ -r /proc/$pid/status ]] || continue
	echo "===== /proc/$pid ====="
	cat "/proc/$pid/status"
	cat "/proc/$pid/wchan"
	cat "/proc/$pid/stack"
    done
    printf w > /proc/sysrq-trigger
    dmesg --color=never
}

test_ec_evacuate_after_degraded_io()
{
    set_watchdog 1200

    prepare_ec_degraded_io "$ktest_out/ec-evacuate-usage.txt"

    fio --output-format=json				\
	--output="$ktest_out/fio-degraded-read.json"	\
	--name=degraded-read				\
	--filename=/mnt/data/seed.dat			\
	--rw=randread					\
	--bs=4k						\
	--size=7G					\
	--runtime=30					\
	--time_based

    bcachefs device online "${ktest_scratch_dev[1]}"
    bcachefs device add -f /mnt "${ktest_scratch_dev[4]}"
    bcachefs device evacuate "${ktest_scratch_dev[1]}"

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt
    bcachefs fsck -n "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks "${ktest_scratch_dev[0]}"
}

test_ec_degraded_read_forward_progress()
{
    local fio_pid monitor_pid fio_rc=0
    local read_watchdog=${READ_WATCHDOG:-90}
    local release_timeout=${RELEASE_TIMEOUT:-60}
    local stalled_marker="$ktest_out/ec-degraded-read-stalled"

    set_watchdog 1200

    prepare_ec_degraded_io "$ktest_out/ec-degraded-read-usage.txt"

    rm -f "$stalled_marker"
    fio --output-format=json				\
	--output="$ktest_out/fio-degraded-read.json"	\
	--name=degraded-read				\
	--filename=/mnt/data/seed.dat			\
	--rw=randread					\
	--bs=4k						\
	--size=7G					\
	--runtime=30					\
	--time_based &
    fio_pid=$!

    (
	sleep "$read_watchdog"
	if fio_running "$fio_pid"; then
	    dump_degraded_read_stall "$fio_pid" \
		> "$ktest_out/degraded-read-stalled.txt" 2>&1
	    : > "$stalled_marker"
	    bcachefs device online "${ktest_scratch_dev[1]}"
	    sleep "$release_timeout"
	    if fio_running "$fio_pid"; then
		dump_degraded_read_stall "$fio_pid" \
		    > "$ktest_out/still-blocked-after-online.txt" 2>&1
	    fi
	fi
    ) &
    monitor_pid=$!

    wait "$fio_pid" || fio_rc=$?
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true

    if [[ ! -e $stalled_marker ]]; then
	bcachefs device online "${ktest_scratch_dev[1]}"
    fi

    umount /mnt
    bcachefs fsck -n "${ktest_scratch_dev[@]:0:4}"
    bcachefs_test_end_checks "${ktest_scratch_dev[0]}"

    if [[ -e $stalled_marker ]]; then
	echo "degraded read made progress only after the member came online" >&2
	return 1
    fi

    return "$fio_rc"
}

main "$@"
