#!/usr/bin/env bash

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

require-kernel-config BCACHEFS_FS
require-kernel-config UNICODE=m

config-scratch-devs 4G

# Basic casefolding test - unicode available
test_casefold_basic()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/casefold_dir
    bcachefs set-file-option --casefold /mnt/casefold_dir

    echo "hello" > /mnt/casefold_dir/TestFile

    # Should be able to read with different case
    cat /mnt/casefold_dir/testfile
    cat /mnt/casefold_dir/TESTFILE

    # Verify it's the same file
    [[ $(cat /mnt/casefold_dir/TestFile) == $(cat /mnt/casefold_dir/testfile) ]]

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

# Test casefold_disabled mount option
test_casefold_disabled()
{
    set_watchdog 30

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    # Mount with casefold_disabled
    mount -o casefold_disabled ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/test_dir

    # Trying to enable casefolding should fail: bch2_inode_set_casefold()
    # refuses via bch2_fs_casefold_enabled(), which throws casefolding_disabled
    # (class EOPNOTSUPP) when the fs was mounted casefold_disabled.
    #
    # The old form here grepped for "casefolding" and could never match: that
    # word is in bch_err_ratelimited()'s "Cannot enable casefolding: %s", which
    # goes to dmesg. What reaches us is set-file-option's own context line
    # around the failing setxattr, "setting bcachefs.casefold on ...", which has
    # "casefold" but not "casefolding".
    assert_fails_with "casefold" bcachefs set-file-option --casefold /mnt/test_dir

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

# Test that casefolding fs feature is properly detected
test_casefold_fs_feature()
{
    set_watchdog 30

    # Create fs, enable casefolding on a dir, unmount
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt
    mkdir /mnt/cf_dir
    bcachefs set-file-option --casefold /mnt/cf_dir
    echo "test" > /mnt/cf_dir/MixedCase
    umount /mnt

    # Remount - should work since unicode is available
    mount ${ktest_scratch_dev[0]} /mnt
    cat /mnt/cf_dir/mixedcase
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

test_casefold_negative_parallel_lookup()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/casefold_dir
    bcachefs set-file-option --casefold /mnt/casefold_dir

    local start_gate=$(mktemp -u /tmp/casefold-negative-lookup.XXXXXX)
    mkfifo "$start_gate"

    lookup_miss()
    {
	read -r _ < "$start_gate"
	for i in $(seq 1 2000); do
	    [[ ! -e /mnt/casefold_dir/MiSsInG ]]
	done
    }

    for i in $(seq 1 16); do
	lookup_miss &
    done
    for i in $(seq 1 16); do
	echo go
    done > "$start_gate"
    wait
    rm "$start_gate"

    echo "created" > /mnt/casefold_dir/missing
    [[ $(cat /mnt/casefold_dir/MISSING) == "created" ]]

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

# Lookups racing create, rename and unlink of one name in a casefolded
# directory, where the renames cycle it between two spellings that casefold
# equal (MiSsInG -> MISSING): negative dentries, case-alias renames and the
# unlink-side d_invalidate() all under contention. Lockdep reports and warnings
# fail the test through check_dmesg; a hang through the watchdog; a stall that
# recovers through the hung-task check here.
#
# The workers are python for os.rename(): mv refuses to rename between two
# names for the same file, which is the case-alias rename we want.
casefold_storm_worker='
import os, sys, time

role, d, secs, tid = sys.argv[1], sys.argv[2], float(sys.argv[3]), sys.argv[4]
target, alias = d + "/MiSsInG", d + "/MISSING"
end = time.monotonic() + secs

def quiet(f, *args):
    try:
        f(*args)
    except OSError:
        pass

i = 0
while time.monotonic() < end:
    i += 1
    if role == "lookup":
        quiet(os.stat, target)
        try:
            os.close(os.open(target, os.O_RDONLY))
        except OSError:
            pass
    elif role == "rename":
        tmp = f"{d}/.tmp.{tid}.{i}"
        try:
            with open(tmp, "w") as f:
                f.write("x")
        except OSError:
            continue
        try:
            os.rename(tmp, target)
        except OSError:
            quiet(os.unlink, tmp)
        quiet(os.rename, target, alias)
        quiet(os.rename, alias, f"{d}/alias.{tid}.{i}")
        quiet(os.unlink, f"{d}/alias.{tid}.{i}")
        quiet(os.unlink, alias)
    else:
        quiet(os.unlink, target)
        quiet(os.unlink, alias)
'

test_casefold_lookup_rename_unlink_storm()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    local dir=/mnt/casefold_dir
    mkdir $dir
    bcachefs set-file-option --casefold $dir
    sync
    echo 3 > /proc/sys/vm/drop_caches

    local dmesg_before=$(dmesg | wc -l)
    local pids=() role i

    for role in lookup rename unlink; do
	for i in $(seq 1 4); do
	    python3 -c "$casefold_storm_worker" $role $dir 30 $i &
	    pids+=($!)
	done
    done
    for i in "${pids[@]}"; do
	wait $i
    done

    if dmesg | tail -n +$((dmesg_before + 1)) | grep "blocked for more than"; then
	echo "FAIL: task stalled during the casefold lookup/rename/unlink storm"
	return 1
    fi

    echo "created" > $dir/missing
    [[ $(cat $dir/MISSING) == "created" ]]

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# rmdir in a casefolded dir calls d_invalidate(), which waits for child dentries
# another thread is killing; if that thread is evicting a deleted subdirectory it
# needs the dirents leaf the rmdir may still hold locked. Race the last close of
# an rmdir'd subdirectory against rmdir of its parent.
test_casefold_rmdir_vs_evict()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/casefold_dir
    bcachefs set-file-option --casefold /mnt/casefold_dir

    rmdir_vs_evict()
    {
	local d=/mnt/casefold_dir/w$1

	for i in $(seq 1 2000); do
	    mkdir -p $d/sub
	    sleep 0.00$((RANDOM % 3)) < $d/sub &
	    rmdir $d/sub
	    sleep 0.00$((RANDOM % 3))
	    rmdir $d
	    wait
	done
    }

    for i in $(seq 1 8); do
	rmdir_vs_evict $i &
    done
    wait

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

main "$@"
