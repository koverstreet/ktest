#!/usr/bin/env bash
#
# fsck corruption injection tests for the passes in fs/fs/ (check*.c):
# link counts, directory and subvolume structure.
#
# Each test builds a small filesystem, injects one precise corruption with
# `bcachefs kvdb` on the unmounted image, and asserts:
#
#   - fsck -y detects it (exit != 0) and records the expected error in the
#     superblock - by name: a clean second run can't tell a repair from a
#     check that never looked. check_directory_structure visited no inodes
#     for over a year, and an injected directory loop "converged" clean.
#   - no errors recorded beyond the ones the test declares
#   - a second fsck -n runs clean
#   - the repaired filesystem mounts and is whole
#
# These are the regression tests for the passes' Rust conversions: every
# converted pass gets its injections here.
#
# Inject states that are consistent apart from the corruption under test:
# earlier passes repair whatever they can see first. A subvolume's
# fs_path_parent is checked against its dirent by check_dirents, so a loop
# made by editing fs_path_parent alone never reaches the structure pass.
#
# No bcachefs_test_end_checks: these tests intentionally stamp error
# counters.

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

config-scratch-devs 4G

dev()
{
    echo ${ktest_scratch_dev[0]}
}

kvdb()
{
    bcachefs kvdb $(dev) "$@"
}

kvdb_rw()
{
    bcachefs kvdb --rw $(dev) "$@"
}

# A field of the root subvolume's version of an inode, as update names it:
# inode_field <inum> <field>
inode_field()
{
    kvdb -c "get inodes 0:$1:U32_MAX $2" | tail -1
}

# Inode flag bits, from BCH_INODE_FLAGS() (fs/fs/inode_format.h); inode
# flags are only reachable through bi_flags as a whole.
declare -A INODE_FLAG=(
    [unlinked]=7 [has_child_snapshot]=9 [has_inode_opts]=12
    [has_access_acl]=13 [has_default_acl]=14
)

# inode_flag <inum> <flag>: 1 if set
inode_flag()
{
    echo $(( ($(inode_field $1 bi_flags) >> ${INODE_FLAG[$2]}) & 1 ))
}

# inode_flag_set <inum> <flag> <0|1>
inode_flag_set()
{
    local flags=$(inode_field $1 bi_flags) bit=$(( 1 << ${INODE_FLAG[$2]} ))
    (( $3 )) && flags=$(( flags | bit )) || flags=$(( flags & ~bit ))
    kvdb_rw -c "update inodes 0:$1:U32_MAX bi_flags=$flags"
}

new_fs()
{
    run_quiet "" bcachefs format -f $(dev)
    mount -t bcachefs $(dev) /mnt
}

# "<inode>:<offset> <target>" of the dirent named $1, in the root subvolume's
# snapshot. Names must be unique across the filesystem.
dirent()
{
    bcachefs list -b dirents $(dev) |
	sed -n "s/.*type dirent \([0-9]*:[0-9]*\):U32_MAX .*: $1 -> \([0-9]*\) .*/\1 \2/p"
}

recorded_errors()
{
    bcachefs show-super -f errors_v2 $(dev) |
	sed -nE '/^errors(_v2)? /,${/^errors(_v2)? /!p;}' |
	awk '{print $1}'
}

# check_fsck <error>: detected and recorded, nothing undeclared
# (ktest_expect_sb_errors), repaired
check_fsck()
{
    local expect=$1
    local rc1=0 rc2=0

    bcachefs fsck -y $(dev) || rc1=$?
    echo "first fsck -y exited $rc1"

    if (( rc1 == 0 )); then
	echo "TEST FAILED: fsck missed injected corruption"
	exit 1
    fi

    if ! recorded_errors | grep -qx "$expect"; then
	echo "TEST FAILED: $expect not recorded (recorded: $(recorded_errors | xargs))"
	exit 1
    fi

    if ! check_bcachefs_errors $(dev); then
	echo "TEST FAILED: errors the test didn't declare" \
	     "(ktest_expect_sb_errors='$ktest_expect_sb_errors')"
	exit 1
    fi

    bcachefs fsck -n $(dev) || rc2=$?
    echo "second fsck -n exited $rc2"

    if (( rc2 != 0 )); then
	echo "TEST FAILED: errors remain after fsck -y"
	exit 1
    fi
}

# ── check_nlinks ─────────────────────────────────────────────────────────

# A file with two links whose inode says more. bi_nlink is the link count
# less one for a non-directory (1 here); check_nlinks only counts inodes
# with it nonzero.
test_wrong_nlink()
{
    new_fs
    echo foo > /mnt/f
    ln /mnt/f /mnt/g
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_nlink=5"

    ktest_expect_sb_errors="inode_wrong_nlink"
    check_fsck inode_wrong_nlink

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/f) == 2 ]]
    [[ $(cat /mnt/g) == foo ]]
    umount /mnt
}

# check_fsck_declined <error>: fsck -n reports it, and changes nothing - the
# caller checks the state it cares about
check_fsck_declined()
{
    local expect=$1 rc=0

    bcachefs fsck -n $(dev) > /tmp/fsck-n.log 2>&1 || rc=$?
    cat /tmp/fsck-n.log
    echo "fsck -n exited $rc"

    if (( rc == 0 )); then
	echo "TEST FAILED: fsck -n missed injected corruption"
	exit 1
    fi

    if ! grep -qw "$expect" /tmp/fsck-n.log; then
	echo "TEST FAILED: fsck -n didn't report $expect"
	exit 1
    fi
}

# Whether the inode is on the deleted_inodes list
on_deleted_list()
{
    # Captured, not piped to grep -q: an early exit SIGPIPEs the list, and
    # under pipefail that fails the match
    local list=$(bcachefs list -b deleted_inodes $(dev))
    grep -q "type set 0:$1:" <<< "$list"
}

# A function, not `! on_deleted_list`: set -e ignores a negated command.
not_on_deleted_list()
{
    ! on_deleted_list "$@"
}

# Make a file or directory an unlinked orphan: no dirent, no backpointer,
# unlinked set. Prints the inode number. orphan_unlinked <path in /mnt>,
# with the filesystem mounted; leaves it unmounted.
orphan_unlinked()
{
    local name=$(basename $1) inum=$(stat -c %i $1)
    umount /mnt

    local d=($(dirent $name))
    local flags=$(inode_field $inum bi_flags)
    kvdb_rw -c "set dirents ${d[0]}:U32_MAX deleted" \
	    -c "update inodes 0:$inum:U32_MAX bi_dir=0 bi_dir_offset=0 bi_flags=$(( flags | 1 << ${INODE_FLAG[unlinked]} ))" >&2
    echo $inum
}

# ── check_inodes ─────────────────────────────────────────────────────────

test_dir_nonzero_i_size()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    local x=$(stat -c %i /mnt/x)
    umount /mnt

    kvdb_rw -c "update inodes 0:$x:U32_MAX bi_size=4096"

    ktest_expect_sb_errors="inode_dir_has_nonzero_i_size"
    check_fsck inode_dir_has_nonzero_i_size

    [[ $(inode_field $x bi_size) == 0 ]]
}

# The flags that cache the answer to a question about other btrees, set with
# nothing behind them: no versions in descendant snapshots, no ACL xattrs.
# (The other direction of the ACL flags - xattr present, flag clear - is
# check_xattrs'.)
test_inode_cached_flags_wrong()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    local flags=$(inode_field $inum bi_flags)
    local bit
    for bit in has_child_snapshot has_access_acl has_default_acl; do
	flags=$(( flags | 1 << ${INODE_FLAG[$bit]} ))
    done
    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_flags=$flags"

    ktest_expect_sb_errors="inode_has_child_snapshots_wrong|inode_has_access_acl_flag_wrong|inode_has_default_acl_flag_wrong"
    check_fsck inode_has_child_snapshots_wrong
    local recorded=$(recorded_errors)
    grep -qx inode_has_access_acl_flag_wrong  <<< "$recorded"
    grep -qx inode_has_default_acl_flag_wrong <<< "$recorded"

    for bit in has_child_snapshot has_access_acl has_default_acl; do
	[[ $(inode_flag $inum $bit) == 0 ]]
    done

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# has_inode_opts, both ways: set with no options, clear with one. The packer
# recomputes it and update would correct the injection, so these go in raw
# (update -r), from the stored bi_flags - which also holds the packing
# fields. Empty files, so an option set behind propagation's back has no
# extents to disagree with.
test_inode_opts_flag_wrong()
{
    new_fs
    touch /mnt/f /mnt/g
    local f=$(stat -c %i /mnt/f) g=$(stat -c %i /mnt/g)
    umount /mnt

    local bit=$(( 1 << ${INODE_FLAG[has_inode_opts]} ))
    kvdb_rw -c "update inodes 0:$g:U32_MAX bi_compression=2"
    local f_flags=$(kvdb -c "get -r inodes 0:$f:U32_MAX bi_flags" | tail -1)
    local g_flags=$(kvdb -c "get -r inodes 0:$g:U32_MAX bi_flags" | tail -1)
    kvdb_rw -c "update -r inodes 0:$f:U32_MAX bi_flags=$(( f_flags | bit ))" \
	    -c "update -r inodes 0:$g:U32_MAX bi_flags=$(( g_flags & ~bit ))"
    [[ $(inode_flag $f has_inode_opts) == 1 ]]
    [[ $(inode_flag $g has_inode_opts) == 0 ]]

    ktest_expect_sb_errors="inode_has_inode_opts_flag_wrong"
    check_fsck inode_has_inode_opts_flag_wrong

    [[ $(inode_flag $f has_inode_opts) == 0 ]]
    [[ $(inode_flag $g has_inode_opts) == 1 ]]
    [[ $(inode_field $g bi_compression) == 2 ]]
}

# bi_journal_seq past the journal: reset to the current sequence number. The
# inode trigger stamps bi_journal_seq, so this goes in raw too.
test_inode_journal_seq_in_future()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update -r inodes 0:$inum:U32_MAX bi_journal_seq=1000000000"
    [[ $(inode_field $inum bi_journal_seq) == 1000000000 ]]

    ktest_expect_sb_errors="inode_journal_seq_in_future"
    check_fsck inode_journal_seq_in_future

    (( $(inode_field $inum bi_journal_seq) < 1000000000 ))

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# bi_parent_subvol on an inode that isn't a subvolume root.
#
# Not the only error: the backpointer check runs first and looks the dirent up
# through bi_parent_subvol - subvolume 5 doesn't exist, so the dirent is
# "missing" and the backpointer is cleared, for check_dirents to restore. The
# test checks that it is restored, to the same dirent.
test_inode_bi_parent_nonzero()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    local dir=$(inode_field $inum bi_dir) offset=$(inode_field $inum bi_dir_offset)

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_parent_subvol=5"

    ktest_expect_sb_errors="inode_bi_parent_nonzero|subvol_missing|inode_points_to_missing_dirent"
    check_fsck inode_bi_parent_nonzero

    [[ $(inode_field $inum bi_parent_subvol) == 0 ]]
    [[ $(inode_field $inum bi_dir) == $dir ]]
    [[ $(inode_field $inum bi_dir_offset) == $offset ]]
}

# bi_subvol naming a subvolume that doesn't exist, on an inode that isn't a
# subvolume root: the reference is stripped, not reconstructed - the snapshot
# names subvolume 1, not 7, so nothing else says subvolume 7 was there.
test_inode_bi_subvol_missing()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_subvol=7"

    ktest_expect_sb_errors="inode_bi_subvol_missing"
    check_fsck inode_bi_subvol_missing

    [[ $(inode_field $inum bi_subvol) == 0 ]]
    [[ -z $(bcachefs list -b subvolumes $(dev) | grep "0:7:") ]]
}

# bi_subvol naming the root subvolume, which names the root directory: the
# file's reference is stripped, the root directory's left alone.
test_inode_bi_subvol_wrong()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_subvol=1"

    ktest_expect_sb_errors="inode_bi_subvol_wrong"
    check_fsck inode_bi_subvol_wrong

    [[ $(inode_field $inum bi_subvol) == 0 ]]
    [[ $(inode_field 4096 bi_subvol) == 1 ]]
}

# unlinked set on a file that has dirents - two, a hardlink. The flag clear
# is the whole repair: bi_nlink counts links beyond the first, so it stays 1,
# and the inode trigger takes it off the deleted list. Nothing may be lost.
test_inode_unlinked_but_has_dirent()
{
    new_fs
    echo foo > /mnt/f
    ln /mnt/f /mnt/g
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    inode_flag_set $inum unlinked 1
    on_deleted_list $inum

    ktest_expect_sb_errors="inode_unlinked_but_has_dirent"
    check_fsck inode_unlinked_but_has_dirent

    [[ $(inode_flag $inum unlinked) == 0 ]]
    [[ $(inode_field $inum bi_nlink) == 1 ]]
    not_on_deleted_list $inum

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/f) == 2 ]]
    [[ $(cat /mnt/g) == foo ]]
    umount /mnt
}

# An orphaned directory with unlinked set, and contents: unlinked on a
# directory is only valid on the root of an unlinked subvolume, so the flag
# is cleared and the directory reattached, contents and all. (The rest of the
# errors are from the orphaning: / loses a subdirectory, lost+found gains
# one.)
test_dir_unlinked_but_not_empty()
{
    new_fs
    mkdir /mnt/x
    echo foo > /mnt/x/f
    ln /mnt/x/f /mnt/x/g
    local x=$(orphan_unlinked /mnt/x)

    ktest_expect_sb_errors="inode_dir_unlinked_but_not_empty|inode_unreachable|inode_dir_wrong_nlink"
    check_fsck inode_dir_unlinked_but_not_empty

    [[ $(inode_flag $x unlinked) == 0 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/lost+found/$x/f) == foo ]]
    [[ $(stat -c %h /mnt/lost+found/$x/g) == 2 ]]
    umount /mnt
}

# Declined, it changes nothing: the C cleared the flag whether or not the
# repair was taken.
test_dir_unlinked_but_not_empty_declined()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    local x=$(orphan_unlinked /mnt/x)

    check_fsck_declined inode_dir_unlinked_but_not_empty

    [[ $(inode_flag $x unlinked) == 1 ]]
}

# An unlinked orphan that isn't on the deleted list. Offline, fsck only puts
# it there - a logged op might still refer to it - and delete_dead_inodes,
# later in the same run, deletes it: inode and data. (deleted_inode_but_clean:
# delete_dead_inodes finding work on a clean shutdown.)
#
# The deleted_inodes btree is write-buffered: the inode trigger's insert,
# from making it unlinked, lands after anything else in the same kvdb
# session - so the list entry is removed in a second one.
test_unlinked_inode_not_on_deleted_list()
{
    new_fs
    dd if=/dev/urandom of=/mnt/big bs=64k count=4 status=none
    echo foo > /mnt/keep
    local inum=$(orphan_unlinked /mnt/big)
    kvdb_rw -c "set deleted_inodes 0:$inum:U32_MAX deleted"
    not_on_deleted_list $inum

    ktest_expect_sb_errors="unlinked_inode_not_on_deleted_list|deleted_inode_but_clean"
    check_fsck unlinked_inode_not_on_deleted_list

    [[ -z $(bcachefs list -b inodes $(dev) | grep "0:$inum:") ]]
    [[ -z $(bcachefs list -b extents $(dev) | grep " $inum:") ]]
    not_on_deleted_list $inum

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/keep) == foo ]]
    umount /mnt
}

test_unlinked_inode_not_on_deleted_list_declined()
{
    new_fs
    echo foo > /mnt/big
    local inum=$(orphan_unlinked /mnt/big)
    kvdb_rw -c "set deleted_inodes 0:$inum:U32_MAX deleted"

    check_fsck_declined unlinked_inode_not_on_deleted_list

    not_on_deleted_list $inum
    [[ -n $(bcachefs list -b inodes $(dev) | grep "0:$inum:") ]]
}

# ── check_extents ────────────────────────────────────────────────────────

# "<offset> <size>" of each extent of an inode, in the root snapshot
extents_of()
{
    bcachefs list -b extents $(dev) |
	sed -n "s/.*type extent $1:\([0-9]*\):U32_MAX len \([0-9]*\) .*/\1 \2/p"
}

# i_size short of the data: i_size is what the inode says the file is, so
# the extents past it go - the first 4k stays, byte for byte - and i_sectors
# follows.
test_extent_past_end_of_inode()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    head -c 4096 /mnt/f > /tmp/f-head
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_size=4096"

    ktest_expect_sb_errors="extent_past_end_of_inode|inode_i_sectors_wrong"
    check_fsck extent_past_end_of_inode

    [[ $(extents_of $inum) == "8 8" ]]
    [[ $(inode_field $inum bi_sectors) == 8 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %s /mnt/f) == 4096 ]]
    cmp /mnt/f /tmp/f-head
    umount /mnt
}

test_inode_i_sectors_wrong()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    local inum=$(stat -c %i /mnt/f) sectors
    umount /mnt

    sectors=$(inode_field $inum bi_sectors)
    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_sectors=7"

    ktest_expect_sb_errors="inode_i_sectors_wrong"
    check_fsck inode_i_sectors_wrong

    [[ $(inode_field $inum bi_sectors) == $sectors ]]
}

# A file's inode gone, its extents and dirent still there: check_extents
# reconstructs it, i_size from the last extent - so the data comes back
# whole, and the dirent finds it again.
test_missing_file_with_extents()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "set inodes 0:$inum:U32_MAX deleted"

    ktest_expect_sb_errors="key_in_missing_inode|inode_i_sectors_wrong"
    check_fsck key_in_missing_inode

    [[ $(inode_field $inum bi_size) == 65536 ]]

    mount -t bcachefs $(dev) /mnt
    cmp /mnt/f /tmp/f-orig
    umount /mnt
}

# ── check_xattrs ─────────────────────────────────────────────────────────

# An ACL xattr with the inode's flag for it clear - the direction that
# matters: bch2_get_acl() trusts a clear flag and skips the lookup, so the
# ACL is ignored. check_xattrs sets it from the xattr side.
test_inode_acl_flag_clear()
{
    new_fs
    echo foo > /mnt/f
    mkdir /mnt/d
    setfacl -m u:nobody:r /mnt/f
    setfacl -d -m u:nobody:r /mnt/d
    local f=$(stat -c %i /mnt/f) d=$(stat -c %i /mnt/d)
    umount /mnt

    inode_flag_set $f has_access_acl 0
    inode_flag_set $d has_default_acl 0

    ktest_expect_sb_errors="inode_has_access_acl_flag_wrong|inode_has_default_acl_flag_wrong"
    check_fsck inode_has_access_acl_flag_wrong
    grep -qx inode_has_default_acl_flag_wrong <<< "$(recorded_errors)"

    [[ $(inode_flag $f has_access_acl) == 1 ]]
    [[ $(inode_flag $d has_default_acl) == 1 ]]

    mount -t bcachefs $(dev) /mnt
    grep -qx 'user:nobody:r--' <<< "$(getfacl -c /mnt/f)"
    grep -qx 'user:nobody:r--' <<< "$(getfacl -cd /mnt/d)"
    umount /mnt
}

# An inode's hash seed changed under its xattrs: every one is at the wrong
# offset for the new seed, and gets moved. Lookups by name have to work
# afterwards - the repair moving them somewhere fsck accepts isn't enough.
test_xattrs_rehashed()
{
    new_fs
    touch /mnt/f
    local i
    for i in $(seq 1 20); do setfattr -n user.x$i -v v$i /mnt/f; done
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_hash_seed=12345"

    ktest_expect_sb_errors="hash_table_key_wrong_offset"
    check_fsck hash_table_key_wrong_offset

    [[ $(inode_field $inum bi_hash_seed) == 12345 ]]

    mount -t bcachefs $(dev) /mnt
    for i in $(seq 1 20); do
	[[ $(getfattr --only-values -n user.x$i /mnt/f) == v$i ]]
    done
    umount /mnt
}

# ── check_dirents ────────────────────────────────────────────────────────

# Subdirectory counts are checked per directory as the walk leaves it, and
# for the last directory after the loop. Dirents exist only under /, x and d:
# whichever of x and d has the higher inode number (sharded, so not creation
# order) is checked by the final flush, the other as the walk moves on.
#
# A directory's bi_nlink is its subdirectory count.
test_dir_wrong_nlink()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    mkdir -p /mnt/d/a /mnt/d/b
    local x_nlink=$(stat -c %h /mnt/x) d_nlink=$(stat -c %h /mnt/d)
    local x=$(stat -c %i /mnt/x) d=$(stat -c %i /mnt/d)
    umount /mnt

    kvdb_rw -c "update inodes 0:$x:U32_MAX bi_nlink=3" \
	    -c "update inodes 0:$d:U32_MAX bi_nlink=7"

    ktest_expect_sb_errors="inode_dir_wrong_nlink"
    check_fsck inode_dir_wrong_nlink

    [[ $(inode_field $x bi_nlink) == 0 ]]
    [[ $(inode_field $d bi_nlink) == 2 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/x) == $x_nlink ]]
    [[ $(stat -c %h /mnt/d) == $d_nlink ]]
    umount /mnt
}

# A repair partway through a directory's dirents commits, and the walker
# refetches the directory's inode after a commit, starting its subdirectory
# count over - so the count is partial and gets recounted from the btree
# (recalculate_sums). The recount agrees with i_nlink here: nothing may be
# reported against the directory. The Rust conversion lost the recheck after
# the recount, and flagged every such directory "wrong i_nlink: got 3, should
# be 3".
#
# The repair: a file whose inode is gone, so its dirent is removed. It has to
# come after a subdirectory's dirent, or the count it restarts loses nothing,
# and before another dirent, or nothing sees the commit before the directory
# is checked: the first file after a subdirectory, by dirent offset (hash
# order - twenty files make one after a subdirectory a certainty in practice).
test_dir_nlink_after_dirent_repair()
{
    new_fs
    mkdir -p /mnt/d/a /mnt/d/b
    touch /mnt/d/f{1..20}
    local d=$(stat -c %i /mnt/d) d_nlink=$(stat -c %h /mnt/d)
    umount /mnt

    # "offset name target type" for each dirent in d, in walk order
    local inum=$(bcachefs list -b dirents $(dev) |
	sed -n "s/.*type dirent $d:\([0-9]*\):U32_MAX .*: \([a-z0-9]*\) -> \([0-9]*\) type \([a-z]*\).*/\1 \2 \3 \4/p" |
	sort -n |
	awk '$4 == "dir" { seen = 1; next } seen && $4 == "reg" { print $3; exit }')
    [[ -n $inum ]]

    kvdb_rw -c "set inodes 0:$inum:U32_MAX deleted"

    ktest_expect_sb_errors="dirent_to_missing_inode"
    check_fsck dirent_to_missing_inode

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/d) == $d_nlink ]]
    [[ $(ls /mnt/d | wc -l) == 21 ]]
    umount /mnt
}

# A dirent's d_type disagreeing with its inode: the inode wins.
test_dirent_d_type_wrong()
{
    new_fs
    echo foo > /mnt/f
    umount /mnt

    local f=($(dirent f))
    kvdb_rw -c "update dirents ${f[0]}:U32_MAX d_type=4"	# DT_DIR

    ktest_expect_sb_errors="dirent_d_type_wrong"
    check_fsck dirent_d_type_wrong

    [[ -n $(bcachefs list -b dirents $(dev) | grep ": f -> ${f[1]} type reg") ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# An inode's backpointer naming another dirent - in the same directory, and in
# another directory. check_inodes clears it, and check_dirents sets it from
# the dirent that does point at the inode: it has to end up where it was.
test_inode_backpointer_wrong()
{
    new_fs
    mkdir /mnt/x /mnt/y
    echo foo > /mnt/x/f
    echo bar > /mnt/x/g
    local f_inum=$(stat -c %i /mnt/x/f) g_inum=$(stat -c %i /mnt/x/g)
    local y=$(stat -c %i /mnt/y)
    umount /mnt

    local f=($(dirent f)) g=($(dirent g))

    # f's backpointer to g's dirent; g's to a dirent position in y
    kvdb_rw -c "update inodes 0:$f_inum:U32_MAX bi_dir_offset=${g[0]#*:}" \
	    -c "update inodes 0:$g_inum:U32_MAX bi_dir=$y"

    ktest_expect_sb_errors="inode_points_to_wrong_dirent|inode_points_to_missing_dirent"
    check_fsck inode_points_to_wrong_dirent
    grep -qx inode_points_to_missing_dirent <<< "$(recorded_errors)"

    [[ $(inode_field $f_inum bi_dir) == ${f[0]%:*} ]]
    [[ $(inode_field $f_inum bi_dir_offset) == ${f[0]#*:} ]]
    [[ $(inode_field $g_inum bi_dir) == ${g[0]%:*} ]]
    [[ $(inode_field $g_inum bi_dir_offset) == ${g[0]#*:} ]]
}

# A directory's inode gone, its dirents still there: the inode is
# reconstructed from them. The new inode has a new hash seed, so every dirent
# in it is at the wrong offset and gets rehashed - the test is that names
# still resolve afterwards, which a fsck that only converges doesn't show.
# (A missing file with extents is reconstructed earlier, by check_extents.)
#
# With a subdirectory: a rehash can move its dirent behind the walk, out of
# the new inode's subdirectory count, and i_nlink was left 0 until the next
# fsck - the second fsck -n here caught it.
test_missing_dir_with_contents()
{
    new_fs
    mkdir -p /mnt/x/sub/deeper
    local i
    for i in $(seq 1 20); do echo $i > /mnt/x/sub/f$i; done
    echo deep > /mnt/x/sub/deeper/z
    local sub=$(stat -c %i /mnt/x/sub)
    umount /mnt

    kvdb_rw -c "set inodes 0:$sub:U32_MAX deleted"

    ktest_expect_sb_errors="missing_inode_with_contents|hash_table_key_wrong_offset|inode_dir_missing_backpointer|inode_dir_wrong_nlink"
    check_fsck missing_inode_with_contents

    mount -t bcachefs $(dev) /mnt
    [[ -d /mnt/x/sub ]]
    for i in $(seq 1 20); do
	[[ $(cat /mnt/x/sub/f$i) == $i ]]
    done
    [[ $(cat /mnt/x/sub/deeper/z) == deep ]]
    [[ $(ls /mnt/x/sub | wc -l) == 21 ]]
    umount /mnt
}

# ── check_directory_structure ────────────────────────────────────────────

# Two directories, each the other's parent, cut off from the root. Built
# from real dirents so that only the structure pass can see it: with
# /a/b/c, b's dirent "c" is repointed at a, a's backpointer is pointed at
# that dirent, and a's own dirent is removed. c, orphaned by the repoint,
# is reattached on the way (the side errors).
test_dir_loop()
{
    new_fs
    mkdir -p /mnt/a/b/c
    umount /mnt

    local a=($(dirent a)) b=($(dirent b)) c=($(dirent c))

    kvdb_rw -c "update dirents ${c[0]}:U32_MAX d_inum=${a[1]}" \
	    -c "update inodes 0:${a[1]}:U32_MAX bi_dir=${b[1]} bi_dir_offset=${c[0]#*:}" \
	    -c "set dirents ${a[0]}:U32_MAX deleted"

    ktest_expect_sb_errors="dir_loop|inode_dir_wrong_nlink|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck dir_loop

    # The loop is broken: b is reachable again, wherever a was reattached
    mount -t bcachefs $(dev) /mnt
    [[ -n $(find /mnt -name b -type d) ]]
    umount /mnt
}

# The same, three directories round: with /a/b/c/d, c's dirent "d" is
# repointed at a, so a -> c -> b -> a. Depths a=1, b=2, c=3: the walk from
# a stops at c -> b, which isn't on its path - before "check_path_loop:
# don't trust bi_depth past a wrong one" that renumbered a and c upwards
# from b instead of reporting the loop, where the two-directory loop just
# swapped its depths.
test_dir_loop3()
{
    new_fs
    mkdir -p /mnt/a/b/c/d
    umount /mnt

    local a=($(dirent a)) d=($(dirent d))

    kvdb_rw -c "update dirents ${d[0]}:U32_MAX d_inum=${a[1]}" \
	    -c "update inodes 0:${a[1]}:U32_MAX bi_dir=${d[0]%:*} bi_dir_offset=${d[0]#*:}" \
	    -c "set dirents ${a[0]}:U32_MAX deleted"

    ktest_expect_sb_errors="dir_loop|inode_dir_wrong_nlink|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck dir_loop

    mount -t bcachefs $(dev) /mnt
    [[ -n $(find /mnt -name b -type d) ]]
    [[ -n $(find /mnt -name c -type d) ]]
    umount /mnt
}

main "$@"
