#!/usr/bin/env bash
#
# fsck corruption injection tests for the passes in fs/fs/ (check*.c):
# link counts, directory and subvolume structure.
#
# Each test builds a small filesystem, injects one precise corruption with
# `bcachefs kvdb` on the unmounted image, and asserts:
#
#   - fsck -y detects it (exit != 0) and records the expected error in the
#     superblock - by name: a clean second run can't tell a repair from a
#     check that never looked. check_directory_structure visited no inodes
#     for over a year, and an injected directory loop "converged" clean.
#   - no errors recorded beyond the ones the test declares
#   - a second fsck -n runs clean
#   - the repaired filesystem mounts and is whole
#
# These are the regression tests for the passes' Rust conversions: every
# converted pass gets its injections here.
#
# Inject states that are consistent apart from the corruption under test:
# earlier passes repair whatever they can see first. A subvolume's
# fs_path_parent is checked against its dirent by check_dirents, so a loop
# made by editing fs_path_parent alone never reaches the structure pass.
#
# No bcachefs_test_end_checks: these tests intentionally stamp error
# counters.

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

config-scratch-devs 4G

dev()
{
    echo ${ktest_scratch_dev[0]}
}

kvdb()
{
    bcachefs kvdb $(dev) "$@"
}

kvdb_rw()
{
    bcachefs kvdb --rw $(dev) "$@"
}

# A field of the root subvolume's version of an inode, as update names it:
# inode_field <inum> <field>
inode_field()
{
    kvdb -c "get inodes 0:$1:U32_MAX $2" | tail -1
}

# Inode flag bits, from BCH_INODE_FLAGS() (fs/fs/inode_format.h); inode
# flags are only reachable through bi_flags as a whole.
declare -A INODE_FLAG=(
    [unlinked]=7 [has_child_snapshot]=9 [has_inode_opts]=12
    [has_access_acl]=13 [has_default_acl]=14
)

# inode_flag <inum> <flag>: 1 if set
inode_flag()
{
    echo $(( ($(inode_field $1 bi_flags) >> ${INODE_FLAG[$2]}) & 1 ))
}

# inode_flag_set <inum> <flag> <0|1>
inode_flag_set()
{
    local flags=$(inode_field $1 bi_flags) bit=$(( 1 << ${INODE_FLAG[$2]} ))
    (( $3 )) && flags=$(( flags | bit )) || flags=$(( flags & ~bit ))
    kvdb_rw -c "update inodes 0:$1:U32_MAX bi_flags=$flags"
}

new_fs()
{
    run_quiet "" bcachefs format -f $(dev)
    mount -t bcachefs $(dev) /mnt
}

# "<inode>:<offset> <target>" of the dirent named $1, in the root subvolume's
# snapshot. Names must be unique across the filesystem.
dirent()
{
    bcachefs list -b dirents $(dev) |
	sed -n "s/.*type dirent \([0-9]*:[0-9]*\):U32_MAX .*: $1 -> \([0-9]*\) .*/\1 \2/p"
}

recorded_errors()
{
    bcachefs show-super -f errors_v2 $(dev) |
	sed -nE '/^errors(_v2)? /,${/^errors(_v2)? /!p;}' |
	awk '{print $1}'
}

# check_fsck <error>: detected and recorded, nothing undeclared
# (ktest_expect_sb_errors), repaired
check_fsck()
{
    local expect=$1
    local rc1=0 rc2=0

    bcachefs fsck -y $(dev) || rc1=$?
    echo "first fsck -y exited $rc1"

    if (( rc1 == 0 )); then
	echo "TEST FAILED: fsck missed injected corruption"
	exit 1
    fi

    if ! recorded_errors | grep -qx "$expect"; then
	echo "TEST FAILED: $expect not recorded (recorded: $(recorded_errors | xargs))"
	exit 1
    fi

    if ! check_bcachefs_errors $(dev); then
	echo "TEST FAILED: errors the test didn't declare" \
	     "(ktest_expect_sb_errors='$ktest_expect_sb_errors')"
	exit 1
    fi

    bcachefs fsck -n $(dev) || rc2=$?
    echo "second fsck -n exited $rc2"

    if (( rc2 != 0 )); then
	echo "TEST FAILED: errors remain after fsck -y"
	exit 1
    fi
}

# check_fsck_any: as check_fsck, for injections where more than one of the
# declared errors can be the one that finds it - which, depending on walk
# order. Found, nothing undeclared, repaired; the test checks the state.
check_fsck_any()
{
    local rc1=0 rc2=0

    bcachefs fsck -y $(dev) || rc1=$?
    echo "first fsck -y exited $rc1 (recorded: $(recorded_errors | xargs))"

    if (( rc1 == 0 )); then
	echo "TEST FAILED: fsck missed injected corruption"
	exit 1
    fi

    if ! check_bcachefs_errors $(dev); then
	echo "TEST FAILED: errors the test didn't declare" \
	     "(ktest_expect_sb_errors='$ktest_expect_sb_errors')"
	exit 1
    fi

    bcachefs fsck -n $(dev) || rc2=$?
    echo "second fsck -n exited $rc2"

    if (( rc2 != 0 )); then
	echo "TEST FAILED: errors remain after fsck -y"
	exit 1
    fi
}

# ── check_nlinks ─────────────────────────────────────────────────────────

# A file with two links whose inode says more. bi_nlink is the link count
# less one for a non-directory (1 here); check_nlinks only counts inodes
# with it nonzero.
test_wrong_nlink()
{
    new_fs
    echo foo > /mnt/f
    ln /mnt/f /mnt/g
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_nlink=5"

    ktest_expect_sb_errors="inode_wrong_nlink"
    check_fsck inode_wrong_nlink

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/f) == 2 ]]
    [[ $(cat /mnt/g) == foo ]]
    umount /mnt
}

# check_fsck_declined <error>: fsck -n reports it, and changes nothing - the
# caller checks the state it cares about
check_fsck_declined()
{
    local expect=$1 rc=0

    bcachefs fsck -n $(dev) > /tmp/fsck-n.log 2>&1 || rc=$?
    cat /tmp/fsck-n.log
    echo "fsck -n exited $rc"

    if (( rc == 0 )); then
	echo "TEST FAILED: fsck -n missed injected corruption"
	exit 1
    fi

    if ! grep -qw "$expect" /tmp/fsck-n.log; then
	echo "TEST FAILED: fsck -n didn't report $expect"
	exit 1
    fi
}

# has_key <btree> <string>: a line of `bcachefs list -b <btree>` contains it
has_key()
{
    [[ $(bcachefs list -b $1 $(dev)) == *"$2"* ]]
}

# A function, not `! has_key`: set -e ignores a negated command.
no_key()
{
    ! has_key "$@"
}

# Whether the inode is on the deleted_inodes list
on_deleted_list()
{
    has_key deleted_inodes "type set 0:$1:"
}

# A function, not `! on_deleted_list`: set -e ignores a negated command.
not_on_deleted_list()
{
    ! on_deleted_list "$@"
}

# Make a file or directory an unlinked orphan: no dirent, no backpointer,
# unlinked set. Prints the inode number. orphan_unlinked <path in /mnt>,
# with the filesystem mounted; leaves it unmounted.
orphan_unlinked()
{
    local name=$(basename $1) inum=$(stat -c %i $1)
    umount /mnt

    local d=($(dirent $name))
    local flags=$(inode_field $inum bi_flags)
    kvdb_rw -c "set dirents ${d[0]}:U32_MAX deleted" \
	    -c "update inodes 0:$inum:U32_MAX bi_dir=0 bi_dir_offset=0 bi_flags=$(( flags | 1 << ${INODE_FLAG[unlinked]} ))" >&2
    echo $inum
}

# ── check_inodes ─────────────────────────────────────────────────────────

test_dir_nonzero_i_size()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    local x=$(stat -c %i /mnt/x)
    umount /mnt

    kvdb_rw -c "update inodes 0:$x:U32_MAX bi_size=4096"

    ktest_expect_sb_errors="inode_dir_has_nonzero_i_size"
    check_fsck inode_dir_has_nonzero_i_size

    [[ $(inode_field $x bi_size) == 0 ]]
}

# The flags that cache the answer to a question about other btrees, set with
# nothing behind them: no versions in descendant snapshots, no ACL xattrs.
# (The other direction of the ACL flags - xattr present, flag clear - is
# check_xattrs'.)
test_inode_cached_flags_wrong()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    local flags=$(inode_field $inum bi_flags)
    local bit
    for bit in has_child_snapshot has_access_acl has_default_acl; do
	flags=$(( flags | 1 << ${INODE_FLAG[$bit]} ))
    done
    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_flags=$flags"

    ktest_expect_sb_errors="inode_has_child_snapshots_wrong|inode_has_access_acl_flag_wrong|inode_has_default_acl_flag_wrong"
    check_fsck inode_has_child_snapshots_wrong
    local recorded=$(recorded_errors)
    grep -qx inode_has_access_acl_flag_wrong  <<< "$recorded"
    grep -qx inode_has_default_acl_flag_wrong <<< "$recorded"

    for bit in has_child_snapshot has_access_acl has_default_acl; do
	[[ $(inode_flag $inum $bit) == 0 ]]
    done

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# has_inode_opts, both ways: set with no options, clear with one. The packer
# recomputes it and update would correct the injection, so these go in raw
# (update -r), from the stored bi_flags - which also holds the packing
# fields. Empty files, so an option set behind propagation's back has no
# extents to disagree with.
test_inode_opts_flag_wrong()
{
    new_fs
    touch /mnt/f /mnt/g
    local f=$(stat -c %i /mnt/f) g=$(stat -c %i /mnt/g)
    umount /mnt

    local bit=$(( 1 << ${INODE_FLAG[has_inode_opts]} ))
    kvdb_rw -c "update inodes 0:$g:U32_MAX bi_compression=2"
    local f_flags=$(kvdb -c "get -r inodes 0:$f:U32_MAX bi_flags" | tail -1)
    local g_flags=$(kvdb -c "get -r inodes 0:$g:U32_MAX bi_flags" | tail -1)
    kvdb_rw -c "update -r inodes 0:$f:U32_MAX bi_flags=$(( f_flags | bit ))" \
	    -c "update -r inodes 0:$g:U32_MAX bi_flags=$(( g_flags & ~bit ))"
    [[ $(inode_flag $f has_inode_opts) == 1 ]]
    [[ $(inode_flag $g has_inode_opts) == 0 ]]

    ktest_expect_sb_errors="inode_has_inode_opts_flag_wrong"
    check_fsck inode_has_inode_opts_flag_wrong

    [[ $(inode_flag $f has_inode_opts) == 0 ]]
    [[ $(inode_flag $g has_inode_opts) == 1 ]]
    [[ $(inode_field $g bi_compression) == 2 ]]
}

# bi_journal_seq past the journal: reset to the current sequence number. The
# inode trigger stamps bi_journal_seq, so this goes in raw too.
test_inode_journal_seq_in_future()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update -r inodes 0:$inum:U32_MAX bi_journal_seq=1000000000"
    [[ $(inode_field $inum bi_journal_seq) == 1000000000 ]]

    ktest_expect_sb_errors="inode_journal_seq_in_future"
    check_fsck inode_journal_seq_in_future

    (( $(inode_field $inum bi_journal_seq) < 1000000000 ))

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# bi_parent_subvol on an inode that isn't a subvolume root.
#
# Not the only error: the backpointer check runs first and looks the dirent up
# through bi_parent_subvol - subvolume 5 doesn't exist, so the dirent is
# "missing" and the backpointer is cleared, for check_dirents to restore. The
# test checks that it is restored, to the same dirent.
test_inode_bi_parent_nonzero()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    local dir=$(inode_field $inum bi_dir) offset=$(inode_field $inum bi_dir_offset)

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_parent_subvol=5"

    ktest_expect_sb_errors="inode_bi_parent_nonzero|subvol_missing|inode_points_to_missing_dirent"
    check_fsck inode_bi_parent_nonzero

    [[ $(inode_field $inum bi_parent_subvol) == 0 ]]
    [[ $(inode_field $inum bi_dir) == $dir ]]
    [[ $(inode_field $inum bi_dir_offset) == $offset ]]
}

# bi_subvol naming a subvolume that doesn't exist, on an inode that isn't a
# subvolume root: the reference is stripped, not reconstructed - the snapshot
# names subvolume 1, not 7, so nothing else says subvolume 7 was there.
test_inode_bi_subvol_missing()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_subvol=7"

    ktest_expect_sb_errors="inode_bi_subvol_missing"
    check_fsck inode_bi_subvol_missing

    [[ $(inode_field $inum bi_subvol) == 0 ]]
    no_key subvolumes "0:7:"
}

# bi_subvol naming the root subvolume, which names the root directory: the
# file's reference is stripped, the root directory's left alone.
test_inode_bi_subvol_wrong()
{
    new_fs
    echo foo > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_subvol=1"

    ktest_expect_sb_errors="inode_bi_subvol_wrong"
    check_fsck inode_bi_subvol_wrong

    [[ $(inode_field $inum bi_subvol) == 0 ]]
    [[ $(inode_field 4096 bi_subvol) == 1 ]]
}

# unlinked set on a file that has dirents - two, a hardlink. The flag clear
# is the whole repair: bi_nlink counts links beyond the first, so it stays 1,
# and the inode trigger takes it off the deleted list. Nothing may be lost.
test_inode_unlinked_but_has_dirent()
{
    new_fs
    echo foo > /mnt/f
    ln /mnt/f /mnt/g
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    inode_flag_set $inum unlinked 1
    on_deleted_list $inum

    ktest_expect_sb_errors="inode_unlinked_but_has_dirent"
    check_fsck inode_unlinked_but_has_dirent

    [[ $(inode_flag $inum unlinked) == 0 ]]
    [[ $(inode_field $inum bi_nlink) == 1 ]]
    not_on_deleted_list $inum

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/f) == 2 ]]
    [[ $(cat /mnt/g) == foo ]]
    umount /mnt
}

# An orphaned directory with unlinked set, and contents: unlinked on a
# directory is only valid on the root of an unlinked subvolume, so the flag
# is cleared and the directory reattached, contents and all. (The rest of the
# errors are from the orphaning: / loses a subdirectory, lost+found gains
# one.)
test_dir_unlinked_but_not_empty()
{
    new_fs
    mkdir /mnt/x
    echo foo > /mnt/x/f
    ln /mnt/x/f /mnt/x/g
    local x=$(orphan_unlinked /mnt/x)

    ktest_expect_sb_errors="inode_dir_unlinked_but_not_empty|inode_unreachable|inode_dir_wrong_nlink"
    check_fsck inode_dir_unlinked_but_not_empty

    [[ $(inode_flag $x unlinked) == 0 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/lost+found/$x/f) == foo ]]
    [[ $(stat -c %h /mnt/lost+found/$x/g) == 2 ]]
    umount /mnt
}

# An empty directory with unlinked set and no name: what rmdir leaves when
# the directory's open, or a crash comes before it's reaped. Legitimate - it's
# waiting for deletion like any unlinked file, and handled as one: put back
# on the deleted list, and reaped. It used to have the flag quietly cleared
# and be reattached: an rmdir'd directory reappearing in lost+found. (The
# root's wrong nlink is the injection's: removing the dirent didn't
# decrement it, as rmdir does.)
test_dir_unlinked_empty()
{
    new_fs
    mkdir /mnt/e
    echo foo > /mnt/keep
    local e=$(orphan_unlinked /mnt/e)
    kvdb_rw -c "set deleted_inodes 0:$e:U32_MAX deleted"

    ktest_expect_sb_errors="unlinked_inode_not_on_deleted_list|deleted_inode_but_clean|inode_dir_wrong_nlink"
    check_fsck unlinked_inode_not_on_deleted_list

    no_key inodes "0:$e:"
    not_on_deleted_list $e

    mount -t bcachefs $(dev) /mnt
    [[ -z $(ls /mnt/lost+found) ]]
    [[ $(cat /mnt/keep) == foo ]]
    umount /mnt
}

# Declined, it changes nothing: the C cleared the flag whether or not the
# repair was taken.
test_dir_unlinked_but_not_empty_declined()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    local x=$(orphan_unlinked /mnt/x)

    check_fsck_declined inode_dir_unlinked_but_not_empty

    [[ $(inode_flag $x unlinked) == 1 ]]
}

# An unlinked orphan that isn't on the deleted list. Offline, fsck only puts
# it there - a logged op might still refer to it - and delete_dead_inodes,
# later in the same run, deletes it: inode and data. (deleted_inode_but_clean:
# delete_dead_inodes finding work on a clean shutdown.)
#
# The deleted_inodes btree is write-buffered: the inode trigger's insert,
# from making it unlinked, lands after anything else in the same kvdb
# session - so the list entry is removed in a second one.
test_unlinked_inode_not_on_deleted_list()
{
    new_fs
    dd if=/dev/urandom of=/mnt/big bs=64k count=4 status=none
    echo foo > /mnt/keep
    local inum=$(orphan_unlinked /mnt/big)
    kvdb_rw -c "set deleted_inodes 0:$inum:U32_MAX deleted"
    not_on_deleted_list $inum

    ktest_expect_sb_errors="unlinked_inode_not_on_deleted_list|deleted_inode_but_clean"
    check_fsck unlinked_inode_not_on_deleted_list

    no_key inodes "0:$inum:"
    no_key extents " $inum:"
    not_on_deleted_list $inum

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/keep) == foo ]]
    umount /mnt
}

# The same, an empty file: delete_dead_inodes' deleted_inode_but_clean
# queues its log entry, and with no extents to delete nothing commits it
# before bch2_inode_rm_snapshot()'s next iteration begins - and drops it
# (bch2_trans_begin() WARNs).
test_unlinked_inode_empty_not_on_deleted_list()
{
    new_fs
    touch /mnt/empty
    echo foo > /mnt/keep
    local inum=$(orphan_unlinked /mnt/empty)
    kvdb_rw -c "set deleted_inodes 0:$inum:U32_MAX deleted"

    ktest_expect_sb_errors="unlinked_inode_not_on_deleted_list|deleted_inode_but_clean"
    check_fsck unlinked_inode_not_on_deleted_list

    no_key inodes "0:$inum:"
    not_on_deleted_list $inum
}

test_unlinked_inode_not_on_deleted_list_declined()
{
    new_fs
    echo foo > /mnt/big
    local inum=$(orphan_unlinked /mnt/big)
    kvdb_rw -c "set deleted_inodes 0:$inum:U32_MAX deleted"

    check_fsck_declined unlinked_inode_not_on_deleted_list

    not_on_deleted_list $inum
    has_key inodes "0:$inum:"
}

# ── check_extents ────────────────────────────────────────────────────────

# "<offset> <size>" of each extent of an inode, in the root snapshot
extents_of()
{
    bcachefs list -b extents $(dev) |
	sed -n "s/.*type extent $1:\([0-9]*\):U32_MAX len \([0-9]*\) .*/\1 \2/p"
}

# i_size short of the data: i_size is what the inode says the file is, so
# the extents past it go - the first 4k stays, byte for byte - and i_sectors
# follows.
test_extent_past_end_of_inode()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    head -c 4096 /mnt/f > /tmp/f-head
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_size=4096"

    ktest_expect_sb_errors="extent_past_end_of_inode|inode_i_sectors_wrong"
    check_fsck extent_past_end_of_inode

    [[ $(extents_of $inum) == "8 8" ]]
    [[ $(inode_field $inum bi_sectors) == 8 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %s /mnt/f) == 4096 ]]
    cmp /mnt/f /tmp/f-head
    umount /mnt
}

# Two extents overlapping, in one snapshot: a 128k file's extent copied to
# end 32k later, so the copy covers [32k,160k). In one snapshot the extent
# later in key order wins: the file reads the original's first 32k, then the
# original's first 96k again - the copy's view of [32k,128k). The copy's
# tail is past i_size and goes, and the two extents left sharing data become
# a reflink. Byte-for-byte, because "converges" says nothing about which
# extent won.
test_extent_overlapping()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=128k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    local e=($(extents_of $inum))
    [[ ${e[0]} == 256 && ${e[1]} == 256 ]]
    kvdb_rw -c "copy extents $inum:256:U32_MAX $inum:320:U32_MAX"

    ktest_expect_sb_errors="extent_overlapping|extent_past_end_of_inode|dup_extents_to_reflink"
    check_fsck extent_overlapping

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %s /mnt/f) == 131072 ]]
    cmp -n 32768 /mnt/f /tmp/f-orig
    cmp -n 98304 -i 32768:0 /mnt/f /tmp/f-orig
    umount /mnt
}

# Keys of the wrong type for their inode: which side is wrong?
#
# A file with data, and a dirent copied in under it: the file's extents say
# it's a file, so the dirent is the stray, and goes. Nothing else changes -
# in particular not the dirent's target, which the deleted dirent used to
# get rehashed back in and pointed at.
test_key_in_wrong_inode_type_stray()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    mkdir /mnt/d
    echo x > /mnt/d/x
    local f=$(stat -c %i /mnt/f) x=$(stat -c %i /mnt/d/x)
    umount /mnt

    local xd=($(dirent x))
    local x_dir=$(inode_field $x bi_dir) x_off=$(inode_field $x bi_dir_offset)
    kvdb_rw -c "copy dirents ${xd[0]}:U32_MAX $f:${xd[0]#*:}:U32_MAX"

    ktest_expect_sb_errors="key_in_wrong_inode_type"
    check_fsck key_in_wrong_inode_type

    no_key dirents "type dirent $f:"
    [[ $(inode_field $x bi_dir) == $x_dir ]]
    [[ $(inode_field $x bi_dir_offset) == $x_off ]]

    mount -t bcachefs $(dev) /mnt
    [[ -f /mnt/f ]]
    cmp /mnt/f /tmp/f-orig
    [[ $(cat /mnt/d/x) == x ]]
    umount /mnt
}

# An empty file with a dirent under it: it has no keys of its own type, so
# its keys say what it is - a directory, with the entry in it.
test_key_in_wrong_inode_type_takes_keys()
{
    new_fs
    touch /mnt/e
    mkdir /mnt/d
    echo x > /mnt/d/x
    local e=$(stat -c %i /mnt/e)
    umount /mnt

    local xd=($(dirent x))
    kvdb_rw -c "copy dirents ${xd[0]}:U32_MAX $e:${xd[0]#*:}:U32_MAX"

    ktest_expect_sb_errors="key_in_wrong_inode_type|dirent_d_type_wrong|hash_table_key_wrong_offset|inode_dir_wrong_nlink|inode_multiple_links_but_nlink_0"
    check_fsck key_in_wrong_inode_type

    mount -t bcachefs $(dev) /mnt
    [[ -d /mnt/e ]]
    [[ $(cat /mnt/e/x) == x ]]
    [[ $(cat /mnt/d/x) == x ]]
    umount /mnt
}

# A file whose mode says directory: check_inodes zeroes a directory's i_size
# first, and the file's extents then say it's a file - which has to get an
# i_size covering them back, or they're past the end and go. All 64k of it
# used to.
test_inode_dir_mode_on_file()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_mode=$(( 0040755 ))"

    ktest_expect_sb_errors="key_in_wrong_inode_type|inode_dir_has_nonzero_i_size"
    check_fsck key_in_wrong_inode_type

    [[ $(inode_field $inum bi_size) == 65536 ]]

    mount -t bcachefs $(dev) /mnt
    [[ -f /mnt/f ]]
    cmp /mnt/f /tmp/f-orig
    umount /mnt
}

test_inode_i_sectors_wrong()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    local inum=$(stat -c %i /mnt/f) sectors
    umount /mnt

    sectors=$(inode_field $inum bi_sectors)
    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_sectors=7"

    ktest_expect_sb_errors="inode_i_sectors_wrong"
    check_fsck inode_i_sectors_wrong

    [[ $(inode_field $inum bi_sectors) == $sectors ]]
}

# A file's inode gone, its extents and dirent still there: check_extents
# reconstructs it, i_size from the last extent - so the data comes back
# whole, and the dirent finds it again.
test_missing_file_with_extents()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "set inodes 0:$inum:U32_MAX deleted"

    ktest_expect_sb_errors="key_in_missing_inode|inode_i_sectors_wrong"
    check_fsck key_in_missing_inode

    [[ $(inode_field $inum bi_size) == 65536 ]]

    mount -t bcachefs $(dev) /mnt
    cmp /mnt/f /tmp/f-orig
    umount /mnt
}

# ── check_xattrs ─────────────────────────────────────────────────────────

# An ACL xattr with the inode's flag for it clear - the direction that
# matters: bch2_get_acl() trusts a clear flag and skips the lookup, so the
# ACL is ignored. check_xattrs sets it from the xattr side.
test_inode_acl_flag_clear()
{
    new_fs
    echo foo > /mnt/f
    mkdir /mnt/d
    setfacl -m u:nobody:r /mnt/f
    setfacl -d -m u:nobody:r /mnt/d
    local f=$(stat -c %i /mnt/f) d=$(stat -c %i /mnt/d)
    umount /mnt

    inode_flag_set $f has_access_acl 0
    inode_flag_set $d has_default_acl 0

    ktest_expect_sb_errors="inode_has_access_acl_flag_wrong|inode_has_default_acl_flag_wrong"
    check_fsck inode_has_access_acl_flag_wrong
    grep -qx inode_has_default_acl_flag_wrong <<< "$(recorded_errors)"

    [[ $(inode_flag $f has_access_acl) == 1 ]]
    [[ $(inode_flag $d has_default_acl) == 1 ]]

    mount -t bcachefs $(dev) /mnt
    grep -qx 'user:nobody:r--' <<< "$(getfacl -c /mnt/f)"
    grep -qx 'user:nobody:r--' <<< "$(getfacl -cd /mnt/d)"
    umount /mnt
}

# An inode's hash seed changed under its xattrs: every one is at the wrong
# offset for the new seed, and gets moved. Lookups by name have to work
# afterwards - the repair moving them somewhere fsck accepts isn't enough.
test_xattrs_rehashed()
{
    new_fs
    touch /mnt/f
    local i
    for i in $(seq 1 20); do setfattr -n user.x$i -v v$i /mnt/f; done
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    kvdb_rw -c "update inodes 0:$inum:U32_MAX bi_hash_seed=12345"

    ktest_expect_sb_errors="hash_table_key_wrong_offset"
    check_fsck hash_table_key_wrong_offset

    [[ $(inode_field $inum bi_hash_seed) == 12345 ]]

    mount -t bcachefs $(dev) /mnt
    for i in $(seq 1 20); do
	[[ $(getfattr --only-values -n user.x$i /mnt/f) == v$i ]]
    done
    umount /mnt
}

# ── check_extents_to_backpointers ────────────────────────────────────────

# Two files' extents pointing at the same data: f's, copied into g (sparse,
# the same size). Same extent twice, so one is dropped - g's: the
# backpointer slot both map to holds the copy's, so f's is the extent being
# checked when the duplicate's found, and sizes equal, the other goes. g's
# extent becomes an error key; f keeps its data, and has to keep a
# backpointer - deleting the dropped pointer's backpointer empties the slot
# they share.
test_bp_dup_same_extent()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    truncate -s 64k /mnt/g
    local f=$(stat -c %i /mnt/f) g=$(stat -c %i /mnt/g)
    umount /mnt

    local e=($(extents_of $f))
    [[ ${e[0]} == 128 && ${e[1]} == 128 ]]
    kvdb_rw -c "copy extents $f:128:U32_MAX $g:128:U32_MAX"

    ktest_expect_sb_errors="data_lost_double_allocation|ptr_to_missing_backpointer|inode_i_sectors_wrong|backpointer_to_missing_ptr"
    check_fsck data_lost_double_allocation

    mount -t bcachefs $(dev) /mnt
    cmp /mnt/f /tmp/f-orig
    ! cat /mnt/g > /dev/null 2>&1
    umount /mnt
}

# The same, into a directory with entries: the copy is the stray, twice
# over - a double allocation, and an extent under a directory. It goes; f
# and d are untouched.
test_bp_dup_into_dir()
{
    new_fs
    dd if=/dev/urandom of=/mnt/f bs=64k count=1 oflag=direct status=none
    cp /mnt/f /tmp/f-orig
    mkdir /mnt/d
    echo x > /mnt/d/x
    local f=$(stat -c %i /mnt/f) d=$(stat -c %i /mnt/d)
    umount /mnt

    kvdb_rw -c "copy extents $f:128:U32_MAX $d:128:U32_MAX"

    ktest_expect_sb_errors="data_lost_double_allocation|ptr_to_missing_backpointer|key_in_wrong_inode_type|extent_past_end_of_inode|inode_i_sectors_wrong|backpointer_to_missing_ptr"
    check_fsck_any

    mount -t bcachefs $(dev) /mnt
    cmp /mnt/f /tmp/f-orig
    [[ $(cat /mnt/d/x) == x ]]
    umount /mnt
}

# ── check_dirents ────────────────────────────────────────────────────────

# Subdirectory counts are checked per directory as the walk leaves it, and
# for the last directory after the loop. Dirents exist only under /, x and d:
# whichever of x and d has the higher inode number (sharded, so not creation
# order) is checked by the final flush, the other as the walk moves on.
#
# A directory's bi_nlink is its subdirectory count.
test_dir_wrong_nlink()
{
    new_fs
    mkdir /mnt/x
    touch /mnt/x/f
    mkdir -p /mnt/d/a /mnt/d/b
    local x_nlink=$(stat -c %h /mnt/x) d_nlink=$(stat -c %h /mnt/d)
    local x=$(stat -c %i /mnt/x) d=$(stat -c %i /mnt/d)
    umount /mnt

    kvdb_rw -c "update inodes 0:$x:U32_MAX bi_nlink=3" \
	    -c "update inodes 0:$d:U32_MAX bi_nlink=7"

    ktest_expect_sb_errors="inode_dir_wrong_nlink"
    check_fsck inode_dir_wrong_nlink

    [[ $(inode_field $x bi_nlink) == 0 ]]
    [[ $(inode_field $d bi_nlink) == 2 ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/x) == $x_nlink ]]
    [[ $(stat -c %h /mnt/d) == $d_nlink ]]
    umount /mnt
}

# A repair partway through a directory's dirents commits, and the walker
# refetches the directory's inode after a commit, starting its subdirectory
# count over - so the count is partial and gets recounted from the btree
# (recalculate_sums). The recount agrees with i_nlink here: nothing may be
# reported against the directory. The Rust conversion lost the recheck after
# the recount, and flagged every such directory "wrong i_nlink: got 3, should
# be 3".
#
# The repair: a file whose inode is gone, so its dirent is removed. It has to
# come after a subdirectory's dirent, or the count it restarts loses nothing,
# and before another dirent, or nothing sees the commit before the directory
# is checked: the first file after a subdirectory, by dirent offset (hash
# order - twenty files make one after a subdirectory a certainty in practice).
test_dir_nlink_after_dirent_repair()
{
    new_fs
    mkdir -p /mnt/d/a /mnt/d/b
    touch /mnt/d/f{1..20}
    local d=$(stat -c %i /mnt/d) d_nlink=$(stat -c %h /mnt/d)
    umount /mnt

    # "offset name target type" for each dirent in d, in walk order
    local inum=$(bcachefs list -b dirents $(dev) |
	sed -n "s/.*type dirent $d:\([0-9]*\):U32_MAX .*: \([a-z0-9]*\) -> \([0-9]*\) type \([a-z]*\).*/\1 \2 \3 \4/p" |
	sort -n |
	awk '$4 == "dir" { seen = 1; next } seen && $4 == "reg" { print $3; exit }')
    [[ -n $inum ]]

    kvdb_rw -c "set inodes 0:$inum:U32_MAX deleted"

    ktest_expect_sb_errors="dirent_to_missing_inode"
    check_fsck dirent_to_missing_inode

    mount -t bcachefs $(dev) /mnt
    [[ $(stat -c %h /mnt/d) == $d_nlink ]]
    [[ $(ls /mnt/d | wc -l) == 21 ]]
    umount /mnt
}

# A dirent's d_type disagreeing with its inode: the inode wins.
test_dirent_d_type_wrong()
{
    new_fs
    echo foo > /mnt/f
    umount /mnt

    local f=($(dirent f))
    kvdb_rw -c "update dirents ${f[0]}:U32_MAX d_type=4"	# DT_DIR

    ktest_expect_sb_errors="dirent_d_type_wrong"
    check_fsck dirent_d_type_wrong

    has_key dirents ": f -> ${f[1]} type reg"

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == foo ]]
    umount /mnt
}

# An inode's backpointer naming another dirent - in the same directory, and in
# another directory. check_inodes clears it, and check_dirents sets it from
# the dirent that does point at the inode: it has to end up where it was.
test_inode_backpointer_wrong()
{
    new_fs
    mkdir /mnt/x /mnt/y
    echo foo > /mnt/x/f
    echo bar > /mnt/x/g
    local f_inum=$(stat -c %i /mnt/x/f) g_inum=$(stat -c %i /mnt/x/g)
    local y=$(stat -c %i /mnt/y)
    umount /mnt

    local f=($(dirent f)) g=($(dirent g))

    # f's backpointer to g's dirent; g's to a dirent position in y
    kvdb_rw -c "update inodes 0:$f_inum:U32_MAX bi_dir_offset=${g[0]#*:}" \
	    -c "update inodes 0:$g_inum:U32_MAX bi_dir=$y"

    ktest_expect_sb_errors="inode_points_to_wrong_dirent|inode_points_to_missing_dirent"
    check_fsck inode_points_to_wrong_dirent
    grep -qx inode_points_to_missing_dirent <<< "$(recorded_errors)"

    [[ $(inode_field $f_inum bi_dir) == ${f[0]%:*} ]]
    [[ $(inode_field $f_inum bi_dir_offset) == ${f[0]#*:} ]]
    [[ $(inode_field $g_inum bi_dir) == ${g[0]%:*} ]]
    [[ $(inode_field $g_inum bi_dir_offset) == ${g[0]#*:} ]]
}

# A directory's inode gone, its dirents still there: the inode is
# reconstructed from them. The new inode has a new hash seed, so every dirent
# in it is at the wrong offset and gets rehashed - the test is that names
# still resolve afterwards, which a fsck that only converges doesn't show.
# (A missing file with extents is reconstructed earlier, by check_extents.)
#
# With a subdirectory: a rehash can move its dirent behind the walk, out of
# the new inode's subdirectory count, and i_nlink was left 0 until the next
# fsck - the second fsck -n here caught it.
test_missing_dir_with_contents()
{
    new_fs
    mkdir -p /mnt/x/sub/deeper
    local i
    for i in $(seq 1 20); do echo $i > /mnt/x/sub/f$i; done
    echo deep > /mnt/x/sub/deeper/z
    local sub=$(stat -c %i /mnt/x/sub)
    umount /mnt

    kvdb_rw -c "set inodes 0:$sub:U32_MAX deleted"

    ktest_expect_sb_errors="missing_inode_with_contents|hash_table_key_wrong_offset|inode_dir_missing_backpointer|inode_dir_wrong_nlink"
    check_fsck missing_inode_with_contents

    mount -t bcachefs $(dev) /mnt
    [[ -d /mnt/x/sub ]]
    for i in $(seq 1 20); do
	[[ $(cat /mnt/x/sub/f$i) == $i ]]
    done
    [[ $(cat /mnt/x/sub/deeper/z) == deep ]]
    [[ $(ls /mnt/x/sub | wc -l) == 21 ]]
    umount /mnt
}

# An empty file and an empty directory with xattrs, their inodes gone: the
# xattrs are contents too, so each is reconstructed where its dirent is, as
# what the dirent says it was - xattrs don't say. Not left for check_xattrs
# to reconstruct after the dirent's gone, nameless, into lost+found.
test_missing_inode_with_xattrs()
{
    new_fs
    touch /mnt/f
    mkdir /mnt/d
    setfattr -n user.a -v A /mnt/f
    setfattr -n user.b -v B /mnt/d
    local f=$(stat -c %i /mnt/f) d=$(stat -c %i /mnt/d)
    umount /mnt

    kvdb_rw -c "set inodes 0:$f:U32_MAX deleted" \
	    -c "set inodes 0:$d:U32_MAX deleted"

    ktest_expect_sb_errors="missing_inode_with_contents|hash_table_key_wrong_offset|inode_dir_missing_backpointer|inode_dir_wrong_nlink"
    check_fsck missing_inode_with_contents

    mount -t bcachefs $(dev) /mnt
    [[ -f /mnt/f ]]
    [[ -d /mnt/d ]]
    [[ $(getfattr --only-values -n user.a /mnt/f) == A ]]
    [[ $(getfattr --only-values -n user.b /mnt/d) == B ]]
    [[ -z $(ls /mnt/lost+found) ]]
    umount /mnt
}

# ── check_directory_structure ────────────────────────────────────────────

# Two directories, each the other's parent, cut off from the root. Built
# from real dirents so that only the structure pass can see it: with
# /a/b/c, b's dirent "c" is repointed at a, a's backpointer is pointed at
# that dirent, and a's own dirent is removed. c, orphaned by the repoint,
# is reattached on the way (the side errors).
test_dir_loop()
{
    new_fs
    mkdir -p /mnt/a/b/c
    umount /mnt

    local a=($(dirent a)) b=($(dirent b)) c=($(dirent c))

    kvdb_rw -c "update dirents ${c[0]}:U32_MAX d_inum=${a[1]}" \
	    -c "update inodes 0:${a[1]}:U32_MAX bi_dir=${b[1]} bi_dir_offset=${c[0]#*:}" \
	    -c "set dirents ${a[0]}:U32_MAX deleted"

    ktest_expect_sb_errors="dir_loop|inode_dir_wrong_nlink|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck dir_loop

    # The loop is broken: b is reachable again, wherever a was reattached
    mount -t bcachefs $(dev) /mnt
    [[ -n $(find /mnt -name b -type d) ]]
    umount /mnt
}

# The same, three directories round: with /a/b/c/d, c's dirent "d" is
# repointed at a, so a -> c -> b -> a. Depths a=1, b=2, c=3: the walk from
# a stops at c -> b, which isn't on its path - before "check_path_loop:
# don't trust bi_depth past a wrong one" that renumbered a and c upwards
# from b instead of reporting the loop, where the two-directory loop just
# swapped its depths.
test_dir_loop3()
{
    new_fs
    mkdir -p /mnt/a/b/c/d
    umount /mnt

    local a=($(dirent a)) d=($(dirent d))

    kvdb_rw -c "update dirents ${d[0]}:U32_MAX d_inum=${a[1]}" \
	    -c "update inodes 0:${a[1]}:U32_MAX bi_dir=${d[0]%:*} bi_dir_offset=${d[0]#*:}" \
	    -c "set dirents ${a[0]}:U32_MAX deleted"

    ktest_expect_sb_errors="dir_loop|inode_dir_wrong_nlink|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck dir_loop

    mount -t bcachefs $(dev) /mnt
    [[ -n $(find /mnt -name b -type d) ]]
    [[ -n $(find /mnt -name c -type d) ]]
    umount /mnt
}


# ── check_dirents: DT_SUBVOL ─────────────────────────────────────────────

# "<pos> <parent subvol> <child subvol>" of the subvolume dirent named $1,
# pos with its snapshot
subvol_dirent()
{
    bcachefs list -b dirents $(dev) |
	sed -n "s/.*type dirent \([0-9]*:[0-9]*:[0-9A-Z_]*\) .*: $1 -> \([0-9]*\) -> \([0-9]*\) type subvol.*/\1 \2 \3/p"
}

# /mnt/sv, a subvolume, and /mnt/sv/inner, a subvolume in it: inner's dirent
# lives in sv's snapshot, with sv as its parent. Leaves it unmounted.
subvol_setup()
{
    new_fs
    bcachefs subvolume create /mnt/sv
    bcachefs subvolume create /mnt/sv/inner
    echo foo > /mnt/sv/inner/f
    umount /mnt
}

# A subvolume dirent's parent_subvol is the subvolume it's in. Two ways to get
# it wrong: a subvolume that exists but whose snapshot doesn't see the dirent
# (the root subvolume - sv's snapshot isn't its ancestor), and one that
# doesn't exist. Either way it's rewritten to the subvolume that does see it,
# and the nested subvolume is where it was.
do_subvol_dirent_parent_wrong()
{
    local bad_parent=$1 err=$2 side=${3:-}

    subvol_setup
    local d=($(subvol_dirent inner))
    local parent=${d[1]} child=${d[2]}
    [[ -n $child ]]

    kvdb_rw -c "update dirents ${d[0]} d_parent_subvol=$bad_parent"

    ktest_expect_sb_errors="$err${side:+|$side}"
    check_fsck $err

    d=($(subvol_dirent inner))
    [[ ${d[1]} == $parent && ${d[2]} == $child ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/sv/inner/f) == foo ]]
    umount /mnt
}

test_dirent_not_visible_in_parent_subvol()
{
    do_subvol_dirent_parent_wrong 1 dirent_not_visible_in_parent_subvol
}

# (subvol_missing: the subvolume lookup records it too, ahead of the repair.)
test_dirent_to_missing_parent_subvol()
{
    do_subvol_dirent_parent_wrong 99 dirent_to_missing_parent_subvol subvol_missing
}

# A subvolume dirent naming a subvolume that doesn't exist: the dirent goes,
# and the real subvolume it used to name, now with no dirent, is reattached -
# its contents whole.
test_dirent_to_missing_subvol()
{
    subvol_setup
    local d=($(subvol_dirent inner))
    local child=${d[2]}
    [[ -n $child ]]

    kvdb_rw -c "update dirents ${d[0]} d_child_subvol=99"

    # The subvolume's root is reattached as an inode (its backpointer named
    # the dirent that's gone), into lost+found as subvol-<id>
    ktest_expect_sb_errors="dirent_to_missing_subvol|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck dirent_to_missing_subvol

    [[ -z $(subvol_dirent inner) ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/lost+found/subvol-$child/f) == foo ]]
    umount /mnt
}

# ── snapshot versions ────────────────────────────────────────────────────

subvol_snapshot()
{
    kvdb -c "get subvolumes 0:$1:0 snapshot" | tail -1
}

# A dirent whose inode was deleted in a descendant snapshot, where the dirent
# still shows: rm in a snapshotted subvolume leaves whiteouts for both in the
# subvolume's snapshot, and the dirent's is removed. The repair puts it back,
# for the subvolume only - the snapshot keeps the file.
test_dirent_to_overwritten_inode()
{
    new_fs
    bcachefs subvolume create /mnt/sv
    echo foo > /mnt/sv/f
    local dir=$(stat -c %i /mnt/sv)
    bcachefs subvolume snapshot /mnt/sv /mnt/snap
    rm /mnt/sv/f
    umount /mnt

    local sv_snap=$(subvol_snapshot 2)
    local wh=$(kvdb -c 'list dirents' |
	sed -n "s/.*type whiteout \($dir:[0-9]*\):$sv_snap .*/\1/p")
    [[ -n $wh ]]

    kvdb_rw -c "set dirents $wh:$sv_snap deleted"

    ktest_expect_sb_errors="dirent_to_overwritten_inode"
    check_fsck dirent_to_overwritten_inode

    mount -t bcachefs $(dev) /mnt
    [[ ! -e /mnt/sv/f ]]
    [[ $(cat /mnt/snap/f) == foo ]]
    umount /mnt
}

# A directory's hash seed differing between its snapshot versions: every
# version takes the snapshot root's, and names resolve in every view after -
# old dirents, in the snapshot both share, and new ones, in the subvolume's.
#
# Never detected from June until "inode: bch2_inode_find_oldest_snapshot()
# finds the oldest again": the "snapshot root" each version was checked
# against was itself.
test_inode_snapshot_hash_mismatch()
{
    new_fs
    bcachefs subvolume create /mnt/sv
    mkdir /mnt/sv/d
    local i
    for i in $(seq 1 20); do echo $i > /mnt/sv/d/f$i; done
    local d=$(stat -c %i /mnt/sv/d)
    bcachefs subvolume snapshot /mnt/sv /mnt/snap
    for i in $(seq 1 5); do echo $i > /mnt/sv/d/g$i; done
    umount /mnt

    local sv_snap=$(subvol_snapshot 2)
    echo "sv snapshot $sv_snap; versions of d:"
    kvdb -c 'list -k inodes' | grep ":$d:"
    local seed=$(kvdb -c "get inodes 0:$d:$sv_snap bi_hash_seed" | tail -1)
    kvdb_rw -c "update inodes 0:$d:$sv_snap bi_hash_seed=12345"

    ktest_expect_sb_errors="inode_snapshot_mismatch"
    check_fsck inode_snapshot_mismatch

    [[ $(kvdb -c "get inodes 0:$d:$sv_snap bi_hash_seed" | tail -1) == $seed ]]

    mount -t bcachefs $(dev) /mnt
    for i in $(seq 1 20); do
	[[ $(cat /mnt/sv/d/f$i) == $i ]]
	[[ $(cat /mnt/snap/d/f$i) == $i ]]
    done
    for i in $(seq 1 5); do
	[[ $(cat /mnt/sv/d/g$i) == $i ]]
	[[ ! -e /mnt/snap/d/g$i ]]
    done
    umount /mnt
}

# ── str_hash ─────────────────────────────────────────────────────────────

# Two dirents with the same name: b's dirent renamed to a in place, so it's
# also at the wrong offset. The move to where "a" hashes finds the real a
# there; one of them is renamed. Both files have to survive, each under a
# name that leads to it, with backpointers that agree.
test_dirent_duplicate_name()
{
    new_fs
    echo A > /mnt/a
    echo B > /mnt/b
    local a=$(stat -c %i /mnt/a) b=$(stat -c %i /mnt/b)
    umount /mnt

    local d=($(dirent b))
    kvdb_rw -c "update dirents ${d[0]}:U32_MAX d_name=a"

    ktest_expect_sb_errors="hash_table_key_wrong_offset|hash_table_key_duplicate"
    check_fsck hash_table_key_duplicate

    mount -t bcachefs $(dev) /mnt
    ls -la /mnt
    [[ $(ls /mnt | grep -c '^a') == 2 ]]
    local f
    for f in /mnt/a*; do
	case $(stat -c %i $f) in
	    $a) [[ $(cat $f) == A ]] ;;
	    $b) [[ $(cat $f) == B ]] ;;
	    *)  echo "TEST FAILED: $f is neither file"; exit 1 ;;
	esac
    done
    umount /mnt
}

# ── lost+found and reattach ──────────────────────────────────────────────

# Cut an inode version off from its name: its dirent at the dirent's own
# snapshot removed (or, with -s, hidden from @snapshot only), and the version
# at @snapshot without a backpointer. orphan_version [-s] <inum> <snapshot>
# <dirent pos>
orphan_version()
{
    local in_snapshot=""
    [[ $1 == -s ]] && { in_snapshot="-s"; shift; }
    local inum=$1 snapshot=$2 d=$3

    if [[ -n $in_snapshot ]]; then
	kvdb_rw -c "set -s dirents ${d%:*}:$snapshot deleted"
    else
	kvdb_rw -c "set dirents $d deleted"
    fi
    kvdb_rw -c "update inodes 0:$inum:$snapshot bi_dir=0 bi_dir_offset=0"
}

# "<inode>:<offset>:<snapshot>" of the dirent named $1, any snapshot
dirent_pos()
{
    kvdb -c 'list dirents' |
	sed -n "s/.*type dirent \([0-9]*:[0-9]*:[0-9A-Z_]*\) .*: $1 -> .*/\1/p" | head -1
}

snap_field()
{
    kvdb -c "get snapshots 0:$1:0 $2" | tail -1
}

# f, written, then the root subvolume snapshotted at /mnt/snap: f's keys are
# in the interior snapshot both leaves inherit. Prints "<inum> <interior>
# <root leaf> <snap leaf>"; leaves it mounted.
snap_setup()
{
    new_fs >&2
    echo x > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    bcachefs subvolume snapshot /mnt /mnt/snap >&2
    echo "$inum"
}

snap_ids()
{
    local leaf=$(subvol_snapshot 1)
    echo "$(snap_field $leaf parent) $leaf $(subvol_snapshot 2)"
}

# An unreachable file with no lost+found: it's created, and the file put in
# it.
test_lostfound_created()
{
    new_fs
    rmdir /mnt/lost+found
    echo x > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    umount /mnt

    orphan_version $inum U32_MAX $(dirent_pos f)

    ktest_expect_sb_errors="inode_unreachable"
    check_fsck inode_unreachable

    mount -t bcachefs $(dev) /mnt
    [[ -d /mnt/lost+found ]]
    [[ $(cat /mnt/lost+found/$inum) == x ]]
    umount /mnt
}

# The name a reattach wants taken by another file: lost+found/<inum> made by
# hand first. It's reattached at the next free name, <inum>.1, and the other
# file keeps its own - it used to stop fsck, fsck_repair_unimplemented.
test_lostfound_name_taken()
{
    new_fs
    echo x > /mnt/f
    local inum=$(stat -c %i /mnt/f)
    echo other > /mnt/lost+found/$inum
    umount /mnt

    orphan_version $inum U32_MAX $(dirent_pos f)

    ktest_expect_sb_errors="inode_unreachable"
    check_fsck inode_unreachable

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/lost+found/$inum) == other ]]
    [[ $(cat /mnt/lost+found/$inum.1) == x ]]
    umount /mnt
}

# lost+found deleted in a snapshot, and a file there to reattach: lost+found
# is restored in that snapshot - the same inode, which rmdir deleted there
# too, so it comes from the tree's root snapshot - and the other view is left
# as it was.
test_lostfound_restored()
{
    local inum=$(snap_setup)
    echo y >> /mnt/snap/f
    rmdir /mnt/snap/lost+found
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    orphan_version -s $inum $snap $(dirent_pos f)

    ktest_expect_sb_errors="inode_unreachable"
    check_fsck inode_unreachable

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/snap/lost+found/$inum) == $'x\ny' ]]
    [[ $(cat /mnt/f) == x ]]
    [[ ! -e /mnt/lost+found/$inum ]]
    umount /mnt
}

# Reattaching a version with versions below it that are unreachable too: the
# oldest is reattached, and the ones below pointed at its dirent - one entry
# in lost+found, that each view sees its own version through.
test_reattach_descendant_follows()
{
    local inum=$(snap_setup)
    echo y >> /mnt/f
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    orphan_version $inum $interior $(dirent_pos f)
    kvdb_rw -c "update inodes 0:$inum:$leaf bi_dir=0 bi_dir_offset=0"

    ktest_expect_sb_errors="inode_unreachable"
    check_fsck inode_unreachable

    [[ $(kvdb -c "get inodes 0:$inum:$leaf bi_dir_offset" | tail -1) == \
       $(kvdb -c "get inodes 0:$inum:$interior bi_dir_offset" | tail -1) ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/lost+found/$inum) == $'x\ny' ]]
    [[ $(cat /mnt/snap/lost+found/$inum) == x ]]
    umount /mnt
}

# Reattaching a version with a version below it that has a name of its own,
# which can't be carried up - its directory doesn't exist in the older view:
# the lost+found entry is whited out below, so that view has the file once,
# under its own name.
test_reattach_descendant_whiteout()
{
    local inum=$(snap_setup)
    mkdir /mnt/d
    mv /mnt/f /mnt/d/g
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    orphan_version $inum $interior $(dirent_pos f)

    ktest_expect_sb_errors="inode_unreachable"
    check_fsck inode_unreachable

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/snap/lost+found/$inum) == x ]]
    [[ $(cat /mnt/d/g) == x ]]
    [[ ! -e /mnt/lost+found/$inum ]]
    umount /mnt
}

# A chain of $1 snapshots of the root, f appended to before each: f has a
# version at every interior node, and snapshot sK sees K lines. Leaves it
# unmounted.
snapshot_chain()
{
    new_fs
    local i
    for i in $(seq 1 $1); do
	echo $i >> /mnt/f
	bcachefs subvolume snapshot /mnt /mnt/s$i
    done
    umount /mnt
}

# Every version of f in the chain unreachable: the oldest is reattached and
# the fixup points every version below at its dirent - more than one
# transaction holds, so it commits partway (commit_lazy_if_full()), and the
# re-drive has to adopt the reattach dirent it already made, and skip the
# versions already fixed. Every snapshot still sees its own f, through the
# one lost+found entry.
test_reattach_partial_commit()
{
    local n=120
    snapshot_chain $n

    local d=$(dirent_pos f)
    local inum=$(kvdb -c 'list dirents' | sed -n "s/.*: f -> \([0-9]*\) .*/\1/p" | head -1)

    local cmds=(-c "set dirents $d deleted") s
    for s in $(kvdb -c 'list -k inodes' | sed -n "s/.*type inode_v3 0:$inum:\([0-9A-Z_]*\) .*/\1/p"); do
	cmds+=(-c "update inodes 0:$inum:$s bi_dir=0 bi_dir_offset=0")
    done
    kvdb_rw "${cmds[@]}"

    local rc=0
    bcachefs fsck -yv $(dev) > /tmp/fsck-v.log 2>&1 || rc=$?
    echo "fsck -yv exited $rc"
    (( rc != 0 ))
    grep -q 'resuming reattach' /tmp/fsck-v.log

    ktest_expect_sb_errors="inode_unreachable"
    check_bcachefs_errors $(dev)
    bcachefs fsck -n $(dev)

    mount -t bcachefs $(dev) /mnt
    local i
    for i in $(seq 1 $n); do
	[[ $(wc -l < /mnt/s$i/lost+found/$inum) == $i ]]
    done
    [[ $(wc -l < /mnt/lost+found/$inum) == $n ]]
    umount /mnt
}

# An unreachable version whose descendant has a name in a directory the
# older view also has: the name is carried up, rather than a lost+found
# entry made - the snapshot sees the file under the name it was renamed to.
test_inode_unreachable_dirent_in_descendant()
{
    local inum=$(snap_setup)
    mv /mnt/f /mnt/g
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    orphan_version $inum $interior $(dirent_pos f)

    ktest_expect_sb_errors="inode_unreachable_dirent_in_descendant"
    check_fsck inode_unreachable_dirent_in_descendant

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/g) == x ]]
    [[ $(cat /mnt/snap/g) == x ]]
    [[ ! -e /mnt/snap/lost+found/$inum ]]
    umount /mnt
}

# A dirent in an ancestor snapshot whose inode exists only in a descendant:
# a view on another branch sees a name for a file that isn't there. The dirent
# is moved down to the snapshot with the inode.
test_dirent_to_inode_in_descendant_snapshot()
{
    snap_setup > /dev/null
    echo z > /mnt/h
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    local d=$(dirent_pos h)
    kvdb_rw -c "copy dirents $d ${d%:*}:$interior" \
	    -c "set dirents $d deleted"

    ktest_expect_sb_errors="dirent_to_inode_in_descendant_snapshot"
    check_fsck dirent_to_inode_in_descendant_snapshot

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/h) == z ]]
    [[ ! -e /mnt/snap/h ]]
    umount /mnt
}

# The same, for moving a dirent down to the snapshots its inode is in: h's
# dirent moved up to the snapshot above the chain, where h never existed,
# and h with a version at every node of the chain below it - one copy of the
# dirent per version, more than one transaction holds, and the re-drive has
# to skip the copies already committed. The snapshot taken before h existed
# still doesn't see it.
#
# Unverified that it does commit partway: the re-drive leaves no trace to
# check for, unlike the reattach's "resuming reattach". A dirent copy costs
# far less transaction memory than an inode write, hence the longer chain.
test_dirent_to_descendant_partial_commit()
{
    local n=400
    new_fs
    bcachefs subvolume snapshot /mnt /mnt/before
    local i
    for i in $(seq 1 $n); do
	echo $i >> /mnt/h
	bcachefs subvolume snapshot /mnt /mnt/s$i
    done
    umount /mnt

    local top=$(snap_field $(subvol_snapshot 2) parent)
    local d=$(dirent_pos h)
    kvdb_rw -c "copy dirents $d ${d%:*}:$top" \
	    -c "set dirents $d deleted"

    ktest_expect_sb_errors="dirent_to_inode_in_descendant_snapshot"
    check_fsck dirent_to_inode_in_descendant_snapshot

    mount -t bcachefs $(dev) /mnt
    for i in $(seq 1 $n); do
	[[ $(wc -l < /mnt/s$i/h) == $i ]]
    done
    [[ $(wc -l < /mnt/h) == $n ]]
    [[ ! -e /mnt/before/h ]]
    umount /mnt
}

# ── str_hash duplicates: which one wins ──────────────────────────────────

# The same dirent twice, the copy one slot on: the copy goes.
test_dirent_duplicate_identical()
{
    new_fs
    echo A > /mnt/a
    umount /mnt

    local d=($(dirent a))
    kvdb_rw -c "copy dirents ${d[0]}:U32_MAX ${d[0]%:*}:$(( ${d[0]#*:} + 1 )):U32_MAX"

    ktest_expect_sb_errors="hash_table_key_duplicate|hash_table_key_wrong_offset"
    check_fsck hash_table_key_duplicate

    mount -t bcachefs $(dev) /mnt
    [[ $(ls /mnt) == $'a\nlost+found' ]]
    [[ $(cat /mnt/a) == A ]]
    umount /mnt
}

# Two names the same, one pointing at nothing: the dangling one goes, both
# when it's the one being checked (k) and when it's the one ahead in the
# probe sequence (dup). The file the renamed dirent used to name is
# reattached.
#
# The renamed dirent has to be the one with the lower offset: the walk has
# to reach it, and find the duplicate, before it reaches the one it
# duplicates - a dangling dirent reached first is just removed, and there's
# no duplicate left to resolve. Offsets are hashes, so which of the two
# that is is decided at run time.
do_dirent_duplicate_dangling()
{
    local dangling=$1

    new_fs
    echo x > /mnt/x
    echo y > /mnt/y
    umount /mnt

    local dx=($(dirent x)) dy=($(dirent y))
    # As strings, padded: offsets are u64, bash arithmetic is signed
    local lo=x hi=y
    [[ $(printf %20s ${dx[0]#*:}) > $(printf %20s ${dy[0]#*:}) ]] && { lo=y; hi=x; }
    local dlo=($(dirent $lo)) dhi=($(dirent $hi))

    case $dangling in
	k)   kvdb_rw -c "update dirents ${dlo[0]}:U32_MAX d_name=$hi d_inum=999999" ;;
	dup) kvdb_rw -c "update dirents ${dlo[0]}:U32_MAX d_name=$hi" \
		     -c "update dirents ${dhi[0]}:U32_MAX d_inum=999999" ;;
    esac

    ktest_expect_sb_errors="hash_table_key_duplicate|hash_table_key_wrong_offset|inode_unreachable|inode_points_to_wrong_dirent|inode_points_to_missing_dirent"
    check_fsck hash_table_key_duplicate

    mount -t bcachefs $(dev) /mnt
    case $dangling in
	k)   [[ $(cat /mnt/$hi) == $hi ]]
	     [[ $(cat /mnt/lost+found/${dlo[1]}) == $lo ]] ;;
	dup) [[ $(cat /mnt/$hi) == $lo ]]
	     [[ $(cat /mnt/lost+found/${dhi[1]}) == $hi ]] ;;
    esac
    umount /mnt
}

test_dirent_duplicate_dangling_k()
{
    do_dirent_duplicate_dangling k
}

test_dirent_duplicate_dangling_dup()
{
    do_dirent_duplicate_dangling dup
}

# The same name in two snapshots: the descendant's wins in its own view - the
# ancestor's is whited out there, and nowhere else.
#
# The surviving dirent, in the leaf, names an inode whose only version is in
# the ancestor: check_dirents used to call it missing and "reconstruct" it in
# the leaf over the real one, and once get_visible() saw the ancestor's
# version, the backpointer repair wrote it in place - pointing the snapshot's
# view of b at the leaf's dirent.
test_dirent_duplicate_snapshots()
{
    new_fs
    echo A > /mnt/a
    echo B > /mnt/b
    bcachefs subvolume snapshot /mnt /mnt/snap
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    local db=($(dirent b))
    kvdb_rw -c "copy dirents ${db[0]}:U32_MAX ${db[0]}:$leaf" \
	    -c "update dirents ${db[0]}:$leaf d_name=a"

    ktest_expect_sb_errors="hash_table_key_duplicate|hash_table_key_wrong_offset|inode_points_to_wrong_dirent|inode_points_to_missing_dirent|inode_unreachable"
    check_fsck hash_table_key_duplicate

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/a) == B ]]
    [[ $(cat /mnt/snap/a) == A ]]
    [[ $(cat /mnt/snap/b) == B ]]
    umount /mnt
}

# No injection: a rename over an existing file in a snapshot leaves a dirent
# in the leaf shadowing the ancestor's at the same position, pointing at an
# inode that lives only in the ancestor. That's a normal filesystem, and fsck
# must find nothing - the target inode is visible from the dirent, whatever
# overwrote the dirent's own position.
test_rename_over_in_snapshot_clean()
{
    new_fs
    echo A > /mnt/a
    echo B > /mnt/b
    bcachefs subvolume snapshot /mnt /mnt/snap
    mv /mnt/a /mnt/b
    umount /mnt

    bcachefs fsck -n $(dev)

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/b) == A ]]
    [[ $(cat /mnt/snap/b) == B ]]
    umount /mnt
}

# No damage: a dirent repeated, unchanged, in a snapshot below the one it was
# made in, its inode only in the ancestor. Unusual - whatever makes a dirent
# writes its inode there too - but valid: a lookup in the leaf finds the
# ancestor's version, which names this dirent. fsck must call it clean, not
# take the inode for missing and reconstruct it over the real one.
test_dirent_in_snapshot_inode_in_ancestor()
{
    new_fs
    echo B > /mnt/b
    bcachefs subvolume snapshot /mnt /mnt/snap
    umount /mnt

    local leaf=$(subvol_snapshot 1)
    local db=($(dirent b))
    kvdb_rw -c "copy dirents ${db[0]}:U32_MAX ${db[0]}:$leaf"

    bcachefs fsck -n $(dev)

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/b) == B ]]
    [[ $(cat /mnt/snap/b) == B ]]
    umount /mnt
}

# A dirent in the leaf naming an inode whose only version is in the
# ancestor, where it has a name already: in the leaf, c's dirent repointed at
# b's inode. The leaf now sees two links to it, the snapshot one - and the
# repair that adds the link has to give the leaf a version of its own, not
# rewrite the ancestor's, which is the snapshot's b too.
test_dirent_target_repair_in_snapshot()
{
    new_fs
    echo B > /mnt/b
    echo C > /mnt/c
    local b=$(stat -c %i /mnt/b)
    bcachefs subvolume snapshot /mnt /mnt/snap
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    local dc=($(dirent c))
    kvdb_rw -c "copy dirents ${dc[0]}:U32_MAX ${dc[0]}:$leaf" \
	    -c "update dirents ${dc[0]}:$leaf d_inum=$b"

    local nlink=$(kvdb -c "get inodes 0:$b:$interior bi_nlink" | tail -1)
    local dir=$(kvdb -c "get inodes 0:$b:$interior bi_dir_offset" | tail -1)

    ktest_expect_sb_errors="inode_wrong_nlink|inode_multiple_links_but_nlink_0|inode_unreachable|inode_points_to_wrong_dirent"
    check_fsck_any

    # The ancestor's version - the snapshot's b - untouched:
    [[ $(kvdb -c "get inodes 0:$b:$interior bi_nlink" | tail -1) == $nlink ]]
    [[ $(kvdb -c "get inodes 0:$b:$interior bi_dir_offset" | tail -1) == $dir ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/c) == B ]]
    [[ $(cat /mnt/b) == B ]]
    [[ $(stat -c %h /mnt/b) == 2 ]]
    [[ $(cat /mnt/snap/b) == B ]]
    [[ $(cat /mnt/snap/c) == C ]]
    [[ $(stat -c %h /mnt/snap/b) == 1 ]]
    umount /mnt
}

# A dirent in a leaf whose inode was deleted in between: b removed in the
# root, then snapshotted again, so the middle snapshot has whiteouts - and
# b's dirent copied into the newest leaf. That leaf resolves the inode to
# nothing, whatever the oldest snapshot still has: the dirent goes. Nothing
# older changes.
test_dirent_target_deleted_between()
{
    new_fs
    echo B > /mnt/b
    bcachefs subvolume snapshot /mnt /mnt/s1
    rm /mnt/b
    bcachefs subvolume snapshot /mnt /mnt/s2
    umount /mnt

    local leaf=$(subvol_snapshot 1)
    local db=$(kvdb -c 'list dirents' | sed -n "s/.*type dirent \([0-9]*:[0-9]*\):U32_MAX .*: b -> .*/\1/p")
    [[ -n $db ]]
    kvdb_rw -c "copy dirents $db:U32_MAX $db:$leaf"

    ktest_expect_sb_errors="dirent_to_missing_inode"
    check_fsck dirent_to_missing_inode

    mount -t bcachefs $(dev) /mnt
    [[ ! -e /mnt/b ]]
    [[ ! -e /mnt/s2/b ]]
    [[ $(cat /mnt/s1/b) == B ]]
    umount /mnt
}

# One version wrong, in a descendant, and the ancestor's right: the
# descendant's backpointer is repaired, and the ancestor's left alone.
test_dirent_target_descendant_version()
{
    local inum=$(snap_setup)
    echo y >> /mnt/f
    umount /mnt

    local ids=($(snap_ids)) interior leaf snap
    interior=${ids[0]} leaf=${ids[1]} snap=${ids[2]}

    local off=$(kvdb -c "get inodes 0:$inum:$interior bi_dir_offset" | tail -1)
    kvdb_rw -c "update inodes 0:$inum:$leaf bi_dir_offset=12345"

    ktest_expect_sb_errors="inode_points_to_missing_dirent|inode_points_to_wrong_dirent"
    check_fsck_any

    [[ $(kvdb -c "get inodes 0:$inum:$leaf bi_dir_offset" | tail -1) == $off ]]
    [[ $(kvdb -c "get inodes 0:$inum:$interior bi_dir_offset" | tail -1) == $off ]]

    mount -t bcachefs $(dev) /mnt
    [[ $(cat /mnt/f) == $'x\ny' ]]
    [[ $(cat /mnt/snap/f) == x ]]
    umount /mnt
}

# ── keys in deleted snapshots ────────────────────────────────────────────

# The root subvolume snapshotted and the snapshot deleted: the interior node
# above the root's leaf is parked no_keys, its keys moved down to the leaf.
# Prints "<leaf> <interior>"; leaves it unmounted.
parked_interior_setup()
{
    bcachefs subvolume snapshot /mnt /mnt/snap >&2
    bcachefs subvolume delete /mnt/snap >&2
    echo 1 > /sys/fs/bcachefs/*/internal/trigger_delete_dead_snapshots
    umount /mnt

    local leaf=$(subvol_snapshot 1)
    local interior=$(snap_field $leaf parent)
    if [[ $interior == 0 || $(snap_field $interior state) != $((0x372b5a01)) ]]; then
	echo "TEST BROKEN: expected a no_keys interior above the root leaf" >&2
	kvdb -c 'list snapshots' >&2
	exit 1
    fi
    echo "$leaf $interior"
}

# A key the accounting knows about in a parked interior: the node has data,
# so check_snapshots undeletes it rather than lose the key - and the file
# reads back whole.
test_deleted_interior_has_data()
{
    new_fs
    dd if=/dev/urandom of=/mnt/g bs=64k count=1 oflag=direct status=none
    cp /mnt/g /tmp/g-orig
    local g=$(stat -c %i /mnt/g)
    local ids=($(parked_interior_setup)) leaf interior
    leaf=${ids[0]} interior=${ids[1]}

    local e=$(kvdb -c 'list extents' | sed -n "s/.*type extent \($g:[0-9]*\):$leaf .*/\1/p")
    [[ -n $e ]]
    kvdb_rw -c "copy extents $e:$leaf $e:$interior" \
	    -c "set extents $e:$leaf deleted"

    ktest_expect_sb_errors="snapshot_deleted_but_has_data"
    check_fsck snapshot_deleted_but_has_data

    mount -t bcachefs $(dev) /mnt
    cmp /mnt/g /tmp/g-orig
    umount /mnt
}

main "$@"
