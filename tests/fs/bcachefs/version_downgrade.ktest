#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

config-image	$(dirname $(readlink -e ${BASH_SOURCE[0]}))/version-new-image

test_downgrade()
{
    set_watchdog 60

    # config-image disks start at the second one, whatever the storage bus
    # happens to name it
    local dev=/dev/${ktest_dev_prefix}b

    bcachefs show-super $dev
    mount -t bcachefs -o errors=ro $dev /mnt
    umount /mnt
    bcachefs show-super $dev
}

main "$@"
