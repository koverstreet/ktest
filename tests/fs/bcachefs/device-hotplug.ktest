#!/usr/bin/env bash
#
# Devices coming and going underneath a filesystem.
#
# The guest asks the supervisor to run device_del/device_add on the VM it is
# itself running inside (prelude.sh qemu_monitor), so a disk really does leave
# the PCI bus and really does come back - the block device disappears from the
# guest along with everything udev built on top of it, exactly the way it does
# when someone pulls a cable.
#
# This is the substrate for the multi-device problems: a filesystem whose
# members show up one at a time at boot, a mount that has to decide how long
# to wait, one that has to go degraded because a member is never coming. None
# of those are testable without being able to make a device not be there yet.
#
# What this file starts with is the round trip on its own, one device, no
# filesystem-level cleverness: if a disk cannot leave and come back with its
# contents intact, nothing built on top of that is worth debugging.

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

# SCSI, because qemu will not hotplug on the root complex - "Bus 'pcie.0' does
# not support hotplugging" - and that is where virtio-blk disks are attached.
# The PCI ways around it need a bridge or a root port per disk plus a PCI
# hotplug driver in the guest; a SCSI unplug needs none of that.
#
# Set here rather than globally: virtio-scsi-pci has a bug where the root
# filesystem's superblock sometimes reads back as zeroes (see prelude.sh), so
# a few percent of boots panic. Confined to this test that's one flaky test;
# as the default it was a few percent of every boot in the suite.
ktest_storage_bus=virtio-scsi-pci

config-scratch-devs 4G

test_unplug_replug()
{
    set_watchdog 120

    local dev=${ktest_scratch_dev[0]}
    local sum

    run_quiet "" bcachefs format -f $dev

    mount -t bcachefs $dev /mnt
    dd if=/dev/urandom of=/mnt/foo bs=1M count=16 oflag=direct
    sum=$(md5sum < /mnt/foo)
    umount /mnt

    scratch_dev_unplug 0
    scratch_dev_plug 0

    mount -t bcachefs $dev /mnt
    if [[ $(md5sum < /mnt/foo) != $sum ]]; then
	echo "contents of /mnt/foo changed across the unplug"
	exit 1
    fi
    umount /mnt

    bcachefs fsck -ny $dev
    bcachefs_test_end_checks $dev
}

main "$@"
