#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

#config-image	$(dirname $(readlink -e ${BASH_SOURCE[0]}))/version-10.1-image
config-image	$(dirname $(readlink -e ${BASH_SOURCE[0]}))/version-11.0-image
config-image	$(dirname $(readlink -e ${BASH_SOURCE[0]}))/version-11.1-image
config-image	$(dirname $(readlink -e ${BASH_SOURCE[0]}))/version-11.2-image

test_upgrade()
{
    set_watchdog 60
    setup_tracing `bcachefs_slowpath_tracepoints`

    # config-image disks start at the second one, whatever the storage bus
    # happens to name it
    local first=/dev/${ktest_dev_prefix}b

    bcachefs show-super $first
    #bcachefs fsck $first || true
    mount -t bcachefs $first /mnt
    umount /mnt

    mount -t bcachefs $first /mnt
    umount /mnt

    exit

    for dev in /dev/${ktest_dev_prefix}[bcde]; do
	bcachefs show-super $dev
	mount -t bcachefs $dev /mnt
	umount /mnt
    done
}

main "$@"
