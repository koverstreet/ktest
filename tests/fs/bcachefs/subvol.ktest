    bcachefs subvolume create /mnt/sub1
    bcachefs subvolume create /mnt/sub2
    mv /mnt/sub1 /mnt/sub2
    umount /mnt

    bcachefs fsck -n ${ktest_scratch_dev[0]}

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

