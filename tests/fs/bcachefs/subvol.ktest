test_subvol_snapshot_delete_repeat()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    for i in $(seq 1 64); do
        bcachefs subvolume snapshot /mnt/$i
        bcachefs subvolume delete /mnt/$i
    done
    umount /mnt

    bcachefs fsck -n ${ktest_scratch_dev[0]}

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Distilled from snapshot_sums' flaky failure: `subvolume delete` kicks
# the deletion worker, and an immediate unmount races it - the worker
# aborts on erofs mid-sweep (delete_dead_snapshots(): erofs_trans_commit),
# leaving a half-deleted subvolume: a will_delete snapshot with a dangling
# subvol backref, unswept keys, the root inode missing BCH_INODE_unlinked.
# In the flaky failure fsck then failed to converge on that residue - the
# dead subvol's root was reattached to lost+found on the second run and
# fsck -n failed.
#
# Loop the race so the die-roll is near-deterministic; after every racy
# unmount, fsck must converge: fsck -n clean.
test_subvol_delete_unmount_race()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    local i j
    for i in $(seq 1 12); do
	mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

	bcachefs subvolume create /mnt/vol
	# enough keys that the sweep is still running at unmount:
	for j in $(seq 0 127); do
	    dd if=/dev/zero of=/mnt/vol/file-$j bs=128k count=1 2>/dev/null
	done
	bcachefs subvolume snapshot /mnt/vol /mnt/vol-snap
	echo "post-snap" > /mnt/vol/post-snap

	bcachefs subvolume delete /mnt/vol-snap
	bcachefs subvolume delete /mnt/vol
	umount /mnt		# the deleter is mid-sweep

	mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
	umount /mnt

	bcachefs fsck -n ${ktest_scratch_dev[0]} || {
	    echo "TEST FAILED: fsck not clean after racy unmount, iteration $i"
	    exit 1
	}
    done

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Regression test: whiteouts must survive interior snapshot node collapse.
#
# A snapshot whiteout is load-bearing negative information for descendant
# snapshots: it shadows an ancestor's key. If snapshot deletion collapses
# the node holding the whiteout without migrating it to the surviving
# child, the ancestor's key resurrects - a deleted file reappears in the
# live view, its dirent pointing at a freed inode. Seen in the wild on
# zorba's fs (git branch deletion + hourly snapshot pruning; see
# bcachefs-tools .claude/2026-07-17-zorba-fs-forensics.md).
test_snapshot_whiteout_resurrection()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/dir
    echo old > /mnt/dir/foo

    # snap.a preserves dir/foo; its interior parent holds the dirent
    bcachefs subvolume snapshot /mnt/snap.a

    # deleting foo in the live leaf writes a whiteout shadowing snap.a's
    # dirent
    rm /mnt/dir/foo

    # snap.b turns the whiteout-holding leaf into an interior node
    bcachefs subvolume snapshot /mnt/snap.b

    echo live > /mnt/dir/bar

    # deleting snap.b makes that interior redundant; collapsing it must
    # migrate the whiteout to the surviving child
    bcachefs subvolume delete /mnt/snap.b

    echo 1 | tee /sys/fs/bcachefs/*/internal/trigger_delete_dead_snapshots >& /dev/null || true
    sleep 5

    # drop dentries: the rm left a negative dentry that would mask a
    # resurrected dirent from the lookup path (exactly as in the field)
    echo 2 > /proc/sys/vm/drop_caches

    # readdir hits the dirents btree directly:
    if ls /mnt/dir | grep -q '^foo$'; then
	echo "deleted file resurrected after snapshot collapse"
	ls -la /mnt/dir
	false
    fi

    [[ $(cat /mnt/snap.a/dir/foo) = "old" ]]

    umount /mnt

    bcachefs fsck -n ${ktest_scratch_dev[0]}

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_subvol_snapshot_delete_fio()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    for i in $(seq 1 10); do
	#run_fio_randrw --filesize=500M --bs=4k
	dd if=/dev/zero of=/mnt/test bs=4k count=1024 oflag=direct
        bcachefs subvolume snapshot /mnt/$i
    done

    for i in $(seq 1 10); do
	umount /mnt
	bcachefs fsck -n ${ktest_scratch_dev[0]}
	mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    done

    umount /mnt
    bcachefs fsck -n ${ktest_scratch_dev[0]}

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_snapshot_copygc()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    for i in $(seq 1 4); do
	run_fio_randrw --filesize=1000M --loops=4 --bs=4k
        bcachefs subvolume snapshot /mnt/$i
    done

    bcachefs fs usage -h /mnt
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_snapshot_many_overwrite()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    for i in $(seq 1 100); do
	echo foo > /mnt/test
        bcachefs subvolume snapshot /mnt/snap.$i
    done

    bcachefs fs usage -h /mnt
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_snapshot_prjquota()
{
    run_quiet "" bcachefs format -f --prjquota ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    echo foo > /mnt/test
    bcachefs subvolume snapshot /mnt/snap.$i

    bcachefs fs usage -h /mnt
    umount /mnt

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

md5sum_file()
{
    md5sum $1|cut -d\  -f1
}

check_snapshot_md5sum()
{
    local i=$1
    local sum=/mnt/fiotest.sum.$i

    echo "checking $sum"

    if [[ ! $(<$sum) = $(md5sum_file /mnt/snap.$i/fiotest) ]]; then
	echo "md5sums do not match for $sum and /mnt/snap.$i/fiotest"
	echo $(<$sum)
	md5sum_file /mnt/snap.$i/fiotest
	return 1
    fi
}

check_snapshot_md5sums()
{
    local snap
    for snap in $(ls /mnt|grep '^snap.' || true); do
	echo "about to check $snap"

	check_snapshot_md5sum ${snap##snap.}
    done
}

run_snapshot_fio()
{
    local filename=$1
    shift

    fio --exitall_on_error=1		\
	--minimal			\
	--randrepeat=1			\
	--ioengine=libaio		\
	--iodepth=64			\
	--iodepth_batch=16		\
	--direct=1			\
	--numjobs=1			\
	--thread			\
	--verify=meta			\
	--verify_fatal=1		\
	--overwrite=1			\
	--filesize=500M			\
	--io_size=200M			\
	--bsrange=4k-64k		\
	--name=randrw			\
	--stats=0			\
	--disable_bw=1			\
	--rw=randrw			\
	--filename=$filename		\
	"$@"
}

test_snapshot_sums()
{
    run_quiet "" bcachefs format -f --prjquota ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local i
    for i in $(seq 0 10); do
	run_snapshot_fio /mnt/fiotest

	md5sum_file /mnt/fiotest > /mnt/fiotest.sum.$i

	echo "creating snapshot $i"
        bcachefs subvolume snapshot /mnt/snap.$i
    done

    check_snapshot_md5sums

    local snap
    for snap in $(echo /mnt/snap.*|sort -R); do
	umount /mnt
	mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt

	bcachefs subvolume delete $snap

	check_snapshot_md5sums
    done

    umount /mnt
    bcachefs fsck -n ${ktest_scratch_dev[0]}
}

test_snapshot_rw()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local i
    for i in $(seq 0 10); do
	[[ -f /mnt/fiotest ]] &&
	run_snapshot_fio /mnt/fiotest --verify_only=1
	run_snapshot_fio /mnt/fiotest

	echo "creating snapshot $i"
        bcachefs subvolume snapshot /mnt/snap.$i
	md5sum_file /mnt/snap.$i/fiotest > /mnt/fiotest.sum.$i

	for snap in /mnt/snap.*; do
	    local j=${snap##/mnt/snap.}
	    check_snapshot_md5sum $j

	    run_snapshot_fio /mnt/snap.$j/fiotest --verify_only=1
	    run_snapshot_fio /mnt/snap.$j/fiotest
	    md5sum_file /mnt/snap.$j/fiotest > /mnt/fiotest.sum.$j
	done
    done

    check_snapshot_md5sums

    local snap
    for snap in $(echo /mnt/snap.*|sort -R); do
	umount /mnt
	mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt

	bcachefs subvolume delete $snap
	sleep 1

	check_snapshot_md5sums
    done

    umount /mnt
    bcachefs fsck -n ${ktest_scratch_dev[0]}
}

test_snapshot_implicit_source()
{
    run_quiet "" bcachefs format -f  ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    mkdir /mnt/d
    bcachefs subvolume snapshot /mnt/d/snp1
    umount /mnt

    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt
}

test_delete_subvol_nested()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    bcachefs subvolume create /mnt/a
    bcachefs subvolume create /mnt/a/b
    assert_fails bcachefs subvolume delete /mnt/a
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

test_snapshot_file_delete()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    #dd if=/dev/zero of=/mnt/foo bs=4k count=8 oflag=direct
    touch /mnt/foo
    bcachefs subvolume snapshot /mnt/snapshot
    rm /mnt/snapshot/foo
    rm /mnt/foo

    umount /mnt

    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt
}

test_subvol_mv()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    bcachefs subvolume create /mnt/a
    bcachefs subvolume create /mnt/a/b
    mv /mnt/a/b /mnt
    umount /mnt

    bcachefs fsck ${ktest_scratch_dev[0]}
}

test_subvol_rmdir_empty_snapshot()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    cd /mnt
    bcachefs subvolume create ./sub
    cd sub
    bcachefs subvolume create ./sub2
    bcachefs subvolume snapshot . ./snap
    rmdir ./snap

    cd /
    umount /mnt

    bcachefs fsck ${ktest_scratch_dev[0]}
}

test_snapshot_reflink()
{
    run_quiet "" bcachefs format -f  ${ktest_scratch_dev[0]}
    mount -t bcachefs -o noinline_data ${ktest_scratch_dev[0]} /mnt

    cp /bin/cp /mnt/file
    #echo Test > /mnt/file
    bcachefs subvolume snapshot /mnt/snapshot

    cp --reflink=always /mnt/snapshot/file /mnt/file1
    rm /mnt/file
    cp --reflink=always /mnt/snapshot/file /mnt/file2

    md5sum /mnt/file* /mnt/snapshot/file /bin/cp
    umount /mnt

    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt
}

test_snapshot_file_delete_2()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    local a=/mnt
    local b=/mnt/derivative

    touch $a/hi_there

    bcachefs subvolume snapshot $a $b

    rm $a/hi_there
    rm $b/hi_there

    bcachefs subvolume delete $b
    umount /mnt

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_subvol_delete_by_rename()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    # POSIX rename(2) may overwrite an empty directory, and an empty
    # subvolume root is a legal victim - same precondition as rmdir of a
    # subvolume. mv -T forces rename() rather than moving into the dir.
    # The overwrite must engage the subvolume deletion path, not ordinary
    # unlink accounting.
    bcachefs subvolume create /mnt/victim
    touch /mnt/victim/keep
    bcachefs subvolume snapshot /mnt/victim /mnt/snap
    rm /mnt/victim/keep

    mkdir /mnt/src
    touch /mnt/src/file
    mv -T /mnt/src /mnt/victim

    # now a plain directory, not a subvolume:
    [[ -f /mnt/victim/file ]]
    assert_fails bcachefs subvolume delete /mnt/victim

    # the snapshot and its contents survive the source's deletion:
    [[ -f /mnt/snap/keep ]]

    umount /mnt

    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_subvol_list()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    # Data in root subvol
    dd if=/dev/zero of=/mnt/rootfile bs=1M count=2 oflag=direct

    # "work" subvol with a chain of snapshots (deeply nested snapshot tree)
    bcachefs subvolume create /mnt/work
    dd if=/dev/zero of=/mnt/work/base bs=1M count=4 oflag=direct
    bcachefs subvolume snapshot -r /mnt/work /mnt/work/snap1
    dd if=/dev/zero of=/mnt/work/v2 bs=1M count=2 oflag=direct
    bcachefs subvolume snapshot -r /mnt/work /mnt/work/snap2
    dd if=/dev/zero of=/mnt/work/v3 bs=1M count=1 oflag=direct
    bcachefs subvolume snapshot -r /mnt/work /mnt/work/snap3
    dd if=/dev/zero of=/mnt/work/v4 bs=1M count=1 oflag=direct
    bcachefs subvolume snapshot -r /mnt/work /mnt/work/snap4
    dd if=/dev/zero of=/mnt/work/latest bs=1M count=1 oflag=direct

    # Nested subvolumes with their own snapshots
    bcachefs subvolume create /mnt/projects
    bcachefs subvolume create /mnt/projects/alpha
    dd if=/dev/zero of=/mnt/projects/alpha/data bs=1M count=3 oflag=direct
    bcachefs subvolume create /mnt/projects/beta
    dd if=/dev/zero of=/mnt/projects/beta/data bs=1M count=5 oflag=direct
    bcachefs subvolume snapshot -r /mnt/projects /mnt/projects/backup

    # Snapshot of root
    bcachefs subvolume snapshot -r /mnt /mnt/snap-root

    echo "=== flat (no snapshots) ==="
    bcachefs subvolume list /mnt

    echo ""
    echo "=== flat (with snapshots) ==="
    bcachefs subvolume list --snapshots /mnt

    echo ""
    echo "=== flat recursive ==="
    bcachefs subvolume list -R /mnt

    echo ""
    echo "=== flat --sort=size ==="
    bcachefs subvolume list -R --sort=size /mnt

    echo ""
    echo "=== flat --readonly --snapshots ==="
    bcachefs subvolume list -R --readonly --snapshots /mnt

    echo ""
    echo "=== json ==="
    bcachefs subvolume list --json /mnt

    echo ""
    echo "=== json (with snapshots, recursive) ==="
    bcachefs subvolume list --json --snapshots -R /mnt

    echo ""
    echo "=== tree ==="
    bcachefs subvolume list --tree /mnt

    echo ""
    echo "=== tree (with snapshots) ==="
    bcachefs subvolume list --tree --snapshots /mnt

    echo ""
    echo "=== snapshot tree (root) ==="
    bcachefs subvolume list-snapshots /mnt

    echo ""
    echo "=== snapshot tree (work - deep chain) ==="
    bcachefs subvolume list-snapshots /mnt/work

    echo ""
    echo "=== snapshot tree (projects) ==="
    bcachefs subvolume list-snapshots /mnt/projects

    echo ""
    echo "=== snapshots flat ==="
    bcachefs subvolume list-snapshots --flat /mnt/work

    echo ""
    echo "=== snapshots flat --sort=size ==="
    bcachefs subvolume list-snapshots --flat --sort=size /mnt/work

    echo ""
    echo "=== snapshots flat --readonly ==="
    bcachefs subvolume list-snapshots --flat --readonly /mnt/work

    echo ""
    echo "=== snapshots json ==="
    bcachefs subvolume list-snapshots --json /mnt/work

    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# bch2_check_path_accessible() is the reason `bcachefs subvolume list` doesn't
# tell an unprivileged caller about subvolumes it has no path to. Subvolume
# children are keyed by fs_path_parent, not by directory nesting, so the raw
# iteration finds every subvolume of the parent wherever it sits in the tree;
# the walk from each child's root back up to the listing subvolume, requiring
# MAY_EXEC on every directory along the way, is what filters it.
#
# Nothing exercised that. Every listing test runs as root, and for a directory
# with MAY_EXEC generic_permission() returns 0 on CAP_DAC_READ_SEARCH - so the
# walk's answer is a foregone yes and only its side effects were under test.
# BCH_IOCTL_SUBVOLUME_LIST has no capability check of its own, so an
# unprivileged caller really does get here.
#
# Both directions matter, and the second is the one that bit a user: a
# subvolume the caller can't reach must be omitted, and omitting it must not
# take the rest of the listing with it.
test_subvol_list_unprivileged()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    set_as_user

    chmod 755 /mnt

    # Reachable: every directory on the path is searchable
    mkdir -m 755 /mnt/open
    bcachefs subvolume create /mnt/open/visible

    # Unreachable: a root-owned 0700 directory in the middle of the path.
    # Both are children of the root subvolume either way.
    mkdir -m 755 /mnt/closed
    bcachefs subvolume create /mnt/closed/hidden
    chmod 700 /mnt/closed

    # Assert the setup before asserting the behaviour: if 'hidden' were missing
    # outright, the unprivileged check below would pass having tested nothing.
    local root_out=/tmp/subvol-list-root.log
    bcachefs subvolume list /mnt > $root_out 2>&1
    cat $root_out
    local n
    for n in visible hidden; do
	grep -q "$n" $root_out || {
	    echo "TEST FAILED: root listing is missing $n - setup broken"
	    exit 1
	}
    done

    local user_out=/tmp/subvol-list-user.log
    local rc=0
    $as_user bcachefs subvolume list /mnt > $user_out 2>&1 || rc=$?
    echo "--- unprivileged listing exited $rc"
    cat $user_out

    local ok=1
    (( rc == 0 )) || {
	echo "TEST FAILED: unprivileged listing failed ($rc) instead of omitting the unreachable subvolume"
	ok=0
    }
    grep -q visible $user_out || {
	echo "TEST FAILED: reachable subvolume missing from the unprivileged listing"
	ok=0
    }
    if grep -q hidden $user_out; then
	echo "TEST FAILED: subvolume behind a 0700 directory listed to an unprivileged caller"
	ok=0
    fi

    umount /mnt
    (( ok )) || exit 1

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_subvol_list_stress()
{
    set_watchdog 300
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local nr_subvols=20
    local nr_snaps=10

    # Create subvolumes with data
    for ((i = 0; i < nr_subvols; i++)); do
	bcachefs subvolume create /mnt/sv$i
	dd if=/dev/zero of=/mnt/sv$i/data bs=64K count=1 oflag=direct 2>/dev/null

	# Create snapshot chains of varying depth
	local depth=$(( (i % nr_snaps) + 1 ))
	for ((j = 0; j < depth; j++)); do
	    dd if=/dev/zero of=/mnt/sv$i/v$j bs=64K count=1 oflag=direct 2>/dev/null
	    bcachefs subvolume snapshot -r /mnt/sv$i /mnt/sv$i/snap$j
	done
    done

    # Also snapshot root a few times
    for ((i = 0; i < 5; i++)); do
	dd if=/dev/zero of=/mnt/rootdata$i bs=64K count=1 oflag=direct 2>/dev/null
	bcachefs subvolume snapshot -r /mnt /mnt/snap-root$i
    done

    bcachefs_antagonist

    # Loop listing in various modes while antagonist runs
    for ((iter = 0; iter < 20; iter++)); do
	bcachefs subvolume list /mnt			> /dev/null
	bcachefs subvolume list --snapshots /mnt	> /dev/null
	bcachefs subvolume list -R /mnt			> /dev/null
	bcachefs subvolume list --tree /mnt		> /dev/null
	bcachefs subvolume list-snapshots /mnt		> /dev/null
	bcachefs subvolume list-snapshots --flat /mnt	> /dev/null

	# List from random subvolumes
	for sv in sv0 sv5 sv10 sv15 sv19; do
	    bcachefs subvolume list /mnt/$sv		> /dev/null
	    bcachefs subvolume list --tree /mnt/$sv	> /dev/null
	    bcachefs subvolume list-snapshots /mnt/$sv	> /dev/null
	    bcachefs subvolume list-snapshots --flat /mnt/$sv > /dev/null
	done
    done

    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_insert_range()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    bcachefs subvolume create /mnt/sub
    dd if=/dev/urandom of=/mnt/sub/testf bs=1M count=1 seek=0 conv=notrunc
    fallocate -i -l 4KiB -o 0 /mnt/sub/testf
    bcachefs subvolume snapshot /mnt/sub /mnt/snap
    fallocate -i -l 4KiB -o 0 /mnt/snap/testf

    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# fsck must CONVERGE - not merely find errors - after a batch snapshot whose
# sources are then all deleted at once.
#
# From TiCPU's filesystem (#bcache, https://tiky.ca/p/obligable-kandra.md,
# 2026-09-03). On 2026-08-20 he batch-snapshotted 549 podman layer subvolumes
# and deleted all 549 sources; in his words that "left interior snapshot nodes
# empty-but-referenced, and stacked hundreds of versions onto shared layer
# extents". Two weeks later fsck stopped converging: seven consecutive runs
# all ended "errors fixed" and never "clean", 204 inode numbers flagged in
# every run, odd runs resembling odd and even resembling even - a 2-cycle.
#
# Suspected mechanism: an inode has ONE bi_dir, but several snapshot views
# disagree about what it should point at. check_inodes clears it, correct for
# the view whose dirent is gone; check_dirents then sees older live dirent
# versions whose backpointer no longer matches and re-points it, correct for
# THEIR views. Both repairs are right and they sum to zero.
#
# This is deliberately NOT subvol_snapshot_delete_repeat, which interleaves -
# snapshot i, delete i, snapshot i+1 - so only one deletion is ever in flight.
# Here every snapshot is taken first and only then is every source deleted,
# which is what puts many pending deletions over shared extents at once.
#
# The oracle has to be repeated REPAIR. `fsck -n` cannot show this: a dry run
# reports the same errors forever and never oscillates, because it never
# writes. Only `fsck -y` in a loop can expose repairs that undo each other.
#
# MEASURED 2026-09-03, and it does NOT reproduce the field case at nr=48:
# the emergency-read-only lands ("filesystem not clean", unclean shutdown at
# journal seq 75), fsck finds 2 repair lines, and converges on pass 1. So this
# shape and scale is not sufficient - the field filesystem had 549 subvolumes
# and two weeks of further use between the batch operation and the livelock.
# Kept because it asserts a property we want, on a setup verified to produce
# repairable damage rather than nothing.
test_subvol_batch_snapshot_delete_all_sources()
{
    set_watchdog 600
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local nr=48 i pass

    # A common ancestor, so the snapshot versions below stack on the SAME
    # extents rather than on private copies. That sharing is what the field
    # case had (podman layers) and is half the point of the setup.
    bcachefs subvolume create /mnt/base
    for i in $(seq 0 31); do
	dd if=/dev/urandom of=/mnt/base/file-$i bs=64k count=1 2>/dev/null
    done
    mkdir /mnt/base/dir
    echo shared > /mnt/base/dir/shared

    for i in $(seq 1 $nr); do
	bcachefs subvolume snapshot /mnt/base /mnt/src-$i
	echo "layer-$i" > /mnt/src-$i/dir/layer
    done

    # Every snapshot first...
    for i in $(seq 1 $nr); do
	bcachefs subvolume snapshot /mnt/src-$i /mnt/snap-$i
    done

    # ...and only then every source. This ordering is the test.
    for i in $(seq 1 $nr); do
	bcachefs subvolume delete /mnt/src-$i
    done

    # A plain umount is NOT enough: measured 2026-09-03, the deletion worker
    # drains all 48 and we get "clean shutdown complete", so the interrupted
    # state the field case had is never created and the test passes vacuously.
    # Cut the filesystem off underneath the sweep instead.
    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    # Six passes is well past where a healthy filesystem is clean; a 2-cycle
    # will still be going.
    local found1=0
    for pass in $(seq 1 6); do
	bcachefs fsck -y ${ktest_scratch_dev[0]} > /run/fsck-$pass 2>&1 || true
	[[ $pass = 1 ]] && found1=$(grep -ciE 'fixing|repair|error' /run/fsck-1 || true)

	if bcachefs fsck -n ${ktest_scratch_dev[0]} > /run/fsck-check 2>&1; then
	    echo "fsck converged after $pass repair pass(es); pass 1 had $found1 repair lines"
	    # A converged run that had nothing to repair asserts nothing. Say so
	    # rather than let a green tick stand in for coverage.
	    [[ $found1 = 0 ]] && echo "NOTE: setup produced no repairable state - this run exercised nothing"
	    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
	    return
	fi
    done

    echo "TEST FAILED: fsck did not converge in 6 repair passes"
    echo "--- per pass: a 2-cycle alternates, real progress descends ---"
    # grep -c prints 0 and EXITS NONZERO when nothing matches, which under
    # set -e would kill us in the one path where we need the diagnostics.
    for pass in $(seq 1 6); do
	printf 'pass %s: %s lines, %s of interest\n' "$pass" \
	    "$(wc -l < /run/fsck-$pass)" \
	    "$(grep -ciE 'inode_points_to_missing_dirent|inode_unreachable|backpointer' \
		/run/fsck-$pass || true)"
    done
    echo "--- final dry run ---"
    cat /run/fsck-check
    return 1
}

main "$@"
