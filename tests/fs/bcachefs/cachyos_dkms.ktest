#!/usr/bin/env bash
#
# CachyOS: CONFIG_RUST=n, Clang 22.1.8 ThinLTO. LLVM=1 because a module for a
# ThinLTO kernel has to be built with the LLVM toolchain.
#
# No kernel Rust to build against, so bcachefs's Rust comes from its vendored
# stack - built with the rootfs's rustc, rust-src and bindgen.
#
# This is the configuration koverstreet/bcachefs#1197 died in. v1.39.0's probe
# took the vendored path on any CONFIG_RUST=n kernel, and that path includes a
# Makefile.rust.vendor which install_dkms never shipped - so the build stopped
# at parse time with no module at all. Reproduced here on the reporter's exact
# kernel; the test asserts a module exists, which is what 1.39.0 could not do.

. "$(dirname "$(readlink -e "${BASH_SOURCE[0]}")")/distro-dkms-libs.sh"

distro_rootfs_prepare cachyos

test_cachyos_dkms()
{
    distro_dkms_build cachyos vendored LLVM=1
}

main "$@"
