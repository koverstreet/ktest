#!/usr/bin/env bash
#
# Targeted tests for the userspace FUSE implementation (bcachefs
# fusemount). These exercise the tools' fuse code paths, not the
# bcachefs kernel module - the full fstests-over-fuse run lives in
# fuse.ktest.

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

require-kernel-config FUSE_FS

config-scratch-devs 4G

fuse_mount()
{
    mkdir -p /mnt/fuse
    bcachefs fusemount "$1" /mnt/fuse

    # fusemount daemonizes; wait for the mount to appear
    local i
    for ((i = 0; i < 100; i++)); do
	mountpoint -q /mnt/fuse && return 0
	sleep 0.1
    done
    echo "FAIL: fuse mount didn't come up"
    return 1
}

fuse_unmount()
{
    umount /mnt/fuse

    # fsck validates what the fuse write paths put on disk
    bcachefs fsck -ny "$1"
}

# Regression test for fuse readdir resume cookies: each fuse dirent's
# offset field is the cookie to resume the listing after that entry.
# These were computed one entry behind - pointing one unit past the
# *previous* entry, into the gap between two dirent hash positions.
# Listings that fit in one fuse reply buffer never noticed; a listing
# spanning two or more re-found one entry per resume and crawled the
# ~2^58-wide hash gaps one integer per readdir call: a 41-entry
# directory took 1.7M calls of 100% cpu, indistinguishable from a hang.
#
# 2000 entries spans many reply buffers. The watchdog catches the
# hang-shape of the regression; the diff catches duplicates, misses,
# and misordered resume.
test_readdir_multibuffer()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    fuse_mount ${ktest_scratch_dev[0]}

    mkdir /mnt/fuse/d
    local i
    for ((i = 0; i < 2000; i++)); do
	: > /mnt/fuse/d/$i
    done

    ls -f /mnt/fuse/d | grep -v '^\.' | sort -n > /tmp/got
    seq 0 1999 > /tmp/want
    diff -u /tmp/want /tmp/got

    fuse_unmount ${ktest_scratch_dev[0]}
}

# rename onto an existing name has to replace it. fusemount used to pass
# BCH_RENAME regardless - the mode that means "there is no target", which
# isn't checked - so the rename inserted a second dirent of the same name:
# both names listed, rm -r failing with ENOTEMPTY, and the replaced inode
# never losing its link. And once the replaced inode is unlinked, it has to
# actually be deleted when the kernel lets go of it: with no inode cache
# nothing ever did, and unmount left the filesystem clean with deleted inodes
# outstanding. fuse_unmount's fsck catches that.
test_rename_overwrite()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    fuse_mount ${ktest_scratch_dev[0]}

    echo old > /mnt/fuse/b
    echo new > /mnt/fuse/a
    mv /mnt/fuse/a /mnt/fuse/b

    local got=$(ls /mnt/fuse | grep -vx lost+found)
    if [[ $got != b ]]; then
	echo "FAIL: after mv a b, directory lists: $got"
	return 1
    fi
    if [[ $(cat /mnt/fuse/b) != new ]]; then
	echo "FAIL: b doesn't have the renamed file's contents"
	return 1
    fi

    rm /mnt/fuse/b
    fuse_unmount ${ktest_scratch_dev[0]}
}

# unmount, fsck, mount again straight away - xfstests' repair path, and what
# anyone does after a recovery mount. fuseblk's unmount waits for the daemon
# to shut the filesystem down, so the device must be free for fsck and the
# remount must succeed.
test_remount_cycle()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    local i
    for i in $(seq 1 5); do
	fuse_mount ${ktest_scratch_dev[0]}
	echo $i > /mnt/fuse/f$i
	fuse_unmount ${ktest_scratch_dev[0]}
    done

    fuse_mount ${ktest_scratch_dev[0]}
    for i in $(seq 1 5); do
	[[ $(cat /mnt/fuse/f$i) == $i ]] || { echo "FAIL: f$i lost"; return 1; }
    done
    fuse_unmount ${ktest_scratch_dev[0]}

    # A mount racing an unmount still in progress waits for it, as a kernel
    # mount does - the old daemon's device locks don't make it "already in use
    # by another FUSE mount" (generic/604, which does exactly this; 013, 524)
    for i in $(seq 1 10); do
	fuse_mount ${ktest_scratch_dev[0]}
	for j in $(seq 1 200); do echo $j > /mnt/fuse/s$j; done
	umount /mnt/fuse &
	sleep 0.01
	fuse_mount ${ktest_scratch_dev[0]}
	wait
	umount /mnt/fuse
    done

    # But a device that's actually mounted is refused, and at once
    fuse_mount ${ktest_scratch_dev[0]}
    mkdir -p /mnt/fuse2
    local out
    out=$(timeout 10 bcachefs fusemount ${ktest_scratch_dev[0]} /mnt/fuse2 2>&1) &&
	{ echo "FAIL: second mount of a mounted device succeeded"; return 1; }
    [[ $out == *"already in use"* ]] ||
	{ echo "FAIL: second mount of a mounted device: $out"; return 1; }
    umount /mnt/fuse
}

# A symlink's data ends at i_size rounded up to a block, as page_symlink()
# writes it - no NUL on disk. Writing the NUL too put one block past the end of
# the inode whenever the target's length was a multiple of the block size, and
# fsck deleted it (generic/083, generic/269). fuse_unmount's fsck catches it.
test_symlink_lengths()
{
    local dev=${ktest_scratch_dev[0]} len target

    run_quiet "" bcachefs format -f --block_size=512 $dev
    fuse_mount $dev

    for len in 1 511 512 513 1024 4095; do
	target=$(head -c $len /dev/zero | tr '\0' x)
	ln -s $target /mnt/fuse/l$len
	[[ $(readlink /mnt/fuse/l$len) == $target ]] ||
	    { echo "FAIL: symlink of length $len reads back wrong"; return 1; }
    done

    fuse_unmount $dev
}

# Subvolumes and snapshots through fuse. A snapshot shares inode numbers - and
# generations - with its origin, so a fuse node ID that is just the inode number
# can't tell them apart. Set up with the kernel (fuse can't create subvolumes
# yet), then check through fuse that each path reaches its own inode.
test_subvolumes()
{
    local dev=${ktest_scratch_dev[0]} m=/mnt/fuse

    run_quiet "" bcachefs format -f $dev
    mkdir -p /mnt/kern
    mount -t bcachefs $dev /mnt/kern
    bcachefs subvolume create /mnt/kern/sub
    echo origin > /mnt/kern/sub/f
    mkdir /mnt/kern/sub/d
    echo indir > /mnt/kern/sub/d/g
    bcachefs subvolume snapshot /mnt/kern/sub /mnt/kern/snap
    bcachefs subvolume snapshot -r /mnt/kern/sub /mnt/kern/rosnap
    echo changed > /mnt/kern/sub/f
    umount /mnt/kern

    fuse_mount $dev

    expect() # <file> <contents>
    {
	local got=$(cat "$1")
	[[ $got == "$2" ]] || { echo "FAIL: $1: got '$got', want '$2'"; return 1; }
    }

    expect $m/sub/f changed
    expect $m/snap/f origin
    expect $m/snap/d/g indir

    # Both open at once: two live node IDs for one inode number
    exec 3<$m/sub/f 4<$m/snap/f
    [[ $(cat <&3) == changed && $(cat <&4) == origin ]] ||
	{ echo "FAIL: with both open, the wrong file answered"; return 1; }
    exec 3<&- 4<&-

    # st_ino as the kernel reports it: the bcachefs inode number, same in both
    [[ $(stat -c %i $m/sub/f) == $(stat -c %i $m/snap/f) ]] ||
	{ echo "FAIL: st_ino differs between origin and snapshot"; return 1; }

    # Writes land in the subvolume they were made through
    echo snapnew > $m/snap/f
    expect $m/sub/f changed
    expect $m/snap/f snapnew

    # After eviction, node IDs resolve again to the right inodes
    echo 3 > /proc/sys/vm/drop_caches
    expect $m/sub/f changed
    expect $m/snap/f snapnew
    expect $m/snap/d/g indir

    # The core refuses renames across subvolumes
    python3 -c "
import errno, os, sys
try:
    os.rename('$m/sub/f', '$m/snap/moved')
except OSError as e:
    sys.exit(0 if e.errno == errno.EXDEV else 1)
sys.exit(1)" || { echo "FAIL: cross-subvolume rename wasn't EXDEV"; return 1; }

    # A read-only snapshot reads, and refuses every kind of write
    expect $m/rosnap/f origin
    ! (echo x > $m/rosnap/f) 2>/dev/null	|| { echo "FAIL: wrote to a read-only snapshot"; return 1; }
    ! truncate -s 0 $m/rosnap/f 2>/dev/null	|| { echo "FAIL: truncated in a read-only snapshot"; return 1; }
    ! mv $m/rosnap/d/g $m/rosnap/g 2>/dev/null	|| { echo "FAIL: renamed in a read-only snapshot"; return 1; }
    ! ln $m/rosnap/f $m/rosnap/f2 2>/dev/null	|| { echo "FAIL: linked in a read-only snapshot"; return 1; }
    ! touch $m/rosnap/new 2>/dev/null		|| { echo "FAIL: created in a read-only snapshot"; return 1; }
    expect $m/rosnap/f origin

    fuse_unmount $dev
}

# A directory file handle whose dentry is gone but whose inode isn't (an inotify
# watch pins the inode, not the dentry) gets reconnected: LOOKUP ".." up to a
# connected ancestor, and from a subvolume root that's in the parent subvolume.
#
# FUSE has no get_name, so the kernel finds each name by d_ino in the parent's
# readdir - a snapshot next to its origin is ambiguous there. Snapshots go in
# their own directory here, which is the usual layout anyway.
test_subvolume_handles()
{
    local dev=${ktest_scratch_dev[0]} m=/mnt/fuse

    run_quiet "" bcachefs format -f $dev
    mkdir -p /mnt/kern
    mount -t bcachefs $dev /mnt/kern
    bcachefs subvolume create /mnt/kern/sub
    mkdir /mnt/kern/sub/d /mnt/kern/snaps
    bcachefs subvolume snapshot /mnt/kern/sub /mnt/kern/snaps/s1
    umount /mnt/kern

    fuse_mount $dev

    local d
    for d in $m/sub/d $m/snaps/s1/d; do
	python3 - $d $m <<'EOF' || { echo "FAIL: $d: reconnecting its file handle"; return 1; }
import ctypes, os, sys

libc = ctypes.CDLL(None, use_errno=True)

class FileHandle(ctypes.Structure):
    _fields_ = [("handle_bytes", ctypes.c_uint),
                ("handle_type",  ctypes.c_int),
                ("f_handle",     ctypes.c_ubyte * 128)]

def check(ret, what):
    if ret < 0:
        e = ctypes.get_errno()
        sys.exit(f"{what}: {os.strerror(e)}")
    return ret

path, mnt = sys.argv[1], sys.argv[2]
AT_FDCWD, IN_MODIFY = -100, 2

fh, mnt_id = FileHandle(handle_bytes=128), ctypes.c_int()
check(libc.name_to_handle_at(AT_FDCWD, path.encode(), ctypes.byref(fh), ctypes.byref(mnt_id), 0),
      "name_to_handle_at")

watch = check(libc.inotify_init(), "inotify_init")
check(libc.inotify_add_watch(watch, path.encode(), IN_MODIFY), "inotify_add_watch")
with open("/proc/sys/vm/drop_caches", "w") as f:
    f.write("2")

mnt_fd = os.open(mnt, os.O_RDONLY | os.O_DIRECTORY)
fd = check(libc.open_by_handle_at(mnt_fd, ctypes.byref(fh), os.O_RDONLY | os.O_DIRECTORY),
           "open_by_handle_at")
got = os.readlink(f"/proc/self/fd/{fd}")
if got != path:
    sys.exit(f"open_by_handle_at opened {got}")
EOF
    done

    fuse_unmount $dev
}

main "$@"
