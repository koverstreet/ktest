#!/usr/bin/env bash

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/../fstests.sh

require-kernel-config FUSE_FS

export MKFS_OPTIONS=
export FSTYP=fuseblk.bcachefs
#export FUSE_SUBTYP=.bcachefs

run_tests()
{
    # generic/409,generic/410,generic/411,generic/589: shared subtree tests
    #   mount the same device a second time; the kernel hands back the existing
    #   superblock, but a second fuse daemon can't open a device the first holds
    run_fstests -e generic/409,generic/410,generic/411,generic/589 "$@"
}

main "$@"

