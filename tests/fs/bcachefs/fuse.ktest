#!/usr/bin/env bash

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/../fstests.sh

require-kernel-config FUSE_FS

export MKFS_OPTIONS=
export FSTYP=fuseblk.bcachefs
#export FUSE_SUBTYP=.bcachefs

run_tests()
{
    run_fstests "$@"
}

main "$@"

