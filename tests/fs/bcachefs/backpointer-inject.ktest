#!/usr/bin/env bash
#
# Backpointer corruption injection: the fsck contract for alloc/backpointers.c
# - check_btree_backpointers, check_extents_to_backpointers and
# check_backpointers_to_extents.
#
# Backpointers are an index of the extents and btree nodes, by the bucket
# and sector they point to: positions dev:(sector << 16 | suboffset), so a
# bucket's are one range. They're checked by count, not one by one:
# check_extents_to_backpointers first sums each bucket's backpointers (of
# the bucket's gen) against its alloc key's sector counts -
#   - more than the alloc key: the bucket's backpointers are checked
#     against what they point to - a bad one is backpointer_to_missing_ptr
#   - fewer: the bucket goes on a list the extents and btree node walk
#     recreates missing backpointers for - ptr_to_missing_backpointer
# so a backpointer wrong in a way that leaves its bucket's sum alone is only
# found by check_backpointers_to_extents, which runs only when asked for.
# check_btree_backpointers checks every backpointer has a device and an
# alloc key.
#
# Injected with `bcachefs kvdb --rw -r` (no triggers) on the unmounted
# filesystem: deleting backpointers, copying them to other positions -
# another sector in the bucket, another bucket, another device - and
# editing what they point to. Validation errors (backpointer_level_bad,
# backpointer_dev_bad) can't be injected: kvdb's writes are validated.
#
# Not here yet: missing stripe_backpointers, for which an extent has to have
# an erasure coded pointer to a removed device; and check_bp_dup()'s
# repairs, two extents pointing at the same space.
#
# fsck contract per test (as alloc-inject.ktest): fsck -y must detect (exit
# != 0) and report each expected error; a second fsck -n must run clean;
# file data must survive.
#
# No bcachefs_test_end_checks: these tests intentionally stamp error
# counters.

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G

MANIFEST=/tmp/backpointer-inject-manifest

# The filesystem's devices, set by setup_fs
FS_DEVS=()

kvdb()
{
    bcachefs kvdb "${FS_DEVS[@]}" "$@"
}

kvdb_rw()
{
    bcachefs kvdb --rw "${FS_DEVS[@]}" "$@"
}

fill_fs()
{
    mount -t bcachefs $(join_by : "${FS_DEVS[@]}") /mnt

    for i in $(seq 0 9); do
	dd if=/dev/urandom of=/mnt/data-$i bs=1M count=4 oflag=direct
    done
    (cd /mnt && md5sum data-*) > $MANIFEST

    umount /mnt
}

# setup_fs <nr devices> [format options]: format the first @nr scratch
# devices, with data
setup_fs()
{
    local nr=$1; shift

    FS_DEVS=("${ktest_scratch_dev[@]:0:$nr}")
    run_quiet "" bcachefs format -f "$@" "${FS_DEVS[@]}"
    fill_fs
}

# Writethrough: data written to a durability=0 device is cached there
setup_cached_fs()
{
    FS_DEVS=("${ktest_scratch_dev[@]:0:2}")
    run_quiet "" bcachefs format -f			\
	--durability=0 --label=ssd ${FS_DEVS[0]}	\
	--durability=1 --label=hdd ${FS_DEVS[1]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd
    fill_fs
}

# first_bp <btree> <data type>: the first backpointer on device 0 of that
# data type, as "position sector bucket suboffset": its position, the sector
# it's for, and where that is in its bucket
first_bp()
{
    local keys=$(kvdb -c "list $1 0:0 1:0")
    awk -v t="$2" '$0 ~ "type backpointer 0:" && $0 ~ "data_type=" t " " {
		split($5, p, ":")
		for (i = 1; i <= NF; i++)
			if ($i ~ /^bucket=/) { split(substr($i, 8), b, ":") }
		print p[1] ":" p[2], int(p[2] / 65536), b[2], b[3]
		exit
	}' <<< "$keys"
}

# Device 0's bucket size in sectors, from backpointer @1 (first_bp's output)
bucket_sectors()
{
    local pos sector bucket sub
    read -r pos sector bucket sub <<< "$1"
    echo $(( (sector - sub) / bucket ))
}

# A free bucket on device 0 with no alloc key: in the first freespace
# extent, a bucket the alloc btree has nothing for
hole_bucket()
{
    local keys=$(kvdb -c 'list -k freespace') end len
    read -r end len < <(sed -n '/type set 0:/{s/.*type set 0:\([0-9]*\):0 len \([0-9]*\).*/\1 \2/p;q}' <<< "$keys")
    [[ -n $end ]] || return 1

    local start=$((end - len))
    keys=$(kvdb -c "list -k alloc 0:$start 0:$end")
    local present=$(sed -n 's/.*type alloc_v4 0:\([0-9]*\):0.*/\1/p' <<< "$keys")

    local b
    for ((b = start + 1; b < end; b++)); do
	if ! grep -qx $b <<< "$present"; then
	    echo $b
	    return
	fi
    done
    return 1
}

# fsck_finds <fsck options> -- <error name>...: fsck -y with @options finds
# and reports each
fsck_finds()
{
    local opts=() rc=0 out errname
    while [[ $1 != -- ]]; do opts+=("$1"); shift; done
    shift

    out=$(bcachefs fsck -y "${opts[@]}" "${FS_DEVS[@]}" 2>&1) || rc=$?
    echo "$out"
    echo "fsck -y ${opts[*]} exited $rc"

    if (( rc == 0 )); then
	echo "TEST FAILED: fsck missed injected corruption"
	exit 1
    fi

    for errname in "$@"; do
	if ! grep -q "$errname" <<< "$out"; then
	    echo "TEST FAILED: fsck errored but never reported $errname"
	    exit 1
	fi
    done
}

# fsck -n is clean and the data is intact
check_clean()
{
    local rc=0

    bcachefs fsck -n "${FS_DEVS[@]}" || rc=$?
    echo "fsck -n exited $rc"

    if (( rc != 0 )); then
	echo "TEST FAILED: errors remain after fsck -y"
	exit 1
    fi

    mount -t bcachefs $(join_by : "${FS_DEVS[@]}") /mnt
    (cd /mnt && md5sum -c $MANIFEST)
    umount /mnt
}

# check_fsck_bp <error name>...: fsck -y finds and reports each, then fsck -n
# is clean and the data is intact
check_fsck_bp()
{
    fsck_finds -- "$@"
    check_clean
}

# ── missing backpointers: check_extents_to_backpointers ──────────────────

test_btree_node_bp_missing()
{
    setup_fs 1

    local bp=($(first_bp backpointers btree))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "set -r backpointers ${bp[0]} deleted"

    check_fsck_bp ptr_to_missing_backpointer
}

test_user_bp_missing()
{
    setup_fs 1

    local bp=($(first_bp backpointers user))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "set -r backpointers ${bp[0]} deleted"

    check_fsck_bp ptr_to_missing_backpointer
}

test_cached_bp_missing()
{
    setup_cached_fs

    local bp=($(first_bp backpointers cached))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "set -r backpointers ${bp[0]} deleted"

    check_fsck_bp ptr_to_missing_backpointer
}

# ── backpointers to what isn't there ─────────────────────────────────────

# A user data backpointer copied to another sector of its bucket: the
# bucket's backpointers add up to more than its alloc key says, and the copy
# points to an extent that doesn't point back
test_bp_extra_in_bucket()
{
    setup_fs 1

    local bp=($(first_bp backpointers user))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "copy -r backpointers ${bp[0]} 0:$(( (bp[1] + 1) << 16 ))"

    check_fsck_bp backpointer_to_missing_ptr
}

test_bp_missing_dev()
{
    setup_fs 1

    local bp=($(first_bp backpointers user))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "copy -r backpointers ${bp[0]} 5:${bp[0]#0:}"

    check_fsck_bp backpointer_to_missing_device
}

# A backpointer in a bucket with no alloc key
test_bp_missing_alloc()
{
    setup_fs 1

    local bp=($(first_bp backpointers user))
    [[ -n ${bp[*]} ]]
    local b=$(hole_bucket)
    [[ -n $b ]]

    kvdb_rw -c "copy -r backpointers ${bp[0]} 0:$(( (b * $(bucket_sectors "${bp[*]}")) << 16 ))"

    check_fsck_bp backpointer_to_missing_alloc
}

# A btree node backpointer pointing at another btree: its bucket's sum is
# unchanged, so the default passes don't look - check_backpointers_to_extents
# does, and deletes it; the node's backpointer is then missing, which the
# next full fsck recreates
test_bp_wrong_target()
{
    setup_fs 1

    local bp=($(first_bp backpointers btree))
    [[ -n ${bp[*]} ]]

    kvdb_rw -c "update -r backpointers ${bp[0]} btree_id=5"

    bcachefs fsck -n "${FS_DEVS[@]}"

    fsck_finds -o recovery_passes=check_backpointers_to_extents -- backpointer_to_missing_ptr
    fsck_finds -- ptr_to_missing_backpointer
    check_clean
}

# A stripe backpointer - an erasure coded pointer's, whose device was
# removed - to an extent that isn't there. Its position is synthetic: dev
# (stripe idx << 8) | block. Only check_backpointers_to_extents looks; its
# delete has to go to stripe_backpointers, not backpointers, or it's
# reported again on every run.
test_stripe_bp_dangling()
{
    setup_fs 1

    kvdb_rw -c "set -r stripe_backpointers $(( 2 << 8 )):$(( 4096 << 16 )) backpointer \
		btree_id=0 level=0 data_type=7 bucket_len=8 pos.inode=4096 pos.offset=8 \
		flags.erasure_coded=1 flags.stripe_ptr=1"

    fsck_finds -o recovery_passes=check_backpointers_to_extents -- backpointer_to_missing_ptr

    local rc=0
    bcachefs fsck -n -o recovery_passes=check_backpointers_to_extents "${FS_DEVS[@]}" || rc=$?
    if (( rc != 0 )); then
	echo "TEST FAILED: stripe backpointer still there after fsck -y"
	exit 1
    fi

    check_clean
}

main "$@"
