#!/usr/bin/env bash

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

require-kernel-config BCACHEFS_ERASURE_CODING

config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G

test_ec_small()
{
    set_watchdog 60

    bcachefs_antagonist

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    #enable_memory_faults
    dd if=/dev/zero of=/mnt/foo bs=1M count=1 oflag=sync
    #disable_memory_faults

    bcachefs scrub /mnt

    mount -o remount,ro /mnt
    bcachefs fs usage /mnt
    df -h /mnt
    umount /mnt

    bcachefs fsck -n "${ktest_scratch_dev[@]}"

    # test remount:
    echo "Testing remount"
    mount -t bcachefs -o fsck $devs /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_umount()
{
    set_watchdog 180

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    for i in $(seq 1 10); do
	mount -t bcachefs $devs /mnt
	dd if=/dev/zero of=/mnt/foo bs=8M count=128
	sync
	umount /mnt
    done

    mount -t bcachefs $devs /mnt
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    # Test is too short for this to be meaningful:
    bcachefs reset-counters --counters=trans_restart_would_deadlock ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=data_update_key_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# GH #1212 (daniron26): 248 bcachefs_ec_create workers wedged in
# bch2_journal_res_get_slowpath during unmount. The superblock is never
# released, no subsequent mount is possible, and the only recovery is
# trigger_emergency_read_only or a reboot.
#
# test_ec_umount() above cannot catch this, for two reasons: it syncs before
# unmounting, so every stripe create has already completed, and dd has exited,
# so nothing is still producing stripes. The reported hang needs a BACKGROUND
# producer still running at shutdown - reconcile converting to EC.
#
# Candidate mechanism (from reading, not yet confirmed by a run):
#   __bch2_fs_read_only() calls bch2_fs_ec_stop() then bch2_fs_ec_flush().
#   ec_stop walks stripe_head_list and cancels h->s; flush waits on
#   stripe_new_list. A stripe already detached from its head and handed to the
#   create workqueue is on the second list and unreachable from the first, so
#   flush waits for a create that stop could not cancel. The create commits at
#   the bottom watermark with no_check_rw, so journal pressure refuses it with
#   journal_full - operation_blocked class, which sustains an unbounded wait.
#
# The umount is bounded on purpose: if it really wedges, an unguarded umount
# burns the watchdog and takes the rest of the run with it.

# Locate the sysfs dir, and fail loudly if the files we gate on aren't there.
# The first version globbed /sys/fs/bcachefs/*/new_stripes - new_stripes is in
# the internal/ group, so that read a nonexistent path, returned empty, and was
# indistinguishable from "no stripes in flight". A broken probe fails in the
# direction that looks like a clean negative, so it has to be checked, not read.
ec_sysfs_dir()
{
    local d

    for d in /sys/fs/bcachefs/*/; do
	if [[ -e $d/reconcile_status && -e $d/internal/new_stripes ]]; then
	    echo "${d%/}"
	    return 0
	fi
    done
    return 1
}

# Two facts have to hold when umount starts, or an iteration proves nothing.
# Neither is implied by "pending reconcile is nonzero", which is what the first
# version of this test checked - that counts work QUEUED, not work IN FLIGHT.
#
#   reconcile_status  reconcile is running, rather than parked in the io_clock
#                     wait. "waiting:" is that park, and is #347's symptom.
#   new_stripes       something is listed under "in flight:", i.e. present on
#                     stripe_new_list. That list is what bch2_fs_ec_flush()
#                     waits on, and per #348 the wait is MAX_SCHEDULE_TIMEOUT
#                     with no shutdown escape - so it is the state that wedges.
ec_umount_armed()
{
    local sysfs status stripes

    sysfs="$1"
    status="$(cat "$sysfs/reconcile_status" 2>/dev/null || true)"
    stripes="$(cat "$sysfs/internal/new_stripes" 2>/dev/null || true)"

    if [[ -z $status ]]; then
	return 1
    fi
    if [[ $status == waiting:* ]]; then
	return 1
    fi

    [[ -n "$(sed -n '/^in flight:/,$p' <<<"$stripes" | tail -n +2)" ]]
}

# Everything we need to tell the two "reconcile is asleep" cases apart:
# asleep with a backlog (#347) vs asleep because the conversion finished.
ec_dump_state()
{
    local sysfs="$1"

    echo "--- reconcile_status ---"
    cat "$sysfs/reconcile_status" || true
    echo "--- reconcile_scan_pending ---"
    cat "$sysfs/reconcile_scan_pending" || true
    echo "--- internal/new_stripes ---"
    cat "$sysfs/internal/new_stripes" || true
    echo "--- pending reconcile work ---"
    bcachefs fs usage -h /mnt 2>&1 | grep -iE 'pending|stripe|erasure' || true
}

# Reconcile parks on the io clock, and the io clock only advances on write IO.
# In the previous version the only writer was a dd that had already exited, so
# once reconcile parked nothing could advance the clock except reconcile itself
# - it ended up waiting on traffic only it would have generated. daniron26's
# filesystem was taking GB of writes throughout. So the load has to be
# sustained for the whole iteration, not a burst that finishes first.
# setsid so the writer is a process group leader: killing the shell that runs
# the loop does NOT kill the dd it is currently blocked in, and a surviving dd
# holds /mnt open, so umount returns EBUSY at once. That looked exactly like a
# wedge in the first run - "770 D dd balance_dirty_pages_ratelimited_flags" in
# the D-state dump was the whole story. Kill the group, not the shell.
# Sets $ec_writer_pid rather than echoing it, and sends the child's output to
# /dev/null. Both matter: `writer="$(start)"` deadlocks, because the setsid'd
# writer inherits the command substitution's stdout and the substitution blocks
# until every holder of that pipe exits - which this loop never does. Cost me a
# 40-minute run that sat on "=== iteration 1 ===" and burned the watchdog.
ec_background_writer_start()
{
    setsid bash -c '
	i=0
	while true; do
	    dd if=/dev/zero of="/mnt/bg.$((i % 4))" bs=1M count=256 2>/dev/null || break
	    i=$((i + 1))
	done' >/dev/null 2>&1 &
    ec_writer_pid=$!
}

# Which processes hold a path under $1? Straight out of procfs, because fuser
# and lsof are not guaranteed present in the test image - and a missing probe
# reports "nothing holds it", which is the same shape of silent false negative
# that made the previous run claim a wedge.
ec_path_holders()
{
    local dir="$1" p link target

    for p in /proc/[0-9]*; do
	for link in "$p"/cwd "$p"/fd/*; do
	    target="$(readlink "$link" 2>/dev/null)" || continue
	    if [[ $target == "$dir" || $target == "$dir"/* ]]; then
		echo "${p#/proc/} $(cat "$p/comm" 2>/dev/null) -> $target"
		continue 2
	    fi
	done
    done
}

ec_background_writer_stop()
{
    local writer="$1" waited=0 holders

    kill -- -"$writer" 2>/dev/null || true
    wait "$writer" 2>/dev/null || true

    # Don't take the kill's word for it: anything still holding /mnt makes the
    # umount below fail for a reason that has nothing to do with GH #1212.
    while true; do
	holders="$(ec_path_holders /mnt)"
	if [[ -z $holders ]]; then
	    return 0
	fi
	if (( waited >= 30 )); then
	    echo "WARNING: /mnt still held after ${waited}s:"
	    echo "$holders"
	    return 1
	fi
	sleep 1
	waited=$((waited + 1))
    done
}

test_ec_umount_reconcile_inflight()
{
    set_watchdog 2700

    local devs sysfs rc=0 armed=0 i waited
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    for i in $(seq 1 6); do
	echo "=== iteration $i ==="

	# Format every iteration: the conversion backlog is the whole point,
	# and after the first pass the previous run's extents are already
	# striped, so every later iteration would start with nothing to do.
	run_quiet "" bcachefs format -f		\
	    --replicas=2			\
	    "${ktest_scratch_dev[@]}"
	mount -t bcachefs $devs /mnt

	if ! sysfs="$(ec_sysfs_dir)"; then
	    echo "FAILED: no sysfs dir with both reconcile_status and"
	    echo "internal/new_stripes - the test cannot observe its own"
	    echo "precondition, so it cannot report a negative"
	    umount /mnt
	    return 1
	fi

	# A working set written WITHOUT erasure coding...
	dd if=/dev/zero of=/mnt/bulk bs=1M count=2048 2>/dev/null
	sync

	# ...so turning EC on hands reconcile a whole-filesystem conversion
	# backlog. This is the field condition - daniron26 was converting to
	# EC 4+1 and evacuating a device.
	# On the mountpoint, not the devices: set-fs-option opens devices
	# exclusively, so passing them while mounted is EBUSY.
	bcachefs set-fs-option --erasure_code /mnt

	# Sustained load for the rest of the iteration: keeps the io clock
	# advancing so reconcile can't park, and keeps stripes forming.
	ec_background_writer_start

	waited=0
	while ! ec_umount_armed "$sysfs"; do
	    if (( waited >= 120 )); then
		break
	    fi
	    sleep 1
	    waited=$((waited + 1))
	done

	echo "--- state with writer running, after ${waited}s ---"
	ec_dump_state "$sysfs"

	if ! ec_umount_armed "$sysfs"; then
	    echo "NOT ARMED after ${waited}s: reconcile idle, or nothing on"
	    echo "stripe_new_list. This iteration tests nothing."
	    ec_background_writer_stop "$ec_writer_pid" || true
	    umount /mnt
	    continue
	fi

	armed=$((armed + 1))
	echo "armed after ${waited}s (reconcile running, stripe in flight)"

	# The writer holds files open, so it has to go before umount can
	# proceed at all. Re-dump after: if stopping it drains stripe_new_list
	# before umount starts, that's the thing to see, not to guess at.
	if ! ec_background_writer_stop "$ec_writer_pid"; then
	    echo "FAILED: writer outlived the kill and still holds /mnt - any"
	    echo "umount failure below would be EBUSY, not GH #1212"
	    return 1
	fi

	echo "--- state after writer stopped, entering umount ---"
	ec_dump_state "$sysfs"

	# timeout(1) returns 124 only when it actually timed out; any other
	# nonzero is umount's own status. Conflating them is how the previous
	# run reported "did not complete in 240s - candidate GH #1212 repro"
	# for an EBUSY that came back in milliseconds.
	urc=0
	timeout 240 umount /mnt || urc=$?

	if (( urc != 0 && urc != 124 )); then
	    echo "FAILED: umount returned $urc, not a timeout - test bug, not a wedge"
	    echo "holders of /mnt:"
	    ec_path_holders /mnt
	    return 1
	fi

	if (( urc == 124 )); then
	    echo "ERROR: umount did not complete in 240s - candidate GH #1212 repro"
	    echo "--- tasks in D state ---"
	    ps -eo pid,stat,comm,wchan:32 | grep -E '^\s*[0-9]+\s+D' || true
	    echo "--- bcachefs kernel threads/workers ---"
	    ps -eo pid,stat,comm,wchan:32 | grep -iE 'bcachefs|ec_create' || true
	    echo "--- did the journal complain? ---"
	    dmesg | grep -i 'journal stuck' || echo "  (no 'Journal stuck?' in dmesg)"
	    echo "--- stacks of blocked tasks ---"
	    echo w > /proc/sysrq-trigger || true
	    rc=1
	    break
	fi
    done

    if [[ $rc != 0 ]]; then
	echo "FAILED: unmount wedged with reconcile EC work in flight"
	return 1
    fi

    # Never arming means the workload is wrong, not that the bug is absent.
    # Failing here is the point: a green result that tested nothing is worse
    # than a red one.
    if (( armed == 0 )); then
	echo "FAILED: no iteration reached the precondition - workload does not"
	echo "set up the state GH #1212 needs, so this run proves nothing"
	return 1
    fi

    echo "umount completed on all $armed armed iteration(s) of $i - not reproduced"
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
}

do_ec_test()
{
    set_watchdog 240

    bcachefs_antagonist

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	"$@"					\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    #enable_memory_faults

    run_fio_randrw

    #disable_memory_faults

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt
    bcachefs fsck -n "${ktest_scratch_dev[@]}"

    # test remount:
    echo "Testing remount"
    mount -t bcachefs -o fsck $devs /mnt
    cat /mnt/fiotest > /dev/null
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec()
{
    do_ec_test
}

test_ec_lz4()
{
    do_ec_test --compression=lz4
}

test_ec_crypto()
{
    do_ec_test --encrypted --no_passphrase
}

test_ec_crypto_lz4()
{
    do_ec_test --encrypted --no_passphrase --compression=lz4
}

# Encrypted, erasure-coded data that has moved from foreground_target to
# background_target - koverstreet/bcachefs-tools#1056: once striped, scrub and
# reads reported nearly all of it corrupt, with "got 00000000" for every stripe
# block, and after a reboot it all read back fine. That looks like a stripe
# buffer that was never filled rather than bad data on disk.
#
# Random data, not zeroes: a read path that hands back an unfilled (zeroed)
# buffer without catching it would otherwise pass the md5 check.
test_ec_crypto_background_target_scrub_before_remount()
{
    set_watchdog 360

    run_quiet "" bcachefs format -f			\
	--encrypted --no_passphrase			\
	--erasure_code					\
	--replicas=2					\
	--bucket_size=256k				\
	--label=ssd.ssd0 ${ktest_scratch_dev[0]}	\
	--label=ssd.ssd1 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd0 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[3]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[4]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    dd if=/dev/urandom of=/mnt/ec-background-file bs=1M count=256 oflag=direct status=progress
    md5sum /mnt/ec-background-file > /root/ec-background-file.md5

    for i in $(seq 1 120); do
	bcachefs list -b extents "${ktest_scratch_dev[@]}" > /tmp/ec-background-extents
	if grep -q stripe_ptr /tmp/ec-background-extents; then
	    break
	fi
	sleep 1
    done

    bcachefs fs usage -h /mnt

    bcachefs list -b extents "${ktest_scratch_dev[@]}" > /tmp/ec-background-extents
    if ! grep -q stripe_ptr /tmp/ec-background-extents; then
	echo "expected extents to move to erasure-coded background target"
	exit 1
    fi

    bcachefs scrub /mnt
    echo 3 > /proc/sys/vm/drop_caches
    md5sum -c /root/ec-background-file.md5

    umount /mnt

    mount -t bcachefs $devs /mnt
    bcachefs scrub /mnt
    echo 3 > /proc/sys/vm/drop_caches
    md5sum -c /root/ec-background-file.md5
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_mixed_tiers()
{
    set_watchdog 240

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--compression=lz4			\
	--replicas=2				\
	--label dup				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	--label tri				\
	${ktest_scratch_dev[2]}			\
	${ktest_scratch_dev[3]}			\
	${ktest_scratch_dev[4]}			\
	--foreground_target=dup			\
	--promote_target=dup			\
	--background_target=tri

    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    #enable_memory_faults
    run_fio_randrw
    #dd if=/dev/zero of=/mnt/foo bs=1M count=100 oflag=direct
    #disable_memory_faults

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt

    # test remount:
    echo "Testing remount"
    mount -t bcachefs -o fsck $devs /mnt
    umount /mnt

    # background_target=tri, so every stripe should carry the tri label
    check_bcachefs_stripe_labels "${ktest_scratch_dev[@]}"

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# The same labelling question as test_ec_mixed_tiers, but asked of copygc
# rather than of reconcile.
#
# It has to be asked separately because the two form stripes by different
# routes and only reconcile was ever getting it right: reconcile sets
# data_opts->target from the extent's background_target, copygc left it at 0,
# and a stripe created under target 0 gets disk_label 0 - no label, i.e. every
# device in the filesystem, stamped into the stripe key for good. Reported by
# i7920c0, whose unlabelled stripes kept widening back onto his flash tier.
#
# A short fio run doesn't reach this at all. test_ec_mixed_tiers finishes with
# thousands of stripes and every one of them labelled, because none of them
# came from copygc - so this churns the tri tier until copygc has real work,
# and checks that it did some before believing the result.
test_ec_copygc_labels()
{
    set_watchdog 1800

    # Deliberately NOT filling the device, which is how the single-tier
    # copygc tests generate fragmentation. copygc frees a bucket by moving
    # what's still live in it somewhere else, so at ENOSPC it has nowhere to
    # go and the run turns into a test of the allocator under pressure
    # instead of a test of what copygc stamps on a stripe. Churn gives the
    # same fragmentation with somewhere to move to.
    #
    # 256k buckets rather than the small ones copygc_torture uses: partial
    # death is what puts a bucket on the fragmentation LRU, and a bucket only
    # dies partially if it holds several extents.
    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--bucket_size=256k			\
	--label dup				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	--label tri				\
	${ktest_scratch_dev[2]}			\
	${ktest_scratch_dev[3]}			\
	${ktest_scratch_dev[4]}			\
	--foreground_target=dup			\
	--promote_target=dup			\
	--background_target=tri

    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    # ~4G against a 12G tri tier: enough stripes to be worth checking, and
    # room left over for copygc to evacuate into.
    dd if=/dev/urandom of=/mnt/fiotest bs=16M count=256 oflag=direct
    sync

    # Now orphan it, repeatedly. Every rewritten extent lands on dup and gets
    # reconciled down to tri as a new stripe block, while the copy it replaced
    # dies where it already sat on tri - so tri buckets go part-live and onto
    # the fragmentation LRU, which is exactly the state that has copygc
    # forming stripes. Truncating as well keeps the file from being rewritten
    # in place forever.
    local i
    for i in $(seq 0 $((($ktest_priority + 1) * 3))); do
	run_fio_base				\
	    --buffer_compress_percentage=50	\
						\
	    --name=randwrite			\
	    --stonewall				\
	    --rw=randwrite			\
	    --bsrange=4k-128k			\
	    --runtime=30			\
	    --time_based

	truncate --size=$(($(stat -c '%s' /mnt/fiotest) - 16777216)) /mnt/fiotest

	# Per round, so that a run which ends at zero shows whether copygc
	# never started or stalled partway - and no grep, because grep exits 1
	# on no match and everything here is under set -e.
	echo "round $i: evacuate_bucket $(awk '/since mount/ {print $3}' \
		/sys/fs/bcachefs/*/counters/evacuate_bucket)"
    done

    sync
    bcachefs fs usage -h /mnt

    # The denominator. Zero unlabelled stripes means nothing if copygc never
    # created one - which is exactly how this bug survived the existing EC
    # tests - so establish that it moved something before reading the result.
    #
    # The counter is read via a path that has to be checked rather than
    # assumed: an unexpanded glob makes awk print nothing, `local` swallows
    # its exit status, and an empty $moved then reads as 0 in the arithmetic
    # below - so "copygc did nothing" and "I couldn't measure copygc" would
    # come out as the same failure with the same wrong message.
    local counter=$(echo /sys/fs/bcachefs/*/counters/evacuate_bucket)
    if [[ ! -r $counter ]]; then
	echo "no evacuate_bucket counter at $counter - can't tell whether"
	echo "copygc ran, so this run proves nothing either way."
	false
    fi

    local moved=$(awk '/since mount/ {print $3}' "$counter")
    if (( moved == 0 )); then
	echo "copygc never evacuated a bucket - the fs didn't get fragmented,"
	echo "so this run says nothing about the stripes copygc creates."
	false
    fi
    echo "copygc evacuated $moved buckets"

    umount /mnt

    check_bcachefs_stripe_labels "${ktest_scratch_dev[@]}"

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# EC + tiering + evacuate: does taking a device out of the background tier
# produce stripes with no label?
#
# This is the case the field report was actually about, and it has a sharp
# expected outcome because of the device counts. tri holds three devices and
# redundancy is 1, so a stripe needs three failure domains. Evacuate one tri
# device and only two are left:
#
#   asking for the tri label  -> insufficient devs, no stripe head, the write
#                                falls back to replicas inside tri. Correct.
#   asking for target 0       -> disk_label 0, whose device set is every rw
#                                device in the filesystem - so a stripe CAN
#                                form, by spanning tri AND the flash.
#
# The second is i7920c0's report almost verbatim ("label=none stripes widened
# into the flash again"), which makes this a positive control rather than only
# a regression test: it should go red on a kernel without the movers-set-target
# fix and green with it.
#
# The labels are checked on both sides of the evacuate with the same
# instrument. Without the before-check, an unlabelled stripe at the end has
# two explanations - the evacuate made it, or the workload did - and no way to
# tell them apart.
test_ec_evacuate_tiered()
{
    set_watchdog 900

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--label dup				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	--label tri				\
	${ktest_scratch_dev[2]}			\
	${ktest_scratch_dev[3]}			\
	${ktest_scratch_dev[4]}			\
	--foreground_target=dup			\
	--promote_target=dup			\
	--background_target=tri

    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    dd if=/dev/urandom of=/mnt/fiotest bs=16M count=128 oflag=direct
    sync
    bcachefs fs usage -h /mnt
    umount /mnt

    echo "=== before the evacuate: reconcile's stripes should all be labelled"
    check_bcachefs_stripe_labels "${ktest_scratch_dev[@]}"

    mount -t bcachefs $devs /mnt

    echo "=== evacuating ${ktest_scratch_dev[2]}, a tri device"
    bcachefs device evacuate ${ktest_scratch_dev[2]}

    bcachefs fs usage -h /mnt
    umount /mnt

    echo "=== after the evacuate: anything unlabelled here came from it"
    check_bcachefs_stripe_labels "${ktest_scratch_dev[@]}"

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_writethrough()
{
    set_watchdog 240

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--nocow					\
	--replicas=2				\
	--label fast				\
	${ktest_scratch_dev[0]}			\
	--label slow				\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}			\
	${ktest_scratch_dev[3]}			\
	${ktest_scratch_dev[4]}			\
	--foreground_target=fast		\
	--promote_target=slow			\
	--background_target=fast

    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    run_fio_randrw

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt

    # test remount:
    echo "Testing remount"
    mount -t bcachefs -o fsck $devs /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs reset-counters --counters=trans_restart_upgrade ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_gc()
{
    set_watchdog 2400

    local loops=$((($ktest_priority + 1) * 4))

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	--erasure_code				\
	"${ktest_scratch_dev[@]}"

    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    bcachefs_antagonist

    fill_device /mnt/fiotest

    # Writing with a small block size will increase the size of our metadata,
    # meaning we'll eventually see -ENOSPC even though ideally we shouldn't
    # since we're overwriting
    # When we do, truncate to free up some space and keep going:
    for i in $(seq 0 $loops); do
	run_fio_base				\
	    --name=randwrite			\
	    --stonewall				\
	    --rw=randwrite			\
	    --size=20G				\
	    --bsrange=4k-4k || true

	cur_size=$(stat -c '%s' /mnt/fiotest)
	new_size=$(($cur_size - 1048576))
	echo "truncating to $new_size"

	truncate --size=$new_size /mnt/fiotest
    done

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -n "${ktest_scratch_dev[@]}"

    # test remount:
    mount -t bcachefs $devs /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Stripe reuse, and with it ec_old_stripe_fold() - the continuation that folds
# a reused stripe's carried-forward blocks into the new stripe's buffers so
# parity at create covers them.
#
# Nothing else here reaches that path on purpose. Reuse only fires when a
# full-stripe allocation fails (__stripe_alloc_or_reuse), i.e. when there is no
# room left for a fresh stripe, and every other EC test in this file has space
# to spare. test_ec_gc does get there, but by filling 4G a device for tens of
# minutes; --fs_size reaches the same corner in half a minute.
#
# The churn has to actually starve the allocator, not merely leave the
# filesystem full: reuse is what happens when the nowait full-stripe attempt at
# BCH_WATERMARK_stripe can't get a bucket on every failure domain. A gentler
# version of this loop - 512M a device, 64M freed and 32M written a round -
# kept the filesystem at 90-odd percent and got zero reuses in ten rounds,
# which is a green light for the allocator and a useless test.
#
# And space starvation is the ONLY way in. The obvious alternative - take a
# device read-only so a stripe can't get a block in every failure domain -
# doesn't work: __bch2_ec_stripe_head_get() recomputes the width from the live
# rw set on every call (it watches rw_devs_change_count), so losing a domain
# just makes the next stripe narrower. The full-stripe attempt can fail for
# want of space; it can't fail for want of domains.
#
# That puts this test in the same corner where a small full EC filesystem
# wedges on journal_full (see the ktest task). Seen once, in one of three runs
# of this test; a probe running the same workload four times as hard saw it
# zero times in seven. So it's rare and not reproducible on demand - if this
# test times out, check the log for "Journal stuck" before assuming the fold
# broke.
#
# Reuse happening is the whole point, so a run where the counter stays at zero
# fails loudly rather than passing green - green would mean an empty path was
# exercised successfully.
test_ec_stripe_reuse()
{
    set_watchdog 600

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--fs_size=256M				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    # Read it once up front: a zero at the end has to mean "no reuse", not "the
    # counter moved or changed format", and those are the same empty string to
    # the awk below.
    local reuses=$(echo /sys/fs/bcachefs/*/counters/stripe_reuse)
    if [[ ! -r $reuses ]] ||
       [[ ! $(awk '/since mount/ {print $3}' "$reuses") =~ ^[0-9]+$ ]]; then
	echo "can't read a number out of $reuses - no way to tell whether a"
	echo "stripe was ever reused, so this test can't say anything."
	false
    fi

    fill_device /mnt/fiotest

    # Overwrites on a full COW filesystem need free space, so each round hands
    # some back first. Truncating is also what fragments the stripes: it frees
    # blocks out from under them, which is what puts them on the fragmentation
    # LRU that stripe_reuse() reads.
    local i nr=0
    for i in $(seq 1 10); do
	truncate --size=$(($(stat -c '%s' /mnt/fiotest) - 33554432)) /mnt/fiotest

	run_fio_base				\
	    --name=randwrite			\
	    --stonewall				\
	    --rw=randwrite			\
	    --bsrange=4k-128k			\
	    --runtime=15			\
	    --time_based || true

	nr=$(awk '/since mount/ {print $3}' "$reuses")
	echo "round $i: stripe_reuse $nr"

	if (( nr )); then
	    break
	fi
    done

    if (( ! nr )); then
	echo "no stripe was ever reused: the filesystem never got full enough"
	echo "for a full-stripe allocation to fail, so ec_old_stripe_fold()"
	echo "never ran and this run says nothing about it."
	false
    fi

    sync

    # "622 reuses and fsck is clean" only says the fold ran without erroring.
    # What it can't see is whether the fold swapped in the RIGHT data: parity is
    # generated at create over new_stripe.data[], and for a carried-forward
    # block that buffer is whatever ec_old_stripe_fold() put there. Wrong data
    # gives parity that doesn't describe the stripe, and parity is only ever
    # consulted for a block that can't be read directly - which nothing here
    # does.
    #
    # force_reconstruct_read makes every read of an ec extent take the
    # reconstruct path instead (bch2_bkey_pick_read_device()), so the same bytes
    # come back a second time through the parity the fold's data produced. No
    # device has to be removed and no oracle has to be authored: the direct read
    # is the oracle.
    #
    # It's a BCH_DEBUG_PARAMS_DEBUG() knob, so it only exists on a debug build.
    # Without it this arm would compare two identical direct reads, so skip it
    # and say so rather than pass green.
    local frr=/sys/module/bcachefs/parameters/force_reconstruct_read
    local retries=$(echo /sys/fs/bcachefs/*/counters/data_read_retry)
    if [[ -w $frr ]]; then
	local direct reconstructed before after
	if ! direct=$(set -o pipefail
		      dd if=/mnt/fiotest bs=1M count=64 iflag=direct status=none |
		      md5sum); then
	    echo "reading /mnt/fiotest failed before the reconstruct read even started"
	    false
	fi

	before=$(awk '/since mount/ {print $3}' "$retries")
	echo 1 > $frr
	reconstructed=$(set -o pipefail
			dd if=/mnt/fiotest bs=1M count=64 iflag=direct status=none |
			md5sum) || reconstructed="READ FAILED"
	echo 0 > $frr
	after=$(awk '/since mount/ {print $3}' "$retries")

	# Forced reconstruct is punted through bch2_rbio_retry(), which is what
	# bumps data_read_retry. If it didn't move, no read took the reconstruct
	# path - the flag didn't apply, or none of what we read was erasure
	# coded - and the comparison below is between two identical direct reads.
	if (( after == before )); then
	    echo "force_reconstruct_read was set but data_read_retry didn't move:"
	    echo "nothing was read through parity, so this arm proves nothing."
	    false
	fi

	if [[ $direct != $reconstructed ]]; then
	    echo "ERROR: reading through erasure coding parity does not return"
	    echo "the data that is on disk:"
	    echo "  direct:        $direct"
	    echo "  reconstructed: $reconstructed"
	    false
	fi

	echo "reconstruct read matches direct read, $((after - before)) reconstructs"
    else
	echo "no $frr - not a debug build, skipping the reconstruct-read check"
    fi

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# A reused stripe that can't be reconstructed records damage against what it
# couldn't read - and a block fails as a whole on one bad granule of its stripe
# checksum. Extents elsewhere in the block were read fine; their own checksums
# say so, and they mustn't be recorded as lost (ChH on #bcache: 26 files
# reported damaged, which read back fine).
#
# Every stripe gets the same 4k at the start of two of its data blocks
# corrupted: two failures, one redundancy, so a reuse of any of them can't
# reconstruct - and since both copies are bad at that offset, the file there is
# genuinely unreadable. Reuse only happens with the filesystem full (see
# test_ec_stripe_reuse), so fill it with small files, fragment every stripe by
# deleting half, and write until a reuse records damage. Then: every file
# recorded damaged has to actually fail to read.
test_ec_reuse_lost_blocks_per_extent()
{
    set_watchdog 600

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--bucket_size=256k			\
	--fs_size=256M				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt
    local i
    for ((i = 0; i < 100000; i++)); do
	dd if=/dev/urandom of=/mnt/f$i bs=64k count=1 2>/dev/null || break
    done
    local nr_files=$i
    echo "wrote $nr_files files"
    umount /mnt

    # Stripe keys print a header, then one line per block, data blocks first:
    #   vdc 1:42:0 gen 0#512    (name dev:bucket:offset, then sectors in use)
    # First 4k of the first two data blocks in use, in every stripe:
    local targets=$(bcachefs list -b stripes "${ktest_scratch_dev[0]}" |
	awk '/type stripe/ {
		split($0, h, "blocks "); split(h[2], b, ":")
		nr_data = b[1]; block = 0; picked = 0
		next
	     }
	     $2 ~ /^[0-9]+:[0-9]+:[0-9]+$/ {
		if (block++ >= nr_data || picked >= 2)
		    next
		split($2, p, ":"); split($4, u, "#")
		if (u[2] > 0) { print $1, p[2] * 512 + p[3]; picked++ }
	     }')
    local nr_targets=$(echo "$targets" | grep -c . || true)
    echo "corrupting $nr_targets blocks"
    (( nr_targets )) || { echo "FAIL: no stripe blocks found"; return 1; }

    local name sector
    while read name sector; do
	dd if=/dev/urandom of=/dev/$name bs=512 count=8 seek=$sector conv=notrunc 2>/dev/null
    done <<< "$targets"

    mount -t bcachefs $devs /mnt
    for ((i = 1; i < nr_files; i += 2)); do rm -f /mnt/f$i; done
    sync

    local round
    for ((round = 0; round < 50; round++)); do
	[[ -n $(bcachefs damage ls /mnt) ]] && break
	for ((i = 0; i < 200; i++)); do
	    dd if=/dev/urandom of=/mnt/n$round.$i bs=64k count=1 2>/dev/null || break
	done
	sync
    done

    # "name: error..." per damaged file
    local damaged=($(bcachefs damage ls /mnt | sed 's/:.*//'))
    echo "after $round rounds: ${#damaged[@]} files recorded damaged"
    (( ${#damaged[@]} )) ||
	{ echo "FAIL: no reuse ever hit a corrupted stripe - nothing tested"; return 1; }

    echo 3 > /proc/sys/vm/drop_caches
    local f good=0
    for f in "${damaged[@]}"; do
	f=/mnt/$f
	[[ -f $f ]] || { echo "FAIL: damage ls named $f, which doesn't exist"; return 1; }
	if cat "$f" > /dev/null 2>&1; then
	    echo "recorded damaged but reads fine: $f"
	    good=$((good + 1))
	fi
    done
    (( ! good )) || { echo "FAIL: $good of ${#damaged[@]} files recorded damaged read back fine"; return 1; }

    umount /mnt
}

do_remove_test()
{
    offline=$1
    evacuate=$2

    set_watchdog 240

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    bcachefs device resize-journal ${ktest_scratch_dev[0]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[1]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[2]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[3]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[4]} 512M

    local fioout="$ktest_out/fio-out"
    run_fio_randrw >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 1

    if [[ $offline = 1 ]]; then
	echo -n "offlining ${ktest_scratch_dev[0]}... "
	bcachefs device offline --force	${ktest_scratch_dev[0]}
	echo "done"
    fi

    if [[ $evacuate = 1 ]]; then
	echo -n "evacuating ${ktest_scratch_dev[0]}... "
	bcachefs device evacuate	${ktest_scratch_dev[0]}
	echo "done"
    fi

    echo -n "removing ${ktest_scratch_dev[0]}... "
    if [[ $evacuate = 1 ]]; then
	bcachefs device remove		${ktest_scratch_dev[0]}
    else
	bcachefs device remove --force	${ktest_scratch_dev[0]}
    fi
    echo "done"

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    bcachefs scrub /mnt
    umount /mnt

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[1]}
}

test_device_remove_offline()
{
    do_remove_test 1 0
}

test_device_remove_online()
{
    do_remove_test 0 0
}

test_device_evacuate_offline()
{
    do_remove_test 1 1
}

test_device_evacuate_online()
{
    do_remove_test 0 1
}

# Removing a device from a stripe doesn't delete the extents in its block:
# their pointer becomes BCH_SB_MEMBER_INVALID and they keep the stripe
# pointer, so reconstruct still serves them. Do it enough times and the
# stripe drops below nr_data, at which point every one of those extents is
# gone for good - and until "ec: record damage when forced removal kills a
# stripe" nothing said so. The stripe key names no inode and the extents
# aren't visited by that pass, so `damage ls` stayed empty and the user
# found out by opening a file.
#
# The removals are aimed rather than arbitrary: the geometry and the
# devices holding the blocks come from the stripe itself, so we take out
# nr_redundant + 1 of THAT stripe's devices.
#
# Reading the file back is the control. If it still reads then nothing was
# lost, an empty `damage ls` would be correct rather than a bug, and the
# run has said nothing - so the test reports that instead of passing.
# Stripe backpointers - one per stripe per block, at btree=stripes level=0 -
# are zero length, so a missing one never makes a bucket's backpointer sectors
# disagree with its sector counts: fsck used to be blind to them, and stripe
# reuse was deleting them (tools: 1.40 stripe_backpointer_idx). Delete every
# one of them and check that fsck finds and restores them all.
ec_stripe_bps()
{
    bcachefs kvdb -c "list backpointers POS_MIN SPOS_MAX" "${ktest_scratch_dev[@]}" |
	awk '$4 == "backpointer" && /btree=stripes level=0 /'
}

test_ec_stripe_backpointers_missing()
{
    ktest_expect_sb_errors="ptr_to_missing_backpointer"
    set_watchdog 180

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=64 oflag=direct
    sync
    umount /mnt

    local before=$(ec_stripe_bps | wc -l)
    if ((!before)); then
	echo "no stripe backpointers: no stripe formed, so this run tests nothing"
	false
    fi
    echo "deleting $before stripe backpointers"

    local inject=$(mktemp)
    ec_stripe_bps | awk '{print "set backpointers", $5, "deleted"}' > $inject
    bcachefs kvdb --rw "${ktest_scratch_dev[@]}" < $inject

    if [[ -n $(ec_stripe_bps) ]]; then
	echo "injection didn't take: stripe backpointers still present"
	false
    fi

    if bcachefs fsck -n "${ktest_scratch_dev[@]}"; then
	echo "ERROR: fsck -n passed with every stripe backpointer missing"
	false
    fi

    local ret=0
    bcachefs fsck -y "${ktest_scratch_dev[@]}" || ret=$?
    if ((ret != 1)); then
	echo "ERROR: fsck -y returned $ret, expected 1 (errors fixed)"
	false
    fi

    local after=$(ec_stripe_bps | wc -l)
    if ((after != before)); then
	echo "ERROR: $before stripe backpointers before, $after after repair"
	false
    fi

    bcachefs fsck -n "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_force_remove_records_damage()
{
    ktest_expect_sb_errors="data_lost_device_removed"
    ktest_expect_device_errors=1
    set_watchdog 300

    # Explicit bucket size so bcachefs_first_stripe_blocks has a real one to
    # convert block offsets with - ec.ktest doesn't otherwise define it.
    local bucket_kb=512

    # Metadata has to survive losing two devices - forced removal won't drop
    # the last copy of a btree node - while the 4+1 stripes' data doesn't:
    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--metadata_replicas=3			\
	--bucket_size=${bucket_kb}k		\
	"${ktest_scratch_dev[@]}"
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs "$devs" /mnt
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=64 oflag=direct
    sync
    umount /mnt

    local info=$(bcachefs list -b stripes "${ktest_scratch_dev[@]}" |
		 bcachefs_first_stripe_blocks $((bucket_kb * 2)))
    local nr_data=$(awk '/^meta/ {print $2}' <<<"$info")
    local nr_red=$(awk '/^meta/ {print $3}' <<<"$info")

    if [[ ! $nr_data =~ ^[0-9]+$ ]] || ((nr_red == 0)); then
	echo "no usable stripe: the workload never formed one, so this run says"
	echo "nothing about forced removal killing a stripe."
	bcachefs list -b stripes "${ktest_scratch_dev[@]}" | head
	return 1
    fi
    echo "stripe is ${nr_data}:${nr_red}; removing $((nr_red + 1)) of its devices"

    # Member index -> path: ktest_scratch_dev is in format order, which is
    # the order bcachefs assigned indices.
    local -a victims=()
    local idx
    for idx in $(awk '/^block/ {print $3}' <<<"$info" | sort -un); do
	victims+=("${ktest_scratch_dev[$idx]}")
	((${#victims[@]} > nr_red)) && break
    done

    if ((${#victims[@]} < nr_red + 1)); then
	echo "stripe spans only ${#victims[@]} devices, can't take it below nr_data"
	return 1
    fi

    # Without reconcile: it repairs the stripes after the first removal, and
    # the second then costs nothing.
    mount -t bcachefs -o noreconcile_enabled "$devs" /mnt

    if [[ -n $(bcachefs damage ls /mnt) ]]; then
	echo "ERROR: damage recorded before anything was removed"
	bcachefs damage ls /mnt
	return 1
    fi

    local dev
    for dev in "${victims[@]}"; do
	echo "removing $dev"
	bcachefs device remove --force "$dev"
    done

    echo "damage after the removals:"
    bcachefs damage ls /mnt

    # The control: the file has to actually be broken. cat succeeding means
    # the removals cost us nothing and there is nothing to record.
    if cat /mnt/testfile >/dev/null 2>&1; then
	echo "testfile still reads after $((nr_red + 1)) forced removals: no data"
	echo "was lost, so this run can't tell whether the loss gets recorded."
	umount /mnt
	return 1
    fi

    local ok=1
    bcachefs damage ls /mnt | grep -E "^testfile: .*data_lost_device_removed" >/dev/null || ok=0

    umount /mnt

    # Which half broke: an empty damage btree means nothing recorded, keys
    # with no ioctl output means the surface over them is wrong, and the
    # counters say whether the removal path saw the loss at all.
    if ((!ok)); then
	echo "ERROR: forced removal destroyed testfile and recorded no damage for it"
	echo "--- damage btree:"
	bcachefs kvdb "${ktest_scratch_dev[1]}" -c "list damage" || true
	echo "--- sb error counters:"
	bcachefs show-super -f errors "${ktest_scratch_dev[1]}" || true
	return 1
    fi

    bcachefs_test_end_checks ${ktest_scratch_dev[1]}
}

# Keep writing to an erasure-coded filesystem after losing a member -
# koverstreet/bcachefs-tools#1057: a 13+2 array with one disk pulled took
# writes for a while, then froze.
#
# Still open: with a member missing, EC writes block on stripe buffer memory
# that can't be freed (stripe_buf_mem_blocked) - the same wedge
# test_ec_stripe_buf_limit reaches with every member present. The timeout
# turns a freeze into a failure instead of a watchdog kill.
test_ec_degraded_continued_writes()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--data_replicas=3			\
	--metadata_replicas=3			\
	"${ktest_scratch_dev[@]}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    dd if=/dev/zero of=/mnt/pre-degraded bs=1M count=256 oflag=direct conv=fsync status=progress

    echo -n "offlining ${ktest_scratch_dev[0]}... "
    bcachefs device offline --force ${ktest_scratch_dev[0]}
    echo "done"

    timeout 120 bash -c '
	for i in $(seq 1 16); do
	    dd if=/dev/zero of=/mnt/degraded-write-$i bs=1M count=64 oflag=direct conv=fsync status=progress
	done
	sync
    '

    bcachefs fs usage -h /mnt
    bcachefs scrub /mnt
    umount /mnt

    mount -t bcachefs -o degraded "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[1]}
}

test_device_failed()
{
    set_watchdog 240

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    local fioout="$ktest_out/fio-out"
    run_fio_randrw >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 1

    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    bcachefs scrub /mnt
    umount /mnt

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_bucket_mismatch()
{
    # Reproduces phaeton's IRC report (2026-05-25): mkfs without EC,
    # device-add more disks at a different bucket_size, then enable EC +
    # raise replicas. EC requires uniform bucket size across the stripe;
    # mismatch caused a silent infinite reconcile_hipri loop with no
    # progress and unbounded journal growth.
    #
    # Pass conditions: reconcile makes progress (or completes), OR a
    # clear error is surfaced. Watchdog catches the infinite-loop bug.
    set_watchdog 240
    setup_tracing bcachefs:trans_restart_upgrade bcachefs:transaction_begin

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	--bucket_size=1M			\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs "${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}" /mnt

    dd if=/dev/zero of=/mnt/before bs=1M count=64 oflag=sync

    # Mismatched bucket size on the added devices — this is the situation
    # that breaks EC stripe formation.
    bcachefs device add -f --bucket_size=2M /mnt ${ktest_scratch_dev[2]}
    bcachefs device add -f --bucket_size=2M /mnt ${ktest_scratch_dev[3]}
    bcachefs device add -f --bucket_size=2M /mnt ${ktest_scratch_dev[4]}

    bcachefs set-fs-option --data_replicas=3 --erasure_code "${ktest_scratch_dev[@]}"

    # Drive EC stripe formation; reconcile should run.
    dd if=/dev/zero of=/mnt/after bs=1M count=128 oflag=sync
    sync

    # Give reconcile time to either make progress or fail clearly.
    # Watchdog will fire if it spins forever.
    sleep 30

    bcachefs fs usage -h /mnt

    bcachefs scrub /mnt
    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    # Test is too short for this to be meaningful:
    bcachefs reset-counters --counters=trans_restart_upgrade ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# GH #1182 (rkjnsn): the allocator wedges once ec_stripe_buf_limit binds, and
# stays wedged - drives idle, stripes on the in-flight list with no IO
# outstanding, copygc and the writeback flusher parked in the allocator with
# stripe_buf_mem_blocked.
#
# The cap can only be released by a stripe closing; a stripe closes when its
# data blocks fill; filling them needs writes; and the cap blocks writes. So
# waiting on it isn't a throttle, it's a cycle that can only be broken by the
# thing it prevents. The one-deep floor in bch2_ec_stripe_buf_init() (the
# `c->ec.stripe_buf_bytes &&` term, which always lets a stripe through from
# zero) doesn't help once every open stripe is half-filled.
#
# Whether that cycle closes is arithmetic, not timing, which is why he hit it
# and almost nobody else does. A stripe buffer costs bucket_size * nr_blocks -
# parity included - charged against totalram * ec_stripe_buf_limit%, so the
# budget is
#
#	cap / (bucket_size * nr_blocks)
#
# stripes for the whole filesystem. His 2 MiB buckets and 5+2 stripes are 14
# MiB apiece against 5% of 16 GB, so tens; smaller buckets and more memory give
# hundreds. Here, measured: 10 MiB a stripe (2 MiB buckets, 4+1) against a
# 38.9 MB cap, and the run wedges with three open and the fourth blocked. Same
# corner, reached in minutes rather than hours.
#
# The workload has to keep more than a couple of stripes open at once, so it
# churns rather than writing once. Reused stripes cost double - they carry an
# old buffer as well as a new one - but that is not what this test measures:
# nothing here was reused when it wedged (no old_stripe.cl line on any of the
# three), so the numbers above are the single-buffer floor.
#
# Both outcomes need checking. A wedge is stripe_create standing still while
# the buffer memory sits at the cap - stalling with the cap NOT pinned is some
# other bug and shouldn't be reported as this one. And a run where the cap
# never binds at all proves nothing whatsoever, so it fails loudly rather than
# passing green.
test_ec_stripe_buf_limit()
{
    set_watchdog 900

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--bucket_size=2M			\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs -o ec_stripe_buf_limit=1 $devs /mnt

    local new_stripes=$(echo /sys/fs/bcachefs/*/internal/new_stripes)
    local creates=$(echo /sys/fs/bcachefs/*/counters/stripe_create)
    if [[ ! -r $new_stripes || ! -r $creates ]]; then
	echo "missing $new_stripes or $creates - can't tell a wedge from a"
	echo "slow run, so this test can't say anything."
	false
    fi

    dd if=/dev/urandom of=/mnt/fiotest bs=16M count=64 oflag=direct
    sync

    # The wedge lands mid-fio, so the round loop below never reaches its own
    # sampling point once it hits - the first run of this test had to be poked
    # at over ssh, and the evidence died with the VM. This watcher samples
    # independently and captures the state to the log, which ktest copies out.
    #
    # It holds no fio child, so it can be reaped normally, and it exits on its
    # own after dumping.
    #
    # The three files are one join: new_stripes gives each stripe's outstanding
    # ref count and its bucket indices, open_buckets maps a bucket to its stripe
    # (ec idx) and says whether it's on the partial list, and write_op gives the
    # ops still holding buckets, with their age and error. That chain is what
    # answers "why isn't this stripe completing" - which is otherwise only
    # reachable by elimination.
    local async=$(echo /sys/kernel/debug/bcachefs/*/async_objs/write_op)
    (
	while :; do
	    local u=$(awk '/stripe buf memory/ {print $4}' "$new_stripes" 2>/dev/null)
	    if [[ $u = */* ]] &&
	       (( $(numfmt --from=iec ${u%/*}) * 100 >=
		  $(numfmt --from=iec ${u#*/}) * 90 )); then
		echo "=== stripe buf memory pinned at $u - capturing ==="
		echo "--- new_stripes ---";	cat "$new_stripes"	2>&1 || true
		echo "--- open_buckets ---";	cat /sys/fs/bcachefs/*/internal/open_buckets 2>&1 || true
		echo "--- write_op ---";	cat "$async"		2>&1 || true
		echo "=== end capture ==="
		break
	    fi
	    sleep 5
	done
    ) &
    local watcher=$!

    # "pinned" is at-or-above the cap, not equal to it: the limit is only tested
    # on entry and the second buffer of each pair is charged unconditionally, so
    # the wedged value overshoots.
    local pinned=0 stalled=0 prev=0 i
    for i in $(seq 1 20); do
	run_fio_base				\
	    --name=randwrite			\
	    --stonewall				\
	    --rw=randwrite			\
	    --bsrange=4k-128k			\
	    --runtime=30			\
	    --time_based || true

	truncate --size=$(($(stat -c '%s' /mnt/fiotest) - 16777216)) /mnt/fiotest

	local used=$(awk '/stripe buf memory/ {print $4}' "$new_stripes")
	local now=$(awk '/since mount/ {print $3}' "$creates")

	echo "round $i: stripe buf memory $used, stripe_create $now"

	[[ $used = */* ]] || continue
	if (( $(numfmt --from=iec ${used%/*}) * 100 >=
	      $(numfmt --from=iec ${used#*/}) * 90 )); then
	    pinned=1
	    if (( now == prev )); then
		stalled=$((stalled + 1))
	    else
		stalled=0
	    fi
	fi
	prev=$now

	(( stalled < 3 )) || break
    done

    kill $watcher 2>/dev/null || true
    wait $watcher 2>/dev/null || true

    if (( ! pinned )); then
	echo "stripe buffer memory never reached the cap - the workload never"
	echo "asked for more concurrent stripes than the limit allows, so this"
	echo "run says nothing about what happens when it binds."
	false
    fi

    if (( stalled >= 3 )); then
	echo "WEDGED: stripe_create stopped advancing with buffer memory at the cap"
	cat "$new_stripes"
	false
    fi

    sync
    bcachefs fs usage -h /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_crash_recovery()
{
    set_watchdog 600

    local loops=$((($ktest_priority + 1) * 20))

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    for i in $(seq 1 $loops); do
	echo "=== crash recovery iteration $i/$loops ==="

	mount -t bcachefs $devs /mnt

	fio --eta=always			\
	    --exitall_on_error=1		\
	    --randrepeat=0			\
	    --ioengine=libaio			\
	    --iodepth=64			\
	    --iodepth_batch=16			\
	    --direct=1				\
	    --numjobs=1				\
	    --filename=/mnt/fiotest		\
	    --filesize=3500M			\
	    --name=randwrite			\
	    --rw=randwrite			\
	    --bsrange=4k-8k			\
	    --runtime=2 || true

	$ktest_dir/tests/fs/xfstests/src/godown -f /mnt

	umount /mnt
    done

    mount -t bcachefs $devs /mnt
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_ec_repair_stripe_ptr()
{
    # Reproduce the "stripe pointer doesn't match stripe" inconsistency seen in
    # the field (d5cf3484) and exercise the erasure-coding repair path.
    #
    # Lay down erasure-coded data, then corrupt one extent's stripe pointer with
    # the test_inject_stripe_ptr_mismatch error injector (fs/debug/tests.rs): it
    # bumps a stripe_ptr entry's block index so bch2_ptr_matches_stripe() fails
    # against the (still-present) stripe. fsck must then repair the inconsistency
    # without going emergency read-only, and a second fsck must find it clean.
    #
    # Skips check_bcachefs_errors (like the other repair tests) since we record a
    # repairable error on purpose.
    set_watchdog 180

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    # Enough data, spread across buckets, for reconcile to build a stripe:
    dd if=/dev/zero of=/mnt/foo bs=1M count=128 oflag=direct
    sync

    # Erasure coding is a background operation: kick reconcile and retry the
    # injector until a stripe pointer exists to corrupt. The injector fails
    # cleanly (nonzero) when there is none, so the loop self-synchronizes on
    # stripe formation; fail loudly if none ever forms.
    ln -sf /sys/fs/bcachefs/*/perf_test p
    injected=0
    for i in $(seq 1 60); do
	echo 1 > /sys/fs/bcachefs/*/internal/trigger_reconcile_wakeup
	if echo test_inject_stripe_ptr_mismatch 1 1 > p 2>/dev/null; then
	    injected=1
	    break
	fi
	sleep 1
    done

    if [[ $injected != 1 ]]; then
	echo "ERROR: no erasure-coded extent formed to corrupt"
	return 1
    fi

    umount /mnt

    # Repair: fsck must detect and fix the stripe-pointer mismatch.
    mount -t bcachefs -o fsck,fix_errors $devs /mnt
    umount /mnt

    # A second fsck must find nothing left to repair:
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    check_bcachefs_leaks
    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

test_ec_stripe_open_invalidates_update()
{
    # Opening an existing stripe (reuse, repair) must invalidate the relock of
    # a transaction that queued an update to the stripe key: that's how a
    # bch2_trigger_stripe() "empty and not open, delete it" decision is kept
    # from committing after the commit path dropped and retook its locks.
    # The check itself is test_stripe_open_invalidates_update in
    # fs/debug/tests.rs; this lays down a stripe for it to use and quiets the
    # filesystem.
    set_watchdog 180

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt
    dd if=/dev/zero of=/mnt/foo bs=1M count=128 oflag=direct
    sync

    # Let reconcile build its stripes, then quiet it: the test relocks a
    # transaction holding the stripes leaf, and background stripe work holding
    # that leaf's intent lock makes the relock fail for reasons that have
    # nothing to do with the open.
    timeout 120 bcachefs reconcile wait /mnt || true
    echo 0 > /sys/fs/bcachefs/*/options/reconcile_enabled
    echo 0 > /sys/fs/bcachefs/*/options/copygc_enabled

    echo test_stripe_open_invalidates_update 1 1 > /sys/fs/bcachefs/*/perf_test

    umount /mnt
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Reported by ChH on IRC (2026-09-06): a stripe with one csum-bad block and
# another on an offline device.
#
# Two failures against one parity block means reconstruct cannot run, and
# bch2_ec_read_extent() only hands the wanted block back on success - so the
# read fails outright. But that block *was* read; it only failed its checksum,
# so the bytes exist, and --no-poison-check is the caller saying "give me
# whatever is physically there". Returning EIO throws away the only copy left.
#
# The corruption has to be on disk, not read_corrupt_ratio: that injects in
# __bch2_read_endio() on the rbio path, which sits above EC. The stripe buf
# does its own IO and would read the block back clean, so reconstruct would
# find nothing wrong with it and the case would never arise - which is exactly
# what an earlier version of this test did, and it proved nothing.
#
# The assertion is that the read succeeds, not that the data matches: the
# bytes are damaged by construction. Returning them faithfully is the product.
test_ec_read_no_reconstruct_returns_raw()
{
    ktest_expect_device_errors=1
    set_watchdog 300

    # Explicit bucket size so bcachefs_first_stripe_blocks has a real one to
    # convert block offsets with.
    local bucket_kb=512

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--bucket_size=${bucket_kb}k		\
	"${ktest_scratch_dev[@]}"
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs "$devs" /mnt
    dd if=/dev/urandom of=/mnt/victim bs=1M count=64 oflag=direct
    sync
    umount /mnt

    # Geometry from the stripe itself - which devices hold which blocks, and
    # how much redundancy there is - rather than assumed.
    local info=$(bcachefs list -b stripes "${ktest_scratch_dev[@]}" |
		 bcachefs_first_stripe_blocks $((bucket_kb * 2)))
    echo "$info"

    local nr_red=$(awk '/^meta/ {print $3}' <<<"$info")
    if [[ -z $nr_red ]]; then
	echo "ERROR: no stripe found - the data never got erasure coded, so"
	echo "       the reconstruct path is never reached and this test"
	echo "       would pass without testing anything"
	exit 1
    fi

    # Block 0 gets corrupted on disk; block 1's device goes offline. That is
    # nr_redundant + 1 failures for nr_redundant = 1.
    local b0_dev=$(awk '/^block 0 /{print $3}' <<<"$info")
    local b0_sector=$(awk '/^block 0 /{print $4}' <<<"$info")
    local b1_dev=$(awk '/^block 1 /{print $3}' <<<"$info")

    if [[ $nr_red != 1 ]]; then
	echo "ERROR: expected 1 parity block, stripe has $nr_red - the"
	echo "       one-corrupt-one-offline setup below assumes it"
	exit 1
    fi

    echo "corrupting block 0 on device $b0_dev at sector $b0_sector"
    echo "$b0_sector" | bcachefs_corrupt_sectors "${ktest_scratch_dev[$b0_dev]}"

    mount -t bcachefs "$devs" /mnt

    echo "offlining device $b1_dev (block 1)"
    bcachefs device offline --force "${ktest_scratch_dev[$b1_dev]}"

    # A normal read of the damaged region must fail: reconstruct can't run.
    if dd if=/mnt/victim of=/dev/null bs=1M iflag=direct 2>/dev/null; then
	echo "ERROR: read of an unreconstructable extent should have failed"
	echo "       the corruption or the offline device didn't take"
	exit 1
    fi

    # The assertion.
    if ! bcachefs data-read /mnt/victim --len $((64 * 1024 * 1024))	\
	    --no-poison-check --output /tmp/victim.salvaged; then
	echo "ERROR: --no-poison-check read failed"
	echo "       reconstruct couldn't run, but the block we wanted was"
	echo "       read - it only failed its checksum, so the bytes exist"
	exit 1
    fi

    local got=$(stat -c %s /tmp/victim.salvaged 2>/dev/null || echo 0)
    if [[ $got != $((64 * 1024 * 1024)) ]]; then
	echo "ERROR: read succeeded but wrote $got of $((64 * 1024 * 1024)) bytes"
	exit 1
    fi

    umount /mnt
}

# bcachefs#1213: a degraded read of encrypted, erasure coded data. The
# reconstruct punts to retry without going through bch2_read_endio(), which is
# what restores the original bio's bi_end_io - so when the retry completed it,
# a second endio pass ran over pages the retry had already decrypted, failed
# the MAC, and a large buffered read could come back EIO.
test_ec_encrypted_degraded_read()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--encrypted --no_passphrase		\
	"${ktest_scratch_dev[@]}"
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs "$devs" /mnt
    dd if=/dev/urandom of=/mnt/data bs=1M count=64 conv=fsync status=none
    local want=$(md5sum < /mnt/data)
    # Stripes are built by reconcile, after the write - unmounting straight
    # away left none about a third of the time:
    timeout 120 bcachefs reconcile wait /mnt || true
    umount /mnt

    if ! bcachefs list -b stripes "${ktest_scratch_dev[@]}" | grep "type stripe" >/dev/null; then
	echo "ERROR: no stripes - the data never got erasure coded, so the"
	echo "       reconstruct path is never reached"
	exit 1
    fi

    mount -t bcachefs "$devs" /mnt
    bcachefs device offline --force "${ktest_scratch_dev[1]}"
    echo 3 > /proc/sys/vm/drop_caches

    # One read(2) of the whole file: readahead failing and read_folio
    # retrying can hide a failed extent from smaller reads.
    if ! dd if=/mnt/data of=/tmp/data bs=64M count=1 iflag=fullblock status=none; then
	echo "ERROR: buffered read of degraded encrypted EC data failed"
	exit 1
    fi

    if [[ $(md5sum < /tmp/data) != "$want" ]]; then
	echo "ERROR: degraded read returned the wrong data"
	exit 1
    fi

    umount /mnt
}

# tools#975: the same geometry as tools#921, but with data written and stripes
# formed first. Stripe reshape during the removal deletes old stripes and
# writes new ones at other indices, re-adding backpointers the drop scan has
# already walked past; on small devices evacuation is slow, and a fixed scan
# cap gave up with remove_by_backpointer_did_not_terminate.
test_ec_device_remove_with_stripes()
{
    set_watchdog 900

    local dir=/ec-remove-devs
    local i d f failed=0

    mkdir -p $dir
    for i in $(seq 1 5); do
	local devs=()
	for d in 0 1 2 3 4; do
	    truncate -s 512M $dir/d$d
	    devs+=("$(losetup --find --show $dir/d$d)")
	done

	run_quiet "" bcachefs format -f		\
	    --erasure_code			\
	    --replicas=2			\
	    --metadata_replicas=2		\
	    "${devs[@]}"
	mount -t bcachefs "$(join_by : "${devs[@]}")" /mnt

	for f in $(seq 1 200); do
	    dd if=/dev/urandom of=/mnt/file_$f bs=4K count=10 status=none
	done
	sync
	timeout 60 bcachefs reconcile wait /mnt || true

	if ! bcachefs device remove --force ${devs[4]}; then
	    echo "attempt $i: device remove --force failed"
	    failed=$((failed + 1))
	fi

	umount /mnt
	bcachefs fsck -ny "${devs[@]:0:4}"
	for d in "${devs[@]}"; do
	    losetup -d $d
	done
	rm -f $dir/d*
    done
    rm -rf $dir

    if (( failed )); then
	echo "ERROR: $failed of 5 removals failed"
	return 1
    fi
}

# tools#921: device remove --force on an empty EC filesystem, right after
# mount, failed about half the time with remove_by_backpointer_did_not_terminate
# and left the device evacuating. Mount's presplit_shard_boundaries leaves
# interior updates in flight; the drop scan ran ahead of them, found nothing to
# do while their buckets stayed counted, and ten fast scans tripped the stall
# check. Reproduces here only with the reporter's geometry (512M loop devices),
# at ~20% per attempt: thirty clean attempts don't happen by chance.
test_ec_device_remove_after_mount()
{
    set_watchdog 600

    # The reporter's geometry: five 512M loop devices.
    local dir=/ec-remove-devs
    local i d failed=0

    mkdir -p $dir
    for i in $(seq 1 30); do
	local devs=()
	for d in 0 1 2 3 4; do
	    truncate -s 512M $dir/d$d
	    devs+=("$(losetup --find --show $dir/d$d)")
	done

	run_quiet "" bcachefs format -f		\
	    --erasure_code			\
	    --metadata_replicas=2		\
	    "${devs[@]}"
	mount -t bcachefs "$(join_by : "${devs[@]}")" /mnt

	if ! bcachefs device remove --force ${devs[4]}; then
	    echo "attempt $i: device remove --force failed"
	    failed=$((failed + 1))
	fi

	umount /mnt
	for d in "${devs[@]}"; do
	    losetup -d $d
	done
	rm -f $dir/d*
    done
    rm -rf $dir

    if (( failed )); then
	echo "ERROR: $failed of 30 removals failed"
	return 1
    fi
}

# Stripe reconcile work, as printed - "MISSING" if there's no row, which must
# not read as "none".
ec_reconcile_stripes()
{
    bcachefs reconcile status /mnt 2>/dev/null |
	awk '/^[[:space:]]*stripes:/	{ print $2; found = 1 }
	     END			{ if (!found) print "MISSING" }'
}

# tools#929: evacuating marks every stripe with a block on the device
# needs_reconcile and queues it in reconcile_hipri. Set the device back to rw
# before those are rebuilt, and nothing cleared the bit: stripe repair found the
# stripe not degraded and returned without touching it, so reconcile revisited
# the whole queue forever, doing no IO.
# #1075: a stripe repair that fails for want of space must not end the reconcile
# thread - with it gone, all background data movement stops until something
# restarts it.
#
# Full filesystem; stripes capped at 3+1, so bch2_stripe_repair() can't bow out
# with stripe_needs_block_evacuate and actually allocates. Evacuating a device
# queues every stripe with a block on it for repair, and the rebuilds then fail
# for space (bucket_alloc_no_progress, EAGAIN-class) while the device is still
# readable.
ec_repair_no_space_setup()
{
    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--ec_max_data_blocks=3			\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    fill_device /mnt/fiotest || true
}

# reconcile_stripe counts the stripe repair work attempted, in sectors, printed
# human-readable ("29.4G"); as bytes, for arithmetic:
ec_stripe_repair_bytes()
{
    awk '/since mount/ {print $3}' /sys/fs/bcachefs/*/counters/reconcile_stripe |
	sed 's/k$/K/' | numfmt --from=iec
}

# Buckets of data still on dev-$1; 0 once an evacuate has drained it.
# alloc_debug's usage rows are "<type> <buckets> <sectors> <fragmented>", and
# the reserves section after them has a row per watermark - one of which is
# also called "stripe".
ec_dev_bucket_count()
{
    awk '/^reserves:/ { exit }
	 $1 == "user" || $1 == "stripe" || $1 == "parity" { n += $2 }
	 END { print n + 0 }' /sys/fs/bcachefs/*/dev-$1/alloc_debug
}

ec_reconcile_thread_alive()
{
    if grep -q 'Reconcile thread exited' /sys/fs/bcachefs/*/reconcile_status; then
	cat /sys/fs/bcachefs/*/reconcile_status
	echo "FAILED: reconcile thread exited on a stripe it couldn't repair"
	return 1
    fi
}

test_ec_repair_no_space()
{
    set_watchdog 600

    ec_repair_no_space_setup
    local before=$(ec_stripe_repair_bytes)

    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    for i in $(seq 1 60); do
	ec_reconcile_thread_alive || return 1
	sleep 1
    done

    # Known positive: the repair path ran, so the thread had the chance to die
    local after=$(ec_stripe_repair_bytes)
    echo "stripe repair work: $before -> $after bytes"
    if (( after <= before )); then
	echo "FAILED: no stripe repairs ran - this test didn't test anything"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
}

# #1075, part two: with the thread surviving, a stripe that can't be repaired
# for lack of space must not be retried flat out. Nothing changes on a full,
# idle filesystem, so after the first pass has failed every repair there is
# nothing new to try - and before parking, reconcile retried the same stripes
# continuously (~3000 failures in four minutes, 29.4G of repair work on a 20G
# filesystem).
#
# Implementation-agnostic: it measures repair work attempted after the first
# pass has settled, however the stripes end up waiting.
test_ec_repair_no_space_spin()
{
    set_watchdog 600

    ec_repair_no_space_setup
    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    # The first pass: every stripe with a block on dev0 is tried once.
    sleep 60
    ec_reconcile_thread_alive || return 1

    local settled=$(ec_stripe_repair_bytes)
    if (( settled == 0 )); then
	echo "FAILED: no stripe repairs ran - this test didn't test anything"
	return 1
    fi

    sleep 60
    ec_reconcile_thread_alive || return 1

    local later=$(ec_stripe_repair_bytes)
    local retried=$((later - settled))
    echo "stripe repair work: first pass $settled bytes, next 60s $retried bytes"

    if (( retried > 1 << 30 )); then
	echo "FAILED: reconcile retried $(numfmt --to=iec $retried) of stripe" \
	     "repairs in 60s on a full, idle filesystem - nothing changed, so" \
	     "there was nothing new to try"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
}

# #1075, the other side of the gate: when space is short but copygc can make
# some, a stripe repair must wait for copygc, not narrow the stripe. Narrowing
# is for when waiting can't help (device sizes, failure domains, nothing to
# reclaim) - here every device is fragmented, so it can.
#
# Fragmentation: many small files written interleaved, so each bucket holds
# pieces of several, then every other file deleted. Free buckets stay near
# zero - copygc's "can make progress" - while half of every bucket is
# reclaimable.
#
# A narrowing shows in the reconcile_stripe tracepoint as
# "ret stripe_needs_block_evacuate"; there's no counter for it.
test_ec_repair_wait_copygc()
{
    set_watchdog 1200

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--ec_max_data_blocks=3			\
	"${ktest_scratch_dev[@]}"
    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    mkdir /mnt/frag
    fio --name=frag --directory=/mnt/frag	\
	--ioengine=sync --rw=randwrite --bs=64k	\
	--nrfiles=2048 --filesize=1M		\
	--file_service_type=random		\
	--numjobs=8 --group_reporting > /dev/null || true

    find /mnt/frag -type f | sort | awk 'NR % 2' | xargs rm -f
    sync
    bcachefs fs usage -h /mnt

    local T=/sys/kernel/tracing
    [[ -d $T/events ]] || mount -t tracefs nodev $T
    echo 1 > $T/events/bcachefs/reconcile_stripe/enable
    echo 1 > $T/tracing_on

    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    local drained=false
    for i in $(seq 1 600); do
	ec_reconcile_thread_alive || return 1
	if (( $(ec_dev_bucket_count 0) == 0 )); then
	    drained=true
	    break
	fi
	sleep 1
    done

    echo 0 > $T/tracing_on
    local repairs=$(grep -c 'reconcile_stripe:' $T/trace || true)
    local narrowed=$(grep -c 'ret stripe_needs_block_evacuate' $T/trace || true)
    echo "stripe repairs traced: $repairs, narrowed: $narrowed"
    bcachefs fs usage -h /mnt

    if (( repairs == 0 )); then
	echo "FAILED: no stripe repairs ran - this test didn't test anything"
	return 1
    fi
    if (( narrowed )); then
	echo "FAILED: narrowed $narrowed stripes when copygc could make space"
	return 1
    fi
    if ! $drained; then
	echo "FAILED: ${ktest_scratch_dev[0]} didn't drain in 600s"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
}

# #1076: a stripe repair has to fit failure domains, not just devices. The
# allocator puts at most one block of a stripe in a domain, so with dev3 and
# dev4 sharing one, a 3+1 stripe spans all four domains - and evacuating dev0
# leaves four rw devices but three domains, every one already holding a
# carried block. The rebuild can't place a new block; it has to narrow.
#
# Before the fix: insufficient_devices on every pass, and dev0 never drains.
test_ec_repair_domains()
{
    set_watchdog 600

    run_quiet "" bcachefs format -f				\
	--erasure_code						\
	--replicas=2						\
	--ec_max_data_blocks=3					\
	--failure_domain=d0 ${ktest_scratch_dev[0]}		\
	--failure_domain=d1 ${ktest_scratch_dev[1]}		\
	--failure_domain=d2 ${ktest_scratch_dev[2]}		\
	--failure_domain=d3 ${ktest_scratch_dev[3]}		\
	--failure_domain=d3 ${ktest_scratch_dev[4]}
    devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    dd if=/dev/urandom of=/mnt/fiotest bs=1M count=1024 oflag=direct
    sync
    bcachefs fs usage -h /mnt

    if (( $(ec_dev_bucket_count 0) == 0 )); then
	echo "FAILED: nothing on ${ktest_scratch_dev[0]} - this test didn't test anything"
	return 1
    fi

    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    local drained=false
    for i in $(seq 1 300); do
	ec_reconcile_thread_alive || return 1
	if (( $(ec_dev_bucket_count 0) == 0 )); then
	    drained=true
	    break
	fi
	sleep 1
    done

    bcachefs fs usage -h /mnt
    if ! $drained; then
	echo "FAILED: ${ktest_scratch_dev[0]} didn't drain in 300s:" \
	     "$(ec_dev_bucket_count 0) buckets left"
	return 1
    fi
    echo "drained in ${i}s"

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
}

test_ec_evacuate_cancelled()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    local sysfs=$(echo /sys/fs/bcachefs/*/)

    dd if=/dev/urandom of=/mnt/data bs=1M count=2048 status=none
    sync
    local want=$(md5sum < /mnt/data)

    bcachefs device set-state -f evacuating ${ktest_scratch_dev[0]}

    # Wait for the device scan to mark stripes, then pause reconcile before
    # it rebuilds them all:
    local stripes waited=0
    while stripes=$(ec_reconcile_stripes); [[ $stripes == 0 ]] && (( waited < 60 )); do
	sleep 1
	waited=$((waited + 1))
    done
    echo 0 > $sysfs/options/reconcile_enabled

    stripes=$(ec_reconcile_stripes)
    echo "stripe reconcile work queued by the evacuate: $stripes"
    if [[ $stripes == 0 || $stripes == MISSING ]]; then
	echo "ERROR: no stripes queued ($stripes) - this run tests nothing"
	return 1
    fi

    bcachefs device set-state rw ${ktest_scratch_dev[0]}
    echo 1 > $sysfs/options/reconcile_enabled

    timeout 60 bcachefs reconcile wait /mnt || true
    bcachefs reconcile status /mnt

    stripes=$(ec_reconcile_stripes)
    if [[ $stripes != 0 ]]; then
	echo "ERROR: $stripes of stripe reconcile work still queued after the"
	echo "       evacuation was cancelled - reconcile will revisit it forever"
	return 1
    fi

    if [[ $(md5sum < /mnt/data) != "$want" ]]; then
	echo "ERROR: data changed"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}
# Setting a device's durability to 0 should restore the durability of the data
# on it: a replicated extent gets another replica, and a stripe gets its block
# on that device rebuilt elsewhere, as when the device is evacuating.

# dz_extents <inum> <dev> [<dev2>]: for the extents of <inum>, print
# "<extents> <below durability 2> <with a durable ptr on dev> <erasure coded>
# <with durable ptrs on dev and dev2>". The key text's durability is only
# meaningful for replicated extents: for an erasure coded one it is
# bch2_bkey_durability_safe(), which assumes redundancy + 1 without reading the
# stripe.
dz_extents()
{
    awk -v ino="$1" -v d="$2" -v d2="${3:--1}" '
	function done() {
	    if (cur) { n++; low += dur < 2; on += ondev; ec += striped; both += ondev && ondev2 }
	}
	/^u64s/ {
	    done()
	    split($5, p, ":")
	    # As strings: inode numbers past 2^53 compare equal as doubles
	    cur = $4 == "extent" && p[1] "" == ino ""
	    dur = match($0, /durability: [0-9]+/) ? substr($0, RSTART + 12, RLENGTH - 12) + 0 : 0
	    ondev = 0
	    ondev2 = 0
	    striped = 0
	    next
	}
	cur && /stripe_ptr:/ { striped = 1 }
	cur && /ptr:/ && !/stripe_ptr:/ && !/ cached/ {
	    for (i = 1; i <= NF; i++)
		if (split($i, a, ":") == 3 && a[1] ~ /^[0-9]+$/) {
		    if (a[1] == d)
			ondev = 1
		    if (a[1] == d2)
			ondev2 = 1
		    break
		}
	}
	END { done(); print n + 0, low + 0, on + 0, ec + 0, both + 0 }' \
	/sys/kernel/debug/bcachefs/*/btrees/extents/keys
}

# dz_stripes_on <dev_idx>: number of stripes with a block on dev_idx. Block
# pointers are on the lines after the key's header line; the header has the
# key position, which also looks like a:b:c.
dz_stripes_on()
{
    awk -v d="$1" '
	/^u64s/ { n += on; on = 0; next }
	{
	    for (i = 1; i <= NF; i++)
		if (split($i, a, ":") == 3 && a[1] ~ /^[0-9]+$/ && a[1] == d)
		    on = 1
	}
	END { print n + on }' /sys/kernel/debug/bcachefs/*/btrees/stripes/keys
}

# Stripes with a block on a durability=0 device: the stripe-level checks
# (reconcile's stripe flag, stripe_degraded(), stripe reuse) test
# bch2_dev_bad_or_evacuating(), not durability, so nothing rebuilds the block,
# and every extent in those stripes is left at durability 1 (a 1-parity stripe
# sums its two least durable blocks: 0 + 1). A replicated file in the same
# filesystem is the control: its extents get another replica. Device 0 is used
# because the durability change only scans device 0's backpointers (see
# test_durability_zero_rereplicate).
test_ec_durability_zero()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    local sysfs=$(echo /sys/fs/bcachefs/*/)

    mkdir /mnt/rep
    setfattr -n bcachefs.erasure_code -v 0 /mnt/rep

    dd if=/dev/urandom of=/mnt/ec bs=1M count=512 status=none
    dd if=/dev/urandom of=/mnt/rep/f bs=1M count=64 status=none
    sync
    timeout 120 bcachefs reconcile wait /mnt || true

    local ec_sum=$(md5sum < /mnt/ec) rep_sum=$(md5sum < /mnt/rep/f)
    local ec_ino=$(stat -c %i /mnt/ec) rep_ino=$(stat -c %i /mnt/rep/f)
    local ec_n ec_low ec_on ec_striped rep_n rep_low rep_on rep_striped x

    read ec_n ec_low ec_on ec_striped x < <(dz_extents $ec_ino 0)
    read rep_n rep_low rep_on rep_striped x < <(dz_extents $rep_ino 0)
    local stripes=$(dz_stripes_on 0)
    echo "before: EC file: $ec_n extents, $ec_striped erasure coded; $stripes stripes with a block on dev 0"
    echo "before: replicated file: $rep_n extents, $rep_on with a copy on dev 0, $rep_low below durability 2"

    if [[ $ec_n == 0 || $ec_striped != $ec_n || $stripes == 0 ||
	  $rep_n == 0 || $rep_striped != 0 || $rep_on == 0 || $rep_low != 0 ]]; then
	echo "ERROR: precondition failed - this run tests nothing"
	return 1
    fi

    echo 0 > ${sysfs}dev-0/durability
    timeout 120 bcachefs reconcile wait /mnt || true
    bcachefs reconcile status /mnt

    read rep_n rep_low rep_on rep_striped x < <(dz_extents $rep_ino 0)
    stripes=$(dz_stripes_on 0)
    echo "after durability=0 on dev 0:"
    echo "  $stripes stripes with a block on dev 0"
    echo "  replicated file: $rep_n extents, $rep_on with a durable copy on dev 0, $rep_low below durability 2"

    local ret=0
    if [[ $rep_low != 0 ]]; then
	echo "ERROR: control: $rep_low replicated extents not re-replicated"
	ret=1
    fi
    if [[ $stripes != 0 ]]; then
	echo "ERROR: $stripes stripes still have a block on the durability=0 device (stripe durability 1)"
	ret=1
    fi

    if [[ $(md5sum < /mnt/ec) != "$ec_sum" || $(md5sum < /mnt/rep/f) != "$rep_sum" ]]; then
	echo "ERROR: data changed"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
    return $ret
}

# The durability hook queues RECONCILE_SCAN_device with .dev = inum, and the
# sysfs device option path passes inum 0, so the scan always walks device 0's
# backpointers. Setting durability=0 on any other device re-replicates nothing.
test_durability_zero_rereplicate()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	"${ktest_scratch_dev[@]}"
    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    local sysfs=$(echo /sys/fs/bcachefs/*/)

    dd if=/dev/urandom of=/mnt/f bs=1M count=128 status=none
    sync
    timeout 120 bcachefs reconcile wait /mnt || true

    local sum=$(md5sum < /mnt/f) ino=$(stat -c %i /mnt/f)
    local n low on striped both

    read n low on striped both < <(dz_extents $ino 1 0)
    echo "before: $n extents, $on with a copy on dev 1 ($both of them also on dev 0), $low below durability 2"
    if [[ $n == 0 || $on == 0 || $low != 0 || $striped != 0 ]]; then
	echo "ERROR: precondition failed - this run tests nothing"
	return 1
    fi

    echo 0 > ${sysfs}dev-1/durability
    timeout 120 bcachefs reconcile wait /mnt || true
    bcachefs reconcile status /mnt

    read n low on striped both < <(dz_extents $ino 1 0)
    echo "after durability=0 on dev 1: $n extents, $on with a durable copy on dev 1, $low below durability 2"

    local ret=0
    if [[ $low != 0 ]]; then
	echo "ERROR: $low extents with a copy on dev 1 left at durability 1"
	ret=1
    fi

    if [[ $(md5sum < /mnt/f) != "$sum" ]]; then
	echo "ERROR: data changed"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
    return $ret
}


main "$@"
