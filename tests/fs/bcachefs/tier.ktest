#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

config-scratch-devs 1G
config-scratch-devs 1G
config-scratch-devs 16G
config-scratch-devs 16G
# NB: many tests in this file mount/fsck "${ktest_scratch_dev[@]}" - all
# devices - so adding a scratch dev here breaks every one of them unless
# it's formatted into every filesystem. The commented-out device add in
# test_reconcile_data_target_overfull needs a 5th dev (8G) when it's
# re-enabled: re-add it together with converting the scratch_dev[@] users
# to explicit device lists.

run_basic_tiering_test()
{
    run_basic_fio_test "$@"			\
	--block_size=4k				\
	--btree_node_size=32k			\
	--bucket_size=256k				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}		\
	--label=ssd.ssd2 ${ktest_scratch_dev[1]}		\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}		\
	--label=hdd.hdd2 ${ktest_scratch_dev[3]}		\
	--foreground_target=ssd			\
	--promote_target=ssd			\
	--background_target=hdd
}

test_tiering_torture()
{
    run_quiet "" bcachefs format -f			\
	--block_size=4k					\
	--bucket_size=2M				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=ssd.ssd2 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt
    run_fio_randrw
    mv /mnt/fiotest /mnt/fiotest_old

    # Sustained rewrite pressure to drive promote/demote cycling. 10 loops
    # of the 3.5G job is ~20 minutes on the slow (lockdep) configs;
    # run_fio_randrw's own 1200s watchdog is sized for a single loop, so
    # set our own. (Was --loops=50, which could never fit any watchdog
    # we'd want to wait out.)
    set_watchdog 3600
    run_fio					\
	--name=randrw				\
	--rw=randrw				\
	--bsrange=4k-1M				\
	--loops=10

    mount -o remount,ro /mnt
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_tiering()
{
    run_basic_tiering_test
}

test_tiering_misaligned()
{
    run_basic_tiering_test
    run_basic_fio_test "$@"				\
	--block_size=4k					\
	--btree_node_size=32k				\
	--bucket_size=61952				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=ssd.ssd2 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd
}

test_tiering_drop_alloc()
{
    run_basic_tiering_test
    # mount dropping all alloc info

    echo "dropping alloc:"
    mount -t bcachefs -o dangerously_reconstruct_alloc,fsck,fix_errors "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    umount /mnt

    echo "final fsck:"

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_tiering_buffered()
{
    set_watchdog 6000

    run_quiet "" bcachefs format -f			\
	--block_size=4k					\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=ssd.ssd2 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    local loops=$((($ktest_priority + 1) * 4))

    fio --eta=always				\
	--exitall_on_error=1			\
	--ioengine=sync				\
	--numjobs=1				\
	--verify=crc32c				\
	--verify_fatal=1			\
	--buffer_compress_percentage=30		\
	--filename=/mnt/fiotest		    	\
	--filesize=3500M			\
	--loops=$loops				\
	--name=randrw				\
	--rw=randrw				\
	--bsrange=512-16k
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_foreground_target_full_fallback()
{
    set_watchdog 180

    run_quiet "" bcachefs format -f			\
	--block_size=4k					\
	--bucket_size=256k				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt

    # The foreground target is only a preference.  This write is larger than
    # the SSD scratch device, so it must complete by falling back to HDD space
    # instead of waiting forever on SSD/copygc progress.
    dd if=/dev/zero of=/mnt/foreground-target-fallback bs=16M count=96	\
	oflag=direct status=progress
    sync
    bcachefs fs usage -h /mnt

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_writethrough()
{
    run_basic_fio_test "$@"								\
	--durability=0 --label=ssd ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}	\
	--durability=1 --label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd								\
	--promote_target=ssd								\
	--background_target=hdd
}

test_promote()
{
    run_basic_fio_test "$@"			\
	--durability=0 --label=ssd ${ktest_scratch_dev[0]}	\
	--durability=1 --label=hdd ${ktest_scratch_dev[2]}	\
	--foreground_target=hdd			\
	--promote_target=ssd			\
	--background_target=hdd
}

test_setattr()
{
    setup_tracing `bcachefs_slowpath_tracepoints`

    run_quiet "" bcachefs format -f				\
	--durability=0 --label=ssd ${ktest_scratch_dev[0]}	\
	--durability=1 --label=hdd ${ktest_scratch_dev[2]}	\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt

    touch /mnt/foo
    touch /mnt/bar

    bcachefs set-file-option --foreground_target $(basename ${ktest_scratch_dev[0]}) /mnt/
    bcachefs set-file-option --promote_target ssd /mnt/

    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_tiering_no_checksum()
{
    run_basic_tiering_test --data_checksum=none
}

test_tiering_compression()
{
    run_basic_tiering_test --compression=lz4
}

test_tiering_crypto()
{
    run_basic_tiering_test --encrypted --no_passphrase	
}

test_tiering_crypto_lz4()
{
    run_basic_tiering_test --encrypted --no_passphrase --compression=lz4
}

test_tiering_crypto_zstd()
{
    run_basic_tiering_test --encrypted --no_passphrase --compression=zstd
}

test_tiering_replication()
{
    run_basic_tiering_test --replicas=2
}

test_tiering_variable_buckets()
{
    run_basic_fio_test					\
	--label=ssd --bucket_size=32k	${ktest_scratch_dev[0]}	\
	--label=ssd --bucket_size=64k	${ktest_scratch_dev[1]}	\
	--label=hdd --bucket_size=128k	${ktest_scratch_dev[3]}	\
	--label=hdd --bucket_size=256k	${ktest_scratch_dev[2]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd
}

test_tiering_variable_buckets_replicas()
{
    setup_tracing 'bcachefs:data_update bcachefs:data_update_key_fail'

    run_basic_fio_test					\
	--replicas=2					\
	--label=ssd --bucket_size=32k	${ktest_scratch_dev[0]}	\
	--label=ssd --bucket_size=64k	${ktest_scratch_dev[1]}	\
	--label=hdd --bucket_size=128k	${ktest_scratch_dev[3]}	\
	--label=hdd --bucket_size=256k	${ktest_scratch_dev[2]}	\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd
}

test_device_add()
{
    set_watchdog 240
    run_quiet "" bcachefs format -f					\
	--label=ssd ${ktest_scratch_dev[0]}				\
	--label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt

    run_fio_randrw|tail -n200 &

    bcachefs device add -f --label=hdd /mnt ${ktest_scratch_dev[1]}

    wait
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_remove()
{
    set_watchdog 240
    setup_tracing 'bcachefs:trans_restart_relock'

    run_quiet "" bcachefs format -f					\
	--replicas=2							\
	--label=ssd ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}	\
	--label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd						\
	--promote_target=ssd						\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    run_fio_randrw|tail -n200 &

    sleep 5
    bcachefs device remove -f ${ktest_scratch_dev[1]} /mnt

    wait
    umount /mnt

    bcachefs fsck -n "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_remove_background()
{
    set_watchdog 240
    setup_tracing 'bcachefs:trans_restart_relock'

    run_quiet "" bcachefs format -f					\
	--errors=ro					\
	--replicas=2							\
	--label=ssd ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}	\
	--label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd						\
	--promote_target=ssd						\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    bcachefs device resize-journal ${ktest_scratch_dev[0]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[1]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[2]} 512M
    bcachefs device resize-journal ${ktest_scratch_dev[3]} 512M

    run_fio_randrw|tail -n200 &

    sleep 5
    bcachefs device remove -f ${ktest_scratch_dev[2]} /mnt

    wait
    umount /mnt

    bcachefs fsck -n "${ktest_scratch_dev[@]}"
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=bucket_alloc_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_mount_umount_torture()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f					\
	--replicas=2							\
	--label=ssd ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}	\
	--label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd						\
	--promote_target=ssd						\
	--background_target=hdd

    for i in {0..10}; do
	mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
	umount /mnt
    done

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_change_replicas()
{
    set_watchdog 180
    run_quiet "" bcachefs format -f					\
	--label=ssd ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}	\
	--label=hdd ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}	\
	--foreground_target=ssd						\
	--promote_target=ssd						\
	--background_target=hdd

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    (
	cd /sys/fs/bcachefs/*
	while true; do
	    echo 1 > options/data_replicas
	    sleep 0.1
	    echo 2 > options/data_replicas
	    sleep 0.1
	done
    ) &

    loops=$((($ktest_priority + 1) * 4))

    fio --eta=always				\
	--numjobs=1				\
	--buffer_compress_percentage=50		\
	--filename=/mnt/fiotest		    	\
	--filesize=1500M			\
	--loops=$loops				\
	--name=randrw				\
	--rw=randrw				\
	--bsrange=4k-1M	

#    while true; do
#	dd if=/dev/zero of=/mnt/foo bs=1M count=1024 oflag=direct
#	sync
#	#rm /mnt/foo
#    done

    kill %1
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_concurrent_all_device_removal()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f			\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=ssd.ssd2 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[3]}	\
	--replicas=2					\
	--foreground_target=ssd				\
	--promote_target=ssd				\
	--background_target=hdd

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    dd if=/dev/zero of=/mnt/foo bs=128M count=40 oflag=direct

    # Fill cache
    for i in 1 2 3 4; do cat /mnt/foo > /dev/null; done

    bcachefs device remove ${ktest_scratch_dev[0]} &
    bcachefs device remove ${ktest_scratch_dev[1]} &
    bcachefs device remove ${ktest_scratch_dev[2]} &
    bcachefs device remove ${ktest_scratch_dev[3]} &
    wait

    umount /mnt
    bcachefs fsck -ny $(join_by " " "${ktest_scratch_dev[@]}")

    # Test that no incufficient devices issues appears
    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    umount /mnt

    check_bcachefs_leaks
    check_bcachefs_errors ${ktest_scratch_dev[0]}
}

test_read_corrupt()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    [[ ! -f /sys/module/bcachefs/parameters/read_corrupt_ratio ]] && return 0

    set_watchdog 300
    setup_tracing

    echo 8 > /sys/module/bcachefs/parameters/read_corrupt_ratio

    run_quiet "" bcachefs format -f			\
       --label=ssd.ssd1 ${ktest_scratch_dev[0]}		\
       --label=ssd.ssd2 ${ktest_scratch_dev[1]}		\
       --label=hdd.hdd1 ${ktest_scratch_dev[2]}		\
       --label=hdd.hdd2 ${ktest_scratch_dev[3]}		\
       --replicas=2					\
       --foreground_target=ssd				\
       --promote_target=ssd				\
       --background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    run_fio					\
	--name=randwrite			\
	--rw=randwrite				\
	--bsrange=4k-1M
    run_fio					\
	--name=randrread			\
	--rw=randread				\
	--bsrange=4k-1M

    echo 0 > /sys/module/bcachefs/parameters/read_corrupt_ratio

    # Check the read retry path for indirect extents:
    #cp --reflink /mnt/fiotest /mnt/fiotest.reflinked
    #dd if=/mnt/fiotest of=/dev/null bs=4k iflag=direct

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_btree_read_corrupt()
{
    ktest_expect_device_errors=1
    [[ ! -f /sys/module/bcachefs/parameters/btree_read_corrupt_ratio ]] && return 0

    setup_tracing
    set_watchdog 180

    run_quiet "" bcachefs format -f			\
       --label=ssd.ssd1 ${ktest_scratch_dev[0]}		\
       --label=ssd.ssd2 ${ktest_scratch_dev[1]}		\
       --label=hdd.hdd1 ${ktest_scratch_dev[2]}		\
       --label=hdd.hdd2 ${ktest_scratch_dev[3]}		\
       --replicas=2					\
       --foreground_target=ssd				\
       --promote_target=ssd				\
       --background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    run_fio_randrw
    umount /mnt

    echo 8 > /sys/module/bcachefs/parameters/btree_read_corrupt_ratio
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    echo 0 > /sys/module/bcachefs/parameters/btree_read_corrupt_ratio

    dd if=/mnt/fiotest of=/dev/null bs=1M
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
    check_bcachefs_leaks
    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

## reproducer for https://github.com/koverstreet/bcachefs/issues/834
# v1: works as expected, background target=device 0
test_metadata_on_wrong_device_after_disk_add_v1()
{
    run_quiet "" bcachefs format -f \
        --background_target=hdd \
        --foreground_target=hdd \
        --promote_target=hdd \
        --metadata_target=ssd \
        --label=hdd \
        ${ktest_scratch_dev[2]} \
        --label=ssd \
        ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[2]}:${ktest_scratch_dev[0]} /mnt

    for i in $(seq 0 100000); do
        echo $i > /mnt/$i
    done

    bcachefs fs usage -h /mnt

    run_quiet "" bcachefs device add -f --label=hdd /mnt ${ktest_scratch_dev[3]}

    for i in $(seq 0 100000); do
        echo $i > /mnt/a$i
    done

    btree_devs=$(bcachefs fs usage -h --all /mnt/ | grep -c ^btree:)

    test $btree_devs -eq 1 || return 1

    umount /mnt
}

# v2: metadata ends up on wrong device, foreground target=device 0
test_metadata_on_wrong_device_after_disk_add_v2()
{
    run_quiet "" bcachefs format -f \
        --background_target=hdd \
        --foreground_target=hdd \
        --promote_target=hdd \
        --metadata_target=ssd \
        --label=ssd \
        ${ktest_scratch_dev[0]} \
        --label=hdd \
        ${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt

    for i in $(seq 0 100000); do
        echo $i > /mnt/$i
    done

    sync
    bcachefs fs usage -h /mnt

    run_quiet "" bcachefs device add -f --label=hdd /mnt ${ktest_scratch_dev[3]}

    for i in $(seq 0 100000); do
        echo $i > /mnt/a$i
    done

    sync
    bcachefs fs usage -h /mnt

    btree_devs=$(bcachefs fs usage -h --all /mnt/ | grep -c ^btree:)

    test $btree_devs -eq 1 || return 1

    umount /mnt
}

test_recover_super()
{
    set_watchdog 120
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[@]}
    bcachefs show-super -l ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    cp -rx /usr /mnt/usr
    umount /mnt

    echo "Wiping super"
    dd if=/dev/zero of=${ktest_scratch_dev[0]} bs=1M count=1 oflag=direct

    echo "Attempting mount, should fail"
    assert_fails mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    echo "Recovering superblock"
    bcachefs recover-super --src_device ${ktest_scratch_dev[1]} --dev_idx 0 -y ${ktest_scratch_dev[0]}

    echo "Attempting mount, should succeed"
    echo "Fixing errors because recovered device will no longer have a journal"
    mount -t bcachefs -o fsck,fix_errors ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

test_mv_cross_subvol_io_opts()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f			\
	--label=ssd ${ktest_scratch_dev[0]}		\
	--label=hdd ${ktest_scratch_dev[2]}		\
	--foreground_target=ssd				\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt

    # Dest subvol: override targets so data should land on hdd
    bcachefs subvolume create /mnt/dst
    bcachefs set-file-option --foreground_target=hdd /mnt/dst
    bcachefs set-file-option --background_target=hdd /mnt/dst

    # Write test file in root subvol (data goes to ssd via foreground_target)
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=10 oflag=direct

    # mv across subvolumes: rename returns EXDEV, coreutils falls back to
    # copy_file_range (reflink) + unlink
    mv /mnt/testfile /mnt/dst/testfile

    # Verify data is still intact
    md5sum /mnt/dst/testfile

    # The destination reflink_p must have REFLINK_P_MAY_UPDATE_OPTIONS set
    # so the reconciler can move data to match dst subvol's IO path options.
    # Bug: bch2_remap_file_range() passes may_change_src_io_path_opts=false,
    # so the flag never gets propagated to the destination.
    umount /mnt

    local devs=(${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]})
    local extents=$(bcachefs list -b extents "${devs[@]}")

    if echo "$extents" | grep -q "reflink_p.*may_update_opts"; then
	echo "PASS: reflink_p has may_update_opts"
    elif echo "$extents" | grep -q reflink_p; then
	echo "FAIL: reflink_p missing may_update_opts flag"
	echo "Reconciler won't update IO path options after cross-subvol mv"
	echo "$extents" | grep reflink_p
	return 1
    else
	echo "No reflink_p found — mv did not use copy_file_range"
    fi

    bcachefs fsck -ny "${devs[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_reflink_option_propagate()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f			\
	--label=ssd ${ktest_scratch_dev[0]}		\
	--label=hdd ${ktest_scratch_dev[2]}		\
	--foreground_target=ssd				\
	--background_target=hdd

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt

    # Dst subvol with hdd targets — data should eventually move there
    bcachefs subvolume create /mnt/dst
    bcachefs set-file-option --foreground_target=hdd /mnt/dst
    bcachefs set-file-option --background_target=hdd /mnt/dst

    # Write test file in root subvol (goes to ssd via foreground_target)
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=10 oflag=direct

    # Cross-subvol mv: coreutils uses copy_file_range (reflink) + unlink
    # This creates reflink_p extents with REFLINK_P_MAY_UPDATE_OPTIONS set
    mv /mnt/testfile /mnt/dst/testfile

    # Propagate dst subvol's IO options to reflinked indirect extents
    bcachefs reflink-option-propagate /mnt/dst/testfile

    # --set-may-update should be harmless on already-flagged extents
    bcachefs reflink-option-propagate --set-may-update /mnt/dst/testfile

    # Verify data integrity
    md5sum /mnt/dst/testfile

    umount /mnt

    local devs=(${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]})
    bcachefs fsck -ny "${devs[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# When an extent is made indirect, bch2_make_extent_indirect() must snapshot
# the source inode's IO options onto the new reflink_v: a non-degraded data
# extent carries no bch_extent_reconcile entry (the reconciler re-derives the
# options from the inode each pass), but an indirect extent has no inode to
# derive from, so without the snapshot the reconciler reconciles it against
# the filesystem defaults instead - which can ENOSPC the fs trying to bring
# every reflinked extent to the default replica count.
test_reflink_inode_opts()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f			\
	--data_replicas=1				\
	${ktest_scratch_dev[0]}				\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    # A directory with a non-default (per-inode) data_replicas option;
    # files created under it inherit it.
    mkdir /mnt/d
    bcachefs set-file-option --data_replicas=2 /mnt/d
    dd if=/dev/urandom of=/mnt/d/foo bs=1M count=8 oflag=direct

    # foo's extents match the inode option, so they carry no
    # bch_extent_reconcile entry - the bug precondition.
    cp --reflink /mnt/d/foo /mnt/d/bar
    cmp /mnt/d/foo /mnt/d/bar

    umount /mnt

    local devs=(${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]})
    local reflink_keys=$(bcachefs list -b reflink "${devs[@]}")
    echo "$reflink_keys"

    if echo "$reflink_keys" | grep -q "reconcile.*replicas=2 (inode)"; then
	echo "PASS: reflink_v carries the inode's reconcile opts (data_replicas=2)"
    else
	echo "FAIL: reflink_v missing the inode's reconcile opts"
	echo "  expected a reconcile entry with 'replicas=2 (inode)' on the reflink_v keys"
	return 1
    fi

    bcachefs fsck -ny "${devs[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# ---- reconcile target placement tests ----
#
# A target with less durability than data_replicas/metadata_replicas (e.g.
# one ssd, replicas=3) can never fully satisfy reconcile's target goal.
# Reconcile should still do the best possible job — one replica per key on
# the target — then park the remainder on the pending list and terminate,
# rather than re-queueing rewrites forever. A topology change (device add)
# kicks a pending scan that resumes parked work.

usage_dev_bytes()
{
    local label=$1 type=$2

    bcachefs fs usage -f devices /mnt |
	awk -v label="$label" -v type="$type:" '
	    $2 == "(device" && $1 == label	{ in_dev=1; next }
	    $2 == "(device"			{ in_dev=0 }
	    in_dev && $1 == type		{ print $2; exit }'
}

usage_total_bytes()
{
    local type=$1

    bcachefs fs usage -f devices /mnt |
	awk -v type="$type:" '$1 == type { total += $2 } END { print total + 0 }'
}

reconcile_pending_bytes()
{
    local col
    [[ $1 = data ]] && col=2 || col=3

    bcachefs fs usage -f rebalance_work /mnt |
	awk -v col="$col" '$1 == "pending:" { print $col; exit }'
}

require_in_range()
{
    local what=$1 v=${2:-0} lo=$3 hi=$4

    echo "$what: $v (expect $lo..$hi)"
    if (( v < lo || v > hi )); then
	echo "FAIL: $what out of range"
	return 1
    fi
}

btree_node_rewrites()
{
    awk '/since mount/ { print $3 }' /sys/fs/bcachefs/*/counters/btree_node_rewrite
}

# Drive reconcile to completion without `bcachefs reconcile wait`: work
# re-queued by interior btree updates commits asynchronously and doesn't
# yet wake reconcile, so on a quiet fs it can go idle with actionable work
# still queued (and `reconcile wait` stalls). Kick it and poll until the
# non-pending work accounting stays drained — one zero reading isn't
# enough, both because the scan that files work may not have run yet and
# because a kick can transiently unpark pending work for a retry.
reconcile_settle()
{
    local iters=${1:-60} zeros=0 i history=""

    for ((i = 0; i < iters; i++)); do
	echo 1 > /sys/fs/bcachefs/*/internal/trigger_reconcile_wakeup
	sleep 2
	local remaining=$(bcachefs fs usage -f rebalance_work /mnt | awk '
	    $1 ~ /^(replicas|checksum|erasure_code|compression|target|high_priority|stripes):$/ { sum += $2 + $3 }
	    END { print sum + 0 }')
	history+=" $remaining"
	if (( remaining )); then
	    zeros=0
	elif (( ++zeros >= 3 )); then
	    return 0
	fi
    done
    echo "FAIL: reconcile work did not settle"
    echo "remaining-work history (bytes, one sample per 2s):$history"
    bcachefs reconcile status /mnt || true
    bcachefs fs usage -f rebalance_work,devices /mnt || true
    echo "nonzero move/reconcile/alloc counters:"
    grep -H . /sys/fs/bcachefs/*/counters/* 2>/dev/null \
	| grep -v ':0$' \
	| grep -E "move|reconcile|rebalance|update|alloc_fail|nospc" || true
    return 1
}

# metadata_replicas=3, then metadata_target=a single ssd that fits one
# replica: reconcile must place exactly one replica of every btree node on
# the ssd and terminate. Pre-fix this respun btree node rewrites forever:
# btree allocation falls back off target rather than failing, so the
# rewritten node was still off target and got re-queued.
test_reconcile_metadata_target_undersized()
{
    set_watchdog 600

    run_quiet "" bcachefs format -f			\
	--btree_node_size=32k				\
	--metadata_replicas=3				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd3 ${ktest_scratch_dev[3]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt

    # Generate btree nodes spread across all devices:
    mkdir /mnt/fsmark
    fs_mark -S0 -n 30000 -s 0 -d /mnt/fsmark
    sync

    echo ssd > /sys/fs/bcachefs/*/options/metadata_target

    reconcile_settle
    bcachefs reconcile status /mnt
    bcachefs fs usage -f devices,rebalance_work -h /mnt

    # One replica of every node on the ssd == a third of total btree bytes:
    local total_btree=$(usage_total_bytes btree)
    require_in_range "ssd btree bytes" "$(usage_dev_bytes ssd.ssd1 btree)" \
	$((total_btree / 4)) $((total_btree * 5 / 12))

    # The unsatisfiable remainder is parked, not dropped:
    require_in_range "pending metadata bytes" "$(reconcile_pending_bytes metadata)" \
	1 $total_btree

    # Steady state — no rewrite churn:
    local c1=$(btree_node_rewrites)
    sleep 10
    local c2=$(btree_node_rewrites)
    echo "btree node rewrites over 10s idle: $((c2 - c1))"
    if (( c2 - c1 > 8 )); then
	echo "FAIL: reconcile still rewriting btree nodes"
	return 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]:0:4}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# The same shape at the data level: data_replicas=3, background_target=one
# ssd. Every extent should end with exactly one replica on the ssd —
# pre-fix, the data update requested all three replicas in target, failed
# with insufficient_devices, and parked without placing anything.
test_reconcile_data_target_undersized()
{
    # moves to a one-device target ask for data_replicas new copies, get
    # one, and keep the old pointers - the allocator counts the shortfall:
    ktest_expect_sb_errors="write_degraded_insufficient_devices"
    set_watchdog 900

    run_quiet "" bcachefs format -f			\
	--data_replicas=3				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd3 ${ktest_scratch_dev[3]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt

    dd if=/dev/zero of=/mnt/data bs=1M count=500 oflag=direct
    sync

    echo ssd > /sys/fs/bcachefs/*/options/background_target

    reconcile_settle
    bcachefs reconcile status /mnt
    bcachefs fs usage -f devices,rebalance_work -h /mnt

    local total_user=$(usage_total_bytes user)
    require_in_range "ssd user bytes" "$(usage_dev_bytes ssd.ssd1 user)" \
	$((total_user / 4)) $((total_user * 5 / 12))

    require_in_range "pending data bytes" "$(reconcile_pending_bytes data)" \
	1 $total_user

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]:0:4}"
    # Reconcile's per-extent bookkeeping commits race its own data update
    # completions for the same btree leaves, so moving nearly every extent
    # trips the upgrade-restart audit. Known cost of reconcile's
    # read-then-upgrade iterators; accepted, the alternatives are worse:
    bcachefs reset-counters --counters=trans_restart_upgrade ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Overfull target: one replica of the data doesn't fit the target device at
# all. Reconcile fills it as far as the watermark allows, parks the rest,
# and terminates. Adding a second target device then kicks the pending scan
# and the parked work resumes onto the new device.
test_reconcile_data_target_overfull()
{
    set_watchdog 1800

    run_quiet "" bcachefs format -f			\
	--data_replicas=3				\
	--label=ssd.ssd1 ${ktest_scratch_dev[0]}	\
	--label=hdd.hdd1 ${ktest_scratch_dev[1]}	\
	--label=hdd.hdd2 ${ktest_scratch_dev[2]}	\
	--label=hdd.hdd3 ${ktest_scratch_dev[3]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt

    # One replica (1600M) exceeds the 1G target device:
    dd if=/dev/zero of=/mnt/data bs=1M count=1600 oflag=direct
    sync

    echo ssd > /sys/fs/bcachefs/*/options/background_target

    reconcile_settle 120
    bcachefs reconcile status /mnt
    bcachefs fs usage -f devices,rebalance_work -h /mnt

    # Target filled as far as the watermark allows:
    local ssd_user=$(usage_dev_bytes ssd.ssd1 user)
    local ssd_capacity=$(usage_dev_bytes ssd.ssd1 capacity)
    echo "ssd user $ssd_user of capacity $ssd_capacity"
    if (( ssd_user * 2 < ssd_capacity )); then
	echo "FAIL: target not filled before parking"
	return 1
    fi

    local total_user=$(usage_total_bytes user)
    require_in_range "pending data bytes" "$(reconcile_pending_bytes data)" \
	1 $total_user

    # Device add kicks the pending scan; parked work should resume and
    # every extent get one replica on the fresh target device. Disabled
    # for now: the device-add pending scan races freespace init on the
    # new device, so work re-parked in that window never resumes —
    # nothing re-kicks the pending scan when a device *becomes
    # allocatable*. Re-enable once that kick exists.
    #
    #bcachefs device add --label=ssd.ssd2 /mnt ${ktest_scratch_dev[4]}
    #
    #reconcile_settle 120
    #bcachefs reconcile status /mnt
    #bcachefs fs usage -f devices,rebalance_work -h /mnt
    #
    #total_user=$(usage_total_bytes user)
    #require_in_range "ssd2 user bytes" "$(usage_dev_bytes ssd.ssd2 user)" \
    #	$((total_user / 4)) $((total_user * 5 / 12))

    umount /mnt
    # Only the first four devices while the coda is disabled - dev 4 is
    # never formatted without the device add:
    bcachefs fsck -ny "${ktest_scratch_dev[@]:0:4}"
    # Same trans_restart_upgrade suppression as
    # test_reconcile_data_target_undersized, see there:
    bcachefs reset-counters --counters=trans_restart_upgrade ${ktest_scratch_dev[0]}
    # This test deliberately rides the target at full: while it fills,
    # reconcile's dry can-I-improve check (bucket availability) and the
    # real allocator transiently disagree (in-flight updates hold open
    # buckets), so parked extents get retried and fail. The volume is
    # timing-dependent — each kick-triggered pass may rechurn the whole
    # parked list. Expected physics of an overfull target, not a
    # regression signal:
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=bucket_alloc_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Disk reservations at replicas > 1 - GH #1221. Here for the devices, not the
# tiering: raw sectors free say nothing about whether N copies fit on N
# distinct devices, and this file already has four unequal ones.
#
# cehteh had 2x200G + 400G + 2T at replicas=3. When the 200G devices filled
# there was nowhere for a third copy, but 2T of raw space remained, so bcachefs
# kept writing at fewer copies than asked for. With per-device free space
# d_1 >= ... >= d_m, the most storable at n replicas is
#
#	usable(n) = min over k in 0..n-1 of (sum of all but the k largest)/(n-k)
#
# On 1G+1G+16G+16G: usable(3) = min(34G/3, 18G/2, 2G/1) = 2G, against a naive
# total/3 of 11.3G. Don't retarget this at replicas=2 - usable(2) is 17G, which
# is the naive answer too, so it can't tell a fixed build from a broken one.
test_disk_reservation()
{
    set_watchdog 600

    local sectors_per_G=2097152

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--bucket_size=128k			\
	--replicas=3				\
	"${ktest_scratch_dev[@]:0:4}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]:0:4}")" /mnt

    # Resolve and check before parsing: an unmatched glob is passed through
    # literally, and awk on a nonexistent file yields an empty array, which then
    # dies as an unbound variable naming nothing. Say which assumption broke.
    local sysfs=(/sys/fs/bcachefs/*/internal/)
    [[ -r ${sysfs[0]}alloc_debug ]] || {
	echo "FAIL: no readable alloc_debug under /sys/fs/bcachefs/*/internal - contents:"
	ls -la /sys/fs/bcachefs/*/ /sys/fs/bcachefs/*/internal/ 2>&1
	exit 1
    }

    # "slots", not "placeable": slots is the exclusive partition, which is what
    # we want to check the structure of. alloc_debug's "placeable" rows are
    # already the running sum of it, and summing those again is nonsense.
    local avail=($(awk '
	/^sectors_available slots/	{ n = 1; next }
	/^[^ \t]/			{ n = 0 }
	n && $1 ~ /^[0-9]x$/		{ print $2 }
    ' "${sysfs[0]}alloc_debug"))
    ((${#avail[@]} == 4)) || {
	echo "FAIL: parsed ${#avail[@]} replica counts from ${sysfs[0]}alloc_debug, expected 4:"
	cat "${sysfs[0]}alloc_debug"
	exit 1
    }
    echo "slots: ${avail[0]} ${avail[1]} ${avail[2]} ${avail[3]}"

    # The slots are exclusive - avail[n-1] is space placeable at n replicas and
    # NOT at n+1 - so what's placeable at n replicas is the sum from n upwards.
    local placeable=() n j s
    for n in 1 2 3 4; do
	s=0
	for ((j = n; j <= 4; j++)); do
	    s=$((s + avail[j - 1]))
	done
	placeable+=($s)
    done
    echo "placeable: 1x ${placeable[0]}, 3x ${placeable[2]}"

    # 34G at one replica, 6G at three. Windows rather than equalities: sb and
    # journal come off each device first, and it's the two 1G devices - the
    # binding ones - that feel that most. Nothing can exceed the ideal, and a
    # build answering total/n puts 3x up at 1x, far above its ceiling.
    ((placeable[0] > 34 * sectors_per_G * 8 / 10 && placeable[0] <= 34 * sectors_per_G)) ||
	{ echo "FAIL: 1 replica is ${placeable[0]}, expected ~34G of sectors"; exit 1; }
    ((placeable[2] > 6 * sectors_per_G * 8 / 10 && placeable[2] <= 6 * sectors_per_G)) ||
	{ echo "FAIL: 3 replicas is ${placeable[2]}, expected ~6G of sectors (GH #1221)"; exit 1; }

    # Anything placeable at n+1 replicas is placeable at n - you just write one
    # fewer copy - so this has to hold for any device shape. It doesn't if the
    # count is computed as (placeable data) * n: that truncates, by more at
    # higher n, and on uniform devices it puts 3 replicas below 4. It's also
    # what keeps the partition above from going negative.
    for n in 1 2 3; do
	((placeable[n - 1] >= placeable[n])) ||
	    { echo "FAIL: ${n}x placeable ${placeable[n-1]} < $((n+1))x placeable ${placeable[n]}"; exit 1; }
    done

    # The write path first, which is how cehteh met it, and while the
    # filesystem is still empty - a failed fallocate leaves its file behind,
    # and space from a deleted one doesn't necessarily come back by the next
    # statement. bcachefs reserves in write(), so dd sees the ENOSPC itself
    # rather than losing it at writeback.
    #
    # Two sided deliberately: ~2016M fits, so the upper bound is the assertion
    # (the naive number would let all 3072M through) and the lower bound is the
    # control. Without it "wrote 0M" passes, which is exactly what this did
    # when the fallocates ran first.
    dd if=/dev/urandom of=/mnt/fill bs=1M count=3072 2>&1 | tail -n3 || true
    sync
    local written=$(du -m --apparent-size /mnt/fill | cut -f1)
    echo "wrote ${written}M before running out"
    ((written > 1024 && written < 2560)) ||
	{ echo "FAIL: wrote ${written}M, expected ~2016M - only ~2G can hold three copies, but it must hold that much"; exit 1; }
    rm /mnt/fill
    sync

    # fallocate goes straight through bch2_disk_reservation_add(), no writeback
    # in the way. 1G is under both the real limit (2G) and the naive one, so
    # it's the control - and it doubles as proof the rm above gave the space
    # back. 4G is over the real limit and under the naive one, so it's the
    # assertion.
    fallocate -l 1G /mnt/small ||
	{ echo "FAIL: 1G fallocate failed, ~2G should be placeable three times"; exit 1; }
    rm /mnt/small

    if fallocate -l 4G /mnt/toobig; then
	cat "${sysfs[0]}alloc_debug"
	echo "FAIL: 4G fallocate succeeded at replicas=3, only ~2G can hold three copies"
	exit 1
    fi
    rm -f /mnt/toobig

    umount /mnt
    # A write that placed fewer copies than it accounted for surfaces here.
    bcachefs fsck -ny "${ktest_scratch_dev[@]:0:4}"
}

# The slots have to be exclusive, or reservations at different replica counts
# draw the same sectors twice. This is the case that catches it.
#
# The overlap was in the fs-wide pools, not just the percpu caches, so it
# doesn't need a race: filling to 2G short of what's placeable at 1 replica
# leaves the 1x pool with space, so nothing triggers a recalc, so the 3x pool
# is still sitting there holding its own view of sectors the 1x reservation
# already took.
#
#   34G of disk, placeable(1) ~30G, placeable(3) ~5G
#   placeable(1) - 2G at 1 replica	->  2G of disk left
#   1.5G at 3 replicas = 4.5G		->  must fail, and did not before the partition
#
# Sized from what fs usage says is placeable, not hardcoded: the copygc
# reserve moved capacity once already, and a hardcoded 31G made the control
# fail with nothing wrong.
test_disk_reservation_exclusive()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--bucket_size=128k			\
	--replicas=1				\
	"${ktest_scratch_dev[@]:0:4}"

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]:0:4}")" /mnt

    local usage=$(bcachefs fs usage /mnt)
    local free1=$(awk '/^Free:/ { print $2; exit }' <<<"$usage")
    local free3=$(awk '/at 3 replicas:/ { print $4; exit }' <<<"$usage")
    local three=$((3 * 1536 << 20))
    local fill=$(((free1 - (2 << 30)) >> 20 << 20))

    echo "placeable at 1 replica: $free1, at 3: $free3, filling $fill at 1"

    # The premise: 1.5G at 3 fits the 3x pool's view of an empty filesystem,
    # so only exclusivity can refuse it below.
    (( free3 > three )) ||
	{ echo "FAIL: premise - 1.5G at 3 replicas ($three) doesn't fit in $free3 placeable"; exit 1; }

    # Control: if this fails the test is measuring something other than what
    # it thinks.
    fallocate -l $fill /mnt/one ||
	{ echo "FAIL: $fill at 1 replica failed, $free1 should be placeable"; exit 1; }

    mkdir /mnt/three
    bcachefs set-file-option --data_replicas=3 /mnt/three

    # 4.5G of disk against the 2G left. Fits the 3x pool's stale view of the
    # world, which is the bug.
    if fallocate -l 1536M /mnt/three/big; then
	cat /sys/fs/bcachefs/*/internal/alloc_debug
	echo "FAIL: 1.5G at 3 replicas (4.5G of disk) granted after $fill of $free1"
	echo "      was already reserved at 1 - the slots are double counting"
	exit 1
    fi

    # And the reverse ordering, since the draw walks upwards from its own slot
    # and the two directions aren't symmetric.
    rm /mnt/one
    sync
    fallocate -l 1536M /mnt/three/big ||
	{ echo "FAIL: 1.5G at 3 replicas failed on an empty filesystem"; exit 1; }
    if fallocate -l $fill /mnt/one; then
	cat /sys/fs/bcachefs/*/internal/alloc_debug
	echo "FAIL: $fill at 1 replica granted after 4.5G of $free1 was reserved at 3"
	exit 1
    fi

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[@]:0:4}"
}

main $@
