#!/usr/bin/env bash
#
# Arch: CONFIG_RUST=y, GCC 16.1.1, no LTO. The kernel ships its Rust artifacts
# and the rootfs's rustc matches them, so bcachefs's Rust builds against the
# kernel's - the vendored stack here means the probe declined when it should
# not have, and every kernel-Rust-path bug went untested behind a green run.

. "$(dirname "$(readlink -e "${BASH_SOURCE[0]}")")/distro-dkms-libs.sh"

distro_rootfs_prepare arch

test_arch_dkms()
{
    distro_dkms_build arch kernel
}

main "$@"
