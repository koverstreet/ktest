test_dump_sanitize()
{
    rm -f /tmp/dump*

    set_watchdog 60
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    # Small files produce inline_data keys; /usr/bin gives dirents + extents
    echo "sensitive data" > /mnt/secret.txt
    cp -r /usr/bin /mnt
    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    # Sanitize inline data — fsck should still pass
    bcachefs dump -s data -o /tmp/dump ${ktest_scratch_dev[0]}
    bcachefs undump /tmp/dump.qcow2
    bcachefs fsck -ny /tmp/dump
    rm /tmp/dump*

    # Sanitize filenames too — dump/undump shouldn't crash
    bcachefs dump -s filenames -o /tmp/dump ${ktest_scratch_dev[0]}
    bcachefs undump /tmp/dump.qcow2
    rm /tmp/dump*
}

test_kill_btree_node()
{
    set_watchdog 240
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    cp -a /usr /mnt || true
    umount /mnt

    # Doesn't yet work with the alloc btree:
    for btree in extents backpointers freespace; do
	echo "Killing a btree node in btree $btree "
	local index=1

	[[ $btree = freespace ]] && index=0

	bcachefs kill_btree_node -n$btree:0:$index ${ktest_scratch_dev[0]}

	echo "Running fsck"
	# How to assert exit status equals something specific with -o errexit?
	mount -t bcachefs -o fsck,fix_errors,verbose ${ktest_scratch_dev[0]} /mnt
	umount /mnt
	#bcachefs fsck -y ${ktest_scratch_dev[0]} || true

	echo
	echo "Running fsck again; should be clean"

	bcachefs fsck -ny ${ktest_scratch_dev[0]}
    done

    check_bcachefs_leaks
    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

# kill_btree_node zeroes the first block, so nothing about the node parses and
# the only evidence it existed is the parent's pointer. Real media errors don't
# look like that: lioka reported (2026-07-28) a node whose header was intact -
# parent btree_ptr_v2 seq matched, written count and min_key both readable -
# with one bset failing its checksum, and recovery reading it over and over.
#
# -e csum injects that shape. The assertion is that recovery terminates: if it
# spins the watchdog fires, which is the failure we're testing for.
test_btree_node_csum_error()
{
    set_watchdog 240
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    cp -a /usr /mnt || true
    umount /mnt

    local btree
    for btree in extents backpointers; do
	echo "Corrupting a btree node in $btree"
	bcachefs kill_btree_node -e csum -n$btree:0:1 ${ktest_scratch_dev[0]}

	echo "Running fsck"
	mount -t bcachefs -o fsck,fix_errors,verbose ${ktest_scratch_dev[0]} /mnt
	umount /mnt

	echo
	echo "Running fsck again; should be clean"
	bcachefs fsck -ny ${ktest_scratch_dev[0]}
    done

    check_bcachefs_leaks
}

# Same injected shape as above, but read without fix_errors - which is what the
# above never gets to. Mounting with fsck,fix_errors rewrites the node, so by
# the time it runs fsck -ny there's nothing left to trip over; the dry run has
# to come first, and that ordering is the whole test.
#
# No data needed: presplit_shard_boundaries leaves extents leaves whose first
# bset is empty, and one of those is enough to reproduce.
test_btree_node_csum_error_dry_run()
{
    set_watchdog 120
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}

    bcachefs kill_btree_node -e csum -n extents:0:1 ${ktest_scratch_dev[0]}

    # The spin emits without limit - ~10,900 iterations/sec, 124MB of log in 25
    # seconds when measured on a host - and /tmp here is tmpfs, so keeping all of
    # it exhausts the VM's memory long before the watchdog fires. Keep the first
    # chunk, which already holds the repeating pattern, and sink the rest. The
    # tail has to be *consumed* rather than closed: SIGPIPE would kill the fsck,
    # and the test would then pass by stopping the very thing it exists to catch.
    #
    # Watch from outside rather than using timeout, because it isn't established
    # that a spinning fsck dies on a signal here. It does on a host, but the
    # userspace build shims kthreads as pthreads and that hasn't been checked
    # inside a VM - so don't depend on it.
    echo "fsck -n should report the checksum error and exit"
    rm -f /tmp/fsck-dry-run.log /tmp/fsck-dry-run.status
    ( bcachefs fsck -ny ${ktest_scratch_dev[0]} 2>&1;			\
      echo $? > /tmp/fsck-dry-run.status ) |				\
	{ head -c 262144 > /tmp/fsck-dry-run.log; cat > /dev/null; } &
    local pid=$!

    local i
    for i in $(seq 1 30); do
	kill -0 $pid 2>/dev/null || break
	sleep 1
    done

    if kill -0 $pid 2>/dev/null; then
	echo "ERROR: fsck -n still running after 30s, looping on the same node"
	echo "       repetitions in the first 256K of output:" \
	     $(grep -c "checksum error" /tmp/fsck-dry-run.log)
	grep -m2 "checksum error" /tmp/fsck-dry-run.log

	# Take it down before failing. A spinning fsck keeps the scratch
	# device open, and every later test in the run then dies instantly
	# on "Device or resource busy" - six of them the first time this
	# fired, all reported as failures having never run, which buries the
	# one real result under a pile of noise. $pid is the pipeline's tail,
	# not the fsck, so kill the fsck by name: SIGKILL because the whole
	# point of being here is that it isn't responding to anything gentler.
	#
	# -x matches the process name. -f would match the whole command line,
	# and so would also match any shell whose cmdline merely contains the
	# pattern - including one running a script that mentions it. Nothing
	# else is named bcachefs by this point; the format and kill_btree_node
	# runs are long finished.
	pkill -KILL -x bcachefs 2>/dev/null
	kill -KILL $pid 2>/dev/null

	# Deliberately not `wait $pid`. $pid is the pipeline tail - the cat
	# draining the fsck's output - and it cannot see EOF until the fsck's
	# stdout closes. A livelocked in-kernel fsck does not close it promptly
	# even under SIGKILL: teardown reaches kthread_stop() and blocks waiting
	# for the very kthread that is spinning (observed - "task shrinkers
	# blocked for more than 30 seconds", ..._thread_with_file_exit ->
	# kthread_stop -> wait_for_completion). Waiting here hands the test to
	# the outer 120s watchdog and turns a named failure into FAILED TIMEOUT,
	# which is how this read on the dashboard.
	local j
	for j in $(seq 1 10); do
	    pgrep -x bcachefs >/dev/null || break
	    sleep 1
	done

	if pgrep -x bcachefs >/dev/null; then
	    echo "       AND it survived SIGKILL, still present after 10s -"
	    echo "       expected for this livelock: teardown blocks in"
	    echo "       kthread_stop() on the kthread that is spinning, so the"
	    echo "       process cannot be reaped. The device stays busy and"
	    echo "       nothing after this point in the run is trustworthy."
	fi

	exit 1
    fi

    wait $pid
    local ret=$(cat /tmp/fsck-dry-run.status 2>/dev/null)
    local lines=$(wc -l < /tmp/fsck-dry-run.log)
    local errs=$(grep -c "checksum error" /tmp/fsck-dry-run.log)

    echo "fsck -n exited $ret after $lines lines, $errs checksum errors"

    # Also guards the injector: -e csum used to flip a byte past the end of the
    # checksummed region when the target node's first bset was empty, which made
    # the whole thing a silent no-op.
    if [[ $errs = 0 ]]; then
	echo "ERROR: fsck -n reported no checksum error - was anything injected?"
	exit 1
    fi

    echo "Repair should still work, and leave it clean"
    bcachefs fsck -y ${ktest_scratch_dev[0]}
    bcachefs fsck -ny ${ktest_scratch_dev[0]}

    check_bcachefs_leaks
}

test_kill_btree_root_autofix()
{
    set_watchdog 240
    run_quiet "" bcachefs format -f			\
	--btree_node_size=64k				\
	--encrypted --no_passphrase			\
	${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    cp -rL /usr/bin /mnt
    sync

    cat /sys/kernel/debug/bcachefs/*/btrees/extents/keys > /root/extents_before

    umount /mnt
    bcachefs list -m nodes ${ktest_scratch_dev[0]} > /root/nodes_before

    bcachefs kill_btree_node -naccounting:1 -nextents:1 ${ktest_scratch_dev[0]}

    echo "Running fsck"
    # How to assert exit status equals something specific with -o errexit?
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    cat /sys/kernel/debug/bcachefs/*/btrees/extents/keys > /root/extents_after

    umount /mnt
    bcachefs list -m nodes ${ktest_scratch_dev[0]} > /root/nodes_after
    #bcachefs fsck -y ${ktest_scratch_dev[0]} || true

    echo
    echo "Running fsck again; should be clean"

    bcachefs fsck -yk ${ktest_scratch_dev[0]} || true
    mount -t bcachefs -o fsck,fix_errors,verbose ${ktest_scratch_dev[0]} /mnt
    diff -rq /usr/bin /mnt/bin
    umount /mnt

    check_bcachefs_leaks
    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

