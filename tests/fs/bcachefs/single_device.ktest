d_test_nocow_fragmented2()
{
    modprobe brd rd_size=536870912 rd_nr=7
    bcachefs format -f --nocow					\
	--foreground_target=/dev/ram4				\
	--promote_target=/dev/ram5				\
	/dev/ram1 /dev/ram2 /dev/ram5 /dev/ram0			\
	/dev/ram4 /dev/ram6 /dev/ram3
    mount -t bcachefs /dev/ram1:/dev/ram2:/dev/ram5:/dev/ram0:/dev/ram4:/dev/ram6:/dev/ram3 /mnt
    fio --group_reporting					\
	--ioengine=io_uring					\
	--directory=/mnt --size=16m				\
	--time_based --runtime=60s				\
	--iodepth=256 --verify_async=8				\
	--bs=4k-64k --norandommap				\
	--random_distribution=zipf:0.5 --numjobs=16 --rw=randrw	\
	--name=A --direct=1 --name=B --direct=0 >/dev/null &
    sleep 10
    bcachefs device offline /dev/ram5

    wait
    umount /mnt
}

# tools#1053: a torn write to the primary superblock leaves a copy with a higher
# seq and a checksum that doesn't match. We open from a backup, but the next
# superblock write reads slot 0 back first, sees the higher seq, takes it for
# another writer and goes emergency read-only - on every mount.
test_torn_primary_superblock()
{
    set_watchdog 60
    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f $dev

    # format writes the superblock unchecksummed; the first mount writes it
    # with a checksum, which is what a torn write has to break
    local mark=$(dmesg | wc -l)
    mount -t bcachefs $dev /mnt
    umount /mnt

    # all copies are at the same seq here: nothing to repair
    if dmesg | tail -n +$((mark + 1)) | grep "rewrote primary superblock" >/dev/null; then
	echo "ERROR: rewrote a healthy primary superblock"
	return 1
    fi

    # seq is at byte 112 of struct bch_sb, the primary at sector 8: bump the
    # low byte, leaving the checksum stale
    local off=$((4096 + 112))
    local b=$(od -An -tu1 -j $off -N1 $dev | tr -d ' ')
    (( b < 255 ))
    printf "\\x$(printf %02x $((b + 1)))" |
	dd of=$dev bs=1 seek=$off conv=notrunc status=none
    sync

    mount -t bcachefs $dev /mnt
    touch /mnt/foo
    umount /mnt

    if dmesg | grep "Superblock modified by another process" >/dev/null; then
	echo "ERROR: torn primary superblock taken for another writer"
	return 1
    fi

    # The primary must have been rewritten: a fresh read shouldn't need the
    # backups
    if bcachefs show-super $dev 2>&1 | grep "primary superblock unreadable" >/dev/null; then
	echo "ERROR: primary superblock not repaired"
	return 1
    fi
}

# The rotational flag decides, for an extent with reconcile work pending,
# whether its backpointers carry BACKPOINTER_RECONCILE_PHYS and have matching
# reconcile_work_phys entries - set when the backpointer is created. So
# flipping it on a device with pending work leaves those backpointers stale,
# and the flip schedules check_reconcile_work to repair them quietly. Reconcile
# is off so the background_compression work stays pending across the flip;
# after it, overwrite and delete some of the old data so the update paths run
# too. fsck -n must then be clean.
rotational_flip_mount()
{
    mount -t bcachefs -o reconcile_enabled=0 ${ktest_scratch_dev[0]} /mnt
}

# Start from @1 explicitly - virtio disks report rotational, so what format
# autodetects isn't a choice we'd get to test both directions with
rotational_flip_format()
{
    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f --background_compression=zstd $dev
    # set-fs-option refuses a filesystem that has never been started
    rotational_flip_mount
    echo $1 > /sys/fs/bcachefs/*/dev-0/rotational
    umount /mnt
}

rotational_flip_write()
{
    dd if=/dev/zero of=/mnt/a bs=1M count=32 conv=fsync status=none
    dd if=/dev/zero of=/mnt/b bs=1M count=32 conv=fsync status=none
}

# The repair pass is scheduled on the flip, and online it runs in the background
rotational_flip_wait_repair()
{
    local i
    for i in $(seq 1 60); do
	grep -qE '^(Scheduled|Currently running).*check_reconcile_work' \
	    /sys/fs/bcachefs/*/recovery_status || return 0
	sleep 1
    done
    echo "ERROR: check_reconcile_work never finished"
    cat /sys/fs/bcachefs/*/recovery_status
    return 1
}

rotational_flip_churn()
{
    [[ $(cat /sys/fs/bcachefs/*/dev-0/rotational) == $1 ]]
    rotational_flip_wait_repair
    dd if=/dev/zero of=/mnt/a bs=1M count=8 seek=4 conv=notrunc,fsync status=none
    rm /mnt/b
    sync
}

test_rotational_flip_offline()
{
    set_watchdog 180
    local dev=${ktest_scratch_dev[0]}

    for from in 0 1; do
	local to=$((1 - from))
	echo "=== offline flip $from -> $to"

	rotational_flip_format $from
	rotational_flip_mount
	rotational_flip_write
	umount /mnt

	# the work the flip has to deal with
	(( $(bcachefs list -b reconcile_work $dev | wc -l) > 0 ))

	bcachefs set-fs-option --rotational=$to -d 0 $dev

	rotational_flip_mount
	rotational_flip_churn $to
	umount /mnt

	bcachefs fsck -n $dev
    done
}

test_rotational_flip_online()
{
    set_watchdog 180

    for from in 0 1; do
	local to=$((1 - from))
	echo "=== online flip $from -> $to"

	rotational_flip_format $from
	rotational_flip_mount
	rotational_flip_write

	echo $to > /sys/fs/bcachefs/*/dev-0/rotational
	rotational_flip_churn $to
	umount /mnt

	bcachefs fsck -n ${ktest_scratch_dev[0]}
    done
}

test_recover_super()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f		\
	${ktest_scratch_dev[0]}
    bcachefs show-super -l ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    cp -rx /usr/bin /mnt/usr
    umount /mnt

    echo "Wiping super"
    dd if=/dev/zero of=${ktest_scratch_dev[0]} bs=1M count=1 oflag=direct

    echo "Attempting mount, should fail"
    assert_fails mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    echo "Recovering superblock"
    bcachefs recover-super -y ${ktest_scratch_dev[0]}

    echo "Attempting mount, should succeed"
    mount -t bcachefs -o fsck ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    check_bcachefs_counters ${ktest_scratch_dev[0]}
}

# Check that we can mount multiple single device filesystems with the same UUID
test_single_device()
{
    run_quiet "" bcachefs format -f --no_initialize ${ktest_scratch_dev[0]}

    dd if=${ktest_scratch_dev[0]} of=${ktest_scratch_dev[1]} bs=1M count=8 oflag=direct

    mkdir -p /mnt2

    mount  ${ktest_scratch_dev[0]} /mnt
    mount  ${ktest_scratch_dev[1]} /mnt2

    umount /mnt2
    umount /mnt
}

require-kernel-config OVERLAY_FS

test_casefold_overlayfs()
{
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    mkdir -p /mnt/dir/casefold
    bcachefs set-file-option --casefold /mnt/dir/casefold

    echo foo > /mnt/dir/casefold/foo
    cat /mnt/dir/casefold/FOO

    mkdir /mnt/lower
    mkdir /mnt/upper
    mkdir /mnt/work
    mkdir /mnt/merged

    echo "Testing an overlayfs on a casefold fs with non-casefolded dirs"
    mount -t overlay -o lowerdir=/mnt/lower,upperdir=/mnt/upper,workdir=/mnt/work overlay /mnt/merged
    umount /mnt/merged

    echo "Test using casefolded dir - should fail"
    assert_fails mount -t overlay -o lowerdir=/mnt/casefold,upperdir=/mnt/dir/casefold,workdir=/mnt/work overlay /mnt/merged

    echo "Test using a dir with a casefold subdir - should mount"
    mount -t overlay -o lowerdir=/mnt/dir,upperdir=/mnt/upper,workdir=/mnt/work overlay /mnt/merged
    assert_fails ls /mnt/merged/dir/casefold
    umount /mnt/merged

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

# scsi_debug_disk <size_mb> <num_parts>
#
# Load scsi_debug fresh and print its disk (/dev/sdX), once partitions
# 1..num_parts exist. For tests that need what loop/virtio scratch devices
# don't have: a real model in sysfs, and partitions of one parent disk.
# SCSI_DEBUG=m is in the base kconfig, so failing to load it is an error.
scsi_debug_disk()
{
    local size_mb=$1 num_parts=$2 disk= d i p

    modprobe -r scsi_debug 2>/dev/null || true
    modprobe scsi_debug dev_size_mb=$size_mb num_parts=$num_parts || {
	echo "failed to load scsi_debug" >&2
	return 1
    }

    for i in $(seq 1 10); do
	for d in /sys/block/sd*; do
	    if grep -qi scsi_debug "$d/device/model" 2>/dev/null; then
		disk=/dev/$(basename "$d")
		break 2
	    fi
	done
	sleep 1
    done
    [[ -n $disk ]] || { echo "scsi_debug device not found" >&2; return 1; }

    for p in $(seq 1 $num_parts); do
	for i in $(seq 1 10); do [[ -b $disk$p ]] && break; sleep 1; done
	[[ -b $disk$p ]] || { echo "scsi_debug partition $disk$p not found" >&2; return 1; }
    done

    echo "$disk"
}

test_device_model_stored_partition()
{
    set_watchdog 120

    # Regression test for bcachefs-tools #595: a device's model/serial must be
    # stored in the superblock at attach time. The bug built the sysfs path
    # from the *partition* name (e.g. sdr1), which doesn't exist under
    # /sys/block (only whole disks do), so the read failed and the field was
    # left empty for any partitioned device.
    #
    # loop/virtio scratch devices have no model in sysfs, so use scsi_debug,
    # which presents a real model ("scsi_debug") and a partition table.
    local disk
    disk=$(scsi_debug_disk 128 1)
    local part="${disk}1"

    echo "scsi_debug part=$part sysfs model='$(cat /sys/block/$(basename "$disk")/device/model)'"

    run_quiet "" bcachefs format -f "$part"
    mount -t bcachefs "$part" /mnt
    umount /mnt

    local stored
    stored="$(bcachefs show-super "$part" |
	      grep 'Last device model:' | sed 's/.*Last device model:[[:space:]]*//')"
    echo "stored device model='$stored'"
    [[ -n $stored ]] || { echo "FAIL: device model not stored for partition $part (#595)"; return 1; }
}

# bcachefs format warns when two format devices are partitions of the same
# disk, since replicas on them don't survive losing that disk
# (koverstreet/bcachefs-tools#666). A warning, not an error - see
# koverstreet/bcachefs#144 - and --quiet suppresses it.
test_format_warns_when_replicas_share_parent_disk()
{
    set_watchdog 120

    local disk out
    disk=$(scsi_debug_disk 256 2)
    local part1="${disk}1" part2="${disk}2"

    out="$(bcachefs format -f --replicas=2 "$part1" "$part2" 2>&1)"
    echo "$out"
    grep -F "warning: requested 2 replicas" <<< "$out"
    grep -F "warning: multiple format devices share a parent disk:" <<< "$out"
    grep -F "$part1" <<< "$out"
    grep -F "$part2" <<< "$out"

    out="$(bcachefs format -f -q --replicas=2 "$part1" "$part2" 2>&1)"
    echo "$out"
    if grep -F "warning:" <<< "$out"; then
	echo "FAIL: --quiet didn't suppress the parent disk warning"
	return 1
    fi

    modprobe -r scsi_debug
}

# Replace-in-place via O_TRUNC (`date | tee f`, editors, config writers): the
# truncate commits with the next journal write, the new data sits dirty for
# dirty_expire (30s), so a crash in between leaves an empty file. bcachefs
# starts writeback on close of a file that was truncated to 0 - the same
# workaround as ext4's auto_da_alloc - see DOC(replace-in-place) in
# fs/vfs/fs.c.
#
# The crash comes a few seconds after close: long enough for the writeback we
# start and a journal commit, well short of dirty_expire, so without the
# flush every file comes back empty. The old contents are on disk beforehand,
# so an empty file can only be the truncate winning the race.
test_truncate_rewrite_flush_on_close()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local i
    for i in {0..9}; do echo "old $i" > /mnt/$i; done
    umount /mnt
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    for i in {0..9}; do echo "new $i" > /mnt/$i; done
    sleep 5

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    local bad=0
    for i in {0..9}; do
	local got=$(cat /mnt/$i)
	echo "$i: size $(stat -c %s /mnt/$i): $got"
	[[ $got == "new $i" ]] || bad=1
    done
    umount /mnt

    if (( bad )); then
	echo "FAIL: truncated and rewritten files lost their new contents across a crash"
	return 1
    fi
}

#
# Checksum narrowing: after a partial overwrite, each surviving piece of a
# checksummed extent keeps a checksum over the whole original range, so every
# read of it reads and bounces that whole range. The first read of such a piece
# should recompute the checksum over just the live range and rewrite the key
# (bch2_rbio_narrow_crcs()).
#
# Since "bcachefs: Make checksum narrowing more paranoid", can_narrow_crc()
# tests uncompressed_size < live_size, which no valid key satisfies (live_size
# is the key's size, and crc.offset + live_size <= uncompressed_size is a
# validate check). So narrowing never runs: data_read_narrow_crcs stays 0, the
# pieces keep their 512k crc, and a repeat read still reads 512k.

counter_since_mount()
{
    awk '/since mount/ { print $3 }' /sys/fs/bcachefs/*/counters/$1
}

dev_sectors_read()
{
    awk '{ print $3 }' /sys/block/$(basename $(readlink -f $1))/stat
}

# extent_crcs <inum>
#
# One line per extent of <inum>: "<start> <len> <crc size> <crc offset> <csum>",
# in 512-byte sectors, bcachefs's unit whatever the device's logical block size
# (the filesystem block size here is 4k). Key lines print as "u64s N type extent <inum>:<end>:<snap> len L",
# crc entries as "crcNN: c_size C size S offset O nonce N csum T ...".
extent_crcs()
{
    awk -v ino="$1" '
	/^u64s / {
	    want = 0
	    if ($4 != "extent")
		next
	    split($5, p, ":")
	    if (p[1] != ino)
		next
	    want = 1
	    end = p[2]
	    len = $7
	}
	want && /crc(32|64|128): c_size/ {
	    for (i = 1; i < NF; i++) {
		if ($i == "size")
		    size = $(i + 1)
		if ($i == "offset")
		    off = $(i + 1)
		if ($i == "csum")
		    csum = $(i + 1)
	    }
	    print end - len, len, size, off, csum
	    want = 0
	}' /sys/kernel/debug/bcachefs/*/btrees/extents/keys
}

# Layout, in 512-byte sectors: one 1024-sector (512k) extent, with the 8
# sectors (4k) at 512 (256k) overwritten. The left piece is 0..512 (crc offset 0), the right piece
# 520..1024 (crc offset 520), and both keep the 1024-sector crc until narrowed.
narrow_crcs_test()
{
    local dev=${ktest_scratch_dev[0]}
    local ret=0

    set_watchdog 120

    # Extents are also capped by the write point bucket's free space, so the
    # bucket must hold the whole 512k write.
    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--bucket_size=1M			\
	--encoded_extent_max=512k		\
	--compression=none			\
	"$@"					\
	$dev

    dd if=/dev/urandom of=/tmp/expect bs=512k count=1 status=none
    dd if=/dev/urandom of=/tmp/patch bs=4k count=1 status=none

    mount -t bcachefs $dev /mnt
    dd if=/tmp/expect of=/mnt/f bs=512k count=1 iflag=fullblock oflag=direct status=none
    sync
    local ino=$(stat -c %i /mnt/f)
    echo "after the 512k write:"
    extent_crcs $ino

    dd if=/tmp/patch of=/mnt/f bs=4k count=1 seek=64 conv=notrunc oflag=direct status=none
    dd if=/tmp/patch of=/tmp/expect bs=4k count=1 seek=64 conv=notrunc status=none
    sync
    local layout=$(extent_crcs $ino)
    echo "after the 4k overwrite at 256k:"
    echo "$layout"
    umount /mnt

    if ! grep -qx '0 512 1024 0 [a-z0-9_]*' <<< "$layout" ||
       ! grep -qx '520 504 1024 520 [a-z0-9_]*' <<< "$layout"; then
	echo "ERROR: no partially overwritten 512k extent - this run tests nothing"
	return 1
    fi

    # A fresh mount, so the reads below go to disk and the counters start at 0.
    mount -t bcachefs $dev /mnt

    dd if=/mnt/f of=/dev/null bs=4k count=1 iflag=direct status=none
    dd if=/mnt/f of=/dev/null bs=4k count=1 skip=65 iflag=direct status=none

    local narrowed=$(counter_since_mount data_read_narrow_crcs)
    local failed=$(counter_since_mount data_read_narrow_crcs_fail)
    local bounced=$(counter_since_mount data_read_bounce)
    echo "one read of each piece: narrow_crcs $narrowed, narrow_crcs_fail $failed, bounce $bounced"

    if [[ $bounced -lt 2 ]]; then
	echo "ERROR: the reads did not bounce - this run tests nothing"
	return 1
    fi

    if [[ $narrowed != 2 || $failed != 0 ]]; then
	echo "ERROR: expected both pieces narrowed (narrow_crcs 2, narrow_crcs_fail 0)"
	ret=1
    fi

    layout=$(extent_crcs $ino)
    echo "after the reads:"
    echo "$layout"
    if ! grep -qx '0 512 512 0 [a-z0-9_]*' <<< "$layout" ||
       ! grep -qx '520 504 504 0 [a-z0-9_]*' <<< "$layout"; then
	echo "ERROR: the pieces' crcs still cover the whole original extent"
	ret=1
    fi

    local before=$(dev_sectors_read $dev)
    dd if=/mnt/f of=/dev/null bs=4k count=1 iflag=direct status=none
    local read=$(( $(dev_sectors_read $dev) - before ))
    echo "a repeat 4k read of the left piece read $read sectors ($((read / 2))k) from $dev"
    if [[ $read -ge 1024 ]]; then
	echo "ERROR: a 4k read of the 256k left piece still reads the whole 512k extent"
	ret=1
    fi

    umount /mnt

    mount -t bcachefs $dev /mnt
    if ! cmp /mnt/f /tmp/expect; then
	echo "ERROR: file contents changed"
	ret=1
    fi
    umount /mnt

    bcachefs fsck -ny $dev
    bcachefs_test_end_checks $dev
    return $ret
}

test_narrow_crcs()
{
    narrow_crcs_test --data_checksum=crc32c
}

test_narrow_crcs_encrypted()
{
    narrow_crcs_test --encrypted --no_passphrase
}


# Read amplification of buffered overwrites that don't cover whole page cache
# folios, over checksummed extents.
#
# A buffered write that covers only part of a folio reads the folio in first
# (__bch2_buffered_write() -> bch2_read_single_folio()). A checksum covers the
# whole extent, so that read fetches up to encoded_extent_max from disk, but it
# fills only the one folio: its bio has a single bvec and no readahead iterator,
# so readpage_bio_extend() never runs, and the rest is discarded. The next
# write's folio is in the same extent, so a sequential rewrite in 16k writes
# that aren't folio aligned reads every 512k extent once per 16k folio: about
# 32x the data written. Download clients that write one stream of
# concatenated files do this: file boundaries fall at arbitrary offsets.
#
# Expected to fail until the single-folio read in the write path puts the rest
# of the extent it has to read anyway into the page cache.

UO_FILE_MB=64
UO_EXTENT_SECTORS=1024
UO_WRITE=16384

uo_sectors_read()
{
    awk '{ print $3 }' /sys/block/$1/stat
}

uo_counter()
{
    awk '/since mount/ { print $3 }' /sys/fs/bcachefs/*/counters/$1
}

# Succeeds if inode $1's extents in the listing on stdin are all one whole,
# aligned, uncompressed crc32c region of UO_EXTENT_SECTORS each.
uo_check_extents()
{
    awk -v ino=$1 -v want=$UO_EXTENT_SECTORS \
	-v nr=$((UO_FILE_MB * 2048 / UO_EXTENT_SECTORS)) '
	function flush() {
	    if (!have)
		return
	    n++
	    if (len != want || c_size != want || size != want || offset != 0 ||
		csum != "crc32c" || compress != "none" || (end - len) % want) {
		bad++
		print "unexpected extent: " key
	    }
	    have = 0
	}
	/^u64s / {
	    flush()
	    split($5, p, ":")
	    if (p[1] "" != ino "")
		next
	    have = 1; key = $0; end = p[2]
	    len = c_size = size = offset = -1; csum = compress = ""
	    for (i = 1; i < NF; i++)
		if ($i == "len")
		    len = $(i + 1)
	}
	have && /crc(32|64|128): / {
	    for (i = 1; i < NF; i++) {
		if ($i == "c_size")	c_size = $(i + 1)
		if ($i == "size")	size = $(i + 1)
		if ($i == "offset")	offset = $(i + 1)
		if ($i == "csum")	csum = $(i + 1)
		if ($i == "compress")	compress = $(i + 1)
	    }
	}
	END {
	    flush()
	    print "extents: " n + 0 " (want " nr "), unexpected: " bad + 0
	    exit !(n == nr && !bad)
	}'
}

# uo_pass <name> <offset>: write a fresh file of 512k checksummed extents,
# then rewrite it with sequential 16k buffered writes starting at <offset>.
# Sets uo_amp to device bytes read per 100 bytes written by the rewrite.
uo_pass()
{
    local name=$1 start=$2
    local dev=${ktest_scratch_dev[0]}
    local devname=$(basename $(readlink -f $dev))
    local nr=$((UO_FILE_MB * 1024 * 1024 / UO_WRITE - 1))
    local len=$((nr * UO_WRITE))

    echo "=== $name: $nr x 16k writes from offset $start"

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--bucket_size=2M			\
	--encoded_extent_max=512k		\
	--data_checksum=crc32c			\
	--compression=none			\
	$dev

    dd if=/dev/urandom of=/tmp/uo-model bs=1M count=$UO_FILE_MB status=none

    # One write per extent: a larger O_DIRECT write is split into bios along
    # the user buffer's pages, and extents are cut from each bio's start.
    mount -t bcachefs $dev /mnt
    dd if=/tmp/uo-model of=/mnt/f bs=512k oflag=direct status=none
    local ino=$(stat -c %i /mnt/f)
    umount /mnt

    bcachefs list -b extents $dev > /tmp/uo-$name.keys
    if ! uo_check_extents $ino < /tmp/uo-$name.keys; then
	echo "ERROR: $name: precondition failed, extents are not what this test measures:"
	head -n 30 /tmp/uo-$name.keys
	return 1
    fi

    # Mounted fresh, so none of the file is in the page cache.
    mount -t bcachefs $dev /mnt
    local r0=$(uo_sectors_read $devname) b0=$(uo_counter data_read_bounce)
    xfs_io -c "pwrite -S 0x5a -b $UO_WRITE $start $len" -c fsync /mnt/f
    local r1=$(uo_sectors_read $devname) b1=$(uo_counter data_read_bounce)
    umount /mnt

    local read=$(( (r1 - r0) * 512 ))
    uo_amp=$(( read * 100 / len ))
    printf '%s: wrote %d KiB, device read %d KiB (%d.%02dx), bounced reads %d\n' \
	$name $((len >> 10)) $((read >> 10)) $((uo_amp / 100)) $((uo_amp % 100)) $((b1 - b0))

    xfs_io -c "pwrite -S 0x5a -b $UO_WRITE $start $len" /tmp/uo-model
    mount -t bcachefs $dev /mnt
    cmp /mnt/f /tmp/uo-model
    umount /mnt
    rm -f /tmp/uo-model

    bcachefs fsck -ny $dev
}

test_unaligned_overwrite_read_amp()
{
    set_watchdog 600

    local devname=$(basename $(readlink -f ${ktest_scratch_dev[0]}))
    if [[ ! -e /sys/block/$devname/stat ]]; then
	echo "ERROR: no /sys/block/$devname/stat to measure reads from"
	return 1
    fi

    local ret=0

    # 16k aligned: every write covers a whole folio, so nothing is read. If
    # this reads much, the measurement is confounded and the rest is moot.
    uo_pass folio_aligned 0
    local control=$uo_amp

    # A file starting at an arbitrary stream offset: not even block aligned.
    uo_pass unaligned 1536
    local unaligned=$uo_amp

    # Block aligned is not enough: folios are allocated at the write's size and
    # alignment, so the 16k folio after each write is still partly covered.
    uo_pass block_aligned 4096
    local block_aligned=$uo_amp

    if (( control > 50 )); then
	echo "ERROR: folio aligned control read ${control}% of what it wrote"
	ret=1
    fi

    if (( unaligned > 200 )); then
	echo "ERROR: unaligned overwrite read ${unaligned}% of what it wrote"
	ret=1
    fi

    if (( block_aligned > 200 )); then
	echo "ERROR: block aligned overwrite read ${block_aligned}% of what it wrote"
	ret=1
    fi

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
    return $ret
}


# An offline superblock edit persists the edit, and nothing else. The open
# used to make the version upgrade/downgrade decision a start would make, and
# the write that followed persisted it - set-fs-option on an unmounted
# filesystem upgraded it to whatever version the tools know, possibly newer
# than the kernel that mounts it next.
test_offline_sb_edit_keeps_version()
{
    local dev=${ktest_scratch_dev[0]}

    set_watchdog 60

    run_quiet "" bcachefs format -f --version=1.38 $dev
    # offline edits refuse a never-started filesystem; start it without
    # letting the mount upgrade it either
    mount -t bcachefs -o version_upgrade=none $dev /mnt
    umount /mnt

    local before=$(bcachefs show-super $dev | grep -E '^Version( upgrade complete)?:')
    echo "$before"

    bcachefs set-fs-option --compression=lz4 $dev

    if ! bcachefs show-super $dev | grep -E '^ +compression: +lz4$' >/dev/null; then
	echo "ERROR: set-fs-option did not write the option"
	bcachefs show-super $dev | grep -E '^ +compression:'
	return 1
    fi

    local after=$(bcachefs show-super $dev | grep -E '^Version( upgrade complete)?:')
    if [[ "$after" != "$before" ]]; then
	echo "ERROR: an offline set-fs-option changed the superblock version:"
	echo "$after"
	return 1
    fi
}

# Offline superblock edits have to write what they say they write, leave the
# version alone, and refuse a filesystem that has never been started - where
# bch2_write_super() skips the write - rather than report success.

offline_sb_counter()
{
    bcachefs show-super --field-only counters $1 | awk -v c=$2 '$1 == c { print $2 }'
}

sb_version()
{
    bcachefs show-super $1 | grep -E '^Version( upgrade complete)?:'
}

test_reset_counters_offline()
{
    local dev=${ktest_scratch_dev[0]}

    set_watchdog 60

    run_quiet "" bcachefs format -f $dev
    if bcachefs reset-counters $dev; then
	echo "ERROR: reset-counters claimed success on a never-started filesystem"
	return 1
    fi

    mount -t bcachefs $dev /mnt
    dd if=/dev/zero of=/mnt/f bs=1M count=8 conv=fsync status=none
    umount /mnt

    local version=$(sb_version $dev)
    local before=$(offline_sb_counter $dev transaction_commit)
    if [[ -z $before || $before -eq 0 ]]; then
	echo "ERROR: transaction_commit is \"$before\" after writing - this run tests nothing"
	return 1
    fi

    bcachefs reset-counters --counters=transaction_commit $dev

    local after=$(offline_sb_counter $dev transaction_commit)
    echo "transaction_commit: $before -> $after"
    if [[ $after -ne 0 ]]; then
	echo "ERROR: reset-counters didn't persist"
	return 1
    fi
    if [[ "$(sb_version $dev)" != "$version" ]]; then
	echo "ERROR: reset-counters changed the superblock version:"
	sb_version $dev
	return 1
    fi
}

test_recovery_pass_offline()
{
    local dev=${ktest_scratch_dev[0]}

    set_watchdog 60

    run_quiet "" bcachefs format -f $dev
    if bcachefs recovery-pass --set check_allocations $dev; then
	echo "ERROR: recovery-pass claimed success on a never-started filesystem"
	return 1
    fi

    mount -t bcachefs $dev /mnt
    umount /mnt

    local version=$(sb_version $dev)

    bcachefs recovery-pass --set check_allocations $dev
    # a fresh open reads it back from disk:
    if ! bcachefs recovery-pass $dev | grep check_allocations >/dev/null; then
	echo "ERROR: recovery-pass --set didn't persist:"
	bcachefs recovery-pass $dev
	return 1
    fi

    bcachefs recovery-pass --unset check_allocations $dev
    if bcachefs recovery-pass $dev | grep check_allocations >/dev/null; then
	echo "ERROR: recovery-pass --unset didn't persist:"
	bcachefs recovery-pass $dev
	return 1
    fi

    if [[ "$(sb_version $dev)" != "$version" ]]; then
	echo "ERROR: recovery-pass changed the superblock version:"
	sb_version $dev
	return 1
    fi
}

# The passphrase lifecycle on an existing filesystem: adding one, changing
# one, and taking one off.
#
# Prompted by noradtux (IRC, 2026-09-03): formatted --encrypted
# --no_passphrase, later tried to set a passphrase on the unmounted fs, got
# an error he couldn't read. That path - encryption enabled with the master
# key stored in the clear - is the one with no coverage anywhere, and it is
# a different branch in open_and_verify() from the passphrase-protected
# case: it reads the raw key out of the superblock instead of prompting.
#
# set-passphrase has no --passphrase_file, unlike format and unlock, so the
# only way to drive it is stdin. ask_for_new_passphrase() falls back to
# read_from_stdin() when stdin is not a terminal, and in that mode it takes
# one line and does not ask for confirmation.

PASS_A="correct-horse-battery-staple"
PASS_B="second-passphrase-entirely"

dev() { echo "${ktest_scratch_dev[0]}"; }

# Both formats mount once: set-passphrase and remove-passphrase write the
# superblock, and a filesystem that has never been started has no initialized
# superblock to write - they refuse it ("mount it once first"), as
# set-fs-option does.
format_no_passphrase()
{
    run_quiet "" bcachefs format -f --encrypted --no_passphrase $(dev)
    mount -t bcachefs $(dev) /mnt
    umount /mnt
}

format_with_passphrase()
{
    echo "$1" > /run/pass-in
    run_quiet "" bcachefs format -f --encrypted --passphrase_file=/run/pass-in $(dev)
    mount -t bcachefs $(dev) /mnt < /run/pass-in
    umount /mnt
    rm -f /run/pass-in
}

# Does this passphrase actually open the filesystem? unlock is the check that
# doesn't depend on set-passphrase having told the truth about itself.
unlock_succeeds()
{
    echo "$1" > /run/pass-check
    local rc=0
    bcachefs unlock --file=/run/pass-check $(dev) > /run/unlock-out 2>&1 || rc=$?
    rm -f /run/pass-check
    return $rc
}

# --- noradtux's case ------------------------------------------------------

test_set_passphrase_on_no_passphrase_fs()
{
    format_no_passphrase

    if ! echo "$PASS_A" | bcachefs set-passphrase $(dev) > /run/set-out 2>&1; then
	echo "set-passphrase failed on a --no_passphrase filesystem:"
	cat /run/set-out
	return 1
    fi

    if ! unlock_succeeds "$PASS_A"; then
	echo "set-passphrase reported success but the passphrase does not unlock:"
	cat /run/unlock-out
	return 1
    fi
}

test_no_passphrase_roundtrip()
{
    format_no_passphrase

    echo "$PASS_A" | bcachefs set-passphrase $(dev) > /run/set-out 2>&1 || {
	echo "set-passphrase failed:"; cat /run/set-out; return 1; }

    if ! bcachefs remove-passphrase $(dev) > /run/rm-out 2>&1 < <(echo "$PASS_A"); then
	echo "remove-passphrase failed after set-passphrase:"
	cat /run/rm-out
	return 1
    fi

    # Back to where we started: encrypted, key in the clear. unlock --check
    # has nothing to unlock and says so, exiting nonzero - initramfs scripts
    # branch on that - rather than prompting.
    local rc=0
    bcachefs unlock --check $(dev) > /run/check-out 2>&1 || rc=$?
    cat /run/check-out
    if [[ $rc -eq 0 ]] || ! grep -q 'no encryption' /run/check-out; then
	echo "remove-passphrase left a passphrase on the filesystem"
	return 1
    fi
}

# set-passphrase differs from the working unlock --file path in TWO ways, not
# one: the reader (stdin vs file) and the superblock (Fs::open(nostart) vs
# sb_io::read_super). unlock without --file reads stdin against a read_super
# superblock, which holds the sb constant and varies only the reader.
#
# Passing here means the stdin reader is fine and the superblock source is
# what differs. Failing means read_from_stdin() is the problem and it is
# nothing to do with set-passphrase at all.
test_unlock_from_stdin_isolates_the_reader()
{
    format_with_passphrase "$PASS_A"

    if ! echo "$PASS_A" | bcachefs unlock $(dev) > /run/unlock-stdin 2>&1; then
	echo "unlock from stdin rejected the correct passphrase:"
	cat /run/unlock-stdin
	echo "--- so the stdin READER is at fault, not the superblock source"
	return 1
    fi
    echo "stdin reader is fine; set-passphrase differs by superblock source"
}

# Control for change_existing_passphrase: isolates the fixture from the command
# under test. If this fails, --passphrase_file is not putting the passphrase we
# think it is on the filesystem, and the other test's "incorrect passphrase" is
# the setup rather than set-passphrase.
test_format_with_passphrase_then_unlock()
{
    format_with_passphrase "$PASS_A"

    if ! unlock_succeeds "$PASS_A"; then
	echo "the passphrase given to format does not unlock the filesystem:"
	cat /run/unlock-out
	return 1
    fi
}

test_change_existing_passphrase()
{
    format_with_passphrase "$PASS_A"

    # The current passphrase, then the new one, one line each. This failed
    # with "no passphrase read: end of file on stdin": opening the filesystem
    # needs its key, and without one the open (bch2_request_key() in
    # userspace) prompts for the passphrase itself - taking the first line -
    # before set-passphrase asked for it and got EOF. An earlier probe here,
    # feeding 2, 3 and 6 lines, concluded no prompt was eating input; it was.
    if ! bcachefs set-passphrase $(dev) > /run/set-out 2>&1 \
	    < <(printf '%s\n%s\n' "$PASS_A" "$PASS_B"); then
	echo "set-passphrase failed changing an existing passphrase:"
	cat /run/set-out
	return 1
    fi

    if ! unlock_succeeds "$PASS_B"; then
	echo "the new passphrase does not unlock:"
	cat /run/unlock-out
	return 1
    fi

    if unlock_succeeds "$PASS_A"; then
	echo "the OLD passphrase still unlocks after set-passphrase"
	return 1
    fi
}

# --- error quality --------------------------------------------------------
#
# The complaint was that the error was unreadable, so the message itself is
# the assertion here, not just the exit status.

test_set_passphrase_on_unencrypted_fs_says_so()
{
    run_quiet "" bcachefs format -f $(dev)

    if echo "$PASS_A" | bcachefs set-passphrase $(dev) > /run/set-out 2>&1; then
	echo "set-passphrase succeeded on an unencrypted filesystem"
	return 1
    fi

    cat /run/set-out
    if ! grep -qi "encryption" /run/set-out; then
	echo "error does not mention encryption - this is the unreadable case"
	return 1
    fi
}

# read_line()'s byte count was being discarded, so a zero-length read - end of
# file - became an empty passphrase and failed the check. Piping nothing and
# piping the wrong thing produced the same message, on the path automation
# uses: a script whose upstream produced no output was told its passphrase was
# wrong, which sends whoever reads the log somewhere else entirely.
#
# All three states are asserted, because the interesting property is that they
# are DISTINGUISHABLE. The wrong-passphrase leg is not decoration: without it
# this passes for the boring reason that nothing says "incorrect passphrase"
# any more.
test_empty_stdin_is_not_a_wrong_passphrase()
{
    format_with_passphrase "$PASS_A"

    if printf '' | bcachefs unlock $(dev) > /run/eof-out 2>&1; then
	echo "unlock succeeded with nothing on stdin"
	return 1
    fi
    cat /run/eof-out

    if grep -qi "incorrect passphrase" /run/eof-out; then
	echo "end of file on stdin is reported as an incorrect passphrase"
	return 1
    fi
    if ! grep -qi "end of file" /run/eof-out; then
	echo "error does not say what happened"
	return 1
    fi

    if printf 'definitely-not-it\n' | bcachefs unlock $(dev) > /run/wrong-out 2>&1; then
	echo "unlock succeeded with a wrong passphrase"
	return 1
    fi
    if ! grep -qi "incorrect passphrase" /run/wrong-out; then
	echo "a genuinely wrong passphrase no longer says so:"
	cat /run/wrong-out
	return 1
    fi

    if ! printf '%s\n' "$PASS_A" | bcachefs unlock $(dev) > /run/ok-out 2>&1; then
	echo "the correct passphrase does not unlock:"
	cat /run/ok-out
	return 1
    fi
}


main "$@"
