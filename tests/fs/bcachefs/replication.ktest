#!/usr/bin/env bash

. $(dirname $(readlink -e "${BASH_SOURCE[0]}"))/bcachefs-test-libs.sh

require-kernel-config MD
require-kernel-config BLK_DEV_DM
require-kernel-config DM_FLAKEY
require-kernel-config DM_DELAY
require-kernel-config BLK_DEV_LOOP
require-kernel-config BCACHEFS_ERASURE_CODING

config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G
config-scratch-devs 4G

config-mem 4G

test_recovery()
{
    set_watchdog 180

    run_quiet "" bcachefs format -f		\
	--discard				\
	--bucket_size=64k			\
	--block_size=4k				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    for i in `seq 0 20`; do
	mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

	#run_fio_randrw
	fio --eta=always			\
	    --exitall_on_error=1		\
	    --randrepeat=0			\
	    --ioengine=libaio			\
	    --iodepth=64			\
	    --iodepth_batch=16			\
	    --direct=1				\
	    --numjobs=1				\
	    --filename=/mnt/fiotest		\
	    --filesize=3500M			\
	    --name=randwrite			\
	    --rw=randwrite			\
	    --bsrange=4k-8k			\
	    --runtime=2

	$ktest_dir/tests/fs/xfstests/src/godown -f /mnt

	umount /mnt
    done

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_twodevices()
{
    run_basic_fio_test				\
	${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
}

test_largebuckets()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f		\
	--bucket_size=8M			\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    dd if=/dev/zero of=/mnt/foo bs=8M count=1024 oflag=direct
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_replicas()
{
    run_basic_fio_test				\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}
}

test_replicas_variable_buckets()
{
    set_watchdog 1200
    run_quiet "" bcachefs format -f			\
	--replicas=2					\
	--bucket_size=32k	${ktest_scratch_dev[0]}	\
	--bucket_size=64k	${ktest_scratch_dev[1]}	\
	--bucket_size=128k	${ktest_scratch_dev[2]}	\
	--bucket_size=128k	${ktest_scratch_dev[3]}	\
	--bucket_size=128k	${ktest_scratch_dev[4]}

    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt
    fs_mark -v -n 20000 -s 4096 -k -S 0 -D 1000 -N 100000 -d /mnt -t 60
    df -h /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]} ${ktest_scratch_dev[4]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

d_test_copygc_torture()
{
    loops=$((($ktest_priority + 1) * 2))

    bcachefs_antagonist
    set_watchdog 2400

    run_quiet "" bcachefs format -f "$@"	\
	--encrypted --no_passphrase		\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    #enable_memory_faults

    fio						\
	--filename=/mnt/fiotest			\
	--ioengine=sync				\
	--name=write				\
	--rw=write				\
	--bs=16M				\
	--fill_fs=1
    echo 3 > /proc/sys/vm/drop_caches

    for i in $(seq 1 $loops); do
	run_fio_base				\
	    --verify=meta			\
	    --buffer_compress_percentage=50	\
						\
	    --name=randwrite			\
	    --stonewall				\
	    --rw=randwrite			\
	    --loops=$loops			\
	    --bsrange=4k-4k

	cur_size=$(stat -c '%s' /mnt/fiotest)
	new_size=$(($cur_size - 1048576))
	echo "truncating to $new_size"

	truncate --size=$new_size /mnt/fiotest
    done

    rm /mnt/fiotest

    expect_sysfs cache dirty_buckets	0
    expect_sysfs cache dirty_data	0
    expect_sysfs cache cached_buckets	0
    expect_sysfs cache cached_data	0

    #disable_memory_faults
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

do_remove_test()
{
    set_watchdog 300
    offline=$1
    evacuate=$2

    setup_tracing `bcachefs_slowpath_tracepoints`

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    local fioout="$ktest_out/fio-out"
    run_fio_randrw >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 1

    if [[ $offline = 1 ]]; then
	echo -n "offlining ${ktest_scratch_dev[0]}... "
	bcachefs device offline --force	${ktest_scratch_dev[0]}
	echo "done"
    fi

    if [[ $evacuate = 1 ]]; then
	echo -n "evacuating ${ktest_scratch_dev[0]}... "
	bcachefs device evacuate	${ktest_scratch_dev[0]}
	echo "done"
    fi

    bcachefs fs usage -h /mnt

    echo -n "removing ${ktest_scratch_dev[0]}... "
    if [[ $evacuate = 1 ]]; then
	#bcachefs device remove		${ktest_scratch_dev[0]}
	bcachefs device remove		0 /mnt
    else
	#bcachefs device remove --force	${ktest_scratch_dev[0]}
	bcachefs device remove --force	0 /mnt
    fi
    echo "done"

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    bcachefs fs usage -h /mnt
    umount /mnt

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[1]}
}

test_device_remove_offline()
{
    do_remove_test 1 0
}

test_device_remove_online()
{
    do_remove_test 0 0
}

test_device_evacuate_offline()
{
    do_remove_test 1 1
}

test_device_evacuate_online()
{
    do_remove_test 0 1
}

wait_dev_offline_from_block_layer()
{
    for _ in $(seq 1 100); do
	dmesg_since hot_remove | grep "offline from block layer" >/dev/null && return 0
	sleep .1
    done

    echo "no 'offline from block layer' message after hot remove"
    return 1
}

# A block device yanked out from under a mounted filesystem (surprise removal:
# cable pull, dead controller) - koverstreet/bcachefs-tools#985.
#
# The block layer tells the filesystem through blk_holder_ops->mark_dead:
# bch2_fs_bdev_mark_dead(). If the filesystem can continue without the device
# (BCH_FORCE_IF_DEGRADED), the device goes offline: removed from the allocator,
# io refs dropped, superblock released. Otherwise the filesystem goes emergency
# read-only.
#
# The member state (rw/ro/failed/spare) must NOT change: it's persistent admin
# policy, and a flaky link that drops a device and brings it back shouldn't
# rewrite it. So "offline" is what we check, not the member state.
#
# The failure this guards against is a ghost device: the filesystem not
# noticing the removal and still allocating to it, so new writes are silently
# short a replica. The degraded md5 check can't see that (the surviving copy
# reads fine), so we check the new file's pointers directly.
test_device_hot_remove_offlines_dead_dev()
{
    ktest_expect_device_errors=1
    set_watchdog 120

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    dd if=/dev/urandom of=/mnt/before-hot-remove bs=1M count=64 oflag=direct
    sync
    bcachefs fs usage -h /mnt

    dmesg_mark hot_remove
    echo "hot-removing ${ktest_scratch_dev[1]}"
    scratch_dev_unplug 1
    wait_dev_offline_from_block_layer

    dd if=/dev/urandom of=/mnt/after-hot-remove bs=1M count=64 oflag=direct
    sync
    (cd /mnt && md5sum before-hot-remove after-hot-remove) > /root/hot-remove.md5
    local inum=$(stat -c %i /mnt/after-hot-remove)
    bcachefs fs usage -h /mnt

    umount /mnt

    # Pointers of the file written after the removal, by member index: none
    # may be on member 1 (the removed device), and both replicas must be on
    # the survivors - an empty listing would otherwise pass the first check.
    bcachefs list -b extents -s $inum:0 -e $((inum + 1)):0	\
	${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]} > /root/after-hot-remove.extents
    local dev
    for dev in 0 1 2; do
	local nr=$(bcachefs_ptr_sectors 1 $dev < /root/after-hot-remove.extents | wc -l)
	echo "after-hot-remove: $nr pointers on member $dev"

	if [[ $dev == 1 && $nr != 0 ]]; then
	    echo "FAIL: data written after hot remove has pointers to the removed device"
	    return 1
	fi
	if [[ $dev != 1 && $nr == 0 ]]; then
	    echo "FAIL: no pointers on surviving member $dev - listing broken, or write under-replicated"
	    return 1
	fi
    done

    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]}:${ktest_scratch_dev[2]} /mnt
    (cd /mnt && md5sum -c /root/hot-remove.md5)
    umount /mnt

    scratch_dev_plug 1

    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=bucket_alloc_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]}
}

test_device_add()
{
    set_watchdog 240
    setup_tracing `bcachefs_slowpath_tracepoints`

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--no_initialize				\
	${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    run_fio_randrw >"$ktest_out/fio-out" 2>&1 &
    local fiopid=$!

    sleep 1

    echo -n "adding ${ktest_scratch_dev[1]}... "
    bcachefs device add -f /mnt ${ktest_scratch_dev[1]}
    echo "done"

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    umount /mnt
    bcachefs fsck -n ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Replicas must spread across failure domains - the flat per-device
# failure_domain strings (NOT labels: labels are naming and target
# vocabulary, they feed nothing into placement). Two racks of two devices,
# replicas=2: every extent's copies must land in different racks. (Without
# domain-aware allocation this reliably co-locates: one dd per file means
# cold, hashed write points, all stripe clock hands tie at zero, and the
# stable sort pairs the two lowest-index devices for every extent.)
test_failure_domains()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f			\
	--replicas=2					\
	--failure_domain=rack0 ${ktest_scratch_dev[0]}	\
	--failure_domain=rack0 ${ktest_scratch_dev[1]}	\
	--failure_domain=rack1 ${ktest_scratch_dev[2]}	\
	--failure_domain=rack1 ${ktest_scratch_dev[3]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]}:${ktest_scratch_dev[3]} /mnt

    local i
    for i in $(seq 0 49); do
	dd if=/dev/urandom of=/mnt/f$i bs=64k count=1 oflag=direct status=none
    done

    # devices 0,1 = rack0; devices 2,3 = rack1. Ptr lines carry the device
    # name before the numbers ("ptr:    vdb 0:38:0 gen 0"), so find the
    # dev:bucket:offset token and take the device index from it rather
    # than anchoring on position after "ptr:":
    cat /sys/kernel/debug/bcachefs/*/btrees/extents/keys |
    awk '
	/^u64s/	     { if (nptr) check(); nptr = 0; r0 = 0; r1 = 0 }
	/ptr:/	     { for (f = 1; f <= NF; f++)
			   if (split($f, a, ":") == 3 && a[1] ~ /^[0-9]+$/) {
			       if (a[1] + 0 <= 1) r0++; else r1++;
			       nptr++
			       break
			   }
		     }
	function check() {
	    total++
	    if (nptr == 2 && (r0 == 2 || r1 == 2)) {
		bad++
		print "same-rack extent: rack0 ptrs", r0, "rack1 ptrs", r1
	    }
	}
	END {
	    if (nptr) check()
	    printf "extents: %d, same-rack violations: %d\n", total, bad
	    exit (bad > 0 || total == 0)
	}
    '

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_add_label()
{
    # Test setting device label when adding
    # Caught bugs:
    #   - label was not set correctly; set to dev-0 label instead of new one.

    bcachefs format -f -L test_add_label --label=foo ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    bcachefs device add -f --label=bar /mnt ${ktest_scratch_dev[1]}
    expect_sysfs dev-1 label bar
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_add_label_compound()
{
    # Test adding a device with a compond label, a '.' separated "path"
    # (e.g. ssd.sata)
    # Caught bugs:
    #   - filesystem crashed with message "Invalid superblock section disk_groups".

    set_watchdog 30

    bcachefs format -f -L test_add_compound_label --label=hdd ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    bcachefs device add -f --label=foo.bar /mnt ${ktest_scratch_dev[1]}
    expect_sysfs dev-1 label foo.bar
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_add_offline()
{
    # Test adding a device while the filesystem is not mounted,
    # by passing a block device instead of a mountpoint.
    # Uses 2 initial devices to verify superblock propagation —
    # the add must discover and update all member devices.

    run_quiet "" bcachefs format -f		\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    dd if=/dev/urandom of=/mnt/test bs=1M count=64 oflag=direct
    md5sum /mnt/test > /tmp/test.md5
    umount /mnt

    echo "Doing offline add"
    bcachefs device add -f ${ktest_scratch_dev[0]} ${ktest_scratch_dev[2]}

    bcachefs show-super ${ktest_scratch_dev[0]}
    bcachefs show-super ${ktest_scratch_dev[1]}
    bcachefs show-super ${ktest_scratch_dev[2]}

    echo "Mounting multidevice"
    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    md5sum -c /tmp/test.md5
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_add_remount()
{
    # Test adding a device, unmounting and mounting again
    # Caught bugs:
    #   - wrong fs uuid for second device and it's not found by mount, despite correct superlock.

    run_quiet "" bcachefs format -f --discard ${ktest_scratch_dev[0]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    bcachefs device add -f /mnt ${ktest_scratch_dev[1]}
    umount /mnt

    bcachefs show-super ${ktest_scratch_dev[0]}
    bcachefs show-super ${ktest_scratch_dev[1]}
    lsblk -f

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_set_state()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    run_fio_randrw >"$ktest_out/fio-out" 2>&1 &
    local fiopid=$!

    sleep 1

    for state in ro evacuating spare; do
	echo "setting state $state"
	bcachefs device set-state --force $state    ${ktest_scratch_dev[1]}

	echo "setting state rw"
	#bcachefs device set-state	  rw ${ktest_scratch_dev[1]}
	bcachefs device set-state	  rw 1 /mnt
    done

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    # We expect IO error data update fails, from in flight write when the device goes RO
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_ro()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f		\
	--btree_node_size=128k			\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    local fioout="$ktest_out/fio-out"
    run_fio_randrw >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 4

    bcachefs device set-state ro ${ktest_scratch_dev[1]}

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    umount /mnt

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    # We expect IO error data update fails, from in flight write when the device goes RO
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# bcachefs#1157: capacity has to follow device state. bch2_recalc_capacity()
# used to decide from ca->mi.state, which a state change writes only after it
# has recalculated - so a device set ro kept counting towards capacity
# indefinitely.
# tools#914: taking a device out of the rw set has to refuse, without --force,
# when that leaves fewer rw devices than --replicas - and must not make a later
# mount of the same filesystem any stricter.
test_device_ro_below_replicas()
{
    set_watchdog 60
    local d0=${ktest_scratch_dev[0]} d1=${ktest_scratch_dev[1]}

    run_quiet "" bcachefs format -f --replicas=2 $d0 $d1
    mount -t bcachefs $d0:$d1 /mnt

    if bcachefs device set-state ro $d1; then
	echo "ERROR: set-state ro went below --replicas=2 without --force"
	return 1
    fi
    grep -q "\\[rw\\]" /sys/fs/bcachefs/*/dev-1/state

    bcachefs device set-state --force ro $d1
    grep -q "\\[ro\\]" /sys/fs/bcachefs/*/dev-1/state

    # starting with a member ro is unchanged: no -o degraded needed
    umount /mnt
    mount -t bcachefs $d0:$d1 /mnt
    umount /mnt
}

test_device_set_state_capacity()
{
    set_watchdog 60

    run_quiet "" bcachefs format -f		\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    local both=$(stat -f -c '%b' /mnt)
    echo "capacity, both devices rw: $both"

    for state in ro spare evacuating; do
	bcachefs device set-state --force $state ${ktest_scratch_dev[1]}

	local one=$(stat -f -c '%b' /mnt)
	echo "capacity, dev 1 $state: $one"
	if (( one * 4 > both * 3 )); then
	    echo "capacity didn't drop with dev 1 $state"
	    return 1
	fi

	bcachefs device set-state rw 1 /mnt

	local again=$(stat -f -c '%b' /mnt)
	echo "capacity, dev 1 rw again: $again"
	if (( again != both )); then
	    echo "capacity didn't come back with dev 1 rw"
	    return 1
	fi
    done

    umount /mnt
}

# 8M to /mnt/$2 via write path $1
write_8m()
{
    case $1 in
    buffered)	dd if=/dev/zero of=/mnt/$2 bs=1M count=8 conv=fsync ;;
    direct)	dd if=/dev/zero of=/mnt/$2 bs=1M count=8 oflag=direct ;;
    fallocate)	fallocate -l 8M /mnt/$2 ;;
    esac
}

# write_degraded (bcachefs#1221): with fewer rw devices than replicas, the
# default is to write at the replicas we can place rather than return ENOSPC -
# the missing device will come back, and refusing writes until then is worse.
# write_degraded=no refuses them.
#
# Two devices at replicas=2, one set ro: nothing is placeable at 2 replicas, so
# every write path either falls back to 1 or fails. Each has its own
# reservation: buffered writes reserve in write() via the pagecache, direct IO
# and fallocate reserve directly. The disk_reservation_degraded counter says a
# write actually took the fallback, as opposed to squeezing into stale capacity.
#
# All paths are checked and all failures reported, so one run says which paths
# are broken.
test_write_degraded()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    bcachefs device set-state --force ro ${ktest_scratch_dev[1]}

    local counter=$(echo /sys/fs/bcachefs/*/counters/disk_reservation_degraded)
    local opt=$(echo /sys/fs/bcachefs/*/options/write_degraded)
    local failed=0 kind

    degraded_since_mount() { awk '/since mount/ { print $3 }' $counter; }

    for kind in buffered direct fallocate; do
	local before=$(degraded_since_mount) ret=0

	write_8m $kind $kind || ret=$?

	local size=$(stat -c %s /mnt/$kind 2>/dev/null || echo 0)
	echo "$kind: exit $ret, size $size, degraded since mount: $before -> $(degraded_since_mount)"

	if (( ret || size != 8 << 20 )); then
	    echo "FAIL: $kind write failed on a degraded fs with write_degraded=degraded"
	    failed=1
	elif [[ $(degraded_since_mount) == "$before" ]]; then
	    echo "FAIL: $kind write succeeded without taking the degraded fallback"
	    failed=1
	fi
    done

    echo no > $opt
    for kind in buffered direct fallocate; do
	local ret=0 err=$ktest_out/$kind-no.err

	write_8m $kind $kind-no 2>$err || ret=$?

	local size=$(stat -c %s /mnt/$kind-no 2>/dev/null || echo 0)
	echo "$kind, write_degraded=no: exit $ret, size $size: $(grep -m1 -i "error\|failed" $err)"

	if (( ! ret )) || ! grep -q "No space left on device" $err; then
	    echo "FAIL: $kind write with write_degraded=no should fail with ENOSPC"
	    failed=1
	fi
    done
    echo degraded > $opt

    bcachefs device set-state rw 1 /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    (( ! failed ))
}

# The same, with durability=2 devices: one copy on either is both replicas, so
# with the other device ro there's still room at replicas=2 - nothing should
# fall back, and write_degraded=no should change nothing. Space accounting that
# counted a copy as one replica found nothing placeable at 2x here and failed
# every write with ENOSPC_disk_reservation; fallocate then sized a reservation
# key from a sliver of a partial reservation, and the zero-length key it
# committed shut the filesystem down in the journal write (TiCPU, 2026-10-05,
# with one durability=2 device full rather than ro).
test_write_durability2_one_device()
{
    set_watchdog 120

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	--durability=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    bcachefs device set-state --force ro ${ktest_scratch_dev[1]}

    local counter=$(echo /sys/fs/bcachefs/*/counters/disk_reservation_degraded)
    local opt=$(echo /sys/fs/bcachefs/*/options/write_degraded)
    local failed=0 kind

    degraded_since_mount() { awk '/since mount/ { print $3 }' $counter; }

    echo no > $opt
    for kind in buffered direct fallocate; do
	local before=$(degraded_since_mount) ret=0 err=$ktest_out/$kind-dur2.err

	write_8m $kind $kind 2>$err || ret=$?

	local size=$(stat -c %s /mnt/$kind 2>/dev/null || echo 0)
	echo "$kind: exit $ret, size $size, degraded since mount: $before -> $(degraded_since_mount): $(grep -m1 -i "error\|failed" $err)"

	if (( ret || size != 8 << 20 )); then
	    echo "FAIL: $kind write failed with a durability=2 device rw at replicas=2"
	    failed=1
	elif [[ $(degraded_since_mount) != "$before" ]]; then
	    echo "FAIL: $kind write took the degraded fallback it didn't need"
	    failed=1
	fi
    done
    echo degraded > $opt

    bcachefs device set-state rw 1 /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    (( ! failed ))
}

test_device_set_state_offline()
{
    set_watchdog 120
    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    local fioout="$ktest_out/fio-out"
    run_fio_randrw --runtime=60 >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 10

    bcachefs device set-state --force	    ro ${ktest_scratch_dev[1]}

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    umount /mnt

    bcachefs device set-state --offline	    rw ${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    grep rw /sys/block/[sv]dc/bcachefs/state
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_set_state_rw_offline()
{
    # Reproducer for github #1044:
    # Setting an offline device's state back to rw triggers a NULL pointer
    # dereference in bch2_do_discards_work (bdev is NULL) and
    # __bch2_journal_reclaim (ca->devs[] is NULL).

    # Reads hitting the offlined/stale device recover from the good replica:
    ktest_expect_sb_errors="data_read_(io|csum)_err_recovered"

    set_watchdog 60

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    dd if=/dev/zero of=/mnt/test bs=1M count=128 oflag=direct

    for state in ro evacuating; do
	bcachefs device set-state --force $state ${ktest_scratch_dev[1]}
	bcachefs device offline --force ${ktest_scratch_dev[1]}

	# This should not crash:
	bcachefs device set-state rw 1 /mnt

	bcachefs device online ${ktest_scratch_dev[1]}
    done

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_readd()
{
    # fio reads racing the offline/online cycle recover from the good
    # replica (io errors while offline, csum errors from stale data after),
    # and writes while it's offline land at one replica:
    ktest_expect_sb_errors="data_read_(io|csum)_err_recovered|write_degraded_insufficient_devices"

    set_watchdog 120
    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}	

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    local fioout="$ktest_out/fio-out"
    run_fio_randrw --runtime=60 >"$fioout" 2>&1 &
    local fiopid=$!

    sleep 10

    echo -n "offlining ${ktest_scratch_dev[0]}... "
    bcachefs device offline --force	${ktest_scratch_dev[0]}
    echo "done"

    echo -n "onlining ${ktest_scratch_dev[0]}... "
    bcachefs device online ${ktest_scratch_dev[0]}
    echo "done"

    if ! wait $fiopid; then
	cat "$fioout"
	return 1
    fi

    umount /mnt

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    # We expect IO error data update fails, from in flight write when the device goes RO
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_device_repeated_add_remove()
{
    ## Test rapidly adding and removing the same device.
    # Caught bugs:
    #   - found a race condition that leads to a kernel BUG in btree_key_cache.

    set_watchdog 120

    bcachefs format -f -L test_device_repeated_add_remove --label=hdd ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    for ii in {1..10}; do
        echo "add-remove run #$ii ----------------------------------------------------"
        echo "bcachefs device add ${ktest_scratch_dev[1]}"
        bcachefs device add -f /mnt ${ktest_scratch_dev[1]}
        echo "bcachefs device evacuate ${ktest_scratch_dev[1]}"
        bcachefs device evacuate ${ktest_scratch_dev[1]}
        echo "bcachefs device remove ${ktest_scratch_dev[1]}"
        bcachefs device remove ${ktest_scratch_dev[1]}
    done

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_recovery()
{
    set_watchdog 30
    run_quiet "" bcachefs format -f		\
	--errors=ro				\
	${ktest_scratch_dev[@]}

    for i in `seq 0 1`; do
	mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
	run_fio_randrw &

	sleep 5
	$ktest_dir/tests/fs/xfstests/src/godown -f /mnt
	wait

	umount /mnt
    done

    bcachefs fsck -nyk ${ktest_scratch_dev[@]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

do_replicas_errors_test()
{
    error_type=$1

    set_watchdog 180
    setup_tracing `bcachefs_slowpath_tracepoints`

    local p=/sys/module/bcachefs/parameters/verify_all_btree_replicas
    [[ -f $p ]] && echo 1 > $p

    local BLK_DEV_SIZE=`blockdev --getsz ${ktest_scratch_dev[1]}`
    local FLAKEY_TABLE="0 $BLK_DEV_SIZE flakey ${ktest_scratch_dev[1]} 0 180 0"
    local FLAKEY_TABLE_ERROR="0 $BLK_DEV_SIZE flakey ${ktest_scratch_dev[1]} 0 0 180 1 $error_type"

    dmsetup create flakey --table "$FLAKEY_TABLE"

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]} /dev/mapper/flakey

    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]}:/dev/mapper/flakey /mnt

    echo $FLAKEY_TABLE_ERROR|dmsetup load flakey
    dmsetup resume flakey

    run_fio_randrw

    # Check the read retry path for indirect extents:
    cp --reflink /mnt/fiotest /mnt/fiotest.reflinked
    dd if=/mnt/fiotest of=/dev/null bs=4k iflag=direct

    umount /mnt
    dmsetup remove flakey

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}

    # we expect lots of these due to IO errors:
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=bucket_alloc_fail ${ktest_scratch_dev[0]}

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}

    [[ -f $p ]] && echo 0 > $p
    true
}

test_replicas_write_errors()
{
    # Every write to the flakey device fails, so with two devices and
    # replicas=2 writes go degraded - by design, not a bug:
    ktest_expect_sb_errors="write_degraded_insufficient_devices|write_degraded_no_progress"
    do_replicas_errors_test error_writes
}

test_replicas_read_errors()
{
    # dm-flakey error_reads fails the bio with BLK_STS_IOERR:
    ktest_expect_sb_errors="data_read_io_err_recovered|blk_sts_ioerr"
    do_replicas_errors_test error_reads
}

