test_evacuate_corrupted()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    [[ ! -f /sys/module/bcachefs/parameters/write_corrupt_ratio ]] && return 0

    set_watchdog 180
    setup_tracing

    run_quiet "" bcachefs format -f --replicas=2	\
	${ktest_scratch_dev[0]}				\
	${ktest_scratch_dev[1]}				\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    echo 32 > /sys/module/bcachefs/parameters/write_corrupt_ratio
    run_fio_randrw --continue_on_error=io
    echo 0 > /sys/module/bcachefs/parameters/write_corrupt_ratio

    bcachefs device evacuate		${ktest_scratch_dev[1]}
    bcachefs device remove	--force ${ktest_scratch_dev[1]}

    run_fio_randrw --continue_on_error=io --verify_only=1

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}

    # we expect lots of io_move_start_fail when we're degraded:
    #bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# evacuate_corrupted with compression - moving data that will never decompress.
#
# bch2_data_update_read_done() lets a move proceed over corrupt data: if the
# read failed with data_read_csum_err and the extent is flagged poisoned, it
# recomputes the checksum over the corrupt bytes and clears the error, and the
# poison flag carries "this is bad data" forward for userspace. An evacuate read
# doesn't decompress - only scrub sets data_update_verify_decompress - so the
# corrupt lz4 arrives at the write path still compressed, with a checksum that
# now matches it.
#
# The write path is where compression makes the difference. If the extent won't
# fit the current write point it can't be written as is, and the only other
# option is to decompress and repack it - which fails, on garbage lz4, forever.
# So the move fails and whatever queued it comes straight back.
#
# Field report (ar2000jp, #bcache 2026-08-01): eight months of bch-reconcile
# burning IO on a set of poisoned lz4 extents, reconcile status pinned at
# replicas: 216k / high_priority: 216k, dmesg naming the same extents with
# "flags: poisoned ... compress lz4" and terminating in decompress_lz4. The
# existing test could never have caught it: it formats without compression, so
# every extent it poisons takes the path that works.
#
# Fixed by keeping the extent intact instead: the write path decodes onto a
# private copy, so a decompress failure leaves the bio and op->crc untouched and
# the extent can still go out byte-for-byte. It just needs buckets with room for
# the whole thing, which is what data_write_need_fresh_buckets asks for.
test_evacuate_corrupted_compressed()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    [[ ! -f /sys/module/bcachefs/parameters/write_corrupt_ratio ]] && return 0

    set_watchdog 180
    setup_tracing

    run_quiet "" bcachefs format -f --replicas=2 --compression=lz4	\
	${ktest_scratch_dev[0]}				\
	${ktest_scratch_dev[1]}				\
	${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    # Spelled out rather than inherited: run_fio's default happens to be
    # compressible (30), but this test is only a test if the data compresses,
    # so pin it here instead of depending on a default that has no reason to
    # stay that way.
    #
    # Small and one pass, deliberately. The move under test is the explicit
    # evacuate below, not copygc - so there is no reason to fill the device
    # first, and the default 3500M x loops is most of this test's runtime for
    # none of its coverage. A few corrupt compressed extents is the whole
    # requirement.
    local fio_opts="--buffer_compress_percentage=75 --filesize=200M --loops=1"

    echo 32 > /sys/module/bcachefs/parameters/write_corrupt_ratio
    run_fio_randrw --continue_on_error=io $fio_opts
    echo 0 > /sys/module/bcachefs/parameters/write_corrupt_ratio

    bcachefs device evacuate		${ktest_scratch_dev[1]}
    bcachefs device remove	--force ${ktest_scratch_dev[1]}

    run_fio_randrw --continue_on_error=io --verify_only=1 $fio_opts

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]}
}

test_evacuate_errors()
{
    setup_tracing
    set_watchdog 180

    run_quiet "" bcachefs format -f --metadata_replicas=2   \
	${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}

    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    run_fio_randrw --continue_on_error=io

    #bcachefs device evacuate	/dev/mapper/flakey
    bcachefs device remove	--force ${ktest_scratch_dev[1]}

    run_fio_randrw --continue_on_error=io --verify_only=1
    umount /mnt
    true
}

test_cmd_fs_usage()
{
    set_watchdog 240

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	--bucket_size=128k			\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}

    echo -n "mounting... "
    mount -t bcachefs -o verbose ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt
    echo done

    echo "Before writing:"
    bcachefs fs usage  /mnt
    echo
    df -h /mnt
    echo

    run_fio_randrw --size=500M > /dev/null

    echo
    echo "After writing:"
    bcachefs fs usage -h /mnt
    echo
    df -h /mnt

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_rereplicate()
{
    set_watchdog 60
    run_quiet "" bcachefs format -f		\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}
    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    dd if=/dev/zero of=/mnt/test bs=1M count=1024 oflag=direct

    echo 2 > /sys/fs/bcachefs/*/options/metadata_replicas
    echo 2 > /sys/fs/bcachefs/*/options/data_replicas

    if [[ `cat /sys/module/bcachefs/parameters/version` -lt 1057 ]]; then
	bcachefs data rereplicate /mnt
    else
	bcachefs reconcile wait -t replicas /mnt
    fi

    bcachefs fs usage -h /mnt
    umount /mnt

    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_rereplicate2()
{
    echo ":: format with replicas=1 (default)"
    run_quiet "" bcachefs format -f		\
        ${ktest_scratch_dev[0]}			\
        ${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    echo ":: write to fs, while replicas=1"
    touch /mnt/empty-file

    echo ":: we should have some durability=1 data now"
    bcachefs fs usage -h /mnt

    echo ":: set replicas=2 and run rereplicate"
    echo 2 > /sys/fs/bcachefs/*/options/data_replicas
    echo 2 > /sys/fs/bcachefs/*/options/metadata_replicas

    if [[ `cat /sys/module/bcachefs/parameters/version` -lt 1057 ]]; then
	bcachefs data rereplicate /mnt
    else
	bcachefs reconcile wait -t replicas /mnt
    fi

    echo ":: all data should be replicated to both devices now, verifying..."
    local fs_usage_out=$(bcachefs fs usage -h --all /mnt)
    echo "$fs_usage_out"
    local residual_durability_1_data=$(grep -E '^(btree|user):' <<<"$fs_usage_out" | awk '$3 == "1"')

    umount /mnt

    # bcachefs names devices without the /dev/ prefix, so dev_remove and
    # dev_keep are bare names throughout - which is also why they can't be
    # hardcoded: the names depend on the storage bus.
    local dev0=$(basename ${ktest_scratch_dev[0]})
    local dev1=$(basename ${ktest_scratch_dev[1]})

    local dev_remove=
    if ! [[ -n "$residual_durability_1_data" ]]; then
	echo ":: no residual durability=1 data found"
	dev_remove="$dev0"
        echo ":: we will simulate loss of device '$dev_remove' to verify proper replication"
    else
        echo ":: found residual durability=1 data:"
        echo "$residual_durability_1_data"

        local first_spof_dev=$(head -n1 <<<"$residual_durability_1_data" | grep -oP '\[\K[^\]]+' | awk '{print $1}')
	dev_remove="$first_spof_dev"
        echo ":: we will simulate loss of device '$dev_remove', which we suspect of being a single-point-of-failure"
    fi

    # we want to keep the other device
    local dev_keep=
    if [[ "$dev_remove" == "$dev0" ]]; then
        dev_keep="$dev1"
    elif [[ "$dev_remove" == "$dev1" ]]; then
        dev_keep="$dev0"
    else
        echo "device '$dev_remove' is neither $dev0 nor $dev1"
        exit 1
    fi

    echo ":: wipe the super-block on device '$dev_remove' to prevent auto-discovery durring mount"
    dd if=/dev/zero of=/dev/$dev_remove bs=1M count=1 oflag=direct

    echo ":: attempt degraded mount with only device '$dev_keep'"
    mount -t bcachefs -o degraded,fsck,fix_errors /dev/$dev_keep /mnt

    umount /mnt
}

# With a metadata_replicas change pending (its scan not yet run) the btree
# ptrs are allowed to mismatch: the metadata cookie says so. The check read
# the cookie at the node key's inode field instead and reported them.
test_reconcile_btree_ptr_metadata_cookie()
{
    set_watchdog 120
    local devs=("${ktest_scratch_dev[0]}" "${ktest_scratch_dev[1]}")

    run_quiet "" bcachefs format -f --metadata_replicas=1 "${devs[@]}"
    mount -t bcachefs -o reconcile_enabled=0 "$(join_by : "${devs[@]}")" /mnt
    for i in $(seq 500); do echo $i > /mnt/f$i; done
    sync

    echo 2 > /sys/fs/bcachefs/*/options/metadata_replicas
    umount /mnt

    local out rc=0
    out=$(bcachefs fsck -n "${devs[@]}" 2>&1) || rc=$?
    echo "fsck -n exited $rc"
    if grep "incorrect/missing reconcile opts" <<<"$out" >/dev/null; then
	grep -A6 "incorrect/missing reconcile opts" <<<"$out" | head -40
	echo "ERROR: btree ptrs reported while the metadata scan is pending"
	return 1
    fi
}

# Bumping data_replicas on a single file (set-file-option, not the fs-wide
# sysfs knob) must re-replicate that file's existing extents: it queues an
# inum reconcile scan that re-derives need_rb=data_replicas per extent and
# writes the second copy. test_rereplicate covers the fs-wide path; this is
# the per-file path.
#
# Regression coverage for github #1186, where changing data_replicas on a
# file did nothing: the scan completed but queued no work, so durability=1
# data stayed single-replica.
test_rereplicate_file()
{
    set_watchdog 120

    # metadata_replicas=2 so the fs itself survives the degraded mount below;
    # the file's data is then the only single-replica thing, which is the
    # variable under test.
    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--metadata_replicas=2			\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    # default data_replicas=1, so extents land durability 1:
    dd if=/dev/urandom of=/mnt/foo bs=1M count=64 conv=fsync
    md5sum /mnt/foo > /root/foo.md5

    user_durability_1()
    {
	bcachefs fs usage -h --all /mnt |
	    grep -E '^user:' | awk '$3 == "1" { n = 1 } END { print n + 0 }'
    }

    if [[ $(user_durability_1) != 1 ]]; then
	echo "FAIL: precondition - no durability=1 user data after a replicas=1 write"
	bcachefs fs usage -h --all /mnt
	return 1
    fi

    # per-file bump - queues an inum reconcile scan for /mnt/foo:
    bcachefs set-file-option --data_replicas=2 /mnt/foo
    bcachefs reconcile wait -t replicas /mnt

    bcachefs fs usage -h --all /mnt

    if [[ $(user_durability_1) != 0 ]]; then
	echo "FAIL: durability=1 data remains after per-file data_replicas=2 + reconcile"
	return 1
    fi

    # the second copy must be real: lose a device, the data must still read back
    umount /mnt
    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]} /mnt
    md5sum -c /root/foo.md5
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# An IO path option change must re-replicate existing data no matter how the
# effective option changed - set directly on the file, set on an ancestor
# directory (set-file-option propagates recursively via BCHFS_IOC_REINHERIT_ATTRS),
# or an override *removed* so the file falls back to the filesystem-wide
# option. And it must reach all of the file's extents, including those written
# before a snapshot was taken.
#
# Except unset + snap: extents written before the snapshot are shared with it,
# and options accumulate up the snapshot tree as the max over values that are
# *set*. The snapshot still sets data_replicas=1; the live file, once unset,
# sets nothing - the filesystem default doesn't override an inode option. So
# the shared extents correctly stay at 1x.
#
# Parametrized matrix; each test_* wrapper is one point:
#   $1 where:  file  - change the option directly on the file
#              dir   - change it on the subvolume root, reaching the file
#                      through a subdirectory
#   $2 change: set   - fs-wide data_replicas=1, set an explicit =2 override
#              unset - fs-wide data_replicas=2, file written under an
#                      explicit =1 override, then the override is removed
#   $3 snap:   snap|nosnap - snapshot the subvolume before the change
rereplicate_opt_change_test()
{
    local where=$1 change=$2 snap=$3
    local md5 f

    set_watchdog 120

    # metadata_replicas=2 so the fs itself survives the degraded mount below;
    # the file's data is then the only single-replica thing, which is the
    # variable under test.
    local base_replicas=1
    [[ $change == unset ]] && base_replicas=2

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--metadata_replicas=2			\
	--data_replicas=$base_replicas		\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    bcachefs subvolume create /mnt/subvol
    mkdir /mnt/subvol/dir
    touch /mnt/subvol/dir/foo

    local target=/mnt/subvol/dir/foo
    [[ $where == dir ]] && target=/mnt/subvol

    # the unset variants write under an explicit replicas=1 override:
    [[ $change == unset ]] && bcachefs set-file-option --data_replicas=1 $target

    # effective data_replicas=1 either way, so extents land durability 1:
    dd if=/dev/urandom of=/mnt/subvol/dir/foo bs=1M count=64 conv=fsync
    md5=$(md5sum < /mnt/subvol/dir/foo)

    [[ $snap == snap ]] && bcachefs subvolume snapshot /mnt/subvol /mnt/snap

    user_durability_1()
    {
	bcachefs fs usage -h --all /mnt |
	    grep -E '^user:' | awk '$3 == "1" { n = 1 } END { print n + 0 }'
    }

    if [[ $(user_durability_1) != 1 ]]; then
	echo "FAIL: precondition - no durability=1 user data after a replicas=1 write"
	bcachefs fs usage -h --all /mnt
	return 1
    fi

    case $change in
	set)	bcachefs set-file-option --data_replicas=2 $target ;;
	unset)	bcachefs set-file-option --data_replicas=- $target ;;
    esac
    bcachefs reconcile wait -t replicas /mnt

    bcachefs fs usage -h --all /mnt

    if [[ $change == unset && $snap == snap ]]; then
	if [[ $(user_durability_1) != 1 ]]; then
	    echo "FAIL: shared extents left durability 1 after 'unset' on $where,"
	    echo "      but the snapshot still sets data_replicas=1"
	    return 1
	fi

	umount /mnt
	bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
	bcachefs_test_end_checks ${ktest_scratch_dev[0]}
	return 0
    fi

    if [[ $(user_durability_1) != 0 ]]; then
	echo "FAIL: durability=1 data remains after '$change' on $where + reconcile"
	[[ $snap == snap ]] &&
	    echo "(the option change did not propagate to extents predating the snapshot)"
	return 1
    fi

    # the second copy must be real: lose a device, every copy must read back
    umount /mnt
    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]} /mnt

    local files=(/mnt/subvol/dir/foo)
    [[ $snap == snap ]] && files+=(/mnt/snap/dir/foo)

    for f in "${files[@]}"; do
	if [[ $(md5sum < $f) != "$md5" ]]; then
	    echo "FAIL: $f corrupt after device loss"
	    return 1
	fi
    done
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_rereplicate_snapshot()		{ rereplicate_opt_change_test file set	 snap;	 }
test_rereplicate_snapshot_dir()		{ rereplicate_opt_change_test dir  set	 snap;	 }
test_rereplicate_snapshot_unset()	{ rereplicate_opt_change_test file unset snap;	 }
test_rereplicate_snapshot_unset_dir()	{ rereplicate_opt_change_test dir  unset snap;	 }

# no-snapshot controls (file/set is test_rereplicate_file):
test_rereplicate_dir()			{ rereplicate_opt_change_test dir  set	 nosnap; }
test_rereplicate_unset()		{ rereplicate_opt_change_test file unset nosnap; }
test_rereplicate_unset_dir()		{ rereplicate_opt_change_test dir  unset nosnap; }

# fsck given a member *device* (not just the mountpoint) of a mounted fs must
# select online fsck: bcachefs holds its devices exclusively, so the offline
# path fails reading the superblock with EBUSY. The device has to be recognized
# as belonging to a mounted filesystem and routed to BCH_IOCTL_FSCK_ONLINE.
#
# Covers the ways a member can be named, including the one github #1186 tripped:
#   - a bare whole-device member
#   - a partition member (different major:minor and sysfs path than the disk)
#   - an auto-discovered member of a multi-device fs mounted by a *different*
#     device, so the member isn't in /proc/mounts (the old /proc/mounts-based
#     detection missed it; the per-device sysfs bcachefs link covers it)
test_fsck_online_by_device()
{
    set_watchdog 120

    # fsck of a mounted fs via $1 must take the online path and succeed; the
    # offline path would instead fail reading the superblock with EBUSY.
    expect_online_fsck()
    {
	local out rc
	out=$(bcachefs fsck -fy "$1" 2>&1); rc=$?
	echo "$out"
	if ! grep -q "Running fsck online" <<<"$out"; then
	    echo "FAIL: fsck '$1' did not take the online path"
	    return 1
	fi
	if (( rc != 0 )); then
	    echo "FAIL: online fsck of '$1' returned $rc"
	    return 1
	fi
    }

    # bare whole-device member (and the mountpoint, which must still work):
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt
    expect_online_fsck ${ktest_scratch_dev[0]}
    expect_online_fsck /mnt
    umount /mnt

    # partition member:
    printf 'label: gpt\n,,L\n' | sfdisk ${ktest_scratch_dev[1]}
    local part=${ktest_scratch_dev[1]}1
    local i
    for ((i = 0; i < 25; i++)); do [[ -b $part ]] && break; sleep 0.2; done
    [[ -b $part ]] || { echo "FAIL: partition $part never appeared"; return 1; }
    run_quiet "" bcachefs format -f $part
    mount -t bcachefs $part /mnt
    expect_online_fsck $part
    umount /mnt

    # auto-discovered member of a multi-device fs mounted by a *different*
    # device, so it isn't in /proc/mounts:
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}
    mount -t bcachefs ${ktest_scratch_dev[2]} /mnt
    expect_online_fsck ${ktest_scratch_dev[3]}
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[2]} ${ktest_scratch_dev[3]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

disabled_test_device_add_faults()
{
    setup_tracing `bcachefs_slowpath_tracepoints`

    run_quiet "" bcachefs format -f		\
	--errors=remount-ro			\
	${ktest_scratch_dev[0]}
    mount ${ktest_scratch_dev[0]} /mnt

    device_add_fault_fn()
    {
	set_faults "$1 enable"
	assert_fails bcachefs device add -f /mnt ${ktest_scratch_dev[1]}
    }

    run_fault_injection_test bcachefs:add			device_add_fault_fn
    run_fault_injection_test bcachefs:bch_fs_init:dev_alloc	device_add_fault_fn
    run_fault_injection_test bcachefs:bch_fs_init:alloc_start	device_add_fault_fn
    run_fault_injection_test bcachefs:bch_fs_init:read_super	device_add_fault_fn

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_striping()
{
    set_watchdog 60
    setup_tracing `bcachefs_slowpath_tracepoints`

    if false; then
	run_quiet "" bcachefs format -f		\
	    --replicas=2			\
	    ${ktest_scratch_dev[0]}		\
	    ${ktest_scratch_dev[1]}

	mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

	dd if=/dev/zero of=/mnt/test0 bs=1M count=1024 oflag=direct
	bcachefs fs usage -h /mnt

	bcachefs device add -f /mnt ${ktest_scratch_dev[2]}

	dd if=/dev/zero of=/mnt/test1 bs=1M count=1024 oflag=direct
    else
	run_quiet "" bcachefs format -f		\
	    --data_checksum=none		\
	    --replicas=2			\
	    --label cache			\
	    --durability=1			\
	    --bucket_size=8M			\
	    ${ktest_scratch_dev[0]}		\
	    --label hdd				\
	    --durability=2			\
	    ${ktest_scratch_dev[1]}		\
	    ${ktest_scratch_dev[2]}		\
	    --foreground_target=cache		\
	    --background_target=hdd		\
	    --promote_target=cache

	mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

	dd if=/dev/zero of=/mnt/test0 bs=1M count=1024 oflag=direct
    fi

    bcachefs fs usage -h /mnt

    umount /mnt

    # Test is too short for this to be meaningful:
    bcachefs reset-counters --counters=trans_restart_upgrade ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

disabled_change_replicas()
{
    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    (
	cd /sys/fs/bcachefs/*
	while true; do
	    echo 1 > options/data_replicas
	    sleep 0.1
	    echo 2 > options/data_replicas
	    sleep 0.1
	done
    ) &

    run_fio_randrw

    while true; do
	dd if=/dev/zero of=/mnt/foo bs=1M count=1024 oflag=direct
	sync
	#rm /mnt/foo
    done

    kill %1
    umount /mnt

    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

disabled_change_replicas2()
{
    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    local opt=/sys/fs/bcachefs/*/options/data_replicas
    while true; do
	echo 1 > $opt
	dd if=/dev/zero of=/mnt/foo bs=1M count=1024
	echo 2 > $opt
	sync
	#rm /mnt/foo
    done

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_replicas_gc()
{
    local p=/sys/module/bcachefs/parameters/force_reconstruct_read

    set_watchdog 60

    [[ -f $p ]] && echo 1 > $p

    run_quiet "" bcachefs format -f		\
	--replicas=2				\
	${ktest_scratch_dev[@]}	
    devs="$(join_by : "${ktest_scratch_dev[@]}")"

    mount -t bcachefs $devs /mnt

    antagonist_trigger_gc &
    run_fio_randrw

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_gc
    umount /mnt

    # test remount:
    mount -t bcachefs $devs /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[@]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}

    [[ -f $p ]] && echo 0 > $p
    true
}

test_replace_replica()
{
    set_watchdog 60

    bcachefs format -f --replicas=2 ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    mount -t bcachefs -o degraded ${ktest_scratch_dev[0]} /mnt

    bcachefs device add -f /mnt ${ktest_scratch_dev[2]}

    bcachefs device set-state --force evacuating ${ktest_scratch_dev[1]}

    if [[ `cat /sys/module/bcachefs/parameters/version` -lt 1057 ]]; then
	bcachefs data rereplicate /mnt
    else
	bcachefs reconcile wait -t replicas /mnt
    fi

    umount /mnt

    mount -t bcachefs -o degraded ${ktest_scratch_dev[2]} /mnt
    umount /mnt

    # We expect more btree_path_upgrade_fail events than usual in this test,
    # due to the way the btree node rewrite path works and the fact that we're
    # rewriting every btree node
    bcachefs_test_end_checks ${ktest_scratch_dev[0]} 4
}

# Any "Pending reconcile" counter that has wrapped negative, from fs usage's
# raw byte counts. Empty if none.
reconcile_counters_wrapped()
{
    bcachefs fs usage /mnt | awk '
	/^Pending reconcile/	{ in_rb = 1; next }
	in_rb && NF == 0	{ in_rb = 0 }
	in_rb {
		for (i = 2; i <= NF; i++)
			if ($i ~ /^[0-9]+$/ && length($i) >= 19 && $i > 9000000000000000000)
				print $0
	}'
}

reconcile_stage_status()
{
    echo "=== reconcile counters $1:"
    bcachefs fs usage /mnt | sed -n '/^Pending reconcile/,/^$/p'
    local wrapped=$(reconcile_counters_wrapped)
    [[ -n $wrapped ]] && echo "=== WRAPPED $1: $wrapped"
    true
}

# tools#977 (fenio): replacing a failed member of a replicas=3 filesystem left
# the metadata reconcile counters negative, so reconcile wait never returned.
# A new btree node whose first write failed got need_rb in its key while still
# unreachable; if it was freed before its interior update completed, the add
# and the subtract saw different keys. Timing dependent: about half of runs
# hit it without the fix.
test_replicas3_replace_failed_member()
{
    set_watchdog 1800

    local i sectors
    for i in 0 1 2 3; do
	sectors=$(blockdev --getsz ${ktest_scratch_dev[$i]})
	dmsetup create m$i --table "0 $sectors linear ${ktest_scratch_dev[$i]} 0"
    done

    run_quiet "" bcachefs format -f --replicas=3 /dev/mapper/m0 /dev/mapper/m1 /dev/mapper/m2
    mount -t bcachefs /dev/mapper/m0:/dev/mapper/m1:/dev/mapper/m2 /mnt

    run_fio_randrw --filesize=1000M --loops=1

    # Btree churn: the counters that went negative are metadata ones
    mkdir /mnt/dir
    for i in $(seq 1 30000); do echo $i > /mnt/dir/f$i; done
    for i in 1 2 3; do
	bcachefs subvolume snapshot /mnt /mnt/snap$i
	for j in $(seq 1 5000); do echo x >> /mnt/dir/f$((j * i)); done
    done
    sync
    for i in 1 2 3; do bcachefs subvolume delete /mnt/snap$i; done
    sync
    reconcile_stage_status "after preconditioning"

    # Fail member 1 underneath the mounted filesystem:
    sectors=$(blockdev --getsz /dev/mapper/m1)
    dmsetup load m1 --table "0 $sectors error"
    dmsetup suspend --nolockfs m1
    dmsetup resume m1

    dd if=/dev/urandom of=/mnt/degraded bs=1M count=256 conv=fsync status=none
    reconcile_stage_status "after failing member 1"

    # -f: m3 may still hold whatever an earlier subtest in this VM left on it
    bcachefs device add -f /mnt /dev/mapper/m3
    reconcile_stage_status "after device add"
    bcachefs device remove 1 /mnt
    reconcile_stage_status "after device remove"

    timeout 300 bcachefs reconcile wait /mnt || echo "reconcile wait timed out"
    bcachefs reconcile status /mnt || true
    bcachefs fs usage /mnt || true

    local wrapped=$(reconcile_counters_wrapped)
    umount /mnt

    bcachefs fsck -ny /dev/mapper/m0 /dev/mapper/m2 /dev/mapper/m3

    for i in 0 1 2 3; do dmsetup remove m$i; done

    if [[ -n $wrapped ]]; then
	echo "ERROR: reconcile counters went negative:"
	echo "$wrapped"
	return 1
    fi
}

test_key_type_error()
{
    # A replicas=2 filesystem mounted very_degraded on one device: every
    # write is degraded.
    ktest_expect_sb_errors="data_lost_device_removed|write_degraded_insufficient_devices"
    set_watchdog 20

    bcachefs format -f --replicas=2 ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt
    bcachefs set-file-option --data_replicas=1 /mnt
    bcachefs set-file-option --foreground_target=$(basename ${ktest_scratch_dev[1]}) /mnt

    dd if=/dev/zero of=/mnt/foo bs=64k count=8 oflag=direct

    umount /mnt
    mount -t bcachefs -o very_degraded ${ktest_scratch_dev[0]} /mnt

    bcachefs device remove --force ${ktest_scratch_dev[1]}

    # should fail:
    assert_fails dd if=/mnt/foo of=/dev/null bs=64k count=1 iflag=direct

    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}
    bcachefs reset-counters --counters=data_update_fail ${ktest_scratch_dev[0]}
    bcachefs reset-counters --counters=data_update_key_fail ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_force_remove()
{
    set_watchdog 20

    bcachefs format -f ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]}

    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]} /mnt

    fio --group_reporting		\
	--time_based			\
	--runtime=60s			\
	--ioengine=io_uring		\
	--iodepth=256			\
	--verify_async=8		\
	--bs=4k-64k			\
	--directory=/mnt		\
	--size=16m			\
	--norandommap			\
	--random_distribution=zipf:0.5	\
	--numjobs=16			\
	--rw=randrw			\
	--name=A			\
	--direct=1			\
	--name=B			\
	--direct=0 >/dev/null &
    bcachefs device evacuate ${ktest_scratch_dev[0]} || true
    bcachefs device remove --force --force-metadata ${ktest_scratch_dev[0]} || true
    kill %1
    wait
    touch /mnt/foo
    umount /mnt
}

do_scrub()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_csum_err_recovered"
    local offline=$1

    set_watchdog 60
    run_quiet "" bcachefs format -f		\
	--encrypted --no_passphrase		\
	--replicas=3				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}
    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    dd if=/dev/urandom of=/mnt/test bs=1M count=1000 oflag=direct
    md5sum /mnt/test > /root/md5sum.before

    dd if=/dev/zero of=${ktest_scratch_dev[2]} bs=1M seek=2 count=100 oflag=direct || true

    if $offline; then
	bcachefs device offline -f ${ktest_scratch_dev[0]}
    fi
    bcachefs scrub /mnt || true

    md5sum /mnt/test > /root/md5sum.after
    diff /root/md5sum.before /root/md5sum.after

    echo "Second scrub"

    #perf record -a -o /root/perf.data -e bcachefs:error_throw --
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_scrub()
{
    do_scrub false
}

test_scrub_offline()
{
    do_scrub true
}

test_self_healing()
{
    ktest_expect_device_errors=1
    [[ ! -f /sys/module/bcachefs/parameters/force_read_device ]] && return 0

    setup_tracing bcachefs:btree_cache_cannibalize_lock_fail

    set_watchdog 60
    run_quiet "" bcachefs format -f		\
	--encrypted --no_passphrase		\
	--replicas=2				\
	${ktest_scratch_dev[0]}			\
	${ktest_scratch_dev[1]}			\
	${ktest_scratch_dev[2]}
    mount -t bcachefs ${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}:${ktest_scratch_dev[2]} /mnt

    dd if=/dev/urandom of=/mnt/test bs=1M count=1 oflag=direct
    md5sum /mnt/test > /root/md5sum.before

    dd if=/dev/zero of=${ktest_scratch_dev[2]} bs=1M seek=2 count=100 oflag=direct || true

    echo  2 > /sys/module/bcachefs/parameters/force_read_device
    dd if=/mnt/test of=/dev/null bs=1M iflag=direct
    echo -1 > /sys/module/bcachefs/parameters/force_read_device

    md5sum /mnt/test > /root/md5sum.after
    diff /root/md5sum.before /root/md5sum.after

    # Should find nothing to correct:
    bcachefs scrub /mnt
    umount /mnt

    bcachefs fsck -ny ${ktest_scratch_dev[0]} ${ktest_scratch_dev[1]} ${ktest_scratch_dev[2]}
    #bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# A filesystem with more devices than a mount syscall parameter can hold.
#
# fsconfig(2) copies a string value with strndup_user(_value, 256) and refuses
# anything longer with EINVAL rather than truncating it, so the colon-separated
# device list stops fitting at 24 loop devices; 64 of them come to 757 bytes.
# That made every array above ~25 devices unmountable in bcachefs-tools 1.39.2,
# and nothing here caught it because no other test mounts more than ten.
#
# Loopback rather than scratch devices: this wants more devices than is
# reasonable to attach to the VM, and the backing files are sparse - 64 x 32M
# costs about 5M of real space once formatted.
test_many_device_mount()
{
    set_watchdog 180

    local nr=64
    local dir=/loop-devs
    local devs=()
    local i

    mkdir -p $dir
    for ((i = 0; i < nr; i++)); do
	truncate -s 32M $dir/dev-$i
	devs+=("$(losetup --find --show $dir/dev-$i)")
    done

    run_quiet "" bcachefs format -f		\
	--bucket_size=32k			\
	--block_size=4k				\
	"${devs[@]}"

    # mount(8) execs mount.bcachefs for -t bcachefs, and a device string
    # containing ':' is taken as the complete list (device_scan.rs) - so this
    # goes through the helper's mount path without needing udev to find the
    # members.
    local dev_str
    printf -v dev_str '%s:' "${devs[@]}"
    dev_str=${dev_str%:}

    mount -t bcachefs "$dev_str" /mnt
    dd if=/dev/zero of=/mnt/foo bs=1M count=64 oflag=direct
    umount /mnt

    bcachefs fsck -ny "${devs[@]}"
    bcachefs_test_end_checks "${devs[0]}"

    for i in "${devs[@]}"; do
	losetup -d "$i"
    done
    rm -rf $dir
}

# tools#956: taking a device out of the allocator shrank capacity under the
# reservations dirty pagecache already held, and writeback then waited in the
# allocator for space that wasn't coming back - sync never returned.
test_set_state_under_dirty_reservations()
{
    set_watchdog 300

    run_quiet "" bcachefs format -f --replicas=2 --fs_size=512M "${ktest_scratch_dev[@]}"
    mount -t bcachefs "$(join_by : "${ktest_scratch_dev[@]}")" /mnt

    # Buffered and unsynced, until full: reservations, not data yet
    mkdir /mnt/fill
    local i
    for i in $(seq 1 400); do
	dd if=/dev/zero of=/mnt/fill/b$i bs=1M count=16 status=none 2>/dev/null || break
    done

    bcachefs device set-state --force evacuating ${ktest_scratch_dev[4]}

    # A hung sync is in D and can't be killed: poll, don't wait
    rm -f /tmp/sync.done
    ( sync -f /mnt && touch /tmp/sync.done ) &
    for i in $(seq 1 60); do
	[[ -f /tmp/sync.done ]] && break
	sleep 2
    done
    if [[ ! -f /tmp/sync.done ]]; then
	echo "ERROR: sync hung after taking a device out under dirty reservations"
	exit 1
    fi

    umount /mnt
}

# A flushing journal write on a multi-device filesystem first sends an empty
# REQ_PREFLUSH bio to every rw member (journal_write_preflush(), separate_flush)
# and waits for all of them. It does so even for members that have had no
# writes since their last flush, so an idle or read-only member gets a cache
# flush on every fsync. On SATA a cache flush is a non-queued command, so it
# drains the device's NCQ queue even when the cache is clean.
#
# Here the journal, metadata and data all go to one device, and two more
# members get no writes. Each of those should see (almost) no flushes during a
# loop of fsyncs; today each gets one per fsync. Then one of them does get
# data writes, and must still be flushed on every fsync.

# dev_stat <dev> <field>: a /sys/block/<dev>/stat field, 1-based
# (7: sectors written, 16: flush requests completed). The empty preflush bios
# count as write I/Os, but write no sectors.
dev_stat()
{
    awk -v f=$2 '{ print $f }' /sys/block/$(basename $(readlink -f $1))/stat
}

declare -A sectors flushes

stats_start()
{
    local dev
    for dev in ${ktest_scratch_dev[@]}; do
	sectors[$dev]=$(dev_stat $dev 7)
	flushes[$dev]=$(dev_stat $dev 16)
    done
}

stats_end()
{
    local dev
    for dev in ${ktest_scratch_dev[@]}; do
	sectors[$dev]=$(( $(dev_stat $dev 7) - ${sectors[$dev]} ))
	flushes[$dev]=$(( $(dev_stat $dev 16) - ${flushes[$dev]} ))
	echo "$dev: ${sectors[$dev]} sectors written, ${flushes[$dev]} flushes"
    done
}

# fsync_loop <file> <nr>: <nr> 4k appends, each followed by fsync
fsync_loop()
{
    local cmds=() i
    for ((i = 1; i <= $2; i++)); do
	cmds+=(-c "pwrite -q $((i * 4096)) 4k" -c fsync)
    done
    xfs_io -f "${cmds[@]}" $1
}

test_journal_flush_clean_devices()
{
    local fast=${ktest_scratch_dev[0]}
    local hdd1=${ktest_scratch_dev[1]}
    local hdd2=${ktest_scratch_dev[2]}
    local devs=($fast $hdd1 $hdd2)
    local nr=100 ret=0 dev

    set_watchdog 120

    for dev in ${devs[@]}; do
	local wc=$(cat /sys/block/$(basename $(readlink -f $dev))/queue/write_cache)
	if [[ $wc != "write back" ]]; then
	    echo "ERROR: $dev has write_cache \"$wc\", so the block layer drops flushes - this run tests nothing"
	    return 1
	fi
    done

    run_quiet "" bcachefs format -f		\
	--block_size=4k				\
	--data_replicas=1			\
	--metadata_replicas=1			\
	--label=ssd.ssd1 $fast			\
	--label=hdd.hdd1 $hdd1			\
	--label=hdd.hdd2 $hdd2			\
	--foreground_target=ssd			\
	--metadata_target=ssd

    mount -t bcachefs "$(join_by : "${devs[@]}")" /mnt
    mkdir /mnt/hdd
    bcachefs set-file-option --foreground_target=hdd.hdd1 /mnt/hdd

    # Get the one-time writes (replicas entries, the superblock's clean ->
    # dirty transition) out of the way before counting.
    fsync_loop /mnt/f 1
    fsync_loop /mnt/hdd/f 1
    sync

    echo "$nr fsyncs of data on $fast:"
    stats_start
    fsync_loop /mnt/f $nr
    stats_end

    if [[ ${flushes[$fast]} -lt $nr ]]; then
	echo "ERROR: $fast got fewer flushes than fsyncs - this run tests nothing"
	ret=1
    fi
    for dev in $hdd1 $hdd2; do
	if [[ ${sectors[$dev]} -ne 0 ]]; then
	    echo "ERROR: $dev was written to - this run tests nothing"
	    ret=1
	elif [[ ${flushes[$dev]} -gt $((nr / 10)) ]]; then
	    echo "ERROR: $dev had no writes but got ${flushes[$dev]} flushes for $nr fsyncs"
	    ret=1
	fi
    done

    echo "$nr fsyncs of data on $hdd1:"
    stats_start
    fsync_loop /mnt/hdd/f $nr
    stats_end

    if [[ ${sectors[$hdd1]} -lt $((nr * 8)) || ${sectors[$hdd2]} -ne 0 ]]; then
	echo "ERROR: the data did not go to $hdd1 only - this run tests nothing"
	ret=1
    fi
    if [[ ${flushes[$hdd1]} -lt $nr ]]; then
	echo "ERROR: $hdd1 was written before every fsync but got only ${flushes[$hdd1]} flushes for $nr fsyncs"
	ret=1
    fi
    if [[ ${flushes[$hdd2]} -gt $((nr / 10)) ]]; then
	echo "ERROR: $hdd2 had no writes but got ${flushes[$hdd2]} flushes for $nr fsyncs"
	ret=1
    fi

    umount /mnt

    bcachefs fsck -ny ${devs[@]}
    bcachefs_test_end_checks ${devs[@]}
    return $ret
}


#
# Journal scrub
#

#
# Whether recovery messages reach dmesg depends on the mount having a terminal.
#
# RecoveryDisplay::new() (src/recovery_display.rs) picks its sink in order:
# stderr if stderr is a terminal, else plymouth, else /dev/console opened
# directly. Measured in a VM: with a terminal, the scrub's messages are in dmesg;
# run from a plain non-interactive shell they are not - they go to the console,
# which the ktest log shows and dmesg never sees.
#
# So the pty is load-bearing, not cosmetic. Without it every assertion below
# reads an empty dmesg, which is silent for the absent-string ones and only
# visible because test_scrub_journal asserts the same string positively.
#
# The pty's own output is not the place to look - it is the redrawing progress
# display, about a screenful. dmesg is: mark it first and read what follows.
#
mount_capture()
{
    local ret

    dmesg_mark mount_capture
    script -qefc "mount $*" /dev/null < /dev/null && ret=0 || ret=$?

    mount_output=$(dmesg_since mount_capture)
    return $ret
}

#
# Mount with =always on a CLEANLY unmounted filesystem.
#
# This is the only thing that distinguishes always from unclean: it reads the
# journal on a filesystem the superblock says is clean, which no other mount
# path does. test_scrub_journal() below cannot reach it - it does an emergency
# shutdown first, so c->sb.clean is false and both gates pass on the unclean
# half of the ||. The default would take exactly the same path there.
#
# Regression test for ChH's report: journal_start.clean is only assigned once
# bch2_journal_read() reaches a usable flush entry, so finding none left it
# false from the initializer, and recovery reported "filesystem marked clean
# but journal not empty" - the exact opposite of what happened - then went
# emergency read-only at seq 0.
#
test_scrub_journal_clean()
{
    set_watchdog 120

    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f --errors=ro "$dev"

    mount -t bcachefs "$dev" /mnt
    dd if=/dev/urandom of=/mnt/data bs=1M count=32 status=none
    sync

    # Clean unmount: superblock gets marked clean.
    umount /mnt

    if ! bcachefs show-super "$dev" | grep -i 'clean.*1\|^ *clean' >/dev/null; then
	echo "NOTE: could not confirm clean flag in show-super; continuing"
    fi

    echo "Mounting cleanly-unmounted fs with scrub_recent_journal_entries=always..."
    if ! mount_capture -t bcachefs -o scrub_recent_journal_entries=always,verbose "$dev" /mnt; then
	echo "ERROR: mount failed on a clean filesystem with =always"
	exit 1
    fi

    # Every check here is a check for absence, so first establish that the scrub
    # ran at all - on a clean fs it may legitimately find no flush entries to
    # check, but it must have looked.
    if ! grep -qE 'journal scrub: checking|scrub_journal.*No journal flushes' <<< "$mount_output"; then
	echo "ERROR: scrub did not run - the checks below would be vacuous"
	exit 1
    fi

    if grep -q 'marked clean but journal not empty' <<< "$mount_output"; then
	echo "ERROR: spurious clean_but_journal_not_empty on a clean filesystem"
	exit 1
    fi

    if grep -qi 'emergency read only' <<< "$mount_output"; then
	echo "ERROR: went emergency read-only mounting a clean filesystem"
	exit 1
    fi

    # Nothing was corrupted, so nothing should have rewound.
    if grep -q 'not honoring flush/FUA' <<< "$mount_output"; then
	echo "ERROR: rewound a clean, uncorrupted filesystem"
	exit 1
    fi

    echo hello > /mnt/still-writable
    umount /mnt

    bcachefs fsck -ny "$dev"

    echo "Test passed: clean fs mounts with =always, no spurious rewind"
}

#
# Leave an unclean filesystem behind on $1, with data in the journal.
#
unclean_shutdown_with_data()
{
    local dev=$1

    run_quiet "" bcachefs format -f --errors=ro --no_initialize "$dev"
    mount -t bcachefs "$dev" /mnt

    run_fio_base			\
	--filesize=50M			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt
}

#
# The three values of scrub_recent_journal_entries do what their names say.
#
# unclean is 0 deliberately, so that it is the default and existing filesystems
# get the scrub without being told to. Which makes 0 an *enabled* value - and
# recovery.c:930 and journal/read.c:132 both used to test this option for
# truthiness, so the default never scrubbed and "no" scrubbed on every unclean
# mount. The one that matters is a user writing =no to turn the feature off and
# getting it turned on.
#
# Asserted on an unclean filesystem, which is the case that distinguishes all
# three. On a clean one, no and unclean agree.
#
test_scrub_journal_option_values()
{
    set_watchdog 300

    local dev=${ktest_scratch_dev[0]}

    unclean_shutdown_with_data "$dev"
    mount_capture -t bcachefs -o scrub_recent_journal_entries=no,verbose "$dev" /mnt
    umount /mnt
    if grep -q 'journal scrub: checking' <<< "$mount_output"; then
	echo "ERROR: =no scrubbed"
	exit 1
    fi

    unclean_shutdown_with_data "$dev"
    mount_capture -t bcachefs -o scrub_recent_journal_entries=unclean,verbose "$dev" /mnt
    umount /mnt
    if ! grep -q 'journal scrub: checking' <<< "$mount_output"; then
	echo "ERROR: =unclean did not scrub an unclean filesystem"
	exit 1
    fi

    unclean_shutdown_with_data "$dev"
    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,verbose "$dev" /mnt
    umount /mnt
    if ! grep -q 'journal scrub: checking' <<< "$mount_output"; then
	echo "ERROR: =always did not scrub an unclean filesystem"
	exit 1
    fi

    bcachefs fsck -ny "$dev"

    echo "Test passed: no/unclean/always mean what they say"
}

#
# Negative control for test_scrub_journal(): same unclean shutdown, same
# =always mount, but nothing corrupted. The scrub must find nothing and must
# not rewind.
#
# Without this, "the scrub always rewinds" and "the scrub always reports
# flush/FUA errors" both pass the corruption test, because that test only
# asserts the positive.
#
test_scrub_journal_no_corruption()
{
    set_watchdog 300

    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f --errors=ro --no_initialize "$dev"

    mount -t bcachefs "$dev" /mnt

    run_fio_base			\
	--filesize=50M			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    echo "Mounting uncorrupted unclean fs with scrub_recent_journal_entries=always..."
    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,verbose "$dev" /mnt

    # The scrub has to have actually run, or the two checks below pass for the
    # wrong reason:
    if ! grep -q 'journal scrub: checking' <<< "$mount_output"; then
	echo "ERROR: scrub did not run - the checks below would be vacuous"
	exit 1
    fi

    if grep -q 'not honoring flush/FUA' <<< "$mount_output"; then
	echo "ERROR: scrub reported flush/FUA errors with nothing corrupted"
	exit 1
    fi

    if grep -qi 'rewinding from seq' <<< "$mount_output"; then
	echo "ERROR: scrub rewound with nothing corrupted"
	exit 1
    fi

    umount /mnt
    bcachefs fsck -ny "$dev"

    echo "Test passed: no corruption, no rewind"
}

test_scrub_journal()
{
    ktest_expect_device_errors=1
    set_watchdog 300

    local BUCKET_SIZE_KB=512
    local BUCKET_SIZE_SECTORS=$((BUCKET_SIZE_KB * 2))

    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f		\
	--errors=ro				\
	--bucket_size=${BUCKET_SIZE_KB}k	\
	--no_initialize				\
	"$dev"

    # Mount and write data — generates extent keys in the journal
    mount -t bcachefs "$dev" /mnt

    run_fio_base			\
	--filesize=100M			\
	--loops=2			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    # Emergency shutdown — leaves unflushed journal entries
    echo "Triggering emergency shutdown..."
    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    # Get the seq of the 3rd-to-last flush entry — the start of the scrub window
    local scrub_seq=$(bcachefs list_journal -F -D $dev|tail -n2|awk '{print $3}'|head -n1)
    echo "Scrub window starts at seq $scrub_seq"

    if [[ -z $scrub_seq ]]; then
	echo "ERROR: No valid flush seq found in journal"
	exit 1
    fi

    # Extract extent lines from journal entries in the scrub window
    local extents=$(bcachefs list_journal -s "$scrub_seq.." -b extents "$dev") 2>/dev/null

    if [[ -z $extents ]]; then
	echo "ERROR: No extents found in journal scrub window"
	exit 1
    fi

    local extent_sectors=$(echo "$extents" |
	bcachefs_ptr_sectors $BUCKET_SIZE_SECTORS 0)

    if [[ -z $extent_sectors ]]; then
	echo "ERROR: No sector offsets parsed from extents"
	exit 1
    fi

    local nr_total=$(echo "$extent_sectors" | wc -l)

    # Corrupt a limited number of data blocks
    local nr_corrupted=$(echo "$extent_sectors" | head -10 |
	bcachefs_corrupt_sectors "$dev")

    echo "Corrupted $nr_corrupted / $nr_total data extent locations"

    # Mount with scrub_recent_journal_entries — should detect corruption
    # and automatically rewind
    echo "Mounting with scrub_recent_journal_entries=always..."
    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,verbose "$dev" /mnt

    # Verify scrub detected the corruption
    if ! grep -q 'not honoring flush/FUA' <<< "$mount_output"; then
	echo "ERROR: Scrub did not detect flush/FUA corruption"
	exit 1
    fi

    if ! grep -q 'rewinding from seq' <<< "$mount_output"; then
	echo "ERROR: Scrub detected corruption but did not rewind"
	exit 1
    fi

    echo "Scrub detected corruption and rewound automatically"

    umount /mnt

    # Final consistency check
    bcachefs fsck -ny "$dev"

    echo "Test passed: scrub detected corruption, rewind recovered"
}

# The same, with every extent replicated and only one device's copy corrupted:
# the device didn't honour the flush, but nothing was lost - every bad replica
# has a good one on the other device. Rewinding would throw away writes for no
# reason; the scrub has to repair from the good replicas instead.
test_scrub_journal_replicated()
{
    ktest_expect_device_errors=1
    set_watchdog 300

    local BUCKET_SIZE_KB=512
    local BUCKET_SIZE_SECTORS=$((BUCKET_SIZE_KB * 2))

    local dev0=${ktest_scratch_dev[0]}
    local dev1=${ktest_scratch_dev[1]}

    run_quiet "" bcachefs format -f		\
	--errors=ro				\
	--replicas=2				\
	--bucket_size=${BUCKET_SIZE_KB}k	\
	--no_initialize				\
	"$dev0" "$dev1"

    mount -t bcachefs "$dev0:$dev1" /mnt

    run_fio_base			\
	--filesize=100M			\
	--loops=2			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    local scrub_seq=$(bcachefs list_journal -F -D "$dev0" "$dev1"|tail -n2|awk '{print $3}'|head -n1)
    echo "Scrub window starts at seq $scrub_seq"
    [[ -n $scrub_seq ]]

    local extents=$(bcachefs list_journal -s "$scrub_seq.." -b extents "$dev0" "$dev1")
    [[ -n $extents ]]

    # Member 0's copies only: member 1 keeps a good replica of everything
    local nr_corrupted=$(echo "$extents" |
	bcachefs_ptr_sectors $BUCKET_SIZE_SECTORS 0 | head -10 |
	bcachefs_corrupt_sectors "$dev0")
    echo "Corrupted $nr_corrupted member 0 replicas"
    (( nr_corrupted > 0 ))

    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,verbose \
	"$dev0:$dev1" /mnt

    if ! grep -q 'bad replicas, to repair from good ones' <<< "$mount_output"; then
	echo "FAIL: scrub didn't find the bad replicas"
	exit 1
    fi

    if grep 'rewinding from seq' <<< "$mount_output"; then
	echo "FAIL: scrub rewound when every extent had a good replica"
	exit 1
    fi

    local repaired=$(grep -o 'repairing [0-9]* extents/btree nodes from good replicas' <<< "$mount_output" |
		     awk '{print $2}')
    echo "repaired from good replicas: ${repaired:-none}"
    if (( ${repaired:-0} == 0 )); then
	echo "FAIL: nothing repaired from the good replicas"
	exit 1
    fi

    # Everything reads back
    find /mnt -type f -exec cat {} + > /dev/null

    umount /mnt
    bcachefs fsck -ny "$dev0" "$dev1"
}

# btree nodes written in the scrub window: the journal scrub has to check the
# nodes that pointers in the window point to, not just extents. $1 is the
# number of devices; with 2, every node is replicated and only member 0's copy
# is corrupted.
#
# Sets nr_corrupted; skips the test if no node was created in the window.
scrub_journal_btree_node_setup()
{
    local nr_devs=$1
    local BUCKET_SIZE_KB=512
    local BUCKET_SIZE_SECTORS=$((BUCKET_SIZE_KB * 2))
    local devs=("${ktest_scratch_dev[@]:0:$nr_devs}")

    run_quiet "" bcachefs format -f		\
	--errors=ro				\
	--replicas=$nr_devs			\
	--bucket_size=${BUCKET_SIZE_KB}k	\
	--no_initialize				\
	"${devs[@]}"

    mount -t bcachefs "$(join_by : "${devs[@]}")" /mnt

    run_fio_base			\
	--filesize=50M			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    # Hold journal reclaim off: it's what moves last_seq past the entries that
    # created the nodes, once they're written - after which they're durable,
    # not what a dropped flush loses, and not replayed or scrubbed.
    echo 600000 > /sys/fs/bcachefs/*/options/journal_reclaim_delay

    # Split btree nodes in the last flush ranges: the scrub checks the ranges
    # between flush entries newest first, stopping after two clean ones. 4k
    # random direct writes to a fresh file are one extent each, unmergeable,
    # straight into the extents btree - several leaves' worth over the whole
    # run, splitting as it goes. In chunks, each ended by a sync: every chunk
    # is a flush range, whatever the timing. Shut down right after the last.
    sync
    local i
    for i in 0 1 2 3; do
	fio --name=split --filename=/mnt/split --rw=randwrite --bs=4k	\
	    --offset=$((i * 16))M --size=16M --direct=1			\
	    --ioengine=libaio --iodepth=32 --output=/dev/null
	sync
    done

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    # The last two flush ranges - of those the scrub sees: it starts from the
    # first flush at or after the replay start (last_seq), and list_journal
    # lists flushes from before it too
    local flushes=$(bcachefs list_journal -F -D "${devs[@]}" 2>&1)
    local replay_start=$(echo "$flushes" |
	sed -n 's/.*replaying entries \([0-9]*\)-.*/\1/p' | head -n1)
    local scrub_seq=$(echo "$flushes" |
	awk -v s="$replay_start" '/^journal entry/ && $3 >= s { print $3 }' |
	tail -n3 | head -n1)
    [[ -n $scrub_seq ]] ||
	ktest_skip "no flush entries after the replay start ($replay_start)"

    # Nodes created in the window - what a dropped flush can lose. A pointer
    # in the window can also be to an older node with a bset appended (its
    # sectors_written updated): corrupting that node's start would destroy
    # what was written before the window, which isn't what a dropped flush
    # loses. Those have an overwrite entry with the same node seq; new nodes
    # don't. Roots are btree_root entries, not keys: not scrubbed.
    local nodes=$(bcachefs list_journal -s "$scrub_seq.." "${devs[@]}" | awk '
	/u64s [0-9]+ type/ {
	    kind = ""
	    if (/type btree_ptr_v2/)
		kind = /overwrite:/ ? "old" : /btree_keys:/ ? "new" : ""
	    nr++
	    key_kind[nr] = kind
	}
	kind != "" {
	    key_lines[nr] = key_lines[nr] $0 "\n"
	    if (match($0, /seq [0-9a-f]+ written/)) {
		seq = substr($0, RSTART + 4, RLENGTH - 12)
		key_seq[nr] = seq
		if (kind == "old")
		    old_seq[seq] = 1
	    }
	}
	END {
	    for (i = 1; i <= nr; i++)
		if (key_kind[i] == "new" && !(key_seq[i] in old_seq))
		    printf "%s", key_lines[i]
	}')
    local sectors=$(echo "$nodes" | bcachefs_ptr_sectors $BUCKET_SIZE_SECTORS 0)

    echo "replay start $replay_start, flushes from there:" \
	$(echo "$flushes" | awk -v s="$replay_start" '/^journal entry/ && $3 >= s { print $3 }')
    echo "corrupting nodes created after seq $scrub_seq:" \
	$(echo "$nodes" | grep -o 'seq [0-9a-f]* written [0-9]*' | awk '{print $2 "/" $4}')

    # Where splits land depends on journal timing; now and then none do in
    # the window, and there's nothing to test
    [[ -n $sectors ]] ||
	ktest_skip "no btree nodes created in the scrub window (from seq $scrub_seq)"

    nr_corrupted=$(echo "$sectors" | bcachefs_corrupt_sectors "${devs[0]}")
}

# Nodes created in the window, every copy corrupted: the scrub can't repair
# them, and mustn't rewind - a rewind only rolls back leaf keys, the interior
# pointers to the nodes stay. It flags the btree as having lost data instead,
# so topology repair runs before journal replay and the filesystem mounts.
test_scrub_journal_btree_node()
{
    ktest_expect_device_errors=1
    # Losing the nodes: reading them (the corruption overwrote their
    # headers), topology repair, and what the lost nodes' keys referenced
    # left stale - backpointers, pointer gens, alloc info
    ktest_expect_sb_errors="btree_node_bad_magic|btree_node_topology_[a-z_]+"
    ktest_expect_sb_errors+="|backpointer_to_missing_ptr|stale_dirty_ptr"
    ktest_expect_sb_errors+="|lru_entry_bad|alloc_key_to_missing_lru_entry"
    ktest_expect_sb_errors+="|freespace_key_wrong|need_discard_freespace_key_bad"
    set_watchdog 300

    local nr_corrupted
    scrub_journal_btree_node_setup 1
    echo "Corrupted $nr_corrupted btree nodes"

    # The window is also cut to flushes within scrub_journal_max_rewind_secs
    # (default 10) of the newest: widen it, so the flush ranges decide what's
    # checked and not how fast the VM ran the workload
    local mount_ret=0
    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,scrub_journal_max_rewind_secs=3600,verbose \
	${ktest_scratch_dev[0]} /mnt || mount_ret=$?

    if ! grep -q 'btree nodes with no good replica' <<< "$mount_output"; then
	echo "FAIL: scrub didn't find the lost btree nodes"
	exit 1
    fi

    if grep 'rewinding from seq' <<< "$mount_output"; then
	echo "FAIL: rewound for lost btree nodes - the rewind doesn't remove them"
	exit 1
    fi

    if (( mount_ret )); then
	echo "FAIL: recovery didn't get past the lost btree nodes"
	exit 1
    fi

    umount /mnt

    # Topology repair after losing a node leaves alloc info stale for the
    # buckets the lost node's keys pointed to, beyond what the mount fixes
    local ret=0
    bcachefs fsck -y ${ktest_scratch_dev[0]} || ret=$?
    (( ret <= 1 ))
    bcachefs fsck -n ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_scrub_journal_btree_node_replicated()
{
    ktest_expect_device_errors=1
    set_watchdog 300

    local nr_corrupted
    scrub_journal_btree_node_setup 2
    echo "Corrupted $nr_corrupted member 0 btree node replicas"

    # see test_scrub_journal_btree_node
    mount_capture -t bcachefs -o scrub_recent_journal_entries=always,scrub_journal_max_rewind_secs=3600,verbose \
	"${ktest_scratch_dev[0]}:${ktest_scratch_dev[1]}" /mnt

    if ! grep -q 'bad replicas, to repair from good ones' <<< "$mount_output"; then
	echo "FAIL: scrub didn't find the bad btree node replicas"
	exit 1
    fi

    if grep 'rewinding from seq' <<< "$mount_output"; then
	echo "FAIL: scrub rewound when every btree node had a good replica"
	exit 1
    fi

    local repaired=$(grep -o 'repairing [0-9]* extents/btree nodes from good replicas' <<< "$mount_output" |
		     awk '{print $2}')
    echo "repaired from good replicas: ${repaired:-none}"
    if (( ${repaired:-0} == 0 )); then
	echo "FAIL: no btree node repaired from its good replica"
	exit 1
    fi

    find /mnt -type f -exec cat {} + > /dev/null

    umount /mnt
    bcachefs fsck -ny "${ktest_scratch_dev[0]}" "${ktest_scratch_dev[1]}"
}

#
# The journal scrub on a degraded filesystem: one device unplugged, metadata
# still readable from its mirror, data that only landed on the missing device
# unreadable. The scrub has to run, and the missing device mustn't be taken
# for one that dropped a flush.
#
test_scrub_journal_degraded()
{
    ktest_expect_device_errors=1
    set_watchdog 300

    local dev0=${ktest_scratch_dev[0]}
    local dev1=${ktest_scratch_dev[1]}

    # Metadata mirrored, data not: the filesystem has to survive losing a
    # device well enough to mount and run recovery, while the extents that
    # landed on the missing one have nowhere else to be read from. With
    # metadata at 1 replica too, the root inode goes down with the device and
    # the mount fails with ENOENT_bkey_type_mismatch before the scrub is the
    # interesting part.
    run_quiet "" bcachefs format -f --errors=continue --no_initialize	\
	--metadata_replicas=2 --data_replicas=1				\
	"$dev0" "$dev1"
    local fs_uuid=$(bcachefs show-super "$dev0" | \
	sed -n 's/^External UUID:[[:space:]]*//p')

    mount -t bcachefs "$dev0:$dev1" /mnt

    run_fio_base			\
	--filesize=50M			\
	--name=randrw			\
	--rw=randrw			\
	--bsrange=4k-256k

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only
    umount /mnt

    scratch_dev_unplug 1

    echo "Mounting degraded with scrub_recent_journal_entries=always..."
    mount_capture -t bcachefs -o degraded=very,scrub_recent_journal_entries=always,verbose,fix_errors=yes \
	UUID=$fs_uuid /mnt

    if ! grep -q 'journal scrub: checking' <<< "$mount_output"; then
	echo "ERROR: scrub did not run on the degraded mount"
	exit 1
    fi

    # The absent device's replicas aren't read at all: a device that isn't
    # there says nothing about whether it honoured flush/FUA, and mustn't be
    # taken for one that didn't - no report, no rewind.
    if grep -E 'not honoring flush/FUA|rewinding from seq' <<< "$mount_output"; then
	echo "ERROR: the absent device was taken for one that dropped a flush"
	exit 1
    fi

    umount /mnt
    scratch_dev_plug 1

    echo "Test passed: scrub survives a degraded mount"
}


#
# Scrub cancellation tests.
#
# Cancelling a scrub job means closing its progress fd, which blocks in
# kthread_stop() until that device's scrub thread notices and drains its
# in-flight reads. The scrub command must issue those closes in parallel
# on interrupt: serial closes cost the sum of per-device stop latencies.
#
# scrub_cancel is the basic single-device test; the parallel_* tests
# use dm-delay to make per-device stop latency large and controlled,
# then verify the parallelism property directly (timing, and
# simultaneous kthread_stop stack samples).
#
# The filesystem is the first four scratch devices, the ones wrapped in
# dm-delay - scrub_delay_devs, not ktest_scratch_dev[@], for anything that
# names its members.

SCRUB_DELAY_NR_DEVS=4
delay_devs=()

scrub_delay_devs()
{
    echo "${ktest_scratch_dev[@]:0:$SCRUB_DELAY_NR_DEVS}"
}

# dm-delay wrappers over the scratch devices. Created with no delay so
# format/mount/writes run at full speed; set_read_delay swaps in a
# read-side delay just before the scrub under test.
setup_delay_devs()
{
    local i

    # Self-clean in case an earlier failed subtest left state behind:
    umount /mnt 2>/dev/null || true
    for i in $(seq 0 $((SCRUB_DELAY_NR_DEVS - 1))); do
	dmsetup remove --retry scrubdelay$i 2>/dev/null || true
    done

    delay_devs=()
    for i in $(seq 0 $((SCRUB_DELAY_NR_DEVS - 1))); do
	local dev=${ktest_scratch_dev[$i]}
	dmsetup create scrubdelay$i --table \
	    "0 $(blockdev --getsz $dev) delay $dev 0 0"
	delay_devs+=(/dev/mapper/scrubdelay$i)
    done
}

set_read_delay()
{
    local ms=$1 i
    for i in $(seq 0 $((SCRUB_DELAY_NR_DEVS - 1))); do
	local dev=${ktest_scratch_dev[$i]}
	dmsetup reload scrubdelay$i --table \
	    "0 $(blockdev --getsz $dev) delay $dev 0 $ms $dev 0 0"
	dmsetup suspend scrubdelay$i
	dmsetup resume scrubdelay$i
    done
}

teardown_delay_devs()
{
    local i
    for i in $(seq 0 $((SCRUB_DELAY_NR_DEVS - 1))); do
	dmsetup remove --retry scrubdelay$i
    done
    delay_devs=()
}

test_scrub_cancel()
{
    set_watchdog 180
    run_quiet "" bcachefs format -f ${ktest_scratch_dev[0]}
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    # Enough data that the scrub can't finish before we get to cancel it. There
    # is no --rate to slow a scrub down, so the only lever on how long it runs
    # is how much it has to walk, and a scrub that has already finished tells us
    # nothing about cancelling one: the first version wrote 100M and the scrub
    # reported 100% complete before the two second wait below was up. That puts
    # the rate somewhere above 70MB/s - we only know it beat the wait, not by
    # how much - so size for the pessimistic end and leave the wait alone, since
    # shortening it risks cancelling during startup instead of mid-walk.
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=2000 oflag=direct
    sync

    umount /mnt
    mount -t bcachefs ${ktest_scratch_dev[0]} /mnt

    echo "Starting scrub in background..."
    bcachefs scrub ${ktest_scratch_dev[0]} &
    scrub_pid=$!

    # Let it get going, but nowhere near finishing
    sleep 2

    # Check it's actually running before we try to cancel it. Without this both
    # of the ways that can fail - a scrub that died on startup (a renamed
    # subcommand, say, which is what "bcachefs data scrub" had silently become)
    # and a scrub that ran to completion because there wasn't enough to walk -
    # surface several lines below as "kill: no such process", which reads like a
    # cancellation bug rather than a scrub we never got to cancel.
    #
    # They want opposite fixes, so tell them apart by how it exited.
    if ! kill -0 $scrub_pid 2>/dev/null; then
        if wait $scrub_pid; then
            echo "FAILED: scrub finished before we could cancel it"
            echo "        (it needs more data to walk, or a shorter wait above)"
        else
            echo "FAILED: scrub exited nonzero before we could cancel it - it never started"
        fi
        umount /mnt
        exit 1
    fi

    echo "Sending SIGINT to scrub (pid $scrub_pid)..."
    kill -INT $scrub_pid

    echo "Waiting for scrub to exit (should be quick)..."
    local start=$(date +%s)

    # Wait with timeout
    local timeout=10
    while kill -0 $scrub_pid 2>/dev/null; do
        sleep 0.1
        local now=$(date +%s)
        local elapsed=$((now - start))
        if [[ $elapsed -gt $timeout ]]; then
            echo "FAILED: scrub did not exit within ${timeout}s"
            echo "Thread state:"
            cat /proc/$scrub_pid/stack 2>/dev/null || true

            # Check kernel side
            echo "Moving contexts:"
            cat /sys/fs/bcachefs/*/moving_ctxts 2>/dev/null || true

            kill -9 $scrub_pid
            wait $scrub_pid 2>/dev/null || true
            umount /mnt
            exit 1
        fi
    done

    wait $scrub_pid || true
    local end=$(date +%s)
    echo "Scrub exited in $((end - start)) seconds"

    umount /mnt
    bcachefs fsck -ny ${ktest_scratch_dev[0]}
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Start a scrub against the delay devices with the given read delay and
# wait until all four device jobs have reads in flight; sets scrub_pid.
# Callers take over from the SIGINT.
#
# The workload must be many small extents: scrub keeps up to
# move_ios_in_flight (64) reads in flight per device, and anything that
# fits in one submission burst completes after a single delay round no
# matter how large the delay - a handful of big extents makes the whole
# scrub finish in one round before we can interrupt it. 4k random
# writes produce thousands of physically discontiguous (so unmergeable)
# extents per device, sustaining delayed read rounds for minutes.
start_delayed_scrub()
{
    local delay_ms=$1

    setup_delay_devs
    run_quiet "" bcachefs format -f "${delay_devs[@]}"
    local devs="$(join_by : "${delay_devs[@]}")"
    mount -t bcachefs $devs /mnt

    run_fio_base				\
	--name=frag				\
	--rw=randwrite				\
	--bs=4k					\
	--filesize=32M
    sync

    set_read_delay $delay_ms

    bcachefs scrub /mnt &
    scrub_pid=$!
    sleep 3

    # A scrub that finished (needs a bigger workload or delay) and a
    # scrub that died on startup (a broken CLI) both show up here as a
    # dead pid but want opposite fixes; tell them apart by exit status.
    if ! kill -0 $scrub_pid 2>/dev/null; then
	if wait $scrub_pid; then
	    echo "ERROR: scrub finished before it could be interrupted"
	else
	    echo "ERROR: scrub exited nonzero before it could be interrupted - it never started"
	fi
	return 1
    fi
}

# Wait for the scrub command to exit; sets scrub_exit_s. If it is still
# running after $1 seconds, dump its kernel stacks and the filesystem's
# moving_ctxts - a wedged cancellation with no state dump is
# undebuggable from a test log - then kill it so teardown can proceed.
wait_scrub_exit()
{
    local timeout=$1
    local start=$(date +%s)

    while kill -0 $scrub_pid 2>/dev/null; do
	if (($(date +%s) - start > timeout)); then
	    echo "ERROR: scrub still running after ${timeout}s"
	    echo "Thread state:"
	    cat /proc/$scrub_pid/task/*/stack 2>/dev/null || true
	    echo "Moving contexts:"
	    cat /sys/fs/bcachefs/*/moving_ctxts 2>/dev/null || true
	    kill -9 $scrub_pid 2>/dev/null || true
	    wait $scrub_pid 2>/dev/null || true
	    return 1
	fi
	sleep 0.1
    done
    wait $scrub_pid 2>/dev/null || true
    scrub_exit_s=$(($(date +%s) - start))
}

finish_delayed_scrub()
{
    set_read_delay 0
    umount /mnt
    teardown_delay_devs
    bcachefs fsck -ny $(scrub_delay_devs)
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_scrub_cancel_parallel_timing()
{
    set_watchdog 300

    # Stopping one device's scrub job means draining its current batch
    # of delayed reads, up to one full 8s round. The four jobs submit
    # their bursts in lockstep (same start, same delay, same batch
    # size), so batch boundaries stay aligned across devices: serial
    # cancellation finishes one device's drain exactly when the others
    # have just submitted fresh batches, cascading into further full
    # rounds. Measured: parallel ~14s (signal poll + up to two rounds),
    # serial ~47s; the 25s threshold sits between with >10s margin to
    # each.
    start_delayed_scrub 8000

    local start_ms=$(date +%s%3N)
    kill -INT $scrub_pid
    if ! wait_scrub_exit 60; then
	finish_delayed_scrub
	return 1
    fi
    local elapsed_ms=$(($(date +%s%3N) - start_ms))
    echo "cancellation took ${elapsed_ms}ms"

    finish_delayed_scrub

    if ((elapsed_ms > 25000)); then
	echo "ERROR: cancellation took ${elapsed_ms}ms - serial kthread_stop?"
	return 1
    fi
}

# Going read-only must abort running data jobs: every job holds a
# c->writes ref for its thread's lifetime, and the read-only transition
# (asynchronous - the trigger returns immediately) blocks in the write
# ref drain until the jobs are gone. With the abort, each job errors
# out at its next loop iteration, drops its ref, and the scrub command
# sees its jobs finish and exits within seconds. Without it, the jobs
# run to completion - the dm-delay reads make that take minutes - and
# the scrub outliving the trigger by 30s is the failure signature.
test_scrub_emergency_ro()
{
    set_watchdog 300

    start_delayed_scrub 3000

    echo 1 > /sys/fs/bcachefs/*/internal/trigger_emergency_read_only

    if ! wait_scrub_exit 30; then
	return 1
    fi
    echo "scrub exited ${scrub_exit_s}s after emergency read-only"

    set_read_delay 0
    umount /mnt
    teardown_delay_devs

    # Journal replay from the unclean shutdown, then verify:
    local devs="$(join_by : $(scrub_delay_devs))"
    mount -t bcachefs $devs /mnt
    umount /mnt
    bcachefs fsck -ny $(scrub_delay_devs)
}

test_scrub_cancel_parallel_stacks()
{
    set_watchdog 300

    start_delayed_scrub 3000

    kill -INT $scrub_pid

    # Sample the scrub process's kernel stacks while it tears down: with
    # parallel cancellation multiple threads block in kthread_stop() at
    # once; the serial implementation can never show more than one.
    local max_parallel=0 n
    while kill -0 $scrub_pid 2>/dev/null; do
	n=$(grep -l kthread_stop /proc/$scrub_pid/task/*/stack 2>/dev/null | wc -l || true)
	if ((n > max_parallel)); then
	    max_parallel=$n
	fi
	sleep 0.05
    done
    wait $scrub_pid || true
    echo "max threads simultaneously in kthread_stop: $max_parallel"

    finish_delayed_scrub

    if ((max_parallel < 2)); then
	echo "ERROR: never saw parallel kthread_stop - cancellation is serial"
	return 1
    fi
}


#
# Scrub detection and repair of real on-disk data corruption: locate
# extent/stripe pointers from key listings (dev:bucket:offset, fixed
# 512k buckets so the sector math is static), overwrite the data with
# the filesystem unmounted, then verify scrub's exit code: bit 2 =
# errors corrected, bit 4 = uncorrectable errors found.
#
# Five cases:
#   single_replica - no redundancy: scrub must report uncorrectable
#   replicated     - four replicas, random subsets of copies corrupt
#                    (including one extent with three of four gone):
#                    scrub must repair everything from the survivors
#   ec_data        - EC stripe data block corrupt: scrub must repair
#                    via stripe reconstruction
#   ec_parity      - EC stripe parity block corrupt: scrub must repair
#                    it (parity is reconstructible from the intact data
#                    blocks).
#   ec_unreferenced - EC stripe data block corrupt where no live extent
#                    references it any more: scrub must repair it, and
#                    the file must read back with another block of the
#                    stripe offline.

BUCKET_SIZE_KB=512
BUCKET_SIZE_SECTORS=$((BUCKET_SIZE_KB * 2))

test_scrub_corrupt_single_replica()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    set_watchdog 120

    local dev=${ktest_scratch_dev[0]}

    run_quiet "" bcachefs format -f --bucket_size=${BUCKET_SIZE_KB}k "$dev"
    mount -t bcachefs "$dev" /mnt
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=16 oflag=direct
    sync
    umount /mnt

    local nr=$(bcachefs list -b extents "$dev" |
	bcachefs_ptr_sectors $BUCKET_SIZE_SECTORS 0 | head -8 |
	bcachefs_corrupt_sectors "$dev")
    if ((nr == 0)); then
	echo "ERROR: found no extent locations to corrupt"
	return 1
    fi

    mount -t bcachefs "$dev" /mnt
    local rc=0
    bcachefs scrub "$dev" || rc=$?
    echo "scrub exit code: $rc"
    umount /mnt

    if (((rc & 4) == 0)); then
	echo "ERROR: scrub did not report uncorrectable errors"
	return 1
    fi

    bcachefs fsck -ny "$dev"
    bcachefs_test_end_checks "$dev"
}

# Print "extent# dev sector" for every replica pointer in a bkey
# listing on stdin, grouping pointers by the extent they belong to.
extent_replica_locations()
{
    awk -v bsz="$1" '
	/ type extent / { ext++ }
	ext {
	    for (i = 1; i < NF; i++) {
		if ($i != "ptr:")
		    continue
		for (j = i + 1; j <= i + 2 && j <= NF; j++)
		    if ($j ~ /^[0-9]+:[0-9]+:[0-9]+$/) {
			split($j, p, ":")
			print ext, p[1], p[2] * bsz + p[3]
			break
		    }
	    }
	}'
}

test_scrub_corrupt_replicated()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    set_watchdog 180

    run_quiet "" bcachefs format -f --replicas=4	\
	--bucket_size=${BUCKET_SIZE_KB}k		\
	"${ktest_scratch_dev[@]}"
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt
    dd if=/dev/urandom of=/mnt/testfile bs=1M count=16 oflag=direct
    cp /mnt/testfile /root/scrub-orig
    sync
    umount /mnt

    local locations=$(bcachefs list -b extents "${ktest_scratch_dev[@]}" |
	extent_replica_locations $BUCKET_SIZE_SECTORS)
    local nr_extents=$(echo "$locations" |
	awk '{ if ($1 > m) m = $1 } END { print m + 0 }')
    if ((nr_extents < 6)); then
	echo "ERROR: only $nr_extents extents to corrupt"
	return 1
    fi

    # Corrupt random replicas of six random extents. The first victim
    # loses three of its four copies - repair must work from a single
    # surviving replica - and the rest lose a random one to three.
    local ext k dev sector nr=0 first=1
    for ext in $(seq 1 $nr_extents | shuf -n6); do
	if ((first)); then
	    k=3
	    first=0
	else
	    k=$((RANDOM % 3 + 1))
	fi
	while read -r _ dev sector; do
	    echo "corrupting extent $ext replica: dev $dev sector $sector"
	    echo "$sector" |
		bcachefs_corrupt_sectors ${ktest_scratch_dev[$dev]} > /dev/null
	    nr=$((nr + 1))
	done < <(echo "$locations" | awk -v e=$ext '$1 == e' | shuf -n$k)
    done
    echo "corrupted $nr replicas across 6 extents"

    mount -t bcachefs $devs /mnt

    # Scrub each device in turn - sequentially, so concurrent
    # per-device repairs of the same extent can't race. Combined they
    # must find and repair everything, nothing uncorrectable.
    local rc=0 drc d
    for d in "${ktest_scratch_dev[@]}"; do
	drc=0
	bcachefs scrub "$d" || drc=$?
	echo "scrub $d exit code: $drc"
	rc=$((rc | drc))
    done

    if (((rc & 2) == 0)); then
	echo "ERROR: scrub did not report corrected errors"
	return 1
    fi
    if (((rc & 4) != 0)); then
	echo "ERROR: scrub reported uncorrectable errors with a good replica present"
	return 1
    fi

    # Repair must converge: a second full pass runs clean.
    rc=0
    for d in "${ktest_scratch_dev[@]}"; do
	drc=0
	bcachefs scrub "$d" || drc=$?
	rc=$((rc | drc))
    done
    if ((rc != 0)); then
	echo "ERROR: second scrub pass still found errors (exit code $rc)"
	return 1
    fi

    cmp /mnt/testfile /root/scrub-orig
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Format with erasure coding, write data, wait for background reconcile
# to build at least one stripe, and leave the fs unmounted. Sets
# stripe_meta and stripe_block_lines from the first stripe found.
setup_ec_corrupt()
{
    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--bucket_size=${BUCKET_SIZE_KB}k	\
	"${ktest_scratch_dev[@]}"
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    dd if=/dev/urandom of=/mnt/testfile bs=1M count=128 oflag=direct
    cp /mnt/testfile /root/scrub-orig
    sync

    # Stripe creation is a background reconcile operation; kick it and
    # poll the stripe_create counter until a stripe exists.
    local created=0 i
    for i in $(seq 1 60); do
	echo 1 > /sys/fs/bcachefs/*/internal/trigger_reconcile_wakeup
	created=$(awk '/since mount/ {print $3}' \
	    /sys/fs/bcachefs/*/counters/stripe_create)
	if ((created > 0)); then
	    break
	fi
	sleep 1
    done
    if ((created == 0)); then
	echo "ERROR: no stripes created after 60s"
	return 1
    fi
    umount /mnt

    local blocks=$(bcachefs list -b stripes "${ktest_scratch_dev[@]}" |
	bcachefs_first_stripe_blocks $BUCKET_SIZE_SECTORS)
    echo "first stripe:"
    echo "$blocks"

    stripe_meta=$(echo "$blocks" | awk '$1 == "meta" {print $2, $3}')
    stripe_block_lines=$(echo "$blocks" | awk '$1 == "block"')
    if [[ -z $stripe_meta || -z $stripe_block_lines ]]; then
	echo "ERROR: could not parse stripe blocks"
	return 1
    fi
}

# Print "<dev> <sector>" for stripe block index $1.
stripe_block()
{
    echo "$stripe_block_lines" | awk -v want="$1" '$2 == want {print $3, $4}'
}

test_scrub_corrupt_ec_data()
{
    ktest_expect_device_errors=1
    # stripe_read_csum_err: repair reads the stripe, and finds the block bad too
    ktest_expect_sb_errors="stripe_read_csum_err|data_read_(io|csum)_err(_recovered)?"
    set_watchdog 300

    setup_ec_corrupt

    # Corrupt the first data block of the stripe.
    local tdev tsector
    read -r tdev tsector <<< "$(stripe_block 0)"
    echo "corrupting stripe data block 0: dev $tdev sector $tsector"
    echo "$tsector" | bcachefs_corrupt_sectors ${ktest_scratch_dev[$tdev]} > /dev/null

    local devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    local rc=0
    bcachefs scrub ${ktest_scratch_dev[$tdev]} || rc=$?
    echo "scrub exit code: $rc"

    if (((rc & 2) == 0)); then
	echo "ERROR: scrub did not report corrected errors"
	return 1
    fi
    if (((rc & 4) != 0)); then
	echo "ERROR: scrub reported uncorrectable errors despite EC redundancy"
	return 1
    fi

    cmp /mnt/testfile /root/scrub-orig
    umount /mnt

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

test_scrub_corrupt_ec_parity()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="data_read_(io|csum)_err(_recovered)?"
    set_watchdog 300

    setup_ec_corrupt

    # Corrupt the first parity block (block index nr_data): three 4k
    # spots spread across the block.
    local nr_data nr_red
    read -r nr_data nr_red <<< "$stripe_meta"

    local tdev tsector
    read -r tdev tsector <<< "$(stripe_block $nr_data)"
    echo "corrupting stripe parity block $nr_data: dev $tdev sector $tsector"
    printf '%s\n' $tsector $((tsector + 256)) $((tsector + 512)) |
	bcachefs_corrupt_sectors ${ktest_scratch_dev[$tdev]} > /dev/null

    local devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs $devs /mnt

    local rc=0
    bcachefs scrub ${ktest_scratch_dev[$tdev]} || rc=$?
    echo "scrub exit code: $rc"
    umount /mnt

    if (((rc & 2) == 0)); then
	echo "ERROR: scrub did not repair parity block corruption"
	return 1
    fi
    if (((rc & 4) != 0)); then
	echo "ERROR: scrub reported parity corruption as uncorrectable" \
	     "despite intact data blocks"
	return 1
    fi

    bcachefs fsck -ny "${ktest_scratch_dev[@]}"
    bcachefs_test_end_checks ${ktest_scratch_dev[0]}
}

# Print "<offset in bucket> <sectors on disk> <file sector> <len> <whole>
# <ptrs> <stripe idx>" for every key with a pointer into bucket $2 of
# device $1, from a bkey listing on stdin. whole: the key spans its entire
# checksummed region. ptrs: non-cached pointers.
bucket_extents()
{
    awk -v dev="$1" -v bucket="$2" '
	function flush(	i) {
	    for (i = 0; i < nhit; i++)
		print hit[i], nptrs, idx[i]
	    nhit = nptrs = 0
	}
	$1 == "u64s" {
	    flush()
	    extent = $4 == "extent"
	    split($5, pos, ":")
	    len = c_size = size = $7
	    crc_offset = 0
	    stripe = "-"
	    next
	}
	!extent { next }
	$1 ~ /^crc(32|64|128):$/ {
	    for (i = 2; i < NF; i++)
		if ($i == "c_size")
		    c_size = $(i + 1)
		else if ($i == "size")
		    size = $(i + 1)
		else if ($i == "offset")
		    crc_offset = $(i + 1)
	}
	# A stripe_ptr entry precedes the pointer it belongs to.
	$1 == "stripe_ptr:" { stripe = $3 }
	$1 == "ptr:" {
	    if ($0 !~ / cached/)
		nptrs++
	    for (i = 2; i <= 3 && i <= NF; i++)
		if ($i ~ /^[0-9]+:[0-9]+:[0-9]+$/) {
		    split($i, p, ":")
		    if (p[1] == dev && p[2] == bucket) {
			idx[nhit] = stripe
			hit[nhit++] = p[3] " " c_size " " (pos[2] - len) " " len " " \
			    (crc_offset == 0 && len == size)
		    }
		    break
		}
	    stripe = "-"
	}
	END { flush() }' | sort -n
}

test_scrub_corrupt_ec_unreferenced()
{
    ktest_expect_device_errors=1
    ktest_expect_sb_errors="stripe_read_csum_err|data_read_(io|csum)_err(_recovered)?"
    set_watchdog 300

    setup_ec_corrupt

    local nr_data nr_red
    read -r nr_data nr_red <<< "$stripe_meta"
    if ((nr_red != 1)); then
	echo "ERROR: stripe has $nr_red parity blocks; one bad block plus one"
	echo "       offline device is only data loss with one"
	return 1
    fi

    local vdev vsector ddev dsector
    read -r vdev vsector <<< "$(stripe_block 0)"
    read -r ddev dsector <<< "$(stripe_block 1)"
    local vbucket=$((vsector / BUCKET_SIZE_SECTORS))
    local dbucket=$((dsector / BUCKET_SIZE_SECTORS))

    local layout=$(bcachefs list -b extents "${ktest_scratch_dev[@]}" |
	bucket_extents $vdev $vbucket)
    echo "stripe block 0, dev $vdev bucket $vbucket (off size start len whole ptrs stripe):"
    echo "$layout"

    # Scrub reads a key's whole checksummed region, so only deleting a
    # whole key leaves sectors it never reads.
    local off size start len whole stripe
    read -r off size start len whole _ stripe <<< "$layout"
    if [[ $whole != 1 || $stripe == - ]] || (($(wc -l <<< "$layout") < 2)); then
	echo "ERROR: block 0 needs two erasure coded keys, the first a whole"
	echo "       checksummed extent, so one can go while the other stays live"
	return 1
    fi
    local end=$((off + size))

    # The punch leaves a fragmented stripe bucket, and copygc moves those:
    # it could take the live key out of block 0.
    local devs="$(join_by : "${ktest_scratch_dev[@]}")"
    mount -t bcachefs -o nocopygc_enabled $devs /mnt
    fallocate -p -o $((start * 512)) -l $((len * 512)) /mnt/testfile
    cp /mnt/testfile /root/scrub-orig
    umount /mnt

    local extents=$(bcachefs list -b extents "${ktest_scratch_dev[@]}")
    echo "after punching file sectors $start-$((start + len - 1)):"
    bucket_extents $vdev $vbucket <<< "$extents"
    echo "stripe block 1, dev $ddev bucket $dbucket:"
    bucket_extents $ddev $dbucket <<< "$extents"

    if ! bucket_extents $vdev $vbucket <<< "$extents" |
	    awk -v a=$off -v b=$end -v s=$stripe '
		$1 < b && a < $1 + $2	{ overlap = 1 }
		$7 == s			{ live = 1 }
		END			{ exit overlap || !live }'; then
	echo "ERROR: block 0 sectors $off-$((end - 1)) are still referenced, or"
	echo "       block 0 has no live key of stripe $stripe left"
	return 1
    fi

    # Reconstruct reads only the range being read, so the block taken
    # offline has to hold data at the same offsets.
    if ! bucket_extents $ddev $dbucket <<< "$extents" |
	    awk -v a=$off -v b=$end -v s=$stripe '
		$1 < b && a < $1 + $2 && $6 == 1 && $7 == s { found = 1 }
		END { exit !found }'; then
	echo "ERROR: block 1 (dev $ddev) has no single-pointer key of stripe"
	echo "       $stripe over sectors $off-$((end - 1)), so taking it offline"
	echo "       would not make a read reconstruct through the dead range"
	return 1
    fi

    echo "corrupting unreferenced sectors $off-$((end - 1)) of stripe $stripe block 0: dev $vdev"
    seq $((vbucket * BUCKET_SIZE_SECTORS + off)) 8 \
	$((vbucket * BUCKET_SIZE_SECTORS + end - 8)) |
	bcachefs_corrupt_sectors ${ktest_scratch_dev[$vdev]} > /dev/null

    mount -t bcachefs -o nocopygc_enabled $devs /mnt

    # Unlike the tests above, carry on after a scrub failure: the read below
    # is where it turns into data loss.
    local rc=0 failed=0
    bcachefs scrub ${ktest_scratch_dev[$vdev]} || rc=$?
    echo "scrub exit code: $rc"
    if (((rc & 4) != 0)); then
	echo "ERROR: scrub found the unreferenced corruption but left it"
	echo "       uncorrected, and reconstructing block 1 still reads it"
	failed=1
    elif (((rc & 2) == 0)); then
	echo "ERROR: scrub reported no corrected errors with sectors"
	echo "       $off-$((end - 1)) of stripe $stripe block 0 (dev $vdev) corrupt"
	failed=1
    fi

    # A repair may queue a rebuild. The tail of testfile that does not fill
    # a stripe stays queued as erasure_code work, so skip that type.
    timeout 60 bcachefs reconcile wait -t replicas,stripes /mnt || true

    echo "offlining dev $ddev (stripe $stripe block 1)"
    bcachefs device offline --force ${ktest_scratch_dev[$ddev]}

    if ! cmp /mnt/testfile /root/scrub-orig; then
	echo "ERROR: testfile does not read back with dev $ddev offline:"
	echo "       reconstructing block 1 reads block 0 sectors $off-$((end - 1))"
	failed=1
    fi
    umount /mnt

    if ((failed)); then
	return 1
    fi

    # No fsck: a member is still offline.
    bcachefs_test_end_checks ${ktest_scratch_dev[$vdev]}
}


main "$@"
