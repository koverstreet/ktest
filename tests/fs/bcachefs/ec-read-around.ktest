#!/usr/bin/env bash
#
# Reads of erasure-coded data always go to the device that holds the bucket,
# even when that device is evacuating or slow and the stripe could supply the
# data from its other buckets. These tests assert that reads go around such a
# device; they fail today.
#
# test_ec_read_evacuating: with reconcile paused, O_DIRECT reads of a file
#   whose stripe buckets are partly on an evacuating device.
# test_ec_repair_reads_evacuating: stripe repair while evacuating a device
#   reads every bucket of each stripe, the evacuating device's own included.
# test_ec_read_slow_device: one member behind dm-delay; O_DIRECT reads of
#   data on it wait out the delay.

# shellcheck source=tests/fs/bcachefs/bcachefs-test-libs.sh
. "$(dirname "$(readlink -e "${BASH_SOURCE[0]}")")/bcachefs-test-libs.sh"

require-kernel-config BCACHEFS_ERASURE_CODING
require-kernel-config DM_DELAY

config-scratch-devs 1G
config-scratch-devs 1G
config-scratch-devs 1G
config-scratch-devs 1G
config-scratch-devs 1G

ec_ra_bucket_kb=512
ec_ra_file_mb=96
# Btree and journal reads may still hit the device; stripe data must not.
ec_ra_max_dev_read_kb=4096

ec_ra_sectors_read()
{
    awk '{ print $3 }' "/sys/block/$(basename "$(readlink -f "$1")")/stat"
}

ec_ra_uuid()
{
    local entry
    for entry in /sys/fs/bcachefs/*; do
	[[ ${entry##*/} =~ ^[0-9a-f-]{36}$ ]] && echo "${entry##*/}" && return
    done
}

# Stripes with live data and a bucket on member <dev_idx>, from the mounted
# filesystem. Empty stripes don't count: nothing reads them. Block lines print
# as "<name> <dev>:<bucket>:<offset> gen <g>#<sectors>".
ec_ra_stripes_on()
{
    awk -v dev="$1" '
	function flush() { if (on && live) n++; on = live = 0 }
	/type stripe/ { flush() }
	{
	    for (i = 1; i < NF; i++)
		if ($i ~ /^[0-9]+:[0-9]+:[0-9]+$/ && $(i + 1) == "gen") {
		    split($i, p, ":")
		    split($(i + 2), c, "#")
		    on += p[1] == dev
		    live += c[2] > 0
		}
	}
	END { flush(); print n + 0 }' "/sys/kernel/debug/bcachefs/$(ec_ra_uuid)/btrees/stripes/keys"
}

# ec_ra_setup <devs...>: 3+1 stripes over five devices, so a stripe can be
# rebuilt without one of them; one file of ec_ra_file_mb, stripes built.
# Leaves /mnt mounted and sets ec_ra_md5.
ec_ra_setup()
{
    run_quiet "" bcachefs format -f		\
	--erasure_code				\
	--replicas=2				\
	--ec_max_data_blocks=3			\
	--bucket_size=${ec_ra_bucket_kb}k	\
	"$@"
    mount -t bcachefs "$(join_by : "$@")" /mnt

    dd if=/dev/urandom of=/mnt/data bs=1M count=$ec_ra_file_mb conv=fsync status=none
    ec_ra_md5=$(md5sum < /mnt/data)
    # Stripes are built by reconcile after the write:
    timeout 120 bcachefs reconcile wait /mnt || true

    local stripes
    stripes=$(ec_ra_stripes_on 0)
    echo "stripes with a bucket on device 0: $stripes"
    if (( stripes == 0 )); then
	echo "ERROR: no stripes on device 0 - nothing to read around, this run tests nothing"
	exit 1
    fi
}

# ec_ra_reads <before...> -- <devs...>: print per-device KiB read since the
# counts in <before...>, and set ec_ra_dev0_kb.
ec_ra_reads()
{
    local before=() i=0 dev kb
    while [[ $1 != -- ]]; do before+=("$1"); shift; done
    shift
    for dev in "$@"; do
	kb=$(( ($(ec_ra_sectors_read "$dev") - before[i]) / 2 ))
	echo "  device $i ($(basename "$dev")): read $kb KiB"
	(( i == 0 )) && ec_ra_dev0_kb=$kb
	i=$((i + 1))
    done
}

ec_ra_snapshot()
{
    local dev
    for dev in "$@"; do
	ec_ra_sectors_read "$dev"
    done
}

test_ec_read_evacuating()
{
    set_watchdog 300

    local devs=("${ktest_scratch_dev[@]}")
    ec_ra_setup "${devs[@]}"
    local sysfs
    sysfs=/sys/fs/bcachefs/$(ec_ra_uuid)

    # Keep the stripes where they are, so reads see an evacuating device
    # that still holds buckets:
    echo 0 > "$sysfs/options/reconcile_enabled"
    bcachefs device set-state -f evacuating "${devs[0]}"
    echo 3 > /proc/sys/vm/drop_caches

    local before
    mapfile -t before < <(ec_ra_snapshot "${devs[@]}")
    local got
    got=$(dd if=/mnt/data bs=1M iflag=direct status=none | md5sum)
    echo "O_DIRECT read of the ${ec_ra_file_mb}M file, device 0 evacuating:"
    ec_ra_reads "${before[@]}" -- "${devs[@]}"

    if [[ $got != "$ec_ra_md5" ]]; then
	echo "ERROR: data changed"
	exit 1
    fi

    umount /mnt
    bcachefs fsck -ny "${devs[@]}"

    if (( ec_ra_dev0_kb > ec_ra_max_dev_read_kb )); then
	echo "ERROR: read $ec_ra_dev0_kb KiB from the evacuating device; its stripe"
	echo "       buckets could have been reconstructed from the others"
	exit 1
    fi
    bcachefs_test_end_checks "${devs[0]}"
}

test_ec_repair_reads_evacuating()
{
    set_watchdog 600

    local devs=("${ktest_scratch_dev[@]}")
    ec_ra_setup "${devs[@]}"

    local stripes left waited=0
    stripes=$(ec_ra_stripes_on 0)

    local before
    mapfile -t before < <(ec_ra_snapshot "${devs[@]}")
    bcachefs device set-state -f evacuating "${devs[0]}"
    # Not reconcile wait: emptied stripes stay queued on an idle filesystem.
    while left=$(ec_ra_stripes_on 0); (( left > 0 && waited < 300 )); do
	sleep 1
	waited=$((waited + 1))
    done
    echo "evacuating device 0, which had a bucket in $stripes stripes ($((stripes * ec_ra_bucket_kb)) KiB), took ${waited}s:"
    ec_ra_reads "${before[@]}" -- "${devs[@]}"

    if (( left != 0 )); then
	bcachefs reconcile status /mnt
	echo "ERROR: $left stripes with data still on device 0 after ${waited}s -"
	echo "       the evacuation didn't finish, so the read counts are incomplete"
	exit 1
    fi

    if [[ $(md5sum < /mnt/data) != "$ec_ra_md5" ]]; then
	echo "ERROR: data changed"
	exit 1
    fi

    umount /mnt
    bcachefs fsck -ny "${devs[@]}"

    if (( ec_ra_dev0_kb > ec_ra_max_dev_read_kb )); then
	echo "ERROR: evacuating read $ec_ra_dev0_kb KiB from the evacuating device;"
	echo "       each stripe's other buckets, which repair reads anyway, could rebuild its bucket"
	exit 1
    fi
    bcachefs_test_end_checks "${devs[0]}"
}

ec_ra_dm_table()
{
    local name=$1 table=$2
    dmsetup reload "$name" --table "$table"
    dmsetup suspend --nolockfs "$name"
    dmsetup resume "$name"
}

test_ec_read_slow_device()
{
    set_watchdog 600

    # 500 ms stands in for the ~7 s a drive commonly spends in error recovery
    # (SCT ERC), to keep the test short.
    local delay_ms=500 slow_ms=200
    local raw=${ktest_scratch_dev[0]}
    local sz
    sz=$(blockdev --getsz "$raw")

    modprobe dm-delay
    dmsetup create ecslow --table "0 $sz linear $raw 0"
    trap 'umount /mnt 2>/dev/null; dmsetup remove --retry ecslow >/dev/null 2>&1; kill_descendants $BASHPID' EXIT

    local devs=(/dev/mapper/ecslow "${ktest_scratch_dev[@]:1}")
    ec_ra_setup "${devs[@]}"

    # Btree nodes into the cache while every device is fast; O_DIRECT reads
    # below then need only the data.
    cat /mnt/data > /dev/null

    ec_ra_dm_table ecslow "0 $sz delay $raw 0 $delay_ms $raw 0 0 $raw 0 0"

    local i start ms slow=0 max=0
    for (( i = 0; i < ec_ra_file_mb; i++ )); do
	start=$(date +%s%N)
	dd if=/mnt/data of=/dev/null bs=1M skip=$i count=1 iflag=direct status=none
	ms=$(( ($(date +%s%N) - start) / 1000000 ))
	(( ms > slow_ms )) && slow=$((slow + 1))
	(( ms > max )) && max=$ms
    done

    ec_ra_dm_table ecslow "0 $sz linear $raw 0"

    echo "device 0 reads delayed ${delay_ms} ms: $slow of $ec_ra_file_mb 1M O_DIRECT reads took over ${slow_ms} ms (max $max ms)"

    if [[ $(md5sum < /mnt/data) != "$ec_ra_md5" ]]; then
	echo "ERROR: data changed"
	exit 1
    fi

    umount /mnt
    bcachefs fsck -ny "${devs[@]}"
    dmsetup remove --retry ecslow
    trap 'kill_descendants $BASHPID' EXIT

    if (( slow > 0 )); then
	echo "ERROR: $slow reads waited on the delayed device although each stripe's"
	echo "       other buckets could supply the data"
	exit 1
    fi
    bcachefs_test_end_checks "${ktest_scratch_dev[1]}"
}

main "$@"
